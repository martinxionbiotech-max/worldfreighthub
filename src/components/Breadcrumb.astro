---
import { t, type Locale } from '../i18n/ui';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  locale?: Locale;
}

const { items, locale = 'en' } = Astro.props;

const startsWithHome =
  items.length > 0 &&
  (items[0].href === '/' || items[0].label === t(locale, 'breadcrumb.home'));
const crumbs = startsWithHome ? items : [{ label: t(locale, 'breadcrumb.home'), href: '/' }, ...items];
const list = crumbs.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.label,
  ...(item.href ? { item: item.href } : {}),
}));
---

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb">
    {items.map((item) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: list,
})}></script>
