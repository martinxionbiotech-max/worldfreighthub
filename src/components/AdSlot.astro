---
import { t, type Locale } from '../i18n/ui';

interface Props {
  slotLabel?: string;
  locale?: Locale;
}

const { slotLabel, locale = 'en' } = Astro.props;
---

<aside class="ad-slot" aria-label={slotLabel ?? t(locale, 'ad.label')}>
  <span class="ad-label">{slotLabel ?? t(locale, 'ad.label')}</span>
  <p class="mt-1" style="font-size:0.9rem; color: var(--ink);">
    <strong>{t(locale, 'ad.headline')}</strong>
  </p>
  <p>{t(locale, 'ad.text')}</p>
  <a class="btn btn-amber" href={locale === 'ar' ? '/ar/contact/' : '/contact/'}>{t(locale, 'ad.cta')}</a>
</aside>
