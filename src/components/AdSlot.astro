---
interface Props {
  slotLabel?: string;
}

const { slotLabel = 'Advertisement' } = Astro.props;
---

<aside class="ad-slot" aria-label={slotLabel}>
  <span class="ad-label">{slotLabel}</span>
  <p class="mt-1" style="font-size:0.9rem; color: var(--ink);">
    <strong>Advertise with WorldFreightHub</strong>
  </p>
  <p>Reach importers and freight decision-makers on the China&ndash;GCC corridor.</p>
  <a class="btn btn-amber" href="/contact/">Advertise</a>
</aside>
