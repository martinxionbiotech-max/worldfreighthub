---
import { t, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  text?: string;
  label?: string;
  href?: string;
  locale?: Locale;
}

const {
  title,
  text,
  label,
  href,
  locale = 'en',
} = Astro.props;
---

<section class="cta">
  <h2>{title ?? t(locale, 'cta.title')}</h2>
  <p>{text ?? t(locale, 'cta.text')}</p>
  <a class="btn btn-amber" href={href ?? '/get-quote/'}>{label ?? t(locale, 'cta.label')}</a>
</section>
