---
import type { Source } from '../data/types';

interface Props {
  sources: Source[];
  title?: string;
}

const { sources, title = 'Primary sources' } = Astro.props;
---

<div class="source-list">
  <h2>{title}</h2>
  {sources.length > 0 ? (
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.name}
          </a>
          <span class="badge">{source.type}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">No verified sources yet.</p>
  )}
</div>
