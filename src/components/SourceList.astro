---
import type { Source } from '../data/types';
import { t, type Locale } from '../i18n/ui';

interface Props {
  sources: Source[];
  title?: string;
  locale?: Locale;
}

const { sources, title, locale = 'en' } = Astro.props;
---

<div class="source-list">
  <h2>{title ?? t(locale, 'section.primarySources')}</h2>
  {sources.length > 0 ? (
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.name}
          </a>
          <span class="badge">{source.type}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">{t(locale, 'section.noSources')}</p>
  )}
</div>
