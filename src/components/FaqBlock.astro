---
interface QA {
  q: string;
  a: string;
}

interface Props {
  items: QA[];
}

const { items } = Astro.props;
---

<section class="faq">
  <h2>Frequently Asked Questions</h2>
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</section>
