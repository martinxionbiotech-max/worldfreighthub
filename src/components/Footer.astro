---
import { SITE_NAME } from '../site';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = locale === 'ar' ? '/ar' : '';

const explore = [
  { label: t(locale, 'nav.routes'), href: `${prefix}/routes/` },
  { label: t(locale, 'nav.countries'), href: `${prefix}/countries/` },
  { label: t(locale, 'nav.ports'), href: `${prefix}/ports/` },
  { label: t(locale, 'nav.methods'), href: `${prefix}/methods/` },
  { label: t(locale, 'nav.glossary'), href: `${prefix}/glossary/` },
  { label: t(locale, 'footer.data'), href: `${prefix}/data/` },
  { label: t(locale, 'nav.tools'), href: `${prefix}/tools/` },
];

const company = [
  { label: t(locale, 'footer.about'), href: `${prefix}/about/` },
  { label: t(locale, 'footer.methodology'), href: `${prefix}/methodology/` },
  { label: t(locale, 'footer.editorial'), href: `${prefix}/editorial-policy/` },
  { label: t(locale, 'footer.providerVerification'), href: '/provider-verification-policy/' },
  { label: t(locale, 'footer.contact'), href: `${prefix}/contact/` },
  { label: t(locale, 'nav.middleeast'), href: `${prefix}/middleeast/` },
  { label: t(locale, 'nav.europe'), href: '/europe/' },
];

const legal = [
  { label: t(locale, 'footer.privacy'), href: '/privacy-policy/' },
  { label: t(locale, 'footer.terms'), href: '/terms-of-use/' },
  { label: t(locale, 'footer.cookie'), href: '/cookie-policy/' },
  { label: t(locale, 'footer.advertising'), href: '/advertising-disclosure/' },
  { label: t(locale, 'footer.corrections'), href: '/corrections/' },
  { label: t(locale, 'footer.dataChangelog'), href: '/data-changelog/' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <h4>{SITE_NAME}</h4>
        <p>{t(locale, 'footer.brand.tagline')}</p>
      </div>
      <div class="footer-col">
        <h4>{t(locale, 'footer.explore')}</h4>
        <ul>
          {explore.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t(locale, 'footer.company')}</h4>
        <ul>
          {company.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t(locale, 'footer.legal')}</h4>
        <ul>
          {legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="footer-disclaimer">{t(locale, 'footer.disclaimer')}</p>
  </div>
</footer>
