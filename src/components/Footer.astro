---
import { SITE_NAME } from '../site';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = locale === 'ar' ? '/ar' : '';

const explore = [
  { label: t(locale, 'nav.routes'), href: `${prefix}/routes/` },
  { label: t(locale, 'nav.countries'), href: `${prefix}/countries/` },
  { label: t(locale, 'nav.ports'), href: `${prefix}/ports/` },
  { label: t(locale, 'nav.methods'), href: `${prefix}/methods/` },
  { label: t(locale, 'nav.glossary'), href: `${prefix}/glossary/` },
  { label: t(locale, 'footer.data'), href: '/data/' },
  { label: t(locale, 'nav.tools'), href: '/tools/' },
];

const company = [
  { label: t(locale, 'footer.about'), href: '/about/' },
  { label: t(locale, 'footer.methodology'), href: '/methodology/' },
  { label: t(locale, 'footer.editorial'), href: '/editorial-policy/' },
  { label: t(locale, 'footer.contact'), href: '/contact/' },
  { label: t(locale, 'nav.middleeast'), href: '/middleeast/' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <h4>{SITE_NAME}</h4>
        <p>{t(locale, 'footer.brand.tagline')}</p>
      </div>
      <div class="footer-col">
        <h4>{t(locale, 'footer.explore')}</h4>
        <ul>
          {explore.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t(locale, 'footer.company')}</h4>
        <ul>
          {company.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="footer-disclaimer">{t(locale, 'footer.disclaimer')}</p>
  </div>
</footer>
