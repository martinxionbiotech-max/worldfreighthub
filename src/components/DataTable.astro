---
import ConfidenceBadge from './ConfidenceBadge.astro';

export interface Column {
  key: string;
  label: string;
  type?: 'text' | 'confidence' | 'amount' | 'number' | 'link';
}

interface Props {
  columns: Column[];
  rows: Record<string, any>[];
  caption?: string;
}

const { columns, rows, caption } = Astro.props;
---

<div class="table-wrap">
  <table class="data-table">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col) => (
          <th scope="col">{col.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {columns.map((col) => {
            const value = row[col.key];
            return (
              <td>
                {col.type === 'confidence' ? (
                  <ConfidenceBadge level={value} />
                ) : col.type === 'amount' ? (
                  typeof value === 'number' && value > 0 ? (
                    `$${value.toFixed(2)}`
                  ) : (
                    <span class="muted">&mdash;</span>
                  )
                ) : col.type === 'link' ? (
                  <a href={value.href}>{value.label}</a>
                ) : (
                  <span>{value}</span>
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
