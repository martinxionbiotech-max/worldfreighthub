---
import { SITE_NAME, CONTACT } from '../site';

const nav = [
  { label: 'Routes', href: '/routes/' },
  { label: 'Countries', href: '/countries/' },
  { label: 'Ports', href: '/ports/' },
  { label: 'Methods', href: '/methods/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Directory', href: '/directory/' },
  { label: 'Middle East', href: '/middleeast/' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a class="nav-cta nav-cta--whatsapp" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      <a class="nav-cta" href="/get-quote/">Get Quote</a>
    </nav>
  </div>
</header>
