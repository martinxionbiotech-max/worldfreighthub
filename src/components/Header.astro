---
import { SITE_NAME, CONTACT } from '../site';
import { t, localizePath, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = locale === 'ar' ? '/ar' : '';

const pathname = Astro.url.pathname;
const otherLocale: Locale = locale === 'ar' ? 'en' : 'ar';
const otherHref = localizePath(pathname, otherLocale);
// Europe section is English-only — hide the Arabic switch there.
const isEuropeEn = locale === 'en' && pathname.startsWith('/europe/');

// Sections with a live Arabic version get the /ar/ prefix; the rest point to English for now.
const navGroups = [
  {
    label: t(locale, 'nav.destinations'),
    items: [
      { label: t(locale, 'nav.middleeast'), href: `${prefix}/middleeast/` },
      { label: t(locale, 'nav.europe'), href: '/europe/' },
    ],
  },
  {
    label: t(locale, 'nav.guides'),
    items: [
      { label: t(locale, 'nav.routes'), href: `${prefix}/routes/` },
      { label: t(locale, 'nav.countries'), href: `${prefix}/countries/` },
      { label: t(locale, 'nav.ports'), href: `${prefix}/ports/` },
      { label: t(locale, 'nav.methods'), href: `${prefix}/methods/` },
    ],
  },
  {
    label: t(locale, 'nav.resources'),
    items: [
      { label: t(locale, 'nav.glossary'), href: `${prefix}/glossary/` },
      { label: t(locale, 'nav.tools'), href: `${prefix}/tools/` },
      { label: t(locale, 'nav.directory'), href: `${prefix}/directory/` },
    ],
  },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={prefix || '/'}>{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navGroups.map((group) => (
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-toggle" aria-haspopup="true">
            {group.label}
            <span class="caret">▾</span>
          </button>
          <div class="nav-dropdown-menu">
            {group.items.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
      {!isEuropeEn && (
        <a class="lang-switch" href={otherHref} hreflang={otherLocale} lang={otherLocale}>
          {locale === 'ar' ? 'English' : '\u0627\u0644\u0639\u0631\u0628\u064a\u0629'}
        </a>
      )}
      <a class="nav-cta nav-cta--whatsapp" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">{t(locale, 'nav.whatsapp')}</a>
      <a class="nav-cta" href={`${prefix}/get-quote/`}>{t(locale, 'nav.getquote')}</a>
    </nav>
  </div>
</header>
