---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Editorial Policy"
  description="How World Freight Hub researches, verifies, and reviews content."
  canonical="/editorial-policy/"
>
  <div class="container">
    <h1 class="section">Editorial Policy</h1>
    <p>
      Content is researched from English, Chinese, and primary sources, then written as original
      English content. We do not machine-translate and publish.
    </p>
    <p>
      Core facts undergo secondary verification. Single-source information is marked. We do not
      fabricate customer counts, case studies, prices, or ratings.
    </p>
    <h2>Corrections</h2>
    <p>
      To report an error, contact us via the <a href="/contact/">contact page</a>.
    </p>
  </div>
</BaseLayout>
