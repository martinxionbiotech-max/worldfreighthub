---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL } from '../site';
---

<BaseLayout
  title="Editorial Policy"
  description="WorldFreightHub editorial standards: no fake reviews, ratings or prices; transparent sourcing and corrections."
  canonical={`${SITE_URL}/editorial-policy/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Editorial Policy' }]} />
      <h1>Editorial policy</h1>
      <p class="lead">
        The standards that guide everything published on WorldFreightHub.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>No fake data</h2>
    <p>
      We never publish fabricated reviews, ratings, prices, schedules or quotes.
      Where a figure is not yet verified, it is shown as a placeholder and
      marked accordingly.
    </p>

    <h2>Transparency</h2>
    <p>
      Sourcing is disclosed on the pages where it matters. Confidence levels
      accompany estimates, and placeholders are never presented as verified
      facts.
    </p>

    <h2>Corrections</h2>
    <p>
      If you find an error or an outdated figure, contact us and we will review
      it. Corrections are prioritized over page retention.
    </p>

    <h2>Advertising</h2>
    <p>
      Advertising slots are clearly separated from editorial content. Editorial
      decisions are never influenced by advertisers, and ad placements are
      reserved rather than filled with misleading content.
    </p>
  </section>
</BaseLayout>
