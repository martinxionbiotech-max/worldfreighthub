---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ConfidenceBadge from '../components/ConfidenceBadge.astro';
import { SITE_URL } from '../site';
---

<BaseLayout
  title="Methodology"
  description="How WorldFreightHub sources and verifies freight data, and how confidence levels are assigned."
  canonical={`${SITE_URL}/methodology/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Methodology' }]} />
      <h1>Methodology</h1>
      <p class="lead">
        How we source, structure and verify the data behind WorldFreightHub.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>Primary sources first</h2>
    <p>
      We prefer primary sources: government customs and tax authorities, port
      authorities and carriers. Secondary or aggregated data is used only to
      cross-check, never as the sole basis for a published figure.
    </p>

    <h2>Confidence levels</h2>
    <p>
      Every estimate carries a confidence level so readers know how much weight
      to give it.
    </p>
    <ul>
      <li>
        <ConfidenceBadge level="HIGH" /> — confirmed against a primary source.
      </li>
      <li>
        <ConfidenceBadge level="MEDIUM" /> — corroborated by multiple secondary sources.
      </li>
      <li>
        <ConfidenceBadge level="LOW" /> — unverified estimate; treat as a placeholder.
      </li>
    </ul>

    <h2>Rates and transit times</h2>
    <p>
      Freight rates and transit times fluctuate. All figures on this site are
      indicative estimates and are published as placeholders until they are
      verified against a carrier schedule or tariff. No live pricing is shown.
    </p>

    <h2>Verification workflow</h2>
    <p>
      Before any figure is upgraded from a placeholder, it must pass secondary
      verification against at least one independent primary source. Anything
      that cannot be verified remains unpublished or stays marked as an
      estimate.
    </p>
  </section>
</BaseLayout>
