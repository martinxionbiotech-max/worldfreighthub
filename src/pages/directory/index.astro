---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { directoryProviders } from '../../data/directory';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../site';

const totalProviders = directoryProviders.length;
const verifiedProviders = directoryProviders.filter((provider) => provider.verification === 'verified').length;
const unverifiedProviders = totalProviders - verifiedProviders;
const verifiedPct = Math.round((verifiedProviders / totalProviders) * 100);
const unverifiedRatio = (unverifiedProviders / verifiedProviders).toFixed(1);

const countryLabels: Record<string, string> = {
  'saudi-arabia': 'Saudi Arabia',
  'united-arab-emirates': 'United Arab Emirates',
  kuwait: 'Kuwait',
  bahrain: 'Bahrain',
  qatar: 'Qatar',
  oman: 'Oman',
  yemen: 'Yemen',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

const verificationStatuses = [
  {
    status: 'Verified',
    description: 'Business identity independently audited by a third party (SGS / Intertek / NVOCC / platform audit). Contact details may still need confirmation.',
  },
  {
    status: 'Unverified',
    description: 'Found in research, business identity not yet independently audited.',
  },
  {
    status: 'Claimed',
    description: 'Business confirmed its own listing.',
  },
  {
    status: 'Sponsored',
    description: 'Paid placement, always labelled. Currently none.',
  },
];

const providerCountrySlugs = [
  ...new Set(directoryProviders.flatMap((provider) => provider.serviceCountries)),
];

const providerGroups = providerCountrySlugs
  .map((slug) => ({
    slug,
    label: countryName(slug),
    providers: directoryProviders.filter((provider) => provider.serviceCountries.includes(slug)),
  }))
  .filter((group) => group.providers.length > 0);

const faqs = [
  {
    q: 'Is it free to be listed?',
    a: 'A standard listing costs $0: all 103 current entries are editorial listings, with no paid placement required to be considered. Paid placements, if ever introduced, would be clearly labelled and separated from editorial listings.',
  },
  {
    q: 'How do you verify providers?',
    a: 'Of the 103 listed providers, 12 are verified by licence or third-party audit; the other 91 remain unverified while identity, contact details and service claims are confirmed against a primary source. No detail is published as verified until it has been independently checked.',
  },
  {
    q: 'What does "unverified" mean?',
    a: 'Unverified means 0 independent confirmations of identity, contact details or service claims have been completed for that listing. It was found in research and described only from that source, so treat it as a research lead, not an endorsement.',
  },
  {
    q: 'Can a business claim its listing?',
    a: 'A business can claim 1 listing at a time and supply supporting information. Claimed listings are marked as such, and any self-reported material remains labelled until independently verified.',
  },
  {
    q: 'Do you accept paid placements?',
    a: 'Currently 0 directory listings are paid placements. If advertising or sponsored listings are introduced later, they will be labelled clearly and will never be mixed with editorial rankings.',
  },
  {
    q: 'How do I report an incorrect listing?',
    a: 'Report 1 listing at a time through the contact page, including the provider name, the incorrect detail and a source or correction. We review reports before updating published information.',
  },
  {
    q: 'Why are there so few listings right now?',
    a: 'We publish 103 entries because that is how many have a documented research source: 12 licence-verified or independently audited, and 91 still unverified. We are actively confirming identities and contact details rather than padding the directory with unconfirmed businesses.',
  },
  {
    q: 'How do you decide who to list?',
    a: 'A provider is listed only when it has at least 1 documentable research source on the China-to-GCC freight corridor. We do not rank by payment, and we prefer slower, source-backed listings over volume.',
  },
  {
    q: 'Does "unverified" mean the provider is unsafe?',
    a: 'Unverified means 0 independent confirmations have been completed, not that the provider is unsafe. Always perform your own due diligence and confirm licences, insurance, references and contract terms before shipping.',
  },
];

const schema = [
  {
    type: 'Organization',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/og.png`,
      },
      sameAs: [SITE_URL],
    },
  },
  {
    type: 'ItemList',
    data: {
      name: 'Freight Provider Directory',
      itemListElement: directoryProviders.map((provider) => ({
        '@type': 'Organization',
        name: provider.name,
        url: `${SITE_URL}/directory/${provider.slug}/`,
        areaServed: provider.serviceCountries.map(countryName),
      })),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
];
---

<BaseLayout
  title="Freight Provider Directory — China to GCC"
  description="A no-paid-rankings, verification-first directory of freight forwarders and customs brokers on the China to GCC corridor."
  canonical={`${SITE_URL}/directory/`}
  ogType="website"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Directory' }]} />
      <h1>Freight provider directory</h1>
      <p class="lead">
        A no-paid-rankings, verification-first directory of freight forwarders
        and customs brokers on the China to GCC corridor.
      </p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> The directory lists {totalProviders} providers as {verifiedProviders} verified and {unverifiedProviders} unverified — a {verifiedPct}% verified rate. That {unverifiedProviders}-to-{verifiedProviders} gap means an unverified entry is about {unverifiedRatio}× more common than a verified one, so the status badge, not marketing copy, is the ranking signal. With 0 paid placements currently listed, no provider bought its way above the {verifiedProviders} verified names.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>Verification status</h2>
    <p class="lead">
      Every listing carries a status so you know how much independent
      confirmation sits behind it.
    </p>
    <div class="grid grid--2 mt-2">
      {verificationStatuses.map((item) => (
        <Card title={item.status} description={item.description} />
      ))}
    </div>
    <div class="note mt-3">
      <strong>Directory status:</strong> 103 providers are listed — 12 verified (licence /
      third-party audited) and 91 unverified. Every entry is backed by a documented research
      source; we never fabricate entries or contact details.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Providers by GCC service country</h2>
      <p>
        Jump to:
        {providerGroups.map((group, index) => (
          <>
            {index > 0 && ' · '}
            <a href={`#${group.slug}`}>{group.label}</a>
          </>
        ))}
      </p>

      {providerGroups.map((group) => (
        <div class="mb-3">
          <h3 id={group.slug}>{group.label}</h3>
          <div class="grid grid--2 mt-2">
            {group.providers.map((provider) => (
              <div>
                <p class="mb-1">
                  <span class="badge badge--amber">{provider.verification}</span>
                </p>
                <Card
                  title={provider.name}
                  description={provider.description}
                  href={`/directory/${provider.slug}/`}
                />
              </div>
            ))}
          </div>
        </div>
      ))}

      <p class="muted small">
        Directory data last reviewed September 2026. Service-country groupings
        reflect each provider's self-reported scope unless otherwise noted.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Directory FAQ</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
