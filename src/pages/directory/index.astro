---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Freight Forwarder Directory"
  description="A directory of freight forwarders serving China to GCC routes. Verified company data with clear status labels."
  canonical="/directory/"
>
  <div class="container">
    <h1 class="section">Freight Forwarder Directory</h1>
    <p class="muted">
      Coming soon. Every listing will carry a verification status (Verified / Unverified / Claimed / Sponsored) with a source and verification date.
    </p>
    <div class="callout">
      No company data is fabricated. Listings are added only from verifiable public sources.
    </div>
  </div>
</BaseLayout>
