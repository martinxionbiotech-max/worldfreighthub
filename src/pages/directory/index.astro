---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { directoryProviders } from '../../data/directory';
import {
  VERIFICATION_LEVEL_LABELS,
  verificationLevelForSourceType,
  type VerificationLevel,
} from '../../data/types';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../site';

const totalProviders = directoryProviders.length;
const levelCounts: Record<VerificationLevel, number> = {
  LEVEL_1_LISTED: 0,
  LEVEL_2_SOURCE_VERIFIED: 0,
  LEVEL_3_INDEPENDENTLY_VERIFIED: 0,
  LEVEL_4_PROVIDER_CONFIRMED: 0,
};

directoryProviders.forEach((provider) => {
  levelCounts[verificationLevelForSourceType(provider.sourceType)] += 1;
});

const level1Count = levelCounts.LEVEL_1_LISTED;
const level2Count = levelCounts.LEVEL_2_SOURCE_VERIFIED;

const countryLabels: Record<string, string> = {
  'saudi-arabia': 'Saudi Arabia',
  'united-arab-emirates': 'United Arab Emirates',
  kuwait: 'Kuwait',
  bahrain: 'Bahrain',
  qatar: 'Qatar',
  oman: 'Oman',
  yemen: 'Yemen',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

const verificationLevels = [
  {
    title: VERIFICATION_LEVEL_LABELS.LEVEL_1_LISTED,
    description:
      'The provider is documented in a third-party directory or marketplace record. This establishes a listing source, but core identity, website and service claims have not yet been confirmed directly against the provider\u2019s own website.',
  },
  {
    title: VERIFICATION_LEVEL_LABELS.LEVEL_2_SOURCE_VERIFIED,
    description:
      'Core identity, website, service area and published claims were checked against the provider\u2019s own website. This is source verification only, not independent or government verification.',
  },
  {
    title: VERIFICATION_LEVEL_LABELS.LEVEL_3_INDEPENDENTLY_VERIFIED,
    description:
      'Core facts were cross-checked against at least two independent sources. Currently 0 providers have reached this level.',
  },
  {
    title: VERIFICATION_LEVEL_LABELS.LEVEL_4_PROVIDER_CONFIRMED,
    description:
      'The provider has confirmed the listing and supplied supporting documentation. Currently 0 providers have reached this level.',
  },
];

const providerCountrySlugs = [
  ...new Set(directoryProviders.flatMap((provider) => provider.serviceCountries)),
];

const providerGroups = providerCountrySlugs
  .map((slug) => ({
    slug,
    label: countryName(slug),
    providers: directoryProviders.filter((provider) => provider.serviceCountries.includes(slug)),
  }))
  .filter((group) => group.providers.length > 0);

const faqs = [
  {
    q: 'Is it free to be listed?',
    a: `A standard listing costs $0: all ${totalProviders} current entries are editorial listings, with no paid placement required to be considered. Paid placements, if ever introduced, would be clearly labelled and separated from editorial listings.`,
  },
  {
    q: 'How do you source-check providers?',
    a: `All ${totalProviders} listed providers are source-documented: ${level2Count} at LEVEL 2 SOURCE VERIFIED and ${level1Count} at LEVEL 1 LISTED. Identity, website and published service claims have each been checked against the provider's own website or a third-party directory. None has been independently verified.`,
  },
  {
    q: 'What do the LEVEL 1-4 labels mean?',
    a: `LEVEL 1 LISTED means a third-party directory or marketplace record documents the provider. LEVEL 2 SOURCE VERIFIED means core identity, website and published service claims were checked against the provider's own website. LEVEL 3 INDEPENDENTLY VERIFIED and LEVEL 4 PROVIDER CONFIRMED currently have 0 providers. A higher level is stronger source documentation; none of these levels is a recommendation or endorsement.`,
  },
  {
    q: 'Can a business claim its listing?',
    a: 'A business can claim 1 listing at a time and supply supporting information. Claimed listings are marked as such. Currently 0 listings are provider-confirmed, and any self-reported material remains labelled as unverified until the provider supplies corroborating documentation.',
  },
  {
    q: 'Do you accept paid placements?',
    a: 'Currently 0 directory listings are paid placements. If advertising or sponsored listings are introduced later, they will be labelled clearly and will never be mixed with editorial rankings.',
  },
  {
    q: 'How do I report an incorrect listing?',
    a: 'Report 1 listing at a time through the contact page, including the provider name, the incorrect detail and a source or correction. We review reports before updating published information.',
  },
  {
    q: 'Why are there so few listings right now?',
    a: `We publish ${totalProviders} entries because that is how many have a documented research source and have completed source documentation. Source-documented is not the same as independently verified, and we do not pad the directory with unconfirmed businesses.`,
  },
  {
    q: 'How do you decide who to list?',
    a: 'A provider is listed only when it has at least 1 documentable research source on the China-to-GCC freight corridor. We do not rank by payment, and we prefer slower, source-documented listings over volume.',
  },
  {
    q: 'How do I contact a listed provider?',
    a: 'Each listing publishes the provider\u2019s website and links to our Get Quote form, which routes your enquiry to the right contact without adding a fee. Direct phone and email addresses are not published on listings to avoid exposing outdated details.',
  },
];

const schema = [
  {
    type: 'Organization',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/og.png`,
      },
      sameAs: [SITE_URL],
    },
  },
  {
    type: 'ItemList',
    data: {
      name: 'Freight Provider Directory',
      itemListElement: directoryProviders.map((provider) => ({
        '@type': 'Organization',
        name: provider.name,
        url: `${SITE_URL}/directory/${provider.slug}/`,
        areaServed: provider.serviceCountries.map(countryName),
      })),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
];
---

<BaseLayout
  title="Freight Provider Directory — China to GCC"
  description="A no-paid-rankings, source-documented directory of freight forwarders and customs brokers on the China to GCC corridor."
  canonical={`${SITE_URL}/directory/`}
  ogType="website"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Directory' }]} />
      <h1>Freight provider directory</h1>
      <p class="lead">
        A no-paid-rankings, source-documented directory of freight forwarders
        and customs brokers on the China to GCC corridor.
      </p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> The directory lists {totalProviders} providers,
          all source-documented: {level2Count} at LEVEL 2 SOURCE VERIFIED (own
          website) and {level1Count} at LEVEL 1 LISTED (third-party directory).
          0 are independently verified and 0 are provider-confirmed. With 0 paid
          placements currently listed, no provider bought its way into the
          directory — the badge reflects source documentation, not marketing
          copy, recommendation or endorsement.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>Verification levels</h2>
    <p class="lead">
      Every listing carries a LEVEL 1-4 badge showing how its source
      documentation was established. Source-documented does not mean
      independently verified, recommended, endorsed, best, cheapest, or
      guaranteed.
    </p>
    <div class="grid grid--2 mt-2">
      {verificationLevels.map((item) => (
        <Card title={item.title} description={item.description} />
      ))}
    </div>
    <div class="note mt-3">
      <strong>Directory status:</strong> {totalProviders} providers are listed —
      {level2Count} at {VERIFICATION_LEVEL_LABELS.LEVEL_2_SOURCE_VERIFIED} and
      {level1Count} at {VERIFICATION_LEVEL_LABELS.LEVEL_1_LISTED}. 0 providers
      are LEVEL 3 INDEPENDENTLY VERIFIED and 0 are LEVEL 4 PROVIDER CONFIRMED.
      Every entry is backed by a documented research source; we never fabricate
      entries or contact details.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Providers by GCC service country</h2>
      <p>
        Jump to:
        {providerGroups.map((group, index) => (
          <>
            {index > 0 && ' · '}
            <a href={`#${group.slug}`}>{group.label}</a>
          </>
        ))}
      </p>

      {providerGroups.map((group) => (
        <div class="mb-3">
          <h3 id={group.slug}>{group.label}</h3>
          <div class="grid grid--2 mt-2">
            {group.providers.map((provider) => (
              <div>
                <p class="mb-1">
                  <span class="badge badge--amber">
                    {VERIFICATION_LEVEL_LABELS[verificationLevelForSourceType(provider.sourceType)]}
                  </span>
                </p>
                <Card
                  title={provider.name}
                  description={provider.description}
                  href={`/directory/${provider.slug}/`}
                />
              </div>
            ))}
          </div>
        </div>
      ))}

      <p class="muted small">
        Directory data last reviewed September 2026. Service-country groupings
        reflect each provider's documented source scope; they are not
        independently checked.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Directory FAQ</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <Cta text="Tell us about your shipment and we will connect you with source-documented providers on the China–GCC corridor." />
  </section>
</BaseLayout>
