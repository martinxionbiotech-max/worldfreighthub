---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { directoryProviders, type DirectoryProvider } from '../../data/directory';
import {
  VERIFICATION_LEVEL_LABELS,
  verificationLevelForSourceType,
  type VerificationLevel,
} from '../../data/types';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../site';

export function getStaticPaths() {
  return directoryProviders.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props as { provider: DirectoryProvider };

const serviceCountryCount = provider.serviceCountries.length;
const methodCount = provider.methods.length;
const claimCount = provider.selfReportedClaims?.length ?? 0;
const verificationLevel = verificationLevelForSourceType(provider.sourceType);
const verificationLevelLabel = VERIFICATION_LEVEL_LABELS[verificationLevel];

const countryLabels: Record<string, string> = {
  'saudi-arabia': 'Saudi Arabia',
  'united-arab-emirates': 'United Arab Emirates',
  kuwait: 'Kuwait',
  qatar: 'Qatar',
  oman: 'Oman',
  yemen: 'Yemen',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

const verificationExplanations: Record<DirectoryProvider['verification'], string> = {
  verified:
    'source-documented — business identity and published claims were checked against the provider\u2019s own website or a third-party directory. This is not an independent verification.',
  unverified:
    'This provider was found in research, but its identity, contact details and service claims have not yet been source-documented.',
  claimed: 'The business has confirmed its own listing; self-reported details remain labelled until corroborating documentation is supplied.',
  sponsored: 'This is a paid placement, always labelled as sponsored.',
};

const verificationLevelExplanations: Record<VerificationLevel, string> = {
  LEVEL_1_LISTED:
    'The provider is documented in a third-party directory or marketplace record. Core identity, website and service claims have not yet been confirmed directly against the provider\u2019s own website. This is not an independent verification.',
  LEVEL_2_SOURCE_VERIFIED:
    'Core identity, website, service area and published claims were checked against the provider\u2019s own website. This is source verification only; no independent or government verification has been completed.',
  LEVEL_3_INDEPENDENTLY_VERIFIED:
    'Core facts were cross-checked against at least two independent sources. Currently 0 providers have reached this level.',
  LEVEL_4_PROVIDER_CONFIRMED:
    'The provider has confirmed the listing and supplied supporting documentation. Currently 0 providers have reached this level.',
};

const tableColumns = [
  { key: 'listingStatus', label: 'Listing status' },
  { key: 'verificationLevel', label: 'Verification level' },
  { key: 'serviceCountries', label: 'Service countries' },
  { key: 'methods', label: 'Methods' },
  { key: 'platformFocus', label: 'Platform focus' },
  { key: 'source', label: 'Source', type: 'link' as const },
  { key: 'sourceType', label: 'Source type' },
  { key: 'lastReviewed', label: 'Last reviewed' },
];

const tableRows = [
  {
    listingStatus: 'Listed · source-documented',
    verificationLevel: verificationLevelLabel,
    serviceCountries: provider.serviceCountries.map(countryName).join(', '),
    methods: provider.methods.join(', '),
    platformFocus:
      provider.platformFocus && provider.platformFocus.length > 0
        ? provider.platformFocus.join(', ')
        : 'Not stated',
    source: {
      href: provider.source,
      label: provider.sourceName,
    },
    sourceType: provider.sourceType === 'own-website' ? 'Own website' : 'Directory listing',
    lastReviewed: provider.lastVerified,
  },
];

const faqs = [
  {
    q: 'How does WorldFreightHub source-check a freight forwarder?',
    a: 'Source documentation requires documented-source checks — business identity, published service claims and website, checked against the provider\u2019s own website or a third-party directory. Every listing on this directory has completed these checks. This is not an independent verification.',
  },
  {
    q: 'How should I choose a freight forwarder for China-to-GCC shipping?',
    a: 'Choose against 4 checks: a verifiable licence (NVOCC, FMC or equivalent), proven experience on your specific lane, an itemised written quote, and clarity on demurrage/detention. Ask about hidden charges before booking, and confirm who acts as importer of record for DDP shipments.',
  },
  {
    q: 'Why are no direct phone/email details published on listings?',
    a: 'WorldFreightHub publishes the provider\u2019s website and routes enquiries through its Get Quote form, so a request reaches the right contact without exposing a phone number or personal mailbox that could become outdated. You can also reach the provider directly through their published website.',
  },
];

const schema = [
  {
    type: 'LocalBusiness',
    data: {
      name: provider.name,
      ...(provider.website ? { url: provider.website } : {}),
      description: provider.description,
      areaServed: provider.serviceCountries.map(countryName),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`${provider.name} — Freight Provider Directory`}
  description={provider.description}
  canonical={`${SITE_URL}/directory/${provider.slug}/`}
  schema={schema}
  noindex={provider.verification !== 'verified'}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Directory', href: '/directory/' },
          { label: provider.name },
        ]}
      />
      <h1>{provider.name}</h1>
      {provider.nameZh && <p class="lead">{provider.nameZh}</p>}
      <p class="muted">{provider.description}</p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> This profile is {verificationLevelLabel}, with {serviceCountryCount} service countries and {methodCount} freight methods recorded from its source. {claimCount} self-reported claims are published only as claims, and direct phone/email details are not published on the listing — reach the provider through their website or our Get Quote form.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Listing status</span>
        <span class="fact-value">Listed · source-documented</span>
      </div>
      <div class="fact">
        <span class="fact-label">Verification level</span>
        <span class="fact-value">{verificationLevelLabel}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Headquarters</span>
        <span class="fact-value">{provider.hqCountry}</span>
      </div>
    </div>
    <div class="note mt-3">
      <strong>Listing status:</strong> {verificationExplanations[provider.verification]}
    </div>
    <div class="note mt-2">
      <strong>What this level means:</strong> {verificationLevelExplanations[verificationLevel]}
    </div>
  </section>

  <section class="section container">
    <h2>Listing summary</h2>
    <DataTable
      columns={tableColumns}
      rows={tableRows}
      caption="Service scope and claims reflect the published source and are source-documented before publication."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Known limitations</h2>
      <p>
        Source documentation confirms that this listing was found in, and
        checked against, its stated source. It does not verify licences,
        accreditations, certifications, insurance, financial standing,
        operational reliability or current contact accuracy, and it is not a
        recommendation or endorsement.
      </p>
      {verificationLevel === 'LEVEL_1_LISTED' ? (
        <p>
          This listing is LEVEL 1 LISTED: the source is a third-party
          directory record, and core identity, website and service claims
          have not yet been confirmed directly against the provider&rsquo;s
          own website.
        </p>
      ) : (
        <p>
          This listing is LEVEL 2 SOURCE VERIFIED: core identity, website and
          service claims were checked against the provider&rsquo;s own
          website. No independent cross-check has been completed.
        </p>
      )}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Self-reported claims</h2>
      <p>
        These statements come from the provider or a marketplace listing. They
        are self-reported and are <strong>not independently verified</strong>.
      </p>
      {provider.selfReportedClaims && provider.selfReportedClaims.length > 0 ? (
        <ul>
          {provider.selfReportedClaims.map((claim) => (
            <li>{claim}</li>
          ))}
        </ul>
      ) : (
        <p class="muted">No self-reported claims have been recorded yet.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>Contact & verification</h2>
    <div class="note">
      <strong>Business identity source-documented.</strong>{' '}
      {provider.contactNote}
    </div>
    <p>
      WorldFreightHub has source-documented this provider&rsquo;s identity,
      website, service area and published claims against the source of record.
      Direct contact details (phone / email) are not published on the listing;
      reach the provider through their website or via our Get Quote form,
      which routes your request without adding any fee.
    </p>
    <p class="mt-2">
      <a class="btn btn-secondary" href="/contact/">
        Report an incorrect or outdated listing
      </a>
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={faqs} />
    </div>
  </section>

  <section class="section container">
    <Cta text="Tell us about your shipment and we will connect you with source-documented providers on the China–GCC corridor." />
  </section>
</BaseLayout>
