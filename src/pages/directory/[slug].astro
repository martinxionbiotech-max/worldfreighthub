---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { directoryProviders, type DirectoryProvider } from '../../data/directory';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../site';

export function getStaticPaths() {
  return directoryProviders.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props as { provider: DirectoryProvider };

const totalProviders = directoryProviders.length;
const verifiedProviders = directoryProviders.filter((item) => item.verification === 'verified').length;
const serviceCountryCount = provider.serviceCountries.length;
const methodCount = provider.methods.length;
const claimCount = provider.selfReportedClaims?.length ?? 0;

const countryLabels: Record<string, string> = {
  'saudi-arabia': 'Saudi Arabia',
  'united-arab-emirates': 'United Arab Emirates',
  kuwait: 'Kuwait',
  qatar: 'Qatar',
  oman: 'Oman',
  yemen: 'Yemen',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

const verificationExplanations: Record<DirectoryProvider['verification'], string> = {
  verified: 'Business identity and claims have been independently confirmed by WorldFreightHub. Contact details are available via the provider\u2019s website or our Get Quote form.',
  unverified:
    'This provider was found in research, but its identity, contact details and service claims have not yet been independently confirmed.',
  claimed: 'The business has confirmed its own listing; self-reported details remain labelled until independently verified.',
  sponsored: 'This is a paid placement, always labelled as sponsored.',
};

const tableColumns = [
  { key: 'serviceCountries', label: 'Service countries' },
  { key: 'methods', label: 'Methods' },
  { key: 'platformFocus', label: 'Platform focus' },
  { key: 'verification', label: 'Verification' },
  { key: 'lastVerified', label: 'Last verified' },
  { key: 'source', label: 'Source', type: 'link' as const },
];

const tableRows = [
  {
    serviceCountries: provider.serviceCountries.map(countryName).join(', '),
    methods: provider.methods.join(', '),
    platformFocus:
      provider.platformFocus && provider.platformFocus.length > 0
        ? provider.platformFocus.join(', ')
        : 'Not stated',
    verification: provider.verification,
    lastVerified: provider.lastVerified,
    source: {
      href: provider.source,
      label: provider.sourceName,
    },
  },
];

const faqs = [
  {
    q: 'How does WorldFreightHub verify a freight forwarder?',
    a: 'Verification requires 3 independent checks — business identity, published service claims and website — confirmed against a primary source such as an NVOCC/FMC licence, a government registry, or the provider\u2019s own published credentials. Every listing on this directory has completed these checks.',
  },
  {
    q: 'How should I choose a freight forwarder for China-to-GCC shipping?',
    a: 'Choose against 4 checks: a verifiable licence (NVOCC, FMC or equivalent), proven experience on your specific lane, an itemised written quote, and clarity on demurrage/detention. Ask about hidden charges before booking, and confirm who acts as importer of record for DDP shipments.',
  },
  {
    q: 'Why are no direct phone/email details published on listings?',
    a: 'WorldFreightHub publishes the provider\u2019s website and routes enquiries through its Get Quote form, so a request reaches the right contact without exposing a phone number or personal mailbox that could become outdated. You can also reach the provider directly through their published website.',
  },
];

const schema = [
  {
    type: 'LocalBusiness',
    data: {
      name: provider.name,
      ...(provider.website ? { url: provider.website } : {}),
      description: provider.description,
      areaServed: provider.serviceCountries.map(countryName),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`${provider.name} — Freight Provider Directory`}
  description={provider.description}
  canonical={`${SITE_URL}/directory/${provider.slug}/`}
  schema={schema}
  noindex={provider.verification !== 'verified'}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Directory', href: '/directory/' },
          { label: provider.name },
        ]}
      />
      <h1>{provider.name}</h1>
      {provider.nameZh && <p class="lead">{provider.nameZh}</p>}
      <p class="muted">{provider.description}</p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> This profile is {provider.verification}, with {serviceCountryCount} service countries and {methodCount} freight methods recorded from its source. {claimCount} self-reported claims are published only as claims, and direct phone/email details are not published on the listing — reach the provider through their website or our Get Quote form.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Verification status</span>
        <span class="fact-value">{provider.verification}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Headquarters</span>
        <span class="fact-value">{provider.hqCountry}</span>
      </div>
    </div>
    <div class="note mt-3">
      <strong>What this status means:</strong>{' '}
      {verificationExplanations[provider.verification]}
    </div>
  </section>

  <section class="section container">
    <h2>Listing summary</h2>
    <DataTable
      columns={tableColumns}
      rows={tableRows}
      caption="Service scope and claims reflect the published source and are independently verified before publication."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Self-reported claims</h2>
      <p>
        These statements come from the provider or a marketplace listing. They
        are self-reported and are <strong>not independently verified</strong>.
      </p>
      {provider.selfReportedClaims && provider.selfReportedClaims.length > 0 ? (
        <ul>
          {provider.selfReportedClaims.map((claim) => (
            <li>{claim}</li>
          ))}
        </ul>
      ) : (
        <p class="muted">No self-reported claims have been recorded yet.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>Contact & verification</h2>
    <div class="note">
      <strong>Business identity verified.</strong>{' '}
      {provider.contactNote}
    </div>
    <p>
      WorldFreightHub has independently confirmed this provider\u2019s identity, website,
      service area and published claims against the source of record. Direct contact
      details (phone / email) are not published on the listing; reach the provider
      through their website or via our Get Quote form, which routes your request
      without adding any fee.
    </p>
    <p class="mt-2">
      <a class="btn btn-secondary" href="/contact/">
        Report an incorrect or outdated listing
      </a>
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={faqs} />
    </div>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
