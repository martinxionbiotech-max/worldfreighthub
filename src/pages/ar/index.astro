---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { t } from '../../i18n/ui';
import { SITE_URL, SITE_NAME, ORGANIZATION_SCHEMA } from '../../site';
import { stats as s, derivedStats as d } from '../../data/stats';

const locale = 'ar' as const;

// 与英文首页对齐的核心结构化数据（P0-4 M2：阿语首页此前 0 个 JSON-LD 块）
const schema = [
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: 'شبكة معلومات شحن لممر الصين–الخليج: مسارات وموانئ ودول وطرق شحن ودليل مزودين موثوق.',
    },
  },
  ORGANIZATION_SCHEMA,
];

const sections = [
  { title: 'المسارات', description: 'مسارات الشحن من الصين إلى الخليج مع مدد نقل استرشادية.', href: '/ar/routes/' },
  { title: 'الدول', description: 'ملفات دول الخليج الوجهة: ضريبة القيمة المضافة والرسوم والامتثال.', href: '/ar/countries/' },
  { title: 'الموانئ', description: 'موانئ التحميل في الصين والموانئ والمحطات الخليجية.', href: '/ar/ports/' },
  { title: 'طرق الشحن', description: 'FCL وLCL والشحن الجوي وبالسكك وDDP والبريد السريع.', href: '/ar/methods/' },
  { title: 'المصطلحات', description: 'تعريفات مصطلحات الشحن والجمارك واللوجستيات.', href: '/ar/glossary/' },
  { title: 'الدليل', description: 'دليل وكلاء الشحن والمخلصين الجمركيين على ممر الصين–الخليج.', href: '/ar/directory/' },
];
---

<BaseLayout
  title="WorldFreightHub — معلومات الشحن من الصين إلى الخليج"
  description="شبكة معلومات شحن لممر الصين–الخليج: مسارات وموانئ ودول وطرق شحن ودليل مزودين موثوق."
  canonical={`${SITE_URL}/ar/`}
  locale={locale}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <h1>معلومات الشحن من الصين إلى الخليج</h1>
      <p class="lead">
        مرجع معلوماتي للشحن على ممر الصين–الخليج: مسارات الشحن والدول الوجهة والموانئ
        والمحطات وطرق الشحن وتعريفات المصطلحات ودليل مزودين يعتمد التحقق أولًا.
      </p>
    </div>
  </div>

  <section class="section container">
    <blockquote class="tldr">
      <p>
        <strong>TL;DR:</strong> عبر {s.routes} مساراً من الصين إلى دول مجلس التعاون الخليجي، تنقسم {s.gccCountries} دول وجهة إلى ثلاث شرائح ضريبية لتكلفة الوصول: السعودية (رسوم 5% + ضريبة قيمة مضافة 15%) تُخلَّص بفارق 20.75% فوق CIF، والإمارات وعُمان تُخلَّص بفارق 10.25% فوق CIF، وقطر والكويت تُخلَّص بفارق 5% فقط فوق CIF — أي فجوة قدرها 15.75 نقطة مئوية بين أرخص وأعلى تخليص. على شحنة US$10,000 CIF تبلغ قيمة تلك الفجوة US$1,575: نحو US$12,075 في السعودية مقابل US$10,500 في قطر، قبل الرسوم الملاصقة للشحن. وتشمل {s.ports} ملف موانئ و{s.guides} دليل ممر بمتوسط {d.guidesPerPort} دليل لكل ميناء، ويبلغ متوسط {s.providers} مزودين في الدليل عبر {s.routes} مساراً {d.providersPerRoute} مزودين لكل مسار — وكل رقم نطاق مرجعي موسوم بالثقة، وليس عرض سعر مباشراً.
      </p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>النقاط الرئيسية</h2>
    <ol>
      <li>{s.routes} مساراً و{s.gccCountries} دول وجهة تنقسم إلى ثلاث شرائح ضريبية لتكلفة الوصول.</li>
      <li>السعودية تُخلَّص عند 20.75% فوق CIF، والإمارات وعُمان عند 10.25%، وقطر والكويت عند 5% فقط.</li>
      <li>الفجوة 15.75 نقطة مئوية؛ على شحنة US$10,000 CIF تساوي US$1,575.</li>
      <li>الشحنة تهبط نحو US$12,075 في السعودية مقابل US$10,500 في قطر.</li>
      <li>{s.ports} ملف موانئ و{s.guides} دليل ممر ({d.guidesPerPort} دليل/ميناء) و{s.providers} مزودين عبر {s.routes} مساراً ({d.providersPerRoute} مزود/مسار).</li>
    </ol>
  </section>

  <section class="section container">
    <img
      src="/images/ar-gulf-shipping-sunset.webp"
      alt="سفينة حاويات تعبر مياه الخليج الهادئة عند غروب الشمس"
      width="1600"
      height="900"
      loading="lazy"
      class="lead-img"
    />
  </section>

  <section class="section container">
    <div class="grid grid--3">
      {sections.map((s) => (
        <Card locale={locale} title={s.title} description={s.description} href={s.href} />
      ))}
    </div>
  </section>
</BaseLayout>
