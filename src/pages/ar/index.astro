---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { t } from '../../i18n/ui';
import { SITE_URL } from '../../site';

const locale = 'ar' as const;

const sections = [
  { title: 'المسارات', description: 'مسارات الشحن من الصين إلى الخليج مع مدد نقل استرشادية.', href: '/ar/routes/' },
  { title: 'الدول', description: 'ملفات دول الخليج الوجهة: ضريبة القيمة المضافة والرسوم والامتثال.', href: '/ar/countries/' },
  { title: 'الموانئ', description: 'موانئ التحميل في الصين والموانئ والمحطات الخليجية.', href: '/ar/ports/' },
  { title: 'طرق الشحن', description: 'FCL وLCL والشحن الجوي وبالسكك وDDP والبريد السريع.', href: '/ar/methods/' },
  { title: 'المصطلحات', description: 'تعريفات مصطلحات الشحن والجمارك واللوجستيات.', href: '/ar/glossary/' },
  { title: 'الدليل', description: 'دليل وكلاء الشحن والمخلصين الجمركيين على ممر الصين–الخليج.', href: '/ar/directory/' },
];
---

<BaseLayout
  title="WorldFreightHub — معلومات الشحن من الصين إلى الخليج"
  description="شبكة معلومات شحن لممر الصين–الخليج: مسارات وموانئ ودول وطرق شحن ودليل مزودين موثوق."
  canonical={`${SITE_URL}/ar/`}
  locale={locale}
>
  <div class="page-header">
    <div class="container">
      <h1>معلومات الشحن من الصين إلى الخليج</h1>
      <p class="lead">
        مرجع معلوماتي للشحن على ممر الصين–الخليج: مسارات الشحن والدول الوجهة والموانئ
        والمحطات وطرق الشحن وتعريفات المصطلحات ودليل مزودين يعتمد التحقق أولًا.
      </p>
    </div>
  </div>

  <section class="section container">
    <blockquote class="tldr">
      <p>
        <strong>TL;DR:</strong> عبر 21 مساراً من الصين إلى دول مجلس التعاون الخليجي، تنقسم 6 دول وجهة إلى ثلاث شرائح ضريبية لتكلفة الوصول: السعودية (رسوم 5% + ضريبة قيمة مضافة 15%) تُخلَّص بفارق 20.75% فوق CIF، والإمارات وعُمان تُخلَّص بفارق 10.25% فوق CIF، وقطر والكويت تُخلَّص بفارق 5% فقط فوق CIF — أي فجوة قدرها 15.75 نقطة مئوية بين أرخص وأعلى تخليص. على شحنة US$10,000 CIF تبلغ قيمة تلك الفجوة US$1,575: نحو US$12,075 في السعودية مقابل US$10,500 في قطر، قبل الرسوم الملاصقة للشحن. وتشمل 19 ملف موانئ و46 دليل ممر بمتوسط 2.4 دليل لكل ميناء، ويبلغ متوسط 103 مزودين في الدليل عبر 21 مساراً 4.9 مزودين لكل مسار — وكل رقم نطاق مرجعي موسوم بالثقة، وليس عرض سعر مباشراً.
      </p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>النقاط الرئيسية</h2>
    <ol>
      <li>21 مساراً و6 دول وجهة تنقسم إلى ثلاث شرائح ضريبية لتكلفة الوصول.</li>
      <li>السعودية تُخلَّص عند 20.75% فوق CIF، والإمارات وعُمان عند 10.25%، وقطر والكويت عند 5% فقط.</li>
      <li>الفجوة 15.75 نقطة مئوية؛ على شحنة US$10,000 CIF تساوي US$1,575.</li>
      <li>الشحنة تهبط نحو US$12,075 في السعودية مقابل US$10,500 في قطر.</li>
      <li>19 ملف موانئ و46 دليل ممر (2.4 دليل/ميناء) و103 مزودين عبر 21 مساراً (4.9 مزود/مسار).</li>
    </ol>
  </section>

  <section class="section container">
    <div class="grid grid--3">
      {sections.map((s) => (
        <Card locale={locale} title={s.title} description={s.description} href={s.href} />
      ))}
    </div>
  </section>
</BaseLayout>
