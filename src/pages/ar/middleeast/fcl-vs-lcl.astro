    a: 'لا. لا يغير النمط المعاملة الضريبية. الرسوم الجمركية الأساسية الموحدة في الخليج هي 5% من قيمة CIF، وتُفرض ضريبة القيمة المضافة على القيمة الشاملة للرسوم بمعدل دولة الوجهة: السعودية 15%، الإمارات 5%، قطر 0%، الكويت 0%، عُمان 5% والبحرين 10%. صنّف رمز HS الصحيح أولاً، لأن الرسوم وضريبة القيمة المضافة تتراكم بالطريقة نفسها لكلا النمطين.',
  },
  {
    q: 'هل أحتاج SABER أو SASO لشحنة LCL؟',
    a: 'نعم، إذا كانت البضائع خاضعة للتنظيم وكانت السعودية هي الوجهة. مطابقة SABER/SASO تنطبق على السعودية فقط، لا على بقية الخليج، ويجب الحصول على شهادة SABER SC قبل الوصول — سارية منذ 1 يناير 2025. ولا يزيل نمط الشحن (FCL أو LCL) هذا المتطلب.',
  },
  {
    q: 'هل ينطبق ISF على الخليج؟',
    a: 'لا. ISF (إقرار أمن المستورد) برنامج أمريكي ولا ينطبق على واردات الخليج. وللسعودية متطلبها الخاص قبل الوصول عبر SABER/FASAH، لكن يجب ألا تنسخ خطوة ISF الأمريكية في سير عمل FCL أو LCL من الصين إلى الخليج.',
  },
  {
    q: 'كيف أختار بين حاوية 20 قدم و40 قدم للشحن الكامل إلى الخليج؟',
    a: 'ابدأ بالحجم والوزن، لا بالسعة الاسمية. تتسع حاوية 20 قدم لنحو 33 CBM وحاوية 40 قدم لنحو 67 CBM. ولأن حاوية 40 قدم تكلف ~30–50% فقط أكثر من 20 قدم لكنها تستوعب نحو ضعف الحجم، فعادة تكون 40 قدم أفضل قيمة بمجرد اقترابك من امتلاء حاوية 20 قدم — تحقق من حد الوزن والسعر الفوري لكليهما قبل الاختيار.',
  },
  {
    q: 'أي ميناء خليجي يجب أن أستخدمه لقرار FCL مقابل LCL؟',
    a: 'طابق الميناء مع المرسل إليه النهائي، لا مع السعر فقط. استخدم جدة لغرب السعودية، والدمام للمنطقة الشرقية والرياض، وجبل علي لإعادة التصدير الإماراتي ودخول المنطقة الحرة، وميناء حمد لقطر، والشويخ للكويت، وصحار لشمال عُمان، وخليفة بن سلمان للبحرين أو كبديل إلى شرق السعودية. ثم قارن FCL وLCL على تلك البوابة الواحدة.',
  },
  {
    q: 'أين يمكنني الحصول على مقارنة FCL وLCL حقيقية؟',
    a: 'اطلب عرض سعر مفصلاً بنفس المنشأ والسلعة ورمز HS والحجم والوزن ووجهة الخليج النهائية. اطلب من المزود عرض الشحن البحري وOTHC/DTHC ورسوم CFS للشحن الجزئي والوقود والمستندات وفترة الإعفاء من غرامة التأخير/رسوم الاحتجاز والرسوم وضريبة القيمة المضافة والرحلة الداخلية معًا — فالسطر المعلن ليس التكلفة الإجمالية للوصول أبدًا.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن FCL مقابل LCL من الصين إلى الخليج (2026): الحاوية الكاملة مقابل الحاوية المشتركة',
      description:
        'الشحن بالحاويات FCL مقابل LCL من الصين إلى الخليج: أسعار 20 قدم/40 قدم وكل CBM حسب الميناء، ومدة النقل، وقاعدة التعادل ~15 CBM، وغرامة التأخير والرسوم الخفية، وامتثال SABER، وأي نمط يناسب شحنتك.',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
