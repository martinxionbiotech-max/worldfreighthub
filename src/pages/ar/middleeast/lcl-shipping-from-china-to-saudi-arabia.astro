const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن البحري الجزئي من الصين إلى السعودية: الأسعار ورسوم محطات الشحن الجمركية ومقارنة الشحن الكامل (August 2026)',
      description:
        'شرح الشحن البحري الجزئي من الصين إلى السعودية: أسعار إرشادية لكل CBM، رسوم التجميع في محطات الشحن الجمركية والرسوم الخفية، جدول مقارنة الشحن البحري الجزئي مقابل الكامل، مدة النقل، قواعد شهادة مطابقة الشحنة SABER وضريبة القيمة المضافة 15%.',
