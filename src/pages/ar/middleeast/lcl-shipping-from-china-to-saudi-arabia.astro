    a: 'عادة ما تعتمد فوترة الشحن البحري الجزئي على الأكبر من الحجم (بالمتر المكعب) والوزن الحجمي، لذلك يمكن فوترة البضائع الكثيفة بالوزن بدلاً من الحجم والبضائع الخفيفة والضخمة بالحجم. قم بقياس ووزن البضاعة المعبأة الفعلية قبل طلب عرض السعر، وتأكد من نسبة الحجم إلى الوزن لدى وكيل الشحن، لأنها تغير سعر الوحدة.',
  },
  {
    q: 'هل أحتاج إلى شهادات SABER لشحنة الشحن البحري الجزئي؟',
    a: 'نعم، إذا كانت بضائعك خاضعة للوائح. احصل على شهادة مطابقة المنتج (PC) لكل منتج، ثم شهادة مطابقة الشحنة (SC) لكل شحنة. منذ 1 January 2025 يجب الحصول على شهادة مطابقة الشحنة قبل وصول البضاعة وإلا يفشل التخليص؛ في شحنة الشحن البحري الجزئي يكون هذا أكثر إلحاحًا لأن الإيقاف يمكن أن يؤثر على الحاوية المجمعة بأكملها.',
  },
  {
    q: 'أي ميناء سعودي يجب أن أستخدمه للشحن البحري الجزئي؟',
    a: 'جدة هي البوابة الرئيسية على البحر الأحمر وتناسب المرسل إليهم في غرب ووسط السعودية. الدمام هو الميناء الرئيسي على الخليج العربي ويناسب الرياض والمنطقة الشرقية، مع ميناء الرياض الجاف للمرحلة الداخلية. اسأل وكيل الشحن الخاص بك عن محطة الشحن الجمركية بالوجهة التي يفترضها عرض سعر الشحن البحري الجزئي وقارن تكلفة التوصيل النهائية.',
  },
  {
    q: 'ما هي المستندات التي أحتاجها لاستيراد الشحن البحري الجزئي إلى السعودية؟',
    a: 'المجموعة القياسية هي الفاتورة التجارية، وبوليصة الشحن المنزلية، وقائمة التعبئة، وشهادة المنشأ، وشهادة مطابقة SABER للبضائع الخاضعة للوائح. الرمز المنسق (HS) الصحيح مهم لأن الرسوم الجمركية ومتطلبات المطابقة تعتمد عليه، وتستخدم النافذة الموحدة FASAH للإقرار قبل الوصول.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
