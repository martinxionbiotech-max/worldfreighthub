        </div>
        <div class="fact">
          <span class="fact-label">UN/LOCODE</span>
          <span class="fact-value">{khalifaUnlocode} <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">نوع الميناء</span>
          <span class="fact-value">ميناء بحري <ConfidenceBadge locale={locale} level="HIGH" /></span>
