        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="الشحن البحري LCL من الصين إلى الإمارات: تسعير CBM، CFS جبل علي ومقارنة FCL مقابل LCL (August 2026)"
  description="الشحن البحري LCL من الصين إلى الإمارات: أسعار استرشادية بالدرهم لكل CBM، فخ CBM القابل للتحصيل، عملية CFS جبل علي، الرسوم الخفية، جدول مقارنة LCL مقابل FCL وضريبة القيمة المضافة 5%."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الشحن البحري LCL من الصين إلى الإمارات' },
        ]}
      />
      <span class="badge badge--amber">مُحدَّث في August 2026</span>
      <h1>الشحن البحري LCL من الصين إلى الإمارات: تسعير CBM، CFS جبل علي ومقارنة FCL مقابل LCL</h1>
      <p class="lead">
        الشحن بأقل من حمولة حاوية (LCL) يتيح لك الدفع فقط مقابل المساحة التي تستخدمها بضاعتك — لكن
        الـ CBM القابل للتحصيل ورسوم CFS الوجهة يحددان ما إذا كان رخيصًا فعلاً. تغطي هذه الصفحة
        الأسعار الاسترشادية لكل CBM، وفخ الفوترة بين الحجم والوزن، وتدفق التجميع إلى التسليم،
        ومتى يتفوق LCL على FCL، وتراكم الرسوم الخفية في جبل علي.
      </p>
      <p class="small muted">
        شارات الثقة تفصل الأرقام الموثقة عن لقطات السوق الاسترشادية. تعامل مع كل سعر ومدة نقل ورسوم
        بثقة LOW كأرقام استرشادية، وتحقق منها مع الناقل قبل الاعتماد عليها.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">ضريبة القيمة المضافة على الاستيراد في الإمارات</span>
          <span class="fact-value">5% <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">الرسوم الجمركية الأساسية</span>
          <span class="fact-value">5% CIF <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">معيار LCL</span>
          <span class="fact-value">AED 880–980/CBM <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">نقطة التحول LCL مقابل FCL</span>
          <span class="fact-value">~15 CBM <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">شنغهاي → جبل علي</span>
          <span class="fact-value">21 days <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">جبل علي</span>
          <span class="fact-value">مركز الشرق الأوسط <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. ما هو LCL ومتى يستحق الحجز</h2>
    <p>
      في LCL، تُستلم بضاعتك في CFS (محطة شحن الحاويات) في الصين، وتُجمَّع مع بضائع مستوردين آخرين
      في حاوية واحدة، وتُشحن إلى الإمارات، ثم تُفكَّك في CFS الوجهة للتخليص والتسليم. تدفع مقابل
      المساحة والوزن الذي تستخدمه بدلاً من حجز حاوية كاملة. المقابل هو مناولة إضافية في نقطتي CFS
      ومدة أطول من نقل حاوية كاملة مباشر.
    </p>
    <p>
      القاعدة التخطيطية الشائعة هي التفكير في LCL عندما تكون شحنتك <strong>أقل من حوالي
      15 CBM</strong> ومقارنة FCL عندما يقترب الحجم من هذا المستوى. هذا الحد بثقة LOW —
      لا يوجد حد تعادل عالمي موثق في لقطة البحث — لأن نقطة التحول تعتمد على المسار والرسوم الإضافية
      ورسوم CFS وتكاليف الوجهة. الاختبار المفيد دائمًا هو: <em>التكلفة الإجمالية للوصول LCL مقابل
      التكلفة الإجمالية للوصول FCL عند الـ CBM الفعلي الخاص بك</em>.
    </p>

    <div class="grid grid--2 mt-2">
      <Card locale={locale} title="LCL عادة هو الخيار الصحيح عندما...">
        <ul>
          <li>شحنتك صغيرة وأقل بكثير من حاوية كاملة.</li>
          <li>تريد تجنب الدفع مقابل مساحة حاوية غير مستخدمة.</li>
          <li>تختبر سوق الإمارات أو تعيد التخزين بتشكيلة SKUs متنوعة.</li>
          <li>يمكنك تحمل وقت إضافي للتجميع/التفكيك.</li>
        </ul>
      </Card>
      <Card locale={locale} title="انتقل إلى مقارنة FCL عندما...">
        <ul>
          <li>يقترب الحجم من حوالي 15 CBM (قاعدة تخطيطية، LOW).</li>
          <li>البضائع كثيفة أو هشة أو عالية القيمة أو لا يمكن مشاركة المساحة.</li>
          <li>إمكانية التنبؤ بمدة النقل أهم من سعر الوحدة.</li>
          <li>تبدأ رسوم CFS الوجهة والتسليم في التراكم.</li>
        </ul>
      </Card>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. أسعار LCL الاسترشادية ومدة النقل من الصين إلى الإمارات</h2>
      <p>
        يُسعَّر LCL لكل CBM، لذا يتحرك الرقم الرئيسي مع الحجم والسلعة والموسم. اللقطة أدناه رقم
        سوقي جُمع من دليل عام من الصين إلى الإمارات وموسوم عمدًا بثقة LOW؛ أسعار الشحن البحري
        تتغير أسبوعيًا ويجب دائمًا إعادة التسعير بجدول مفصّل.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'service', label: 'الخدمة' },
          { key: 'benchmark', label: 'المعيار الاسترشادي' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={lclRateRows}
        caption="لقطات سوق LCL استرشادية، وليست عروض أسعار ناقل. لم تُنشر أسعار FCL للإمارات في اللقطة الموثقة — اطلب عرض سعر شامل."
      />
      <SourceList locale={locale} sources={rateSources} title="المصادر — أسعار LCL" />

      <h3 class="mt-3">فترات مدة النقل LCL</h3>
      <DataTable locale={locale}
        columns={[
          { key: 'lane', label: 'المسار' },
          { key: 'service', label: 'الخدمة' },
          { key: 'transit', label: 'مدة النقل الاسترشادية' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={lclTransitRows}
        caption="المدة النموذجية شنغهاي–جبل علي 21 days من بيانات مسار WorldFreightHub؛ رقم 14–18 day لقطة ثانوية بثقة LOW. تحقق مع الناقل."
      />
      <SourceList locale={locale} sources={transitSources} title="المصادر — مدة نقل LCL" />

      <div class="note mt-2">
        <strong>فترتان بحريتان مختلفتان، موضح:</strong> رقم 14–18 day هو دليل سوقي يفترض
        إبحارًا مباشرًا سريعًا دون تأخير، بينما المدة النموذجية 21 يومًا مع نطاق
        15–30 day هي رقم تخطيطي يستوعب تقلبات الجدول والميناء. يضيف LCL مناولة التجميع
        والتفكيك فوق المرحلة البحرية، لذا استخدم النطاق الأوسع للتخطيط التجاري.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. فخ CBM القابل للتحصيل: الحجم مقابل الوزن الفعلي</h2>
    <p>
      المفاجأة الأكثر شيوعًا في تسعير LCL هي أن وكيل الشحن لا يفوتير وزنك الفعلي أو حجمك المادي
      بمعزل عن الآخر. إنه يفوتير <strong>الـ CBM القابل للتحصيل</strong> — الأكبر بين الحجم المعبأ
      والحجم المحسوب من الوزن. الشحنة الخفيفة والكبيرة تُفوتر بالمساحة التي تملؤها؛ الشحنة الكثيفة
      تُفوتر بوزنها المحول إلى CBM.
    </p>
    <p>
      القاعدة التخطيطية الشائعة هي <strong>1 CBM = 1,000 kg</strong>، لكن وكلاء الشحن
      يحددون نسبتهم الخاصة، وبعضهم يستخدم عتبات مختلفة للبضائع الخفيفة أو الكثيفة بشكل خاص. هذه
      النسبة بثقة LOW وتعتمد على المسار/الناقل — أكدها قبل التسعير، لأن تغييرًا صغيرًا في النسبة
      يغير سعر الوحدة بشكل ملموس.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'example', label: 'مثال' },
        { key: 'actualWeight', label: 'الوزن الفعلي' },
        { key: 'packedVolume', label: 'الحجم المعبأ' },
        { key: 'weightCbm', label: 'CBM المحسوب من الوزن' },
        { key: 'chargeableCbm', label: 'CBM القابل للتحصيل' },
        { key: 'note', label: 'ماذا يحدث' },
      ]}
      rows={chargeableCbmRows}
      caption="أمثلة توضيحية باستخدام نسبة تخطيط 1,000 kg = 1 CBM. النسبة الدقيقة خاصة بالناقل وبثقة LOW — أكدها قبل الحجز."
    />

    <div class="note mt-2">
      <strong>لماذا يهم هذا لـ LCL إلى الإمارات:</strong> بضائع التجارة الإلكترونية والاستهلاكية
      غالبًا ما تكون كبيرة الحجم مقارنة بوزنها، لذا شحنة "تزن فقط 60 kg" يمكن أن تُفوتر
      بأكثر من نصف CBM. قس ووزن الكراتين المعبأة، ثم اطلب من وكيل الشحن الـ CBM القابل للتحصيل
      والنسبة المستخدمة كتابيًا.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. عملية LCL: من مستودع الصين إلى التسليم في الإمارات</h2>
      <p>
        LCL هو تدفق بمحطتين، ولهذا فهو أبطأ وله بنود رسوم أكثر من FCL. التسلسل أدناه هو مسار
        التجميع إلى التسليم القياسي؛ نقاط التسليم المحددة قد تختلف حسب وكيل الشحن.
      </p>

      <ol>
        <li><strong>الجمع في المنشأ:</strong> تصل البضائع إلى مستودع أو CFS في الصين بالقرب من شنغهاي أو نينغبو أو شنتشن أو قوانغتشو.</li>
        <li><strong>الاستلام والقياس:</strong> يفحص وكيل الشحن ويقيس ويزن البضاعة لتحديد الـ CBM القابل للتحصيل.</li>
        <li><strong>التجميع:</strong> تُخزَّن بضاعتك مع بضائع مستوردين آخرين في حاوية واحدة.</li>
        <li><strong>التخليص التصديري والتحميل:</strong> تُخلَّص الحاوية للتصدير من الصين وتُحمَّل على السفينة.</li>
        <li><strong>المرحلة البحرية:</strong> تبحر الحاوية إلى جبل علي أو خليفة أو ميناء خالد.</li>
        <li><strong>التفريغ والتفكيك:</strong> تُفرَّغ الحاوية وتُفكَّك في CFS الوجهة.</li>
        <li><strong>التخليص الجمركي الإماراتي:</strong> يقدم المرسل إليه أو الوسيط بيان الاستيراد ويدفع الرسوم وضريبة القيمة المضافة عند الاستحقاق.</li>
        <li><strong>التسليم النهائي:</strong> تُنقل البضاعة بالشاحنات إلى عنوانك في الإمارات أو مستودعك أو منشأة المنطقة الحرة.</li>
      </ol>

      <p class="mt-2">
        اطرح سؤالين قبل الحجز: ما CFS الإماراتي الذي يفترضه العرض، وما إذا كان التجميع مباشرًا أو
        عبر إعادة شحن. حاوية LCL المعاد شحنها تضيف نقطة مناولة أخرى ويمكن أن توسع نافذة التسليم.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>5. جدول مقارنة LCL مقابل FCL للإمارات</h2>
    <p>
      السؤال التجاري ليس "أيهما أرخص لكل CBM" بمعزل عن الآخر؛ بل أي خدمة لديها التكلفة الإجمالية
      للوصول الأقل ومخاطر التسليم المناسبة للبضائع. استخدم هذا الجدول كقائمة تحقق، ثم اطلب كلا
      العرضين عند حجمك الفعلي.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'factor', label: 'العامل' },
        { key: 'lcl', label: 'LCL' },
        { key: 'fcl', label: 'FCL' },
        { key: 'confidence', label: 'الثقة', type: 'confidence' },
      ]}
      rows={lclVsFclRows}
      caption="عوامل التخطيط استرشادية وبثقة LOW؛ نقطة التحول تعتمد على المسار والرسوم الإضافية ورسوم الوجهة. تحقق مع وكيل الشحن."
    />

    <div class="note mt-2">
      <strong>نقطة التحول ~15 CBM هي نقطة بداية وليست قاعدة:</strong> في جبل علي، يمكن
      لرسوم CFS الوجهة والتسليم أن تجعل FCL تنافسيًا أقل من 15 CBM، بينما التسليم البسيط
      إلى البر الرئيسي يمكن أن يبقي LCL جذابًا فوق ذلك. قارن كلا الرقمين الإجماليين.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. مناشئ الصين وشبكة CFS الوجهة في الإمارات</h2>
      <p>
        يتم تجميع LCL عادة في CFS بالقرب من ميناء المنشأ. شنغهاي ونينغبو-تشوشان وشنتشن وقوانغتشو
        هي نقاط المنشأ الرئيسية في لقطة البحث؛ وفي نهاية الإمارات، جبل علي هو نقطة التفكيك المهيمنة،
        مع خليفة وميناء خالد لخدمة مناطقهم الخلفية.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'port', label: 'ميناء الصين' },
          { key: 'throughput', label: 'حمولة 2025' },
          { key: 'note', label: 'ملاحظة LCL' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={chinaPortRows}
        caption="أرقام شنغهاي ونينغبو-تشوشان موثقة؛ لم تُذكر حمولة شنتشن وقوانغتشو في لقطة البحث."
      />
      <SourceList locale={locale} sources={chinaPortSources} title="المصادر — موانئ الصين" />

      <h3 class="mt-3">موانئ الوجهة الإماراتية وأدوار CFS</h3>
      <p>
        <strong>جبل علي</strong>، الذي تديره موانئ دبي العالمية، هو أكبر ميناء حاويات في الشرق
        الأوسط ويجمع بين قدرة المياه العميقة ومنطقة حرة كبيرة واتصال قوي بالطرق والبحر. وهذا يجعله
        نقطة التجميع وإعادة الشحن الطبيعية لدول مجلس التعاون والشرق الأوسط وأفريقيا وشبه القارة
        الهندية وليس فقط بوابة دبي.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'العامل' },
          { key: 'jebelAli', label: 'جبل علي' },
          { key: 'khalifa', label: 'ميناء خليفة أبوظبي' },
          { key: 'sharjah', label: 'ميناء خالد (الشارقة)' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={uaePortRows}
        caption="أدوار الموانئ نتائج مصادر ثانوية؛ تحقق من CFS الوجهة ومرحلة التسليم النهائية مع وكيل الشحن."
      />
      <SourceList locale={locale} sources={uaePortSources} title="المصادر — موانئ الإمارات" />

      <div class="note mt-2">
        <strong>مسار LCL في سطر واحد:</strong> اسأل عن CFS الوجهة الذي يفترضه عرض LCL. جبل علي
        مناسب لمعظم مرسَل إليهم دبي والإمارات الشمالية، وخليفة مناسب لأبوظبي، وميناء خالد مناسب
        للشارقة والإمارات الشمالية. سعر بحري أرخص في CFS خاطئ يمكن أن يصبح أكثر تكلفة بعد مرحلة
        النقل البري.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>7. التكلفة الإجمالية للوصول LCL: فخاخ الرسوم الخفية التي يتجاهلها المنافسون</h2>
    <p>
      سعر الشحن البحري لكل CBM هو سطر واحد فقط من التكلفة الإجمالية للوصول LCL. الفخاخ في نقطتي
      CFS وفي محطة الإمارات: استلام المنشأ، وتفكيك الوجهة، وTHC، والمستندات، والحدود الدنيا،
      والتخزين، والتسليم. لم تُنشر أي من هذه المبالغ في لقطة البحث الموثقة، لذا رقم المقارنة
      الصحيح هو عرض سعر شامل مفصّل — وليس سعر AED/CBM رئيسي.
    </p>

    <div class="grid grid--2 mt-2">
      <Card locale={locale} title="تفكيك CFS الوجهة">
        <ul>
          <li>يُفرض مقابل تفكيك الحاوية المجمعة في الإمارات.</li>
          <li>غالبًا يُضاف بعد عرض الشحن البحري؛ اطلبه دائمًا كتابيًا.</li>
          <li>المبلغ المحدد غير منشور في اللقطة — اطلب جدول الرسوم.</li>
        </ul>
      </Card>
      <Card locale={locale} title="الحد الأدنى للشحنة ورسوم THC">
        <ul>
          <li>شحنات LCL الصغيرة جدًا يمكن رفعها إلى حد أدنى.</li>
          <li>تُفرض THC في كلا الطرفين مقابل مناولة المحطة.</li>
          <li>المبالغ غير منشورة في اللقطة — اطلب جدول الرسوم.</li>
        </ul>
      </Card>
      <Card locale={locale} title="رسوم المستندات وأمر التسليم">
        <ul>
          <li>بوليصة الشحن الفرعية وأمر التسليم قد يحملان رسومًا منفصلة.</li>
          <li>اسأل ما إذا كانت المستندات مشمولة في السعر الرئيسي.</li>
          <li>المبلغ المحدد غير منشور في اللقطة — اطلب جدول الرسوم.</li>
        </ul>
      </Card>
      <Card locale={locale} title="التخزين بعد المدة المجانية">
        <ul>
          <li>المدة المجانية في CFS الوجهة محدودة؛ الأيام التي تتجاوزها مدفوعة.</li>
