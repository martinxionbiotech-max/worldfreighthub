    a: 'بالإضافة إلى سعر كل kg: رسوم الوقود والأمن الإضافية، ومناولة المحطة، وتخزين المطار بعد الفترة المجانية، والتخليص الجمركي والسمسرة، ورسوم SABER PC/SC للسعودية، والرسوم الجمركية على الواردات بنسبة 5% من CIF وضريبة القيمة المضافة في الوجهة. لم تُنشر مبالغ الرسوم الإضافية المحددة في اللقطة الموثقة، لذا اطلب جدولًا مفصلاً.',
  },
  {
    q: 'هل يوجد حد إعفاء جمركي أو إعفاء من الرسوم للشحن الجوي إلى الخليج؟',
    a: 'تنشر السعودية (SAR 1,000) والإمارات (AED 1,000) حدين للإعفاء الجمركي للطرود الشخصية/البريدية فقط، ولا تزال ضريبة القيمة المضافة مستحقة. البضائع التجارية المنقولة جوًا تخضع للرسوم عمومًا بغض النظر، ولا تنشر الدول الخليجية الأربع الأخرى حدًا مؤكدًا.',
  },
  {
    q: 'هل ينطبق ISF على الشحن الجوي من الصين إلى الخليج؟',
    a: 'لا. ISF (إقرار أمن المستورد) برنامج أمريكي ولا ينطبق على واردات الخليج جوًا أو بحرًا. الخطوة السعودية المكافئة للتقديم المسبق هي شهادة SABER SC بالإضافة إلى إقرار فسح قبل الوصول.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن الجوي من الصين إلى الخليج — الأسعار والوزن القابل للتحصيل ومدد النقل (2026)',
      description:
        'مرجع شامل للشحن الجوي من الصين إلى الخليج: معايير السعر لكل kg، والوزن القابل للتحصيل مقابل الحجمي، وتخطيط النقل 3–7 أيام، والجوي مقابل السريع، والرسوم الخفية والامتثال.',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
