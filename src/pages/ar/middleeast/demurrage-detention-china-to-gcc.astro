    a: 'ليس تمامًا. رسوم الاحتجاز هي الرسوم المستندة إلى الوقت لبقاء الحاوية في المحطة بعد فترة السماح؛ التخزين عادةً ما يكون رسوم بضائع/مستودع منفصلة عندما تُحتجز البضائع بعد فترة معينة، غالبًا في مركز شحن مجمع (CFS) أو مستودع داخلي. اطلب من وكيل الشحن فصل الاثنين في جدول الوجهة.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'رسوم الاحتجاز والتأخير: دليل الصين إلى الخليج (August 2026)',
      description:
        'شرح رسوم الاحتجاز والتأخير على ممر الصين إلى الخليج: فترة السماح، رسوم المحطة مقابل رسوم الناقل، كيفية عملها بالتزامن، تعليقات SABER، والنطاق الاسترشادي $50–$300+ يوميًا لعام 2025.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
