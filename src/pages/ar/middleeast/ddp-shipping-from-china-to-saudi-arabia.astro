    a: 'عادةً لا، بعد انتهاء المدة المجانية. تُفرض غرامة التأخير من قبل المحطة ورسوم الاحتجاز من قبل الناقل بمجرد تجاوز الحاوية للمدة المجانية، وعادةً ما تكون هذه الرسوم اليومية مستبعدة أو محدودة السقف في تسعير DDP. أكد سياسة المدة المجانية وأي معدلات يومية كتابيًا قبل الحجز.',
  },
  {
    q: 'هل أحتاج إلى مستورد سعودي مسجل بموجب DDP؟',
    a: 'عادةً ما يوفر وكيل شحن DDP مع شريك محلي القدرة على التخليص الجمركي السعودي، لكن الإجابة العملية تعتمد على الهيكل المحلي لوكيل الشحن وتراخيص منتجك. يستخدم بعض مزودي DDP مستوردهم المسجل الخاص أو يعملون مع السجل التجاري للمشتري. أكد ذلك قبل الشحنة الأولى لأنه يؤثر على تسجيل SABER وتسوية الرسوم وضريبة القيمة المضافة.',
  },
  {
    q: 'ماذا يحدث إذا لم يتم الحصول على شهادة SC من SABER قبل الوصول؟',
    a: 'يفشل التخليص الجمركي. منذ 1 January 2025، يعتبر طلب SC المقدم بعد وصول البضاعة لاغيًا، لذا لا يمكن للشحنة التخليص حتى يتم حل مشكلة الشهادة — مما يعني عادةً تأخيرات وتكاليف تخزين وغرامات تأخير. بموجب DDP، لا يزال وكيل الشحن بحاجة إلى بوليصة الشحن وشهادة PC للمنتج قبل أن يتمكن من التقدم بطلب للحصول على SC، لذا أرسل المستندات مبكرًا.',
  },
  {
    q: 'هل يمكن أن تخضع شحنة DDP لضريبة السلع الانتقائية السعودية؟',
    a: 'نعم. لا يلغي DDP ضريبة السلع الانتقائية السعودية. يخضع التبغ لـ 100%، ومشروبات الطاقة لـ 50%، والمشروبات الغازية لـ 50% بالإضافة إلى ضريبة القيمة المضافة حيثما ينطبق ذلك. يجب أن يعكس عرض سعر DDP المتوافق هذه المبالغ، لكن أكد الحساب لرموز HS الخاصة بك.',
  },
  {
    q: 'هل سعر 45 يوان صيني لكل kg هو سعر DDP حقيقي؟',
    a: 'إنه مثال حقيقي تم تسجيله أثناء البحث — عرض سعر من الباب إلى الباب من قوانغتشو/شنتشن إلى السعودية. إنه معيار منخفض الموثوقية، وليس تعريفة عامة: الكثافة، ونوع المنتج، ومتطلبات SABER، وعنوان التسليم، وظروف السوق كلها تغير السعر النهائي. استخدمه كفحص منطقي، وليس كسعر حجز.',
  },
  {
    q: 'كيف أقارن DDP بشحنة CIF أو DAP ذاتية الترتيب؟',
    a: 'قم ببناء نفس هيكل التكلفة الإجمالية للوصول لكل منهما: الشحن، ورسوم المنشأ، ورسوم المناولة في ميناء الوجهة ورسوم الميناء، والتخليص والوساطة، وشهادات SABER PC/SC، والرسوم الجمركية، وضريبة القيمة المضافة، والنقل بالشاحنات للميل الأخير، بالإضافة إلى مخاطر غرامة التأخير/رسوم الاحتجاز. عادةً ما يكون DDP أسهل للمقارنة عندما تطلب عرض سعر شامل مفصل ثم تضيف تكلفة الوقت والامتثال الخاصة بك إلى بديل CIF/DAP.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن DDP من الصين إلى السعودية: ماذا يشمل حقًا مصطلح "الرسوم مدفوعة" (August 2026)',
      description:
        'شرح الشحن DDP من الصين إلى السعودية: من يدفع الرسوم الجمركية وضريبة القيمة المضافة ورسوم SABER، والمعايير الاسترشادية الشاملة، ومقارنة DDP مع DAP/EXW/FOB، والرسوم الخفية التي يجب تأكيدها قبل الحجز.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="الشحن DDP من الصين إلى السعودية: ماذا يشمل حقًا مصطلح &quot;الرسوم مدفوعة&quot; (August 2026)"
  description="شرح الشحن DDP من الصين إلى السعودية: من يدفع الرسوم الجمركية وضريبة القيمة المضافة ورسوم SABER، والمعايير الاسترشادية الشاملة، ومقارنة DDP مع DAP/EXW/FOB، والرسوم الخفية التي يجب تأكيدها قبل الحجز."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الشحن DDP من الصين إلى السعودية' },
        ]}
      />
      <span class="badge badge--amber">تحديث August 2026</span>
      <h1>الشحن DDP من الصين إلى السعودية: ماذا يشمل حقًا مصطلح “الرسوم مدفوعة”</h1>
      <p class="lead">
        التسليم مع دفع الرسوم هو الخيار الأسهل شرحًا للشحن من الصين إلى السعودية، والأسهل أيضًا في
        إساءة التسعير. توضح هذه الصفحة من يدفع فعليًا رسوم 5% الجمركية وضريبة القيمة المضافة 15% ورسوم SABER،
        وكيف يبدو معيار DDP الشامل الواقعي، وكيف يقارن DDP مع DAP وEXW وFOB،
        ورسوم الوجهة التي تُخفى خارج السعر الإجمالي “شامل الضريبة”.
      </p>
      <p class="small muted">
        تفصل شارات الموثوقية بين الأرقام الموثقة والبيانات السوقية الاسترشادية. تعامل مع كل سعر
        ومدة نقل ومعيار DDP منخفض الموثوقية على أنه استرشادي، وتحقق منه مع الناقل أو
        وكيل الشحن قبل الاعتماد عليه.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">ضريبة القيمة المضافة على الاستيراد في السعودية</span>
          <span class="fact-value">15% <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">الرسوم الجمركية الأساسية</span>
          <span class="fact-value">5% CIF <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">قاعدة شهادة SC في SABER</span>
          <span class="fact-value">قبل الوصول <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">مدة النقل البحري DDP</span>
          <span class="fact-value">30–35 days <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">مدة النقل الجوي DDP</span>
          <span class="fact-value">10–15 days <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">عينة عرض سعر DDP</span>
          <span class="fact-value">45 RMB/kg <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. معايير أسعار DDP: حاوية كاملة، حاوية مجمعة، ومن الباب إلى الباب شامل</h2>
    <p>
      يُسعّر DDP بشكل مختلف عن الشحن من ميناء إلى ميناء لأنه يجمع التخليص الجمركي والضرائب و
      التوصيل. يسجل الجدول الأول أدناه معايير اليوان الصيني الشاملة الموجودة في
      البيانات البحثية؛ بينما يظهر الجدول الثاني الشحن البحري من ميناء إلى ميناء للحاويات الكاملة/المجمعة للسياق. وهي غير
      قابلة للمقارنة سطرًا بسطر — أرقام DDP تشمل بالفعل الرسوم الجمركية وضريبة القيمة المضافة وSABER والميل الأخير، بينما
      أرقام الحاويات الكاملة/المجمعة هي للرحلة البحرية فقط.
    </p>

    <h3>معايير DDP الشاملة الاسترشادية</h3>
    <DataTable locale={locale}
      columns={[
        { key: 'service', label: 'خدمة DDP' },
        { key: 'benchmark', label: 'المعيار الاسترشادي' },
        { key: 'basis', label: 'الأساس' },
        { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
      ]}
      rows={ddpRows}
      caption="أمثلة سوقية استرشادية، وليست عروض أسعار ملزمة. يختلف النطاق بين وكلاء الشحن — تحقق مع وكيل شحن قبل الاعتماد على هذه الأرقام."
    />
    <SourceList locale={locale} sources={ddpRateSources} title="المصادر — معايير DDP" />

    <h3 class="mt-3">سياق الحاويات الكاملة من ميناء إلى ميناء</h3>
    <DataTable locale={locale}
      columns={[
        { key: 'container', label: 'الحاوية' },
        { key: 'freightos', label: 'Freightos · شنغهاي–الرياض' },
        { key: 'sino', label: 'Sino-shipping · الصين–السعودية (August 2026)' },
        { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
      ]}
      rows={fclRows}
      caption="بيانات سوقية للشحن البحري فقط. أضف الرسوم الجمركية وضريبة القيمة المضافة وSABER والتوصيل للمقارنة مع DDP."
    />
    <SourceList locale={locale} sources={comparisonRateSources} title="المصادر — أسعار الحاويات الكاملة" />

    <h3 class="mt-3">سياق الحاويات المجمعة من ميناء إلى ميناء</h3>
    <DataTable locale={locale}
      columns={[
        { key: 'volume', label: 'الحجم' },
        { key: 'total', label: 'الإجمالي (Freightos · شنغهاي–الرياض)' },
        { key: 'perCbm', label: 'استرشادي لكل م³' },
        { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
      ]}
      rows={lclRows}
      caption="تنخفض تكلفة وحدة الحاوية المجمعة مع زيادة الحجم. هذه أرقام للشحن البحري فقط — أضف الضرائب وSABER والتوصيل."
    />
    <SourceList locale={locale} sources={comparisonRateSources} title="المصادر — أسعار الحاويات المجمعة" />

    <div class="note mt-2">
      <strong>لماذا يصعب مقارنة أسعار DDP:</strong> قد يقتبس أحد وكلاء الشحن سعرًا “شامل الضريبة” لكنه
      يستبعد رسوم المناولة في ميناء الوجهة وغرامة التأخير بعد المدة المجانية، بينما يقتبس آخر التكلفة الكاملة
      للوصول. اطلب دائمًا نفس النطاق: أي الرسوم، وأي الضرائب، وأي عنوان توصيل، وأي
      سياسة مدة مجانية مشمولة في الرقم.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. مدة النقل DDP حسب الميناء ووسيلة النقل</h2>
      <p>
        تضيف خدمة DDP من الباب إلى الباب وقت التخليص الجمركي والميل الأخير إلى الرحلة من ميناء إلى ميناء. الأرقام
        أدناه هي نتائج بحثية على مستوى الممرات، وليست ضمانات جدول زمني، وتعتمد المدة الدقيقة
        على مدينة المنشأ وميناء التفريغ وجاهزية SABER وعنوان التوصيل النهائي.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'service', label: 'الخدمة' },
          { key: 'origin', label: 'المنشأ' },
          { key: 'destination', label: 'الوجهة' },
          { key: 'transit', label: 'مدة النقل الاسترشادية' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
        ]}
        rows={ddpTransitRows}
        caption="مدد نقل استرشادية فقط — تحقق مع الناقل أو وكيل الشحن المعني قبل الاعتماد على هذه الأرقام."
      />
      <SourceList locale={locale} sources={transitSources} title="المصادر — مدة النقل DDP" />

      <div class="note mt-2">
        <strong>متغير SABER:</strong> تفترض تقديرات مدة النقل أن شهادة PC موجودة بالفعل وأنه
        يتم التقدم بطلب للحصول على SC بمجرد توفر بوليصة الشحن. إذا بدأت أوراق المطابقة
        متأخرة، فقد يتجاوز التأخير في الجانب السعودي بسهولة وقت الإبحار الموفر في
        الرحلة البحرية.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. DDP مقابل DAP (DDU) وEXW وFOB</h2>
    <p>
      توزع شروط التجارة الدولية التكلفة والمخاطر؛ وهي لا تحدد السعر. يركز DDP كلاهما على البائع
      لتجربة المشتري الأكثر سلاسة، بينما يترك EXW وFOB المستورد لإدارة الجانب السعودي. DAP — الخلف
      في شروط التجارة الدولية 2020 لمصطلح DDU القديم — يقع في المنتصف: يقوم البائع
      بالتسليم إلى مكان محدد لكن المشتري يتولى التخليص الجمركي للاستيراد ويدفع الرسوم/ضريبة القيمة المضافة.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'term', label: 'شرط التجارة' },
        { key: 'exportClearance', label: 'التخليص الجمركي للتصدير من الصين' },
        { key: 'oceanFreight', label: 'الشحن البحري' },
        { key: 'saudiImport', label: 'التخليص الجمركي للاستيراد في السعودية والرسوم وضريبة القيمة المضافة' },
        { key: 'riskTransfer', label: 'انتقال المخاطر' },
      ]}
      rows={incotermRows}
      caption="توزيع المسؤوليات القياسي لشروط التجارة الدولية، وليس مقارنة أسعار. تم استبدال DDU بـ DAP في شروط التجارة الدولية 2020."
    />
    <SourceList locale={locale} sources={incotermSources} title="المصادر — ممارسات DDP وشروط التجارة الدولية" />

    <div class="grid grid--2 mt-2">
      <Card locale={locale} title="DDP هو الأفضل عادةً عندما...">
        <ul>
          <li>يريد المشتري سعرًا شاملاً واحدًا ومزودًا واحدًا للمتابعة.</li>
          <li>لست مسجلاً لدى الجمارك السعودية أو ليس لديك مخلص جمركي محلي.</li>
          <li>تبيع مباشرة للمستهلكين أو أمازون أو نون، وتحتاج إلى توصيل إلى الباب.</li>
          <li>تريد أن يتولى وكيل شحن لديه شركاء محليون الرسوم الجمركية وضريبة القيمة المضافة وSABER.</li>
        </ul>
      </Card>
      <Card locale={locale} title="DAP/CIF ذاتي الترتيب أفضل عادةً عندما...">
        <ul>
          <li>لديك سجل تجاري سعودي ويمكنك استرداد ضريبة القيمة المضافة.</li>
          <li>لديك مخلص جمركي حالي وأسعار محطات ونقل بالشاحنات متفاوض عليها.</li>
          <li>التعرض للرسوم الجمركية/ضريبة القيمة المضافة لمنتجك منخفض وتريد شفافية ضريبية واضحة.</li>
          <li>يمكنك إدارة شهادات SABER PC/SC مباشرة والتخليص قبل التفريغ.</li>
        </ul>
      </Card>
    </div>

    <p class="mt-2">
      السؤال التجاري ليس “أي شرط هو الأرخص” بل “من يمكنه التخليص الأسرع وبأقل
      تكلفة إجمالية للوصول”. يمكن لمزود DDP ذي انضباط ضعيف في SABER أن يكون أكثر تكلفة في
      غرامات التأخير من شحنة ذاتية الترتيب مع مخلص قوي — لذا قيم المشغل، وليس
      الشرط فقط.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. الموانئ: شنغهاي ونينغبو-تشوشان وشنتشن وقوانغتشو إلى جدة والدمام وميناء الرياض الجاف</h2>
      <p>
        ترتكز أمثلة معايير DDP في البيانات البحثية على منشآت جنوب الصين —
        قوانغتشو وشنتشن — لكن شنغهاي ونينغبو-تشوشان هما الرائدان في حجم المناولة على هذا الممر
        ويظلان منشأين شائعين للأحجام الأكبر.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'port', label: 'الميناء الصيني' },
          { key: 'throughput', label: 'حجم المناولة 2025' },
          { key: 'note', label: 'ملاحظة' },
          { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
        ]}
        rows={chinaPortRows}
        caption="أرقام شنغهاي ونينغبو-تشوشان موثقة؛ لم يُذكر حجم مناولة شنتشن وقوانغتشو في البيانات البحثية."
      />
      <SourceList locale={locale} sources={primaryPortSources} title="المصادر — الموانئ الصينية" />

      <h3 class="mt-3">موانئ الوجهة السعودية</h3>
      <p>
        تعاملت الموانئ السعودية التي تشغلها موانئ <strong>8.3 million TEU في 2025</strong> (+10.6% على أساس
        سنوي)، وهو رقم متوسط الموثوقية من الصحافة التجارية لأن mawani.gov.sa لم يكن متاحًا
        أثناء البحث. جدة والدمام هما الميناءان البحريان الأكثر أهمية لمعظم عمليات تسليم DDP؛
        بينما يتولى ميناء الرياض الجاف الجزء الداخلي لتوزيع منطقة الرياض الحضرية.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'العامل' },
          { key: 'jeddah', label: 'جدة' },
          { key: 'dammam', label: 'الدمام' },
          { key: 'riyadh', label: 'ميناء الرياض الجاف' },
          { key: 'confidence', label: 'الموثوقية', type: 'confidence' },
        ]}
        rows={saudiPortRows}
        caption="أدوار الموانئ هي نتائج مصادر ثانوية؛ تحقق من المسار ومرحلة التوصيل النهائية مع وكيل الشحن الخاص بك."
      />
