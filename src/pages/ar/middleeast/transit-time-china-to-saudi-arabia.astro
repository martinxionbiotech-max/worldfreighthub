    confidence: 'MEDIUM',
  },
  {
    factor: 'الوضع الأمني في البحر الأحمر',
    effect: 'تغييرات المسارات أدت أحيانًا إلى تمديد مدة النقل',
    note: 'مؤكد من لقطة البحث',
    confidence: 'LOW',
  },
  {
    factor: 'جاهزية الجمارك وSABER',
    effect: 'تأخر SC من SABER أو خطأ في HS أو مستند ناقص يحجز البضاعة',
    note: 'احصل على SC قبل الوصول؛ وقدّم FASAH مبكرًا',
    confidence: 'MEDIUM',
  },
  {
    factor: 'المرحلة البرية إلى الوجهة النهائية',
    effect: 'الدمام/الرياض والتسليم الداخلي يضيفان وقتًا بعد التفريغ',
    note: 'طابق ميناء التفريغ مع المرسل إليه',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'كم تستغرق مدة الشحن من الصين إلى السعودية؟',
    a: 'نطاقات التخطيط الإرشادية تقريبًا 20–45 days بحرًا و2–10 days جواً. الشحن البحري إلى جدة عادة حوالي 20–35 days، بينما الدمام وميناء الرياض الجاف حوالي 30–45 days. هذه نتائج بحثية منخفضة الثقة وليست ضمانات جدول زمني — تحقق مع الناقل وتحقق من إعادة الشحن.',
  },
  {
    q: 'ما هي مدة الشحن البحري إلى جدة؟',
    a: 'تشير لقطات البحث إلى أن الشحن البحري إلى جدة حوالي 20–35 days، مع متوسط مصدر واحد حوالي 20 days على مثال شنتشن–جدة. تعامل مع ذلك كنطاق إرشادي من ميناء إلى ميناء وتأكد من السفينة والرحلة وأي نقاط إعادة شحن قبل الحجز.',
  },
  {
    q: 'كم تستغرق مدة الشحن البحري إلى الدمام أو الرياض؟',
    a: 'النطاقات الإرشادية هي 30–45 days إلى الدمام / ميناء الرياض الجاف. تُظهر Freightos FCL شنغهاي–الرياض عند 30–40 days وLCL عند 32–45 days. غالبًا ما تُفرغ بضائع الرياض في الدمام ثم تُنقل برًا بالسكك الحديدية أو الطرق، لذا فإن نقطة التسليم النهائية مهمة.',
  },
  {
    q: 'ما مدى سرعة الشحن الجوي من الصين إلى السعودية؟',
    a: 'الشحن الجوي من مطار إلى مطار عادة 3–7 days كتقدير تخطيطي، مع نطاقات منشورة تبلغ 2–5 business days و6–10 days حسب المصدر والمسار. الشحن الجوي DDP من الباب إلى الباب يضيف وقتًا وغالبًا ما يُقتبس عند 10–15 days.',
  },
  {
    q: 'هل FCL أسرع من LCL من الصين إلى السعودية؟',
    a: 'نعم، في معظم الحالات يكون FCL أسرع لأن الحاوية المختومة تتحرك كشحنة واحدة. تُظهر Freightos FCL شنغهاي–الرياض عند 30–40 days مقابل LCL عند 32–45 days. يضيف LCL مناولة التجميع والتفكيك، مما قد يضيف أيضًا مخاطر جدولة.',
  },
  {
    q: 'لماذا يوجد فجوة بين وصول السفينة والإفراج عن البضاعة؟',
    a: 'الوصول ليس إفراجًا. بعد التفريغ، يجب أن تصبح الحاوية متاحة، ثم يجب قبول إقرار FASAH قبل الوصول وSC من SABER، وتسوية الرسوم الجمركية/ضريبة القيمة المضافة، وإتمام أي فحص قبل الإفراج. تأخر SC من SABER أو خطأ في رمز HS أو مستند ناقص يحول فجوة يوم واحد إلى احتجاز لعدة أيام.',
  },
  {
    q: 'ما الذي يؤخر غالبًا شحنة من الصين إلى السعودية؟',
    a: 'الأسباب الشائعة هي انتظار إعادة الشحن، وازدحام موسم الذروة، وتغييرات مسارات البحر الأحمر، وازدحام الميناء في جدة أو الدمام، واحتجاز التخليص بسبب تأخر SC من SABER أو مستندات غير صحيحة. التخطيط لأعمال الامتثال قبل الوصول يزيل الجزء القابل للتحكم من التأخير.',
  },
  {
    q: 'كيف يمكنني تقصير مدة النقل من الصين إلى السعودية؟',
    a: 'اختر خدمة مباشرة بدلاً من إعادة الشحن، واحصل على SC من SABER قبل الوصول، وقدّم إقرار FASAH قبل الوصول مبكرًا، وصنف رمز HS بشكل صحيح، واحجز النقل بالشاحنات قبل التفريغ، واستخدم الشحن الجوي فقط عندما تستحق وفرة الوقت القسط الإضافي.',
  },
  {
    q: 'ما الفرق بين مدة النقل من ميناء إلى ميناء ومن الباب إلى الباب؟',
    a: 'من ميناء إلى ميناء يتوقف عند المحطة السعودية ويترك النقل البري قبل الشحن الرئيسي والتخليص السعودي والتسليم لك، لذا فإن الوقت المذكور أقصر لكنه غير مكتمل. من الباب إلى الباب يشمل السلسلة بأكملها إلى العنوان النهائي وهو التوقيت الوحيد المهم لموعد استلام المشتري للبضاعة فعليًا.',
  },
  {
    q: 'هل يبطئ SABER شحنتي؟',
    a: 'فقط إذا تم التعامل معه متأخرًا. يجب الحصول على شهادة مطابقة الشحنة (SC) قبل وصول البضاعة — منذ 1 January 2025، تعتبر SC المقدمة بعد الوصول باطلة. إذا تم إنجاز PC وSC بشكل صحيح قبل الوصول، فإن SABER جزء من عملية التخليص وليس سببًا للتأخير.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'مدة النقل من الصين إلى السعودية: بحرًا وجوًا ومن الباب إلى الباب (August 2026)',
      description:
        'مدة النقل من الصين إلى السعودية موضحة: نطاقات جدة مقابل الدمام بحرًا، فروق FCL مقابل LCL، النقل الجوي والسريع، من ميناء إلى ميناء مقابل من الباب إلى الباب، والتأخيرات التي تمدد الوقت.',
