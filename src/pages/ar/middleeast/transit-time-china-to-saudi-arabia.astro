    confidence: 'LOW',
  },
  {
    factor: 'تقلب الوقت',
    sea: 'نطاق أوسع؛ الجدول الزمني وإعادة الشحن والازدحام تمدد الوقت',
    air: 'نطاق أضيق، لكن التخليص الجمركي وSABER لا تزال تؤخر الإفراج',
    confidence: 'LOW',
  },
  {
    factor: 'أساس الوحدة',
    sea: 'لكل حاوية (FCL) أو لكل CBM / الوزن القابل للتحصيل (LCL)',
    air: 'لكل kg قابل للتحصيل',
    confidence: 'LOW',
  },
  {
    factor: 'الأنسب لـ',
    sea: 'البضائع غير العاجلة، كبيرة الحجم، ذات الطلب المستقر',
    air: 'البضائع العاجلة، القابلة للتلف، الهشة، عالية القيمة أو الحرجة لنفاد المخزون',
    confidence: 'LOW',
  },
  {
    factor: 'بوابة الامتثال',
    sea: 'مطلوب PC/SC من SABER وإقرار FASAH قبل الوصول',
    air: 'تنطبق نفس القواعد؛ الشحن الجوي يقلل وقت النقل وليس الأعمال الورقية',
    confidence: 'MEDIUM',
  },
];

const stageRows = [
  {
    stage: 'الاستلام من المنشأ والتخليص الجمركي للتصدير من الصين',
    effect: 'يضيف وقتًا قبل مغادرة السفينة أو الطائرة',
    note: 'يعتمد التوقيت على بوابة المنشأ وجاهزية المستندات',
    confidence: 'LOW',
  },
  {
    stage: 'القطع والتحميل للسفينة / الطائرة',
    effect: 'البضاعة تنتظر موعد المغادرة المقرر',
    note: 'قلة الرحلات البحرية أو الجوية تعني مزيدًا من الانتظار',
    confidence: 'LOW',
  },
  {
    stage: 'النقل الدولي',
    effect: 'جدة ~20–35 days؛ الدمام/الرياض ~30–45 days بحرًا',
    note: 'الشحن الجوي 2–10 days بالمقارنة',
    confidence: 'LOW',
  },
  {
    stage: 'إعادة الشحن (إن وجدت)',
    effect: 'يضيف مناولة في المحطة وانتظارًا في مركز العبور',
    note: 'الخدمات المباشرة عادة أسرع لكنها أقل تكرارًا',
    confidence: 'LOW',
  },
  {
    stage: 'التفريغ وتوفر المحطة',
    effect: 'تصبح الحاوية أو البضاعة متاحة بعد التفريغ',
    note: 'ازدحام المحطة يمكن أن يطيل هذه المرحلة',
    confidence: 'LOW',
  },
  {
    stage: 'الإفراج الجمركي السعودي',
    effect: 'إقرار FASAH قبل الوصول بالإضافة إلى SC من SABER',
    note: 'تأخر SC أو احتجاز المستندات يوقف الوقت عند الحدود',
    confidence: 'MEDIUM',
  },
  {
    stage: 'التسليم الداخلي',
    effect: 'النقل بالشاحنات من جدة/الدمام إلى العنوان النهائي',
    note: 'بضائع الرياض قد تُنقل عبر ميناء الرياض الجاف',
    confidence: 'LOW',
  },
];

const factorRows = [
  {
    factor: 'جدول الإبحار / الرحلات الجوية وتكرارها',
    effect: 'قلة المغادرات تخلق مدة انتظار أطول في المنشأ أو مركز العبور',
    note: 'تأكد من السفينة والرحلة الفعلية وموعد القطع',
    confidence: 'LOW',
  },
  {
    factor: 'المسار المباشر مقابل إعادة الشحن',
    effect: 'إعادة الشحن تضيف مناولة ووقت انتظار',
