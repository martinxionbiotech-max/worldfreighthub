    transit: '3–7 days',
    basis: 'نطاق تخطيطي للشحن المباشر من مطار إلى مطار؛ يُرجى التحقق مع الناقل',
    confidence: 'LOW',
  },
  {
    lane: 'الصين ← السعودية (شحن جوي DDP)',
