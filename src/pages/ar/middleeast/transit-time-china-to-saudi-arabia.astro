    transit: '10–15 days',
    basis: 'معيار الشحن الجوي DDP من chinaddpshipping',
    confidence: 'LOW',
  },
  {
    lane: 'بريد سريع',
    service: 'توصيل إلى الباب',
    transit: '3–6 أيام عمل',
    basis: 'مثال DHL من ddpchain؛ الشحن السريع من Freightos 3–6 days؛ الشحن السريع من Sino 3–5 days',
