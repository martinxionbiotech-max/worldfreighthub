const worldcargonews: Source = {
  id: 'worldcargonews',
  name: 'World Cargo News — Mawani ports handle 8.3m TEU in 2025',
  url: 'https://www.worldcargonews.com/ports-terminals/2026/01/mawani-ports-handle-8-3m-teu-in-2025/',
  type: 'industry',
};
const sasoInfo: Source = {
  id: 'saso-info',
  name: 'SASO conformity process notes — product testing then pre-shipment inspection',
  url: 'http://www.saso-gov.com/index.php?znhcjwt.html',
  type: 'industry',
};

const primaryPortSources = sourcesByIds([
  'mawani',
  'sipg',
  'ningbo-zhoushan-port',
  'shenzhen-port-group',
]);
const complianceSources = sourcesByIds(['zatca', 'mawani']);
const seaTransitSources: Source[] = [freightos, cargofromchina, ddpchain, chinaddpshipping];
const airTransitSources: Source[] = [freightos, ddpchain, cargofromchina, chinaddpshipping, sinoShipping];
const comparisonSources: Source[] = [freightos, ddpchain, cargofromchina];
const factorSources: Source[] = [
  ...sourcesByIds(['mawani', 'zatca']),
  cargofromchina,
  ddpchain,
  freightos,
  fuxinCcpt,
];

const seaTransitRows = [
  {
    destination: 'جدة',
    service: 'شحن بحري من ميناء إلى ميناء',
    transit: '~20–35 days',
    basis: 'cargofromchina متوسط ~20 days (شنتشن–جدة)؛ ddpchain 20–35 days',
    confidence: 'LOW',
  },
  {
    destination: 'الدمام / ميناء الرياض الجاف',
    service: 'شحن بحري من ميناء إلى ميناء',
    transit: '30–45 days',
    basis: 'بيانات Freightos لمسار شنغهاي–الرياض',
    confidence: 'LOW',
  },
  {
    destination: 'الرياض (من شنغهاي)',
    service: 'FCL',
    transit: '30–40 days',
    basis: 'بيانات مسار FCL شنغهاي–الرياض من Freightos',
    confidence: 'LOW',
  },
  {
    destination: 'الرياض (من شنغهاي)',
    service: 'LCL',
    transit: '32–45 days',
    basis: 'بيانات مسار LCL شنغهاي–الرياض من Freightos',
    confidence: 'LOW',
  },
];

const planningRows = routes
  .filter((route) => route.country === 'saudi-arabia')
  .map((route) => ({
    origin: route.originPort,
    destination: route.destPort,
    typical: `${route.transitDays.typical} يوم`,
    range: `${route.transitDays.range[0]}–${route.transitDays.range[1]} يوم`,
    note: route.note,
    confidence: route.confidence,
  }));

const airTransitRows = [
  {
    lane: 'شنغهاي ← الرياض',
    service: 'شحن جوي من مطار إلى مطار',
    transit: '6–10 days',
    basis: 'بيانات المسار الجوي شنغهاي–الرياض من Freightos',
    confidence: 'LOW',
  },
  {
    lane: 'الصين ← السعودية (أمثلة مسارات)',
    service: 'شحن جوي من مطار إلى مطار',
    transit: '6–10 days',
    basis: 'أمثلة مسارات ddpchain',
    confidence: 'LOW',
  },
  {
    lane: 'الصين ← السعودية (نطاقات السوق)',
    service: 'الشحن الجوي',
    transit: '2–5 business days',
    basis: 'دليل الشحن الجوي من cargofromchina',
    confidence: 'LOW',
  },
  {
    lane: 'الصين ← السعودية (تقدير تخطيطي)',
