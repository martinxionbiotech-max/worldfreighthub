        { key: 'type', label: 'نوع الحاوية' },
        { key: 'interior', label: 'الأبعاد الداخلية الاسمية (ط × ع × ا)' },
        { key: 'volume', label: 'الحجم الاسمي' },
        { key: 'payload', label: 'الحمولة النموذجية' },
        { key: 'note', label: 'ملاحظة تخطيطية' },
