    a: 'الرسوم الجمركية هي 5% من CIF بموجب التعريفة الجمركية الموحدة لدول مجلس التعاون الخليجي. ضريبة القيمة المضافة هي 15% وتُحتسب على CIF بالإضافة إلى الرسوم الجمركية — وليس فقط على CIF. على قيمة CIF تبلغ $10,000 تكون الرسوم الأساسية $500 وضريبة القيمة المضافة 15% من $10,500, أو $1,575, لمجموع قانوني قدره $12,075.',
  },
  {
    q: 'هل FCL أم LCL أرخص من الصين إلى السعودية؟',
    a: 'لا توجد إجابة واحدة. عادةً ما يكون LCL أرخص للأحجام الصغيرة لأنك تدفع فقط مقابل المساحة المستخدمة، لكنه يضيف رسوم تفكيك الحاوية في محطة الشحن، والحد الأدنى للشحنة، والمزيد من مناولة الوجهة. عادةً ما يكون FCL أفضل كلما اقتربت البضاعة من حصة كبيرة من الحاوية. قم بتشغيل كلا العرضين الشاملين لأن نقطة التحول تتغير حسب المسار ورسوم الوجهة.',
  },
  {
    q: 'ما هي الرسوم الخفية التي يجب أن أتوقعها على شحنة سعودية؟',
    a: 'بعيداً عن سعر الشحن، توقع رسوم المنشأ، ورسوم المناولة في ميناء الوجهة ورسوم الميناء، ورسوم المستندات، وسمسرة التخليص الجمركي، ورسوم مطابقة سابر للشهادة الأولية/شهادة الشحنة، والنقل الداخلي، وتأمين البضاعة إذا اخترته، وغرامة التأخير/رسوم الاحتجاز بعد المهلة المجانية. الرسوم الجمركية (5% من CIF) وضريبة القيمة المضافة (15% على CIF بالإضافة إلى الرسوم) هي رسوم قانونية. لم تُنشر مبالغ الرسوم المحددة في لقطة البحث — اطلب جدولاً مفصلاً.',
  },
  {
    q: 'كم تبلغ تكلفة شهادة سابر؟',
    a: 'لشهادة سابر تكلفتان: شهادة المطابقة للمنتج (PC) تُدفع مرة واحدة لكل منتج وتتضمن الاختبار، وعند الاقتضاء، الفحص؛ شهادة مطابقة الشحنة (SC) تُدفع لكل شحنة. لم تنشر لقطة البحث مبالغ رسوم محددة، لذا اطلب عرض سعر سابر للرمز HS وقيمة الشحنة الخاصة بك.',
  },
  {
    q: 'هل تنطبق ضريبة القيمة المضافة 15% على الشحن أيضاً؟',
    a: 'نعم، في الهيكل القياسي. تُحتسب ضريبة القيمة المضافة على CIF بالإضافة إلى الرسوم الجمركية، وتشمل CIF الشحن والتأمين. هذا يعني أن ارتفاع تكلفة الشحن يرفع أيضاً أساس ضريبة القيمة المضافة. تعامل مع المعدل على أنه قابل للتغيير وأكد المعاملة مع هيئة الزكاة والضريبة والجمارك للبضائع المعنية.',
  },
  {
    q: 'ما هي أرخص طريقة للشحن من الصين إلى السعودية؟',
    a: 'بالنسبة لمعظم البضائع كبيرة الحجم وغير المستعجلة، يعطي الشحن البحري أقل تكلفة للوحدة — ولكن فقط إذا قمت بتضمين جميع رسوم الوجهة وقارنت التكلفة الشاملة، وليس السعر الرئيسي. نادراً ما يكون الشحن الجوي هو الخيار الأرخص ويُبرر بالسرعة أو كثافة القيمة أو الاستعجال، وليس بالتكلفة.',
  },
  {
    q: 'كيف يمكنني تقليل التكلفة الإجمالية للوصول على هذا المسار؟',
    a: 'قم بتجميع البضائع في حاويات أقل وأكثر امتلاءً؛ قارن عروض الأسعار الشاملة لـ FCL وLCL؛ صنّف الرمز HS بشكل صحيح قبل الحجز؛ احصل على شهادة مطابقة الشحنة SC من سابر قبل الوصول؛ قدم إقرار فسح ما قبل الوصول في فسح مبكراً؛ احجز النقل بالشاحنات قبل التفريغ؛ وفاوض على جدول رسوم الوجهة بدلاً من قبول أول عرض سعر.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'تكلفة الشحن من الصين إلى السعودية: تحليل شامل للتكلفة الإجمالية للوصول (August 2026)',
      description:
        'شرح تكلفة الشحن من الصين إلى السعودية: معايير الشحن البحري والجوي، رسوم المناولة في الميناء، المستندات، التخليص، رسوم سابر، الرسوم الجمركية 5% وضريبة القيمة المضافة 15%، بالإضافة إلى معادلة التكلفة الإجمالية للوصول CIF × 1.05 × 1.15.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
