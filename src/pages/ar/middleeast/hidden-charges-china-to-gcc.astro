    q: 'هل التفتيش الجمركي يكلف دائماً مبلغاً إضافياً؟',
    a: 'ليس دائماً، ولكن عندما يكون التفتيش أو المعاينة مطلوباً، قد تُضاف رسوم المنشأة والمناولة والحضور المرتبطة به. يعتمد التفتيش على البضاعة وتصنيف النظام المنسق (HS) ومخاطر التصريح. اطلب قاعدة رسوم التفتيش وتأكد من المسؤول عنها قبل وصول البضاعة.',
  },
  {
    q: 'كم تبلغ رسوم الوجهة الخفية على شحنات الصين إلى دول مجلس التعاون الخليجي؟',
    a: 'لا ينشر الملخص البحثي مبالغ محددة لرسوم مناولة الحاويات في المحطة (THC)، والخدمات المينائية، وخدمة البضائع، والمستندات، والأمن (ISPS)، والوساطة، وسابر، والتخزين أو النقل البري الداخلي. الرسوم الكمية الوحيدة هي غرامة التأخير/رسوم الاحتجاز بحوالي $50–$300+ يومياً، بمتوسط 2025 حوالي $150–$300 يومياً. يجب طلب كل شيء آخر كجدول رسوم تفصيلي.',
  },
  {
    q: 'هل الرسوم الجمركية وضريبة القيمة المضافة رسوم خفية؟',
    a: 'لا، إنها تكاليف نظامية، لكنها كثيراً ما تُنسى في المقارنات المبكرة للشحن. ضريبة القيمة المضافة السعودية 15% على قيمة CIF بالإضافة إلى الرسوم الجمركية، وضريبة القيمة المضافة الإماراتية 5%، والرسوم الجمركية الخليجية 5% من قيمة CIF. خصص لها ميزانية منفصلة عن رسوم الوجهة التجارية.',
  },
  {
    q: 'ما الرسوم التي يتحملها الشحن البحري الكامل (FCL) ولا يتحملها الشحن البحري الجزئي (LCL)؟',
    a: 'الشحن البحري الكامل (FCL) يعرضك مباشرة لغرامة التأخير/رسوم الاحتجاز على مستوى الحاوية ورسوم مناولة الحاويات في المحطة (THC) والرسوم المينائية الكاملة للوجهة على الحاوية. الشحن البحري الجزئي (LCL) عادةً يوزع رسوم مناولة الحاويات في المحطة (THC) على المرسل إليهم ويضيف بنود إعادة التفكيك في محطة الشحن الجزئي (CFS) وخدمة البضائع والتخزين، بينما يتحمل مشغّل محطة الشحن الجزئي (CFS) عادةً رسوم احتجاز الحاوية.',
  },
  {
    q: 'كيف أطلب من وكيل الشحن جدول رسوم كامل؟',
    a: 'اطلب جدولاً مكتوباً بنداً ببند من المنشأ إلى التسليم: رسوم مناولة الحاويات في المحطة (OTHC/DTHC)، والخدمات المينائية، وخدمة البضائع، والمستندات/أمر التسليم، والأمن (ISPS)، والتفتيش، والوساطة، وشهادتي سابر (PC/SC)، والتخزين، وغرامة التأخير/رسوم الاحتجاز والنقل الداخلي. اسأل عن البنود الثابتة والبنود المشروطة والتي تتراكم يومياً. قارن الجداول، وليس الأسعار الرئيسية.',
  },
  {
    q: 'لماذا يجب أن أربط هذه الصفحة بدليل غرامة التأخير؟',
    a: 'غرامة التأخير ورسوم الاحتجاز هي المجموعة الفرعية الزمنية ضمن حزمة رسوم الوجهة الأكبر. اقرأ الصفحة المصاحبة لفهم فترة السماح والساعة المجمعة وكيف يتحول تعليق الشحنة في جدة إلى $1,050–$2,100 من التعرض لكل حاوية، ثم استخدم هذه الصفحة لمراجعة الرسوم الثابتة والمشروطة الأخرى.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الرسوم الخفية ورسوم الوجهة: تفصيل تكلفة الشحن من الصين إلى دول مجلس التعاون الخليجي (August 2026)',
      description:
        'كل رسوم الوجهة التي يتجاهلها المستوردون عند الشحن من الصين إلى دول مجلس التعاون الخليجي: رسوم مناولة الحاويات في المحطة (THC)، ورسوم الخدمات المينائية، والمستندات، والأمن (ISPS)، والتفتيش، والوساطة، وسابر، والتخزين، والنقل البري الداخلي ونطاق غرامة التأخير/رسوم الاحتجاز اليومي $50–$300+.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
