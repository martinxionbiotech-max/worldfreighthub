---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import DataTable from '../../../components/DataTable.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import ConfidenceBadge from '../../../components/ConfidenceBadge.astro';
import SourceList from '../../../components/SourceList.astro';
import Card from '../../../components/Card.astro';
import Cta from '../../../components/Cta.astro';
import { SITE_URL } from '../../../site';
import { sourcesByIds } from '../../../data/sources';
import { gccCountriesAr as gccCountries } from '../../../data/countries.ar';
import { gccPortsAr as gccPorts } from '../../../data/ports.ar';
import type { Source } from '../../../data/types';
import { t, type Locale } from '../../../i18n/ui';

const locale = 'ar' as const;

const pageUrl = `${SITE_URL}/ar/middleeast/gcc-customs-duty-comparison/`;

const portRoles: Record<string, string> = {
  jeddah: 'بوابة البحر الأحمر، غرب السعودية',
  dammam: 'بوابة الخليج العربي، المنطقة الشرقية + الرياض',
  'riyadh-dry-port': 'ميناء جاف داخلي؛ امتداد سككي/بري لممر الدمام',
  'jebel-ali': 'أكبر ميناء في الشرق الأوسط؛ مركز إعادة التصدير والمنطقة الحرة في الإمارات',
  'khalifa-port-abu-dhabi': 'بوابة أبوظبي للمياه العميقة',
  'port-khalid': 'بوابة الشارقة / ميناء خالد',
  hamad: 'بوابة قطر التجارية الوحيدة',
  shuwaikh: 'بوابة مدينة الكويت العامة/للحاويات',
  shuaiba: 'بوابة الكويت الصناعية والسائبة',
  sohar: 'بوابة شمال عُمان للحاويات',
  salalah: 'بوابة جنوب عُمان لإعادة الشحن',
  'khalifa-bin-salman': 'بوابة البحرين؛ وصلة جسر الملك فهد إلى السعودية',
};

const portRows = gccPorts.map((port) => ({
  port: port.name,
  unlocode: port.unlocode ?? '—',
  country: port.country,
  role: portRoles[port.slug] ?? port.hinterland,
  confidence: 'HIGH',
}));

const primaryPortByCountry: Record<string, { port: string; typical: string }> = {
  'saudi-arabia': { port: 'جدة (SAJED) / الدمام (SADMM)', typical: '~18 / ~20 يومًا' },
  'united-arab-emirates': { port: 'جبل علي (AEJEA)', typical: '~21 يومًا' },
  qatar: { port: 'ميناء حمد (QAHMD)', typical: '~22 يومًا' },
  kuwait: { port: 'الشويخ (KWSWK)', typical: '~24 يومًا' },
  oman: { port: 'صحار (OMSOH)', typical: '~19 يومًا' },
  bahrain: { port: 'خليفة بن سلمان (BHKBS)', typical: '~22 يومًا' },
};

const dutyRows = gccCountries.map((country) => {
  const vat = country.vatRate === null ? '0% (no ضريبة القيمة المضافة)' : `${country.vatRate}%`;
  return {
    country: country.name,
    currency: country.currency,
    duty: '5% (CIF)',
    vat,
    deMinimis: country.deMinimis,
    confidence: 'HIGH',
  };
});

const transitRows = gccCountries.map((country) => {
  const primary = primaryPortByCountry[country.slug] ?? { port: '—', typical: '—' };
  return {
    country: country.name,
    port: primary.port,
    typical: primary.typical,
    note: 'النموذجي من ميناء إلى ميناء من بيانات المسارات؛ توقيت التخليص يختلف حسب الشحنة/رمز HS',
    confidence: 'MEDIUM',
  };
});

const wfhCountryData: Source = {
  id: 'wfh-gcc-customs-country-data',
  name: 'WorldFreightHub GCC country data — ضريبة القيمة المضافة, duty and de minimis profiles (HIGH confidence)',
  url: `${SITE_URL}/countries/`,
  type: 'organization',
};

const wfhRouteData: Source = {
  id: 'wfh-gcc-customs-route-data',
  name: 'WorldFreightHub route data — China to GCC destination ports (typical transit days; MEDIUM confidence)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const dutySources: Source[] = [wfhCountryData];
const transitSources: Source[] = [wfhRouteData, wfhCountryData];
const decisionSources: Source[] = [wfhCountryData];
const portSources: Source[] = [
  ...sourcesByIds([
    'mawani',
    'dp-world',
    'abu-dhabi-ports',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
];
const costSources: Source[] = [
  ...sourcesByIds([
    'zatca',
    'dubai-customs',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
  wfhCountryData,
];
const complianceSources: Source[] = [
  ...sourcesByIds([
    'zatca',
    'dubai-customs',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
  wfhCountryData,
];

const entryRows = [
  {
    country: 'السعودية',
    duty: '5% (CIF)',
    vat: '15%',
    multiplier: '×1.2075',
    aboveCif: '+20.75%',
    note: 'أعلى ضرائب الخليج؛ يجب الحصول على شهادة SABER/SASO SC قبل الوصول',
    confidence: 'HIGH',
  },
  {
    country: 'الإمارات',
    duty: '5% (CIF)',
    vat: '5%',
    multiplier: '×1.1025',
    aboveCif: '+10.25%',
    note: 'الأقل تعقيدًا؛ يمكن للمناطق الحرة تأجيل الرسوم حتى دخول البر الرئيسي',
    confidence: 'HIGH',
  },
  {
    country: 'قطر',
    duty: '5% (CIF)',
    vat: '0%',
    multiplier: '×1.05',
    aboveCif: '+5%',
    note: 'أقل ضرائب حاليًا؛ من المتوقع ضريبة قيمة مضافة ~5% — خطط لها مستقبلاً',
    confidence: 'HIGH',
  },
  {
    country: 'الكويت',
    duty: '5% (CIF)',
    vat: '0%',
    multiplier: '×1.05',
    aboveCif: '+5%',
    note: 'لا توجد ضريبة قيمة مضافة، لكن التخليص مليء بالمستندات وشهادة PAI',
    confidence: 'HIGH',
  },
  {
    country: 'عُمان',
    duty: '5% (CIF)',
    vat: '5%',
    multiplier: '×1.1025',
    aboveCif: '+10.25%',
    note: 'متوسطة التكلفة؛ صحار أقل ازدحامًا من جبل علي أو جدة',
    confidence: 'HIGH',
  },
  {
    country: 'البحرين',
    duty: '5% (CIF)',
    vat: '10%',
    multiplier: '×1.155',
    aboveCif: '+15.5%',
    note: 'ثاني أعلى ضريبة قيمة مضافة؛ جسر الملك فهد مدخل بديل إلى شرق السعودية',
    confidence: 'HIGH',
  },
];

const costRows = [
  {
    item: 'الرسوم الجمركية على الواردات',
    who: 'سلطة الجمارك الخليجية',
    magnitude: '5% من قيمة CIF (خط الأساس الخليجي الموحد)',
    confidence: 'HIGH',
  },
  {
    item: 'ضريبة القيمة المضافة على الواردات',
    who: 'سلطة الضرائب في الوجهة',
    magnitude: 'السعودية 15% · الإمارات 5% · قطر 0% · الكويت 0% · عُمان 5% · البحرين 10%',
    confidence: 'HIGH',
  },
  {
    item: 'السمسرة الجمركية',
    who: 'المخلص الجمركي المرخص',
    magnitude: 'غير منشور في اللقطة الموثقة — اطلب عرض سعر مفصلاً',
    confidence: 'LOW',
  },
  {
    item: 'المعاينة / الاختبار',
    who: 'الجمارك أو جهة المطابقة',
    magnitude: 'غير منشور في اللقطة الموثقة — اطلب عرض سعر مفصلاً',
    confidence: 'LOW',
  },
  {
    item: 'شهادة SABER (السعودية فقط)',
    who: 'منصة SABER / جهة المطابقة',
    magnitude: 'غير منشور في اللقطة الموثقة — اطلب عرض سعر مفصلاً',
    confidence: 'LOW',
  },
  {
    item: 'رسوم المستندات / التقديم',
    who: 'المخلص / الناقل / الوكيل',
    magnitude: 'غير منشور في اللقطة الموثقة — اطلب عرض سعر مفصلاً',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'ما الرسوم الجمركية على الواردات من الصين إلى الخليج؟',
    a: 'الرسوم الجمركية الأساسية الموحدة في الخليج هي 5% من قيمة CIF (التكلفة + التأمين + الشحن) لمعظم البضائع في السعودية والإمارات وقطر والكويت وعُمان والبحرين. وتنطبق معدلات أعلى أو حمائية على فئات محددة مثل الكحول والتبغ وبعض الخطوط الزراعية، لذا أكد معدل رمز HS الدقيق قبل التسعير.',
  },
  {
    q: 'أي دولة خليجية لديها أعلى ضريبة استيراد؟',
    a: 'السعودية، لأن رسوم 5% وضريبة القيمة المضافة 15% تتراكم إلى مضاعف تكلفة وصول CIF × 1.2075 — أي نحو 20.75% فوق CIF. وتأتي البحرين ثانية بمضاعف CIF × 1.155 (15.5% فوق CIF) مع ضريبة القيمة المضافة 10%.',
  },
  {
    q: 'أي دولة خليجية لديها أقل ضريبة استيراد؟',
    a: 'قطر والكويت لديهما حاليًا أدنى ضريبة استيراد عند رسوم 5% وضريبة قيمة مضافة 0%، أي مضاعف CIF × 1.05. ومن المتوقع أن تفرض قطر ضريبة قيمة مضافة بنحو 5%، لذا يجب أن يبني التسعير المستقبلي هذا الافتراض.',
  },
  {
    q: 'كيف أحسب التكلفة الإجمالية للوصول مع الرسوم وضريبة القيمة المضافة؟',
    a: 'ابدأ من CIF، وأضف رسوم 5%، ثم طبّق ضريبة القيمة المضافة على القيمة الشاملة للرسوم. المضاعف المختصر هو CIF × 1.05 × (1 + معدل ضريبة القيمة المضافة). أمثلة: السعودية ×1.2075، الإمارات ×1.1025، قطر والكويت ×1.05، عُمان ×1.1025، البحرين ×1.155. هذه عملية حسابية من معدلات الرسوم وضريبة القيمة المضافة المنشورة، وليست بديلاً عن تقييم المخلص الدقيق.',
  },
  {
    q: 'هل تُفرض الرسوم على قيمة الفاتورة أم قيمة CIF؟',
    a: 'على قيمة CIF — التكلفة بالإضافة إلى التأمين والشحن — وليس على قيمة الفاتورة وحدها. إذا لم يكن الشحن والتأمين مدرجين في الفاتورة، فستظل سلطة الجمارك تدرجهما في القيمة الخاضعة للتقييم، ولهذا يبدأ حساب التكلفة الإجمالية للوصول من CIF.',
  },
  {
    q: 'هل يوجد حد إعفاء جمركي في الخليج للبضائع التجارية؟',
    a: 'لا يوجد حد إعفاء تجاري مؤكد منشور لقطر أو الكويت أو عُمان أو البحرين. تنشر السعودية والإمارات حدين قدرهما SAR 1,000 وAED 1,000 للطرود الشخصية/البريدية فقط. يجب أن تفترض البضائع التجارية أن الرسوم تنطبق بغض النظر عن حدود الطرود.',
  },
  {
    q: 'هل أحتاج SABER لكل دولة خليجية؟',
    a: 'لا. تنطبق مطابقة SABER/SASO على السعودية فقط. للبضائع السعودية الخاضعة للتنظيم، يجب الحصول على شهادة مطابقة الشحنة (SC) قبل الوصول — سارية منذ 1 يناير 2025. تستخدم الإمارات وقطر والكويت وعُمان والبحرين قواعد شهاداتها الخاصة ولا تستخدم SABER.',
  },
  {
    q: 'هل ينطبق ISF على واردات الخليج؟',
    a: 'لا. ISF (إقرار أمن المستورد) برنامج أمريكي ولا ينطبق على واردات الخليج. الخطوة السعودية المكافئة للتقديم المسبق هي شهادة SABER SC بالإضافة إلى إقرار فسح قبل الوصول؛ وتستخدم الدول الخليجية الأخرى إقراراتها عبر النافذة الموحدة الخاصة بها.',
  },
  {
    q: 'أي سوق خليجية يجب أن أدخلها أولاً؟',
    a: 'يبدأ معظم المستوردين الجدد في الإمارات لأن جبل علي يوفر أكبر منافسة بين الناقلين، وضريبة قيمة مضافة 5%، وتأجيل رسوم المناطق الحرة، وسوق إعادة تصدير كبير. اختر السعودية للحجم وأكبر سوق استهلاكية رغم الضريبة الأعلى وبوابة SABER؛ واختر قطر أو الكويت لأدنى ضريبة حاليًا إذا كان تعقيد التخليص مقبولاً.',
  },
  {
    q: 'هل البحرين طريق أرخص للوصول إلى السعودية؟',
    a: 'ليس من ناحية الضريبة — ضريبة القيمة المضافة في البحرين 10% أقل من 15% في السعودية، لكن النقطة الحقيقية هي الجغرافيا. تدخل البحرين إلى شرق السعودية عبر جسر الملك فهد، لذا يمكن أن تكون بديلاً تشغيليًا لبضائع الدمام/الرياض عندما تكون جدة مزدحمة أو التوجيه السعودي المباشر مكلفًا. قارن التكلفة الإجمالية للوصول كاملة، بما في ذلك رحلة الجسر، قبل الاختيار.',
  },
  {
    q: 'ما المستندات التي أحتاجها للتخليص الجمركي في الخليج؟',
    a: 'المجموعة القياسية هي الفاتورة التجارية وقائمة التعبئة وبوليصة الشحن وشهادة المنشأ وتصنيف HS الصحيح، بالإضافة إلى شهادة SABER للبضائع السعودية الخاضعة للتنظيم. تضيف الكويت شهادة PAI لبعض المنتجات. أكد قائمة المستندات الحالية مع مخلص مرخص لرمز HS المحدد لديك.',
  },
  {
    q: 'هل المناطق الحرة معفاة من الضرائب في الإمارات؟',
    a: 'لا تخضع البضائع المحتفظ بها في منطقة حرة إماراتية للرسوم الجمركية حتى تدخل البر الرئيسي للإمارات أو سوق خليجية أخرى، وتكون إعادة التصدير من المنطقة الحرة معفاة من الرسوم. ولا تزال ضريبة القيمة المضافة تتبع القواعد العادية، وتأجيل الرسوم هو ميزة رأس المال العامل التي يجب أن يسعرها معظم المستوردين بوضوح.',
  },
  {
    q: 'كم يستغرق التخليص الجمركي في الخليج؟',
    a: 'توقيت التخليص غير منشور في اللقطة الموثقة ويختلف حسب الشحنة ورمز HS وجاهزية المستندات وسلطة الوجهة. إيقافات SABER في السعودية هي التأخير الأكثر شيوعًا والقابل للتجنب، لذا أكمل شهادة SC قبل الوصول بدلاً من الاعتماد على عدد أيام تخليص محدد.',
  },
  {
    q: 'أين يمكنني الحصول على تقييم دقيق للرسوم وضريبة القيمة المضافة؟',
    a: 'اطلب عرض سعر مفصلاً للتكلفة الإجمالية للوصول من مخلص خليجي مرخص مع رمز HS الدقيق وقيمة CIF والمنشأ والوجهة. الأرقام على هذه الصفحة هي معدلات الرسوم/ضريبة القيمة المضافة وحدود الإعفاء الجمركي الموثقة، وليست قرارًا تعريفيًا خاصًا بمنتج.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'مقارنة جمارك الصين إلى الخليج والرسوم الجمركية وضريبة القيمة المضافة (6 دول، 2026)',
      description:
        'مقارنة جنبًا إلى جنب لست دول حول الرسوم الجمركية على الواردات من الصين إلى الخليج وضريبة القيمة المضافة وحدود الإعفاء الجمركي والعملية الجمركية وامتثال SABER/SASO للسعودية والإمارات وقطر والكويت وعُمان والبحرين.',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="مقارنة جمارك الصين إلى الخليج والرسوم الجمركية وضريبة القيمة المضافة (6 دول، 2026)"
  description="مقارنة جنبًا إلى جنب لست دول حول الرسوم الجمركية على الواردات من الصين إلى الخليج وضريبة القيمة المضافة وحدود الإعفاء الجمركي والعملية الجمركية وامتثال SABER/SASO للسعودية والإمارات وقطر والكويت وعُمان والبحرين."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'مقارنة جمارك الخليج والرسوم وضريبة القيمة المضافة' },
        ]}
      />
      <span class="badge badge--amber">تحديث سبتمبر 2026</span>
      <h1>الجمارك والرسوم الجمركية وضريبة القيمة المضافة من الصين إلى الخليج</h1>
      <p class="lead">
        صفحة واحدة لمقارنة العبء الضريبي على التكلفة الإجمالية للوصول عبر الأسواق الخليجية الست — السعودية
        والإمارات وقطر والكويت وعُمان والبحرين — مع خط أساس الرسوم الموحد 5% من CIF، وضريبة القيمة المضافة
        لكل دولة، وحدود الإعفاء الجمركي، وبوابة SABER/SASO التي تفرضها السعودية وحدها.
      </p>
      <section class="section container">
        <blockquote class="tldr">
          <p>
