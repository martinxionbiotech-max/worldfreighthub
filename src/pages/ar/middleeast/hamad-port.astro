    a: 'نعم، يوجد في ميناء حمد منطقة حرة مجاورة مرتبطة بمنطقة الميناء. تعتمد معاملة المنطقة الحرة على قواعد المنطقة المحددة والنشاط التجاري، لذا يُرجى تأكيد الشروط مع مواني قطر والجهة المختصة قبل افتراض أي ميزة جمركية أو تنظيمية.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'ميناء حمد قطر — دليل الشحن من الصين: البوابة الحديثة، مدة النقل والتخليص (September 2026)',
      description:
        'معلومات استخباراتية عن ميناء حمد للشحن من الصين: البوابة التجارية الحديثة لقطر، تشغيل مواني قطر، بديل ميناء الدوحة، نوافذ النقل من الصين، مرافق الميناء وتخليص الرسوم الجمركية 5%.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
