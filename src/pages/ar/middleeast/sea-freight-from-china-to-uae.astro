      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="الشحن البحري من الصين إلى الإمارات: المسارات، مدة النقل 21 يومًا إلى جبل علي وسلسلة FCL من 12 خطوة (August 2026)"
  description="الشحن البحري من الصين إلى الإمارات: مسارات شنغهاي/نينغبو/شنتشن إلى جبل علي، مدة النقل النموذجية 21 يومًا، سلسلة FCL من 12 خطوة، رسوم THC وبوليصة الشحن، وضريبة القيمة المضافة 5%."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الشحن البحري من الصين إلى الإمارات' },
        ]}
      />
      <span class="badge badge--amber">محدث August 2026</span>
      <h1>الشحن البحري من الصين إلى الإمارات: المسارات، مدة النقل 21 يومًا إلى جبل علي وسلسلة FCL من 12 خطوة</h1>
      <p class="lead">
        يتركز ممر الشحن البحري بين الصين والإمارات على ميناء جبل علي، أكبر ميناء حاويات في الشرق
        الأوسط. تغطي هذه الصفحة مسارات شنغهاي / نينغبو / شنتشن، ومدة النقل النموذجية البالغة 21 يومًا،
        وسلسلة FCL الكاملة من الحجز إلى إعادة الحاوية الفارغة، ورسوم THC وبوليصة الشحن التي تخفيها
        معظم عروض الأسعار، وقواعد ضريبة القيمة المضافة 5% والرسوم الجمركية 5% التي تشكل التكلفة الإجمالية للوصول.
      </p>
      <p class="small muted">
        شارات الثقة تفصل الأرقام الموثقة عن البيانات السوقية الإرشادية. تعامل مع كل سعر أو مدة نقل
        أو رسوم بثقة LOW كأمر إرشادي، وتأكد مع الناقل قبل الاعتماد عليه.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">ضريبة القيمة المضافة على الاستيراد في الإمارات</span>
          <span class="fact-value">5% <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">الرسوم الجمركية الأساسية على الاستيراد</span>
          <span class="fact-value">5% CIF <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">شنغهاي → جبل علي</span>
          <span class="fact-value">21 days <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">سعر LCL الإرشادي</span>
          <span class="fact-value">AED 880–980/CBM <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">جبل علي</span>
          <span class="fact-value">مركز الشرق الأوسط <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">شنغهاي 2025</span>
          <span class="fact-value">55.06M TEU <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. الشحن البحري في لمحة: FCL وLCL</h2>
    <p>
      الشحن البحري هو الخيار الافتراضي للبضائع المتجهة إلى الإمارات التي لا تحتاج إلى الوصول خلال
      أيام. يأتي في شكلين. <strong>الشحن الكامل (FCL)</strong> يحجز حاوية كاملة 20 قدمًا أو 40 قدمًا
      ويُسعر لكل حاوية؛ <strong>الشحن الجزئي (LCL)</strong> يشارك المساحة مع مستوردين آخرين ويُسعر
      لكل CBM. بالنسبة لمعظم الكميات الثابتة، يمنح FCL أقل تكلفة للوحدة وأبسط مناولة؛ وبالنسبة
      للشحنات الصغيرة أو المختلطة، يتجنب LCL دفع ثمن حاوية فارغة.
    </p>

    <div class="grid grid--2 mt-2">
      <Card locale={locale} title="FCL هو الخيار الأنسب عادة عندما...">
        <ul>
          <li>حجمك يملأ معظم حاوية 20GP أو 40GP.</li>
          <li>البضائع كثيفة أو هشة أو عالية القيمة أو لا ينبغي خلطها.</li>
          <li>القدرة على التنبؤ بمدة النقل ووحدة مختومة أكثر أهمية.</li>
          <li>أنت مستورد راسخ بجدول زمني متكرر.</li>
        </ul>
      </Card>
      <Card locale={locale} title="LCL هو الخيار الأنسب عادة عندما...">
        <ul>
          <li>الشحنة صغيرة وأقل بكثير من حاوية كاملة.</li>
          <li>تختبر السوق الإماراتي أو تعيد تخزين وحدات SKU متنوعة.</li>
          <li>يمكنك تحمل وقت التجميع وإعادة التجزئة.</li>
          <li>تريد تجنب دفع ثمن مساحة حاوية غير مستخدمة.</li>
        </ul>
      </Card>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. أسعار الشحن البحري الإرشادية من الصين إلى الإمارات</h2>
      <p>
        تتغير أسعار الشحن البحري أسبوعيًا مع السعة والوقود والموسم الذروة، لذلك تصنف هذه الصفحة
        الأرقام السوقية عمدًا على أنها ثقة LOW بدلاً من تقديمها كأسعار مضمونة. يتركز ممر الإمارات
        على جبل علي، مما يمنح المستوردين خيارات جدولة واسعة — لكن سعر الشحن الرئيسي لا يزال بحاجة
        إلى التثبيت بعرض سعر شامل، وليس برقم معلن.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'service', label: 'الخدمة' },
          { key: 'benchmark', label: 'السعر الإرشادي' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
        ]}
        rows={rateRows}
        caption="بيانات سوقية إرشادية، وليست عروض أسعار من الناقل. لم تُنشر أسعار حاويات FCL إلى الإمارات في البيان الموثق — اطلب عرض سعر شامل."
      />
      <SourceList locale={locale} sources={rateSources} title="المصادر — أسعار الشحن البحري إلى الإمارات" />

      <div class="note mt-2">
        <strong>لماذا يظهر FCL كـ “اطلب عرض سعر”:</strong> نشر بيان البحث سعر LCL إرشادي وأرقامًا
        جوية لكنه لم ينشر أي سعر موثق لحاوية FCL إلى الإمارات. لا تستنتج أبدًا سعر الحاوية من رقم
        LCL — اطلب نوع المعدات والرسوم الإضافية ورسوم الوجهة مفصلة كتابيًا.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. فترات النقل البحري النموذجية: شنغهاي ونينغبو وشنتشن إلى جبل علي</h2>
    <p>
      تعطي بيانات المسار نفس <strong>المدة النموذجية 21 days</strong> مع نطاق 15–30 day لشنغهاي
      ونينغبو-تشوشان وشنتشن إلى جبل علي. هذا رقم تخطيط بثقة MEDIUM، بينما يذكر دليل سوق ثانوي نافذة
      أسرع 14–18 day تفترض إبحارًا مباشرًا دون تأخير. خطط على النطاق الأوسع وتعامل مع النافذة
      السريعة كأفضل حالة.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'lane', label: 'المسار' },
        { key: 'mode', label: 'النمط' },
        { key: 'transit', label: 'مدة النقل الإرشادية' },
        { key: 'basis', label: 'الأساس' },
        { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
      ]}
      rows={transitRows}
      caption="أرقام 21 يومًا النموذجية مصدرها بيانات مسارات WorldFreightHub؛ رقم ممر 14–18 day هو بيان ثانوي بثقة LOW. تأكد مع الناقل."
    />
    <SourceList locale={locale} sources={transitSources} title="المصادر — مدة النقل البحري" />

    <div class="note mt-2">
      <strong>مباشر مقابل إعادة الشحن:</strong> الإبحار المباشر من الصين إلى جبل علي هو أسرع مسار؛
      الحاوية المعاد شحنها تضيف نقطة مناولة محطة أخرى ويمكن أن توسع نطاق 15–30 day. جميع أرقام
      مدة النقل بثقة LOW/MEDIUM، تأكد مع الناقل.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. حاوية كاملة واحدة: سلسلة FCL من 12 خطوة من الحجز إلى التسليم المعتمد</h2>
      <p>
        سعر الشحن البحري هو التكلفة الأكثر وضوحًا، لكن السلسلة التشغيلية أدناه هي المكان الذي
        تنشأ فيه التأخيرات وغرامة التأخير ورسوم الاحتجاز. راجع كل خطوة قبل الحجز لتعرف أي طرف
        يتحملها وما هي المستندات أو الإجراءات التي تفتح الخطوة التالية.
      </p>

      <ol>
        <li><strong>عرض السعر والحجز:</strong> ثبّت نوع المعدات والمسار والإبحار وموعد القطع والسعر الشامل كتابيًا.</li>
        <li><strong>استلام الحاوية الفارغة:</strong> يفرج الناقل عن الحاوية وتُنقل بالشاحنة إلى موقع التحميل في الصين.</li>
        <li><strong>التعبئة وتخطيط الحمولة:</strong> تُحمّل البضائع وتُثبت وتُختتم؛ ويُخطط توزيع الوزن للسلامة.</li>
        <li><strong>VGM (الكتلة الإجمالية الموثقة):</strong> تُوثق الكتلة الإجمالية للحاوية المعبأة وتُقدم قبل الدخول إلى المحطة.</li>
        <li><strong>بيان التصدير الصيني:</strong> يقدم المصدر بيان التصدير الجمركي وأي مستندات صينية مطلوبة.</li>
        <li><strong>الدخول إلى المحطة والتسليم:</strong> تُقبل الحاوية في المحطة مقابل الحجز.</li>
        <li><strong>التحميل والإبحار:</strong> تُحمّل الحاوية على السفينة ويبدأ الإبحار.</li>
        <li><strong>مدة النقل البحري:</strong> تنتقل الحاوية عبر المسار المخطط إلى الإمارات.</li>
        <li><strong>الوصول والتفريغ:</strong> ترسو السفينة وتُفرغ الحاوية في جبل علي أو خليفة أو الشارقة.</li>
        <li><strong>التخليص الجمركي للاستيراد في الإمارات:</strong> يقدم المرسل إليه أو المخلص الجمركي بيان الاستيراد، ويدفع الرسوم الجمركية وضريبة القيمة المضافة عند استحقاقها، ويفرج عن الحاوية.</li>
        <li><strong>التسليم النهائي:</strong> تُنقل الحاوية بالشاحنة إلى مستودع الإمارات أو المنطقة الحرة أو عنوان المرسل إليه.</li>
        <li><strong>إعادة الحاوية الفارغة:</strong> تُعاد الحاوية فارغة خلال المهلة المسموحة من الناقل لوقف رسوم الاحتجاز.</li>
      </ol>

      <p class="mt-2">
        الخطوتان الأكثر تسببًا في التكاليف عادة هما الخطوة 10 (سرعة التخليص) والخطوة 12 (إعادة
        الحاوية الفارغة). إذا تجاوزت أي منهما فترة السماح، تبدأ غرامة التأخير أو رسوم الاحتجاز.
        جهز المستندات قبل الوصول واحجز النقل البري قبل التفريغ.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>5. الموانئ والمسارات الرئيسية من الصين إلى الإمارات</h2>
    <p>
      شنغهاي ونينغبو-تشوشان وشنتشن هي بوابات المنشأ الرئيسية في بيانات المسار، مع ذكر قوانغتشو أيضًا
      في أدلة الشحن إلى الإمارات. في الطرف الإماراتي، جبل علي هو الوجهة المهيمنة للحاويات، بينما
      يخدم ميناء خليفة في أبوظبي وميناء خالد في الشارقة إماراتهم المعنية.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'port', label: 'الميناء الصيني' },
        { key: 'throughput', label: 'حمولة 2025' },
        { key: 'note', label: 'ملاحظة المسار' },
        { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
      ]}
      rows={chinaPortRows}
      caption="أرقام شنغهاي ونينغبو-تشوشان موثقة؛ لم تُذكر حمولة شنتشن وقوانغتشو في بيان البحث."
    />
    <SourceList locale={locale} sources={chinaPortSources} title="المصادر — الموانئ الصينية" />

    <h3 class="mt-3">موانئ الوجهة في الإمارات</h3>
    <p>
      <strong>جبل علي</strong>، الذي تديره موانئ دبي العالمية، هو أكبر ميناء حاويات في الشرق الأوسط
      ويجمع بين قدرة المياه العميقة ومنطقة حرة كبيرة واتصال بري وبحري قوي. وهذا يجعله نقطة تجميع
      وإعادة شحن طبيعية لدول مجلس التعاون الخليجي والشرق الأوسط وأفريقيا وشبه القارة الهندية وليس
      مجرد بوابة لدبي.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'factor', label: 'العامل' },
        { key: 'jebelAli', label: 'جبل علي' },
        { key: 'khalifa', label: 'ميناء خليفة أبوظبي' },
        { key: 'sharjah', label: 'ميناء خالد (الشارقة)' },
        { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
      ]}
      rows={uaePortRows}
      caption="أدوار الموانئ هي نتائج مصادر ثانوية؛ تأكد من ميناء التفريغ ومرحلة التسليم النهائية مع وكيل الشحن."
    />
    <SourceList locale={locale} sources={uaePortSources} title="المصادر — موانئ الإمارات" />

    <div class="note mt-2">
      <strong>المسار في سطر واحد:</strong> طابق ميناء التفريغ مع المرسل إليه. جبل علي مناسب لمعظم
      وجهات دبي والإمارات الشمالية، وخليفة مناسب لأبوظبي، وميناء خالد مناسب للشارقة والإمارات
      الشمالية. سعر الشحن الأرخص في الميناء الخطأ يمكن أن يصبح أكثر تكلفة بعد النقل البري الداخلي.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. البحري مقابل الجوي: متى يظل المحيط هو الإجابة الصحيحة</h2>
      <p>
        الإمارات ممر قصير بما يكفي ليكون الشحن الجوي مغريًا، لكن الشحن البحري يتفوق بشكل حاسم على
        تكلفة الوحدة للبضائع كبيرة الحجم. المقارنة هي قرار بشأن التكلفة الإجمالية للوصول وأولوية
        التسليم وليس مجرد سباق سرعة.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'العامل' },
          { key: 'sea', label: 'الشحن البحري' },
          { key: 'air', label: 'الشحن الجوي' },
          { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
        ]}
        rows={seaVsAirRows}
        caption="مدة النقل والأسعار الإرشادية بثقة LOW؛ الامتثال للرسوم الجمركية وضريبة القيمة المضافة في الإمارات هو نفسه لكلا النمطين."
      />
      <SourceList locale={locale} sources={airSources} title="المصادر — مقارنة الشحن الجوي" />
    </div>
  </section>

  <section class="section container">
    <h2>7. مكونات تكلفة الشحن البحري: الرسوم التي يتجاهلها المنافسون</h2>
    <p>
      سعر الشحن البحري هو سطر واحد فقط. رسم مناولة المحطة (THC)، والمستندات، ورسوم بوليصة الشحن،
      وغرامة التأخير ورسوم الاحتجاز تقع فوقه، ولم تُنشر أي من هذه المبالغ في بيان البحث الموثق.
      رقم المقارنة الصحيح هو عرض سعر شامل مفصل.
    </p>

    <h3>غرامة التأخير ورسوم الاحتجاز</h3>
    <p>
      <strong>غرامة التأخير (Demurrage)</strong> تفرضها المحطة عندما تبقى الحاوية داخل الميناء بعد
      فترة السماح عقب التفريغ. <strong>رسوم الاحتجاز (Detention)</strong> يفرضها الناقل عندما تبقى
      الحاوية خارج الميناء بعد فترة السماح قبل إعادتها. لم تُنشر فترات السماح والرسوم اليومية في
      البيان وتختلف حسب المحطة والخط الملاحي — اطلبها مع عرض السعر.
    </p>

    <h3 class="mt-3">هيكل تكلفة الشحن البحري الكامل</h3>
    <DataTable locale={locale}
      columns={[
        { key: 'item', label: 'مكون التكلفة' },
        { key: 'who', label: 'الجهة التي تفرضه' },
        { key: 'magnitude', label: 'النطاق الإرشادي' },
        { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
      ]}
      rows={costRows}
      caption="فقط ضريبة القيمة المضافة (5%) والرسوم الأساسية (5% CIF) موثقة. الرسوم غير المحددة الكمية بثقة LOW لأن بيان البحث لم ينشر مبالغ محددة — اطلب جدول رسوم."
    />
    <SourceList locale={locale} sources={costSources} title="المصادر — تكلفة الشحن البحري وجمارك الإمارات" />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>8. الموسم الذروة والعوامل التي تحرك أسعار الشحن البحري</h2>
      <p>
        أسعار الشحن البحري لمسار الصين–الإمارات ليست مستقرة. الموسم الذروة، وتعديلات الوقود،
        وقرارات المسار كلها تحرك السعر الشامل حتى عندما يبدو السعر الأساسي دون تغيير. تعامل مع
        اتجاه كل عامل أدناه كإشارة تخطيط، وليس كتنبؤ.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'العامل' },
          { key: 'effect', label: 'التأثير' },
          { key: 'direction', label: 'الاتجاه' },
          { key: 'confidence', label: 'مستوى الثقة', type: 'confidence' },
        ]}
        rows={factorRows}
        caption="عوامل تخطيط اتجاهية، وليست قواعد تسعير. تأكد من الرسوم الإضافية الحالية وفترات السماح والمسار مع وكيل الشحن."
      />

      <div class="note mt-2">
        <strong>احجز مقابل مواعيد القطع، وليس “في وقت ما هذا الأسبوع”:</strong> تفويت موعد قطع
        السفينة يؤجل البضاعة إلى الإبحار التالي ويمكن أن يدفع التسليم إلى ما بعد خطة فترة السماح.
        اطلب موعد القطع وموعد VGM وموعد المستندات مع عرض السعر.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>9. الامتثال: ضريبة القيمة المضافة والرسوم الجمركية والمستندات ورموز HS للشحن البحري إلى الإمارات</h2>

    <h3>الضريبة والرسوم الجمركية</h3>
    <p>
      ضريبة القيمة المضافة على الاستيراد في الإمارات هي <strong>5%</strong>، التي
      طُبقت في 1 January 2018، وتُحسب على قيمة CIF <em>بالإضافة إلى</em> الرسوم الجمركية. الرسوم
      الجمركية الأساسية على الاستيراد هي <strong>5% من CIF</strong> بموجب التعريفة
      الجمركية الموحدة لدول مجلس التعاون الخليجي، مع إمكانية تطبيق رسوم حماية أو رسوم مكافحة إغراق
      أعلى على سلع محددة — يذكر مصدر ثانوي أمثلة تصل إلى 35% على بعض المنتجات. تأكد من
      كلا الرقمين وتصنيف منتجك مع الهيئة الاتحادية للضرائب وجمارك دبي قبل الاعتماد عليهما.
    </p>

    <h3>المنطقة الحرة مقابل البر الرئيسي</h3>
    <p>
      يمكن للمناطق الحرة الإماراتية المخصصة تعليق الرسوم الجمركية طالما بقيت البضائع داخل المنطقة
      واستوفى المستورد شروط المنطقة؛ معاملة ضريبة القيمة المضافة لا تزال تعتمد على الكيان والموقع
      وهيكل المعاملة. البضائع المخلصة للبر الرئيسي تخضع عادة لرسوم 5% وضريبة القيمة
      المضافة 5% على أساس CIF بالإضافة إلى الرسوم. تأكد من المعاملة لكيانك المحدد
      ووجهتك النهائية.
    </p>

    <h3>المستندات والتصنيف</h3>
    <p>
      المستندات القياسية هي الفاتورة التجارية وبوليصة الشحن وقائمة التعبئة وشهادة المنشأ. صنف
      البضائع برمز <strong>HS</strong> الصحيح قبل عرض السعر، لأن الرسوم الجمركية وأي متطلبات
      مطابقة تعتمد عليه. لاحظ أن <strong>SABER</strong> هي منصة مطابقة سعودية ولا تنطبق على
      الإمارات؛ بالنسبة للإمارات، تأكد مما إذا كان منتجك يحتاج إلى شهادة مطابقة من الجهة المختصة.
    </p>

