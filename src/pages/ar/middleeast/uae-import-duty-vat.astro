    a: 'توثق البيانات البحثية حد إعفاء جمركي من مصدر ثانوي بقيمة AED 1,000 لشحنات البريد السريع الشخصية وAED 3,000 للهدايا، بالإضافة إلى معاملات محتملة بنسبة صفر أو إعفاءات لفئات محددة. تعتمد المعاملة التفضيلية للرسوم على المنشأ وشهادة المنشأ. تأكد من الثلاثة مع الهيئة الاتحادية للضرائب أو جمارك دبي للبضائع المحددة قبل الاعتماد عليها.',
  },
  {
    q: 'هل هناك حد الإعفاء الجمركي في الإمارات؟',
    a: 'تسجل المصادر الثانوية أن البضائع التي تبلغ قيمتها AED 1,000 أو أقل معفاة من الرسوم/الضرائب والهدايا حتى AED 3,000 معفاة. هذا رقم من مصدر ثانوي، لذا تأكد من الحد الحالي مع جمارك دبي أو الهيئة الاتحادية للضرائب، خاصةً للطرود التجارة الإلكترونية منخفضة القيمة.',
  },
  {
    q: 'ما الفرق بين DDP ودفع رسوم الإمارات وضريبة القيمة المضافة بنفسي؟',
    a: 'الدفع الذاتي يُبقي المستورد هو المكلف مع رؤية كاملة بالبنود في مرسال 2 وإمكانية محاسبة التحويل العكسي للمستورد المسجل لضريبة القيمة المضافة. DDP ينقل الدفع إلى البائع أو وكيل الشحن ويجمعه في سعر واحد شامل. معدلات الرسوم وضريبة القيمة المضافة الأساسية لا تتغير — فقط من يدفع، ومدى شفافية الضريبة، وكيفية تنظيم التدفق النقدي.',
  },
  {
    q: 'هل تفرض الإمارات ضريبة انتقائية على البضائع المستوردة؟',
    a: 'تطبق الإمارات ضريبة انتقائية على سلع محددة بالإضافة إلى تسلسل الرسوم وضريبة القيمة المضافة العادي، لكن البيانات البحثية الموثقة لا تنشر معدلات الضريبة الانتقائية الإماراتية. تعامل مع المعاملة الانتقائية بثقة LOW وتأكد من المعدلات الحالية لرموز HS الخاصة بك مع الهيئة الاتحادية للضرائب قبل إنهاء عرض سعر التكلفة الإجمالية للوصول.',
  },
  {
    q: 'أين يجب أن أتحقق من معدلات الرسوم الجمركية وضريبة القيمة المضافة الحالية في الإمارات؟',
    a: 'تحقق من الهيئة الاتحادية للضرائب (FTA) ومن أداة البحث الجمركي الحالية لجمارك دبي لرمز HS الخاص بك. الأرقام في هذه الصفحة من بيانات بحثية مؤرخة؛ المعدلات والإعفاءات والمعاملة الانتقائية قابلة للتغيير ويجب إعادة التحقق منها قبل بناء عرض سعر نهائي للتكلفة الإجمالية للوصول.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
