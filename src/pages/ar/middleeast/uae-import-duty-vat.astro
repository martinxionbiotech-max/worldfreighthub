const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الرسوم الجمركية وضريبة القيمة المضافة في الإمارات: التكلفة الإجمالية للوصول CIF × 1.05 × 1.05 (August 2026)',
      description:
        'كيف تتراكم الرسوم الجمركية الإماراتية (5% CIF) وضريبة القيمة المضافة (5% على CIF + الرسوم): صيغة التكلفة الإجمالية للوصول، مثال عملي بقيمة CIF 1,000 دولار أمريكي، التحويل العكسي لضريبة القيمة المضافة، المنطقة الحرة مقابل البر الرئيسي، رموز HS و DDP مقابل الدفع الذاتي.',
      datePublished: '2026-08-31',
