    a: 'الشويخ (KWSWK) هو البوابة التجارية وللحاويات المذكورة عادةً لمدينة الكويت، بينما ترتبط الشعيبة (KWSHB) عادةً بالممر الصناعي والبتروكيماوي جنوب مدينة الكويت. قدرات المحطات الدقيقة ومزيج البضائع غير منشورة في البيانات الموثقة، لذا تعامل مع تقسيم الأدوار كدليل تخطيط بثقة LOW وتحقق مع سلطة الميناء أو شركة الملاحة.',
  },
  {
    q: 'من يدير موانئ الكويت؟',
    a: 'تخضع موانئ الكويت لإشراف مؤسسة الموانئ الكويتية، مع تشغيل المحطات والخدمات من قبل مشغلي الموانئ ومقدمي الخدمات. لا تنشر بيانات البحث الموثقة المشغل المحدد أو تخصيص المحطة أو الأرصفة أو الطاقة الاستيعابية، لذا اطلب التفاصيل التشغيلية الحالية من سلطة الميناء أو وكيل الشحن الخاص بك.',
  },
  {
    q: 'كم تستغرق مدة الشحن البحري من الصين إلى الشويخ؟',
    a: 'تسجل بيانات مسار WorldFreightHub مدة نموذجية 24 days مع نطاق تخطيط 15–30 day من شنغهاي أو نينغبو-تشوشان أو شنتشن إلى الشويخ (بثقة LOW، لأن بيانات المسار تقديرية). تحقق من مدة النقل مع شركة الملاحة قبل الاعتماد على الرقم.',
  },
  {
    q: 'كم تستغرق مدة الشحن البحري من الصين إلى الشعيبة؟',
    a: 'لا توجد مدة نقل بحري موثقة خاصة بالشعيبة منشورة في بيانات البحث. اطلب مدة نقل خاصة بشركة الملاحة بدلاً من افتراض أن تقدير 24 يوماً للشويخ ينطبق تلقائياً على الشعيبة.',
  },
  {
    q: 'ما هي الرسوم الجمركية وضريبة القيمة المضافة المطبقة في الموانئ الكويتية؟',
    a: 'الرسوم الجمركية الأساسية هي 5% من قيمة CIF بموجب التعريفة الجمركية الموحدة لدول مجلس التعاون الخليجي. لا توجد ضريبة قيمة مضافة عامة في الكويت في الإطار الحالي، لذا فإن الرسوم القانونية الرئيسية للاستيراد هي رسوم 5%. يمكن أن تختلف بنود الرسوم حسب رمز HS المحدد، لذا صنف البضاعة قبل تقديم عرض السعر.',
  },
  {
    q: 'ما هي المستندات المطلوبة للتخليص في الشويخ أو الشعيبة؟',
    a: 'المجموعة القياسية هي الفاتورة التجارية وبوليصة الشحن وقائمة التعبئة وشهادة المنشأ، مع رموز HS الصحيحة ومعلومات بلد المنشأ. قد تتطلب السلع المقيدة ترخيص استيراد أو تصريحاً قبل الوصول.',
  },
  {
    q: 'كيف تعمل غرامة التأخير ورسوم الاحتجاز في الموانئ الكويتية؟',
    a: 'تُفرض غرامة التأخير من قبل المحطة عندما تبقى الحاوية المستوردة داخل الميناء بعد فترة السماح التالية للتفريغ. تُفرض رسوم الاحتجاز من قبل شركة الملاحة البحرية عندما تبقى الحاوية خارج الميناء بعد فترة السماح. لم يتم نشر أيام السماح والمبالغ اليومية الكويتية في البيانات، لذا اطلب جدول الرسوم واحجز النقل البري قبل التفريغ.',
  },
  {
    q: 'هل توجد منطقة حرة في الشويخ أو الشعيبة؟',
    a: 'لدى الكويت نشاط مناطق حرة ومرتبط باللوجستيات، لكن بيانات البحث الموثقة لا تنشر أي معاملة منطقة حرة مرتبطة بشحنة محددة في الشويخ أو الشعيبة. لا تفترض نمط المنطقة الحرة في الإمارات أو قطر؛ أكد قواعد المنطقة ونقطة التفريغ مع الجمارك الكويتية والسلطة المختصة.',
  },
  {
    q: 'هل SABER أو SASO مطلوبان للشحنات إلى الكويت؟',
    a: 'لا. SABER وSASO نظاما مطابقة سعوديان فقط. لا تنسخ خطوة SABER/SASO السعودية إلى استيراد كويتي. قد يكون للكويت معايير أو متطلبات فحص خاصة بها لبعض المنتجات، لكنها غير منشورة في البيانات الموثقة — أكد العملية المطبقة مع الجمارك الكويتية والسلطة الكويتية المختصة.',
  },
  {
    q: 'أي ميناء كويتي يجب أن أستخدمه للواردات الصينية؟',
    a: 'استخدم الشويخ كخيار تخطيط افتراضي للبضائع العامة المعبأة في حاويات والتجارية المتجهة إلى مدينة الكويت. فكر في الشعيبة عندما تكون البضاعة صناعية أو بتروكيماوية أو سائبة أو مرتبطة بمشاريع والممر الجنوبي أنسب. نظراً لأن البيانات لا تنشر قدرات مستوى المحطات، يجب تأكيد الاختيار النهائي مع شركة الملاحة والمستلم.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الموانئ الكويتية — معلومات الشويخ والشعيبة: التوجيه من الصين ومدة النقل والتخليص (September 2026)',
      description:
        'معلومات الموانئ الكويتية للشحن من الصين: الشويخ (KWSWK) مقابل الشعيبة (KWSHB)، أدوار الموانئ، نوافذ النقل من الصين، التخليص برسوم 5% وقرار التوجيه بين الميناءين.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="الموانئ الكويتية — معلومات الشويخ والشعيبة: التوجيه من الصين ومدة النقل والتخليص (September 2026)"
  description="معلومات الموانئ الكويتية للشحن من الصين: الشويخ (KWSWK) مقابل الشعيبة (KWSHB)، أدوار الموانئ، نوافذ النقل من الصين، التخليص برسوم 5% وقرار التوجيه بين الميناءين."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الموانئ الكويتية' },
        ]}
      />
      <span class="badge badge--amber">محدث September 2026</span>
      <h1>الموانئ الكويتية: معلومات الشويخ والشعيبة للشحن من الصين</h1>
      <p class="lead">
        صفحة معلومات موانئ للشاحنين الذين يوجهون البضائع من الصين إلى الكويت. تشرح هذه الصفحة
        قرار الشويخ مقابل الشعيبة، ورمزي UN/LOCODE، وأدوار الموانئ ومنطق الشبكة البرية الخلفية،
        ومدة النقل البحري من الصين، وشكل تكاليف الوجهة، وقواعد التخليص برسوم 5%
        المطبقة عند البوابة الكويتية.
      </p>
      <p class="small muted">
        تفصل شارات الثقة رموز الموانئ الموثقة وأساس رسوم/VAT دول مجلس التعاون الخليجي عن ملاحظات
        التوجيه والرسوم الاسترشادية. تعامل مع كل ملاحظة ميناء أو مدة نقل أو رسوم بثقة LOW كدليل
        تخطيط، وتحقق مع سلطة الموانئ الكويتية أو شركة الملاحة قبل الاعتماد عليها.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">الموانئ</span>
          <span class="fact-value">الشويخ / الشعيبة <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">UN/LOCODE</span>
          <span class="fact-value">{shuwaikhUnlocode} / {shuaibaUnlocode} <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">نوع الميناء</span>
          <span class="fact-value">موانئ بحرية <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">مدة النقل البحري من الصين</span>
          <span class="fact-value">نموذجي 24 days <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">الرسوم الأساسية</span>
          <span class="fact-value">5% CIF <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">ضريبة القيمة المضافة العامة</span>
          <span class="fact-value">لا توجد <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. لماذا تهم خريطة الميناءين في الكويت للشحن من الصين</h2>
    <p>
      الكويت اقتصاد خليجي صغير يعتمد على النفط، لكنها تفتقر إلى بساطة البوابة الواحدة مثل ميناء حمد
      في قطر أو حجم جبل علي في دبي. قبل حجز أي شحنة من الصين إلى الكويت، يواجه المستورد سؤال توجيه
      حقيقياً: <strong>الشويخ أم الشعيبة؟</strong> يغير الاختيار المسافة البرية وملاءمة البضاعة
      والتعرض لرسوم الوجهة.
    </p>
    <p>
      البوابة التجارية المذكورة عادةً هي <strong>الشويخ</strong>، القريبة من مدينة الكويت، بينما
      <strong>الشعيبة</strong> هي الميناء الذي يجب النظر فيه للبضائع الصناعية والبتروكيماوية والسائبة
      ومرتبطة بالمشاريع في الجنوب. لكل منهما رمز UN/LOCODE خاص، لكن البيانات الموثقة لا تنشر
      الأرصفة أو الغاطس أو الرافعات أو الطاقة الاستيعابية أو المشغلين أو الرسوم. وجه الشحنة بمنطق،
      ثم اطلب الحقائق التشغيلية من سلطة الميناء وشركة الملاحة.
    </p>
    <p>
      الجانب القانوني أبسط: تستخدم الكويت أساس <strong>رسوم جمركية 5% على قيمة CIF</strong>
      من التعريفة الموحدة لدول مجلس التعاون الخليجي، بدون ضريبة قيمة مضافة عامة. لذلك يأتي التباين
      الحقيقي في التكلفة النهائية من اختيار الميناء ورسوم المحطات والانضباط في التخليص وغرامة
      التأخير/رسوم الاحتجاز — المجالات التي تبقيها هذه الصفحة واضحة.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. معايير الموانئ الكويتية</h2>
      <p>
        استخدم هذا الجدول كتوجيه أولي، وليس كدليل محطات. الدولة ورموز الموانئ وأساس رسوم/VAT دول
        مجلس التعاون الخليجي هي المرتكزات الموثقة؛ تقسيم الأدوار والمشغل والأرصفة والطاقة الاستيعابية
        محددة بثقة LOW لأن البيانات الموثقة لا تنشر تفاصيل سلطة الموانئ الكويتية.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'parameter', label: 'المعيار' },
          { key: 'value', label: 'القيمة' },
          { key: 'note', label: 'ملاحظة تخطيط' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={parameterRows}
        caption="معايير الموانئ الكويتية — رموز UN/LOCODE وأساس رسوم/VAT دول مجلس التعاون الخليجي هي المرتكزات HIGH/MEDIUM؛ التفاصيل التشغيلية والأدوار بثقة LOW وتتطلب تأكيداً من سلطة الميناء."
      />
      <SourceList locale={locale} sources={portFactSources} title="المصادر — معايير الموانئ الكويتية" />

      <div class="note mt-2">
        <strong>بضائع حساسة للقدرة:</strong> إذا كانت شحنتك تعتمد على رصيف محدد أو غاطس أو قدرة
        رافعة أو توفر رفع ثقيل أو نافذة محطة أو فئة مناولة منتج، اطلب الجدول الزمني والقيود الحالية
        من سلطة الموانئ الكويتية أو وكيل الشحن قبل الحجز. البيانات الموثقة لا توفر قيوداً لكل رصيف.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. نوافذ النقل من الصين إلى الموانئ الكويتية</h2>
    <p>
      النقل إلى الكويت هو نطاق تخطيط وليس وعداً. تعطي بيانات المسار للشويخ مدة نموذجية
      24 days مع نطاق 15–30 day، بثقة LOW. مدة النقل البحري للشعيبة والنقل الجوي
      للكويت غير منشورين، لذا يبقي الجدول هذه البنود واضحة بدلاً من استعارة رقم ممر آخر.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'origin', label: 'المنشأ' },
        { key: 'service', label: 'الخدمة' },
        { key: 'transit', label: 'مدة النقل الاسترشادية' },
        { key: 'basis', label: 'الأساس' },
        { key: 'confidence', label: 'الثقة', type: 'confidence' },
      ]}
      rows={transitRows}
      caption="نوافذ نقل استرشادية فقط — تحقق مع شركة الملاحة المعنية قبل الاعتماد على هذه الأرقام."
    />
    <SourceList locale={locale} sources={transitSources} title="المصادر — أوقات النقل من الصين إلى الموانئ الكويتية" />

    <div class="note mt-2">
      <strong>من ميناء إلى ميناء مقابل باب الكويت:</strong> مدة بحرية نموذجية 24 يوماً إلى الشويخ
      ليست الوقت الإجمالي إلى عنوان في مدينة الكويت. أضف التفريغ والتخليص الجمركي الكويتي وأي فحص
      والنقل البري للمرحلة الأخيرة قبل الالتزام بموعد التسليم.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. معايير أسعار FCL / LCL وقرار الحجم</h2>
      <p>
        أسعار FCL وLCL الكويتية غير منشورة في البيانات الموثقة، لذا يعرض الجدول أدناه "اطلب عرض
        سعر شامل" بدلاً من نطاق دولاري مخصص. الرقم الوحيد للممر هو تقدير 24 يوماً بحرياً للشويخ،
        بثقة LOW.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'service', label: 'الخدمة' },
          { key: 'benchmark', label: 'المعيار الاسترشادي' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={rateRows}
        caption="أسعار FCL/LCL الكويتية غير منشورة في البيانات الموثقة — اطلب عرض سعر شامل بدلاً من استخدام معيار مخصص."
      />
      <SourceList locale={locale} sources={rateSources} title="المصادر — أسعار FCL/LCL الكويتية" />

      <h3 class="mt-3">إرشادات FCL مقابل LCL</h3>
      <p>
        نقطة التحول اتجاهية لأن أياً من السعرين غير منشور. يصبح FCL الخيار المعتاد مع اقتراب الشحنة
        من حصة كبيرة من الحاوية؛ يناسب LCL الكميات الصغيرة التي لن تملأ حاوية. اطلب عرضي سعر شاملين
        لنفس نقطة الوجهة قبل اتخاذ القرار.
      </p>
      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'عامل القرار' },
          { key: 'fcl', label: 'FCL' },
          { key: 'lcl', label: 'LCL' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={fclLclRows}
        caption="إرشادات FCL مقابل LCL اتجاهية؛ معايير FCL وLCL الكويتية غير منشورة في البيانات الموثقة."
      />
      <SourceList locale={locale} sources={modeSources} title="المصادر — إرشادات FCL مقابل LCL" />
    </div>
  </section>

  <section class="section container">
    <div class="container">
      <h2>5. مناشئ الصين وخريطة الوجهة الكويتية</h2>
      <p>
        ترسو شنغهاي ونينغبو-تشوشان خدمات المحيط من شرق الصين؛ تغطي شنتشن وقوانغتشو جنوب الصين، بينما
        تخدم تشينغداو وتيانجين وشيامن الموردين الشماليين ومن فوجيان. على الجانب الكويتي، تتكون خريطة
        الوجهة من ميناءين بحريين — الشويخ (KWSWK) والشعيبة (KWSHB) — بالإضافة إلى مطار الكويت الدولي
        للشحن الجوي.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'port', label: 'ميناء المنشأ الصيني' },
          { key: 'throughput', label: 'الطاقة الاستيعابية' },
          { key: 'note', label: 'ملاحظة تخطيط' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={chinaOriginRows}
        caption="سياق موانئ المنشأ الصينية. أرقام الطاقة الاستيعابية لشنغهاي ونينغبو-تشوشان بثقة HIGH؛ المناشئ الأخرى مذكورة على الممر لكن طاقتها الاستيعابية غير محددة في البيانات."
      />
      <SourceList locale={locale} sources={chinaPortSources} title="المصادر — موانئ المنشأ الصينية" />

      <div class="note mt-2">
        <strong>رموز الوجهة الكويتية:</strong> الشويخ هو {shuwaikhUnlocode} والشعيبة هو
        {shuaibaUnlocode}. استخدم رمز UN/LOCODE الدقيق على بوليصة الشحن حتى لا تصل البضاعة
        إلى الجانب الخطأ من خيار الميناءين.
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. الشويخ مقابل الشعيبة: قرار التوجيه</h2>
      <p>
        سؤال الشويخ/الشعيبة هو المعادل الكويتي لخيار جدة مقابل الدمام في السعودية. إنه قرار ملاءمة
        البضاعة والمسافة البرية، وليس اختلافاً شكلياً في التسمية. الشويخ هو الخيار الافتراضي للتخطيط
        للبضائع التجارية العامة والمعبأة في حاويات بالقرب من مدينة الكويت، بينما الشعيبة هو الخيار
        الافتراضي للبضائع الصناعية والبتروكيماوية والسائبة والمشاريع في الممر الجنوبي. أكد نقطة
        التفريغ النهائية مع شركة الملاحة والمستلم قبل إصدار بوليصة الشحن.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'scenario', label: 'السيناريو' },
          { key: 'bestChoice', label: 'البوابة الأنسب' },
          { key: 'why', label: 'لماذا' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
