  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الشحن البحري مقابل الجوي من الصين إلى الإمارات' },
        ]}
      />
      <span class="badge badge--amber">تحديث August 2026</span>
