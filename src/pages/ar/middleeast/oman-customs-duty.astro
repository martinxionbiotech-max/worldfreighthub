  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'دليل التخليص الجمركي ورسوم الاستيراد في عُمان: رسوم CIF × 1.1025 + ضريبة القيمة المضافة 5% (September 2026)',
      description:
        'دليل التخليص الجمركي ورسوم الاستيراد في عُمان: رسوم CIF الأساسية بنسبة 5%، ضريبة القيمة المضافة 5%، تقديم بيان، المستندات المطلوبة، معاملة رمز HS، البضائع المقيدة ومثال التكلفة الإجمالية للوصول CIF × 1.1025.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout locale={locale}
  title="دليل التخليص الجمركي ورسوم الاستيراد في عُمان: رسوم CIF × 1.1025 + ضريبة القيمة المضافة 5% (September 2026)"
  description="دليل التخليص الجمركي ورسوم الاستيراد في عُمان: رسوم CIF الأساسية بنسبة 5%، ضريبة القيمة المضافة 5%، تقديم بيان، المستندات المطلوبة، معاملة رمز HS، البضائع المقيدة ومثال التكلفة الإجمالية للوصول CIF × 1.1025."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale}
        items={[
          { label: t(locale, 'nav.middleeast'), href: '/ar/middleeast/' },
          { label: 'الجمارك ورسوم الاستيراد في عُمان' },
        ]}
      />
      <span class="badge badge--amber">مُحدّث September 2026</span>
      <h1>التخليص الجمركي ورسوم الاستيراد في عُمان: رسوم CIF × 1.1025 + ضريبة القيمة المضافة 5%</h1>
      <p class="lead">
        موجز جمركي للواردات من الصين إلى عُمان: أساس رسوم CIF بنسبة 5%، طبقة ضريبة القيمة المضافة بنسبة 5%،
        التقديم الإلكتروني عبر نظام بيان العُماني، مجموعة المستندات، معاملة رمز HS، البضائع المقيدة/المحظورة،
        والحساب الذي يحول قيمة CIF إلى تكلفة وصول قانونية.
      </p>
      <p class="small muted">
        شارات الثقة تفصل القواعد الموثقة عن الرسوم التشغيلية الاسترشادية. رسوم 5% الجمركية و
        ضريبة القيمة المضافة بنسبة 5% بثقة متوسطة؛ مبالغ الوساطة والمعالجة والتخزين غير منشورة في
        اللقطة الموثقة ويجب طلبها كجدول رسوم مفصل.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">الرسوم الجمركية الأساسية على الاستيراد</span>
          <span class="fact-value">5% من CIF <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">ضريبة القيمة المضافة</span>
          <span class="fact-value">5% <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">نظام التخليص</span>
          <span class="fact-value">بيان <ConfidenceBadge locale={locale} level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">الجهة المختصة</span>
          <span class="fact-value">الجمارك العُمانية <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER / SASO</span>
          <span class="fact-value">خاص بالسعودية فقط <ConfidenceBadge locale={locale} level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">التكلفة القانونية</span>
          <span class="fact-value">CIF × 1.1025 <ConfidenceBadge locale={locale} level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. نظرة عامة على الضرائب في عُمان</h2>
    <p>
      عُمان هي الدولة الخليجية التي تجمع بين <strong>رسوم جمركية بنسبة 5% على قيمة CIF</strong> بموجب
      التعريفة الجمركية الموحدة لدول مجلس التعاون الخليجي مع <strong>ضريبة قيمة مضافة بنسبة 5%</strong> على الأساس الشامل للرسوم.
      وهذا يجعل التكلفة القانونية الأساسية للوصول:
    </p>
    <div class="note">
      <strong>الإجمالي قبل الرسوم التشغيلية = CIF × 1.05 × 1.05 = CIF × 1.1025.</strong><br />
      قيمة CIF البالغة 10,000 دولار أمريكي تخضع لرسوم 500 (← 10,500)، ثم ضريبة قيمة مضافة بنسبة 5% بقيمة 525، ليصبح الإجمالي 11,025
      قبل رسوم الوجهة.
    </div>
    <p class="mt-2">
      الحقيقة التشغيلية هي أن "طبقتين بنسبة خمسة بالمائة" ليسا مثل "تخليص بسيط".
      لدى عُمان قواعدها الخاصة للبضائع المحظورة/المقيدة، ونظام المطابقة الخاص بها
      (المتميز عن SABER/SASO السعودي) وتدفق تخليص إلكتروني عبر نظام بيان، لذا يتركز الخطر
      في فحص السلع وتصنيف رموز HS وجاهزية المستندات ورسوم الوجهة
      وليس في الحساب نفسه.
    </p>
    <p class="small muted">
      أساس رسوم CIF بنسبة 5% وضريبة القيمة المضافة بنسبة 5% بثقة متوسطة في اللقطة البحثية — إطار دول مجلس التعاون الخليجي
      ومعدل ضريبة القيمة المضافة العُمانية مسجلان في بيانات الدول بهذا الموقع، لكن الإطار المشترك
      موثق لدول خليجية أخرى والتأكيد الخاص بعُمان قيد الانتظار. تعامل معها كمدخلات تخطيط للحالة الحالية
      وتحقق من بند الرسوم ومعاملة ضريبة القيمة المضافة لرمز HS الخاص بك مع الجمارك العُمانية
      والهيئة الضريبية العُمانية قبل الالتزام.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. الرسوم الجمركية وضريبة القيمة المضافة بنسبة 5% والبنود العُمانية غير الموثقة</h2>
      <p>
        فقط أساس 5% لدول مجلس التعاون الخليجي وموقف ضريبة القيمة المضافة بنسبة 5% معروفان بثقة متوسطة.
        البنود الجمركية الخاصة بعُمان والإعفاءات ونسب الصفر في ضريبة القيمة المضافة والوساطة والمعالجة الإلكترونية والمطابقة
        ومبالغ التخزين غير منشورة في اللقطة البحثية الموثقة، لذا ترفض هذه الصفحة
        اختلاق أي رقم رسوم عُماني واحد. اطلب جدول رسوم مفصلاً للبنود التشغيلية
        من مخلص عُماني مرخص أو مزود خدمة بدلاً من ذلك.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'component', label: 'عنصر التكلفة' },
          { key: 'who', label: 'الجهة التي تفرضه' },
          { key: 'rate', label: 'المعدل أو المبلغ' },
          { key: 'basis', label: 'الأساس' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={dutyRows}
        caption="فقط رسوم CIF الخليجية بنسبة 5% وموقف ضريبة القيمة المضافة بنسبة 5% موثقان. الاستثناءات الجمركية والرسوم التشغيلية الخاصة بعُمان بثقة منخفضة ويجب طلبها كجدول رسوم مفصل."
      />
      <SourceList locale={locale} sources={taxSources} title="المصادر — رسوم الاستيراد وضريبة القيمة المضافة في عُمان بنسبة 5%" />

      <div class="note mt-2">
        <strong>قائمة التحقق الضريبية قبل الحجز:</strong> اطلب بند رسوم رمز HS، وقيمة CIF المستخدمة،
        وأي نسبة صفر أو إعفاء من ضريبة القيمة المضافة، وأي تصريح للبضائع المقيدة، بالإضافة إلى رسوم الوساطة
        والمعالجة الإلكترونية العُمانية والمطابقة والفحص وفترة السماح للتخزين — كتابيًا وفي نفس عرض السعر.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. الجدول الزمني للتقييم: من رمز HS إلى الإفراج</h2>
    <p>
      الرسوم الجمركية وضريبة القيمة المضافة في عُمان ليست نسبة مئوية واحدة تُفرض عند الوصول؛ بل هي حساب
      مرتب يبدأ بالتصنيف وفحص السلع. إذا كانت الخطوتان الأوليان خاطئتين، فقد يتعطل التخليص
      عند الحدود — وعلى عكس الأسواق التي تفرض رسومًا فقط، فإن التصحيح يتدفق عبر
      طبقة رسوم 5% وطبقة ضريبة القيمة المضافة بنسبة 5% معًا.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'step', label: 'الخطوة' },
        { key: 'when', label: 'متى' },
        { key: 'basis', label: 'ماذا تعتمد عليه' },
        { key: 'confidence', label: 'الثقة', type: 'confidence' },
      ]}
      rows={calcTimelineRows}
      caption="ترتيب الرسوم/ضريبة القيمة المضافة القانوني مرتبط بمعدل CIF الخليجي المشترك 5% وضريبة القيمة المضافة العُمانية 5%؛ الخطوات التشغيلية مثل التقديم الإلكتروني عبر بيان والفحص بثقة منخفضة."
    />
    <SourceList locale={locale} sources={timelineSources} title="المصادر — الجدول الزمني للتقييم والدفع" />

    <div class="note mt-2">
      <strong>الترتيب الذي يجب تذكره:</strong> صنف ← افحص البضائع المقيدة ← قيم على CIF ←
      الرسوم بنسبة 5% ← ضريبة القيمة المضافة بنسبة 5% على الأساس الشامل للرسوم ← قدم بيان ← ادفع ← أفرج. تخطي
      فحص السلع أو تصنيف HS هو كيف يتحول تقدير "1.1025" المباشر إلى احتجاز حدودي.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. الرسوم المدفوعة ذاتيًا مقابل DDP</h2>
      <p>
        لا يزيل DDP رسوم 5% الجمركية أو ضريبة القيمة المضافة بنسبة 5% في عُمان؛ بل يغير من يدفع ومدى شفافية الضريبة.
        الاختيار يتعلق بالتدفق النقدي وملكية الامتثال والشفافية، وليس بدفع رسوم قانونية
        أو ضريبة قيمة مضافة أقل.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'factor', label: 'العامل' },
          { key: 'selfPay', label: 'الرسوم المدفوعة ذاتيًا' },
          { key: 'ddp', label: 'DDP شامل' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={ddpVsSelfRows}
        caption="الرسوم القانونية بنسبة 5% وضريبة القيمة المضافة بنسبة 5% دون تغيير في أي من الهيكلين؛ فقط الدافع والشفافية والمسؤولية وتوقيت التدفق النقدي تختلف."
      />
      <SourceList locale={locale} sources={taxSources} title="المصادر — الدفع الذاتي مقابل معالجة رسوم DDP" />

      <div class="grid grid--2 mt-2">
        <Card locale={locale} title="الدفع الذاتي أفضل عادةً عندما...">
          <ul>
            <li>كنت مستوردًا عُمانيًا قائمًا مع مخلص جمركي مرخص.</li>
            <li>تريد شفافية كاملة في بنود الرسوم الجمركية وضريبة القيمة المضافة والمعالجة الإلكترونية العُمانية والرسوم التشغيلية.</li>
            <li>لديك بالفعل انضباط في رموز HS وجاهزية للتصاريح.</li>
            <li>حجمك مرتفع بما يكفي لتبرير أعمال التخليص الداخلية.</li>
          </ul>
        </Card>
        <Card locale={locale} title="DDP أفضل عادةً عندما...">
          <ul>
            <li>يريد المشتري سعرًا واحدًا شاملاً ومزودًا واحدًا للمتابعة.</li>
            <li>لست مسجلاً لدى الجمارك العُمانية أو مع مخلص محلي.</li>
            <li>تبيع طرودًا صغيرة أو تريد أن يدير وكيل الشحن التخليص.</li>
            <li>تريد أن يدير وكيل الشحن توقيت الرسوم الجمركية وضريبة القيمة المضافة والبضائع المقيدة معًا.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. هيكل التكلفة الإجمالية للوصول ومثال CIF 10,000 العملي</h2>
    <p>
      قم ببناء التكلفة الإجمالية للوصول بهذا الترتيب: قيمة CIF، الرسوم الجمركية، الأساس الشامل للرسوم، ضريبة القيمة المضافة، ثم الرسوم التشغيلية.
      يستخدم الجدول أدناه مثال <strong>CIF بقيمة 10,000 دولار أمريكي</strong> فقط لإبقاء الحساب شفافًا — وهو ليس معدل سوق أو تقييمًا ملزمًا.
    </p>

    <DataTable locale={locale}
      columns={[
        { key: 'line', label: 'بند التكلفة' },
        { key: 'formula', label: 'الصيغة' },
        { key: 'example', label: 'مثال (دولار أمريكي)' },
        { key: 'confidence', label: 'الثقة', type: 'confidence' },
      ]}
      rows={landedCostRows}
      caption="يستخدم المثال العملي CIF بقيمة 10,000 دولار أمريكي فقط لعرض الحساب. المعدلات قابلة للتغيير — تحقق مع الجمارك العُمانية والهيئة الضريبية العُمانية."
    />
    <SourceList locale={locale} sources={taxSources} title="المصادر — صيغة التكلفة الإجمالية للوصول" />

    <div class="grid grid--2 mt-2">
      <Card locale={locale} title="الصيغة في سطر واحد">
        <p class="lead">
          <strong>CIF × (1 + معدل الرسوم) × (1 + معدل ضريبة القيمة المضافة)</strong>
        </p>
        <p>
          الأساس: CIF × 1.05 × 1.05. أضف الوساطة والمعالجة الإلكترونية العُمانية والمطابقة والفحص
          والتسليم وأي تخزين بعد فترة السماح فوق هذا الرقم القانوني.
        </p>
      </Card>
      <Card locale={locale} title="لماذا تختلف عُمان عن قطر والكويت">
        <p>
          تتوقف قطر والكويت عند CIF × 1.05 (بدون ضريبة قيمة مضافة عامة). تجمع عُمان رسوم 5% مع ضريبة القيمة المضافة بنسبة 5%
          للوصول إلى CIF × 1.1025 — بنفس شكل الإمارات. التكلفة القانونية إذن هي
          مركب رسوم زائد ضريبة قيمة مضافة، وليست موقف رسوم فقط.
        </p>
      </Card>
    </div>

    <div class="note mt-2">
      <strong>عدم الإفصاح الكامل ليس توفيرًا:</strong> يجب أن تعكس قيمة CIF التكلفة والتأمين
      والشحن. قيمة فاتورة منخفضة بشكل غير واقعي أو مكون شحن مفقود يدعو إلى
      إعادة التقييم والغرامات والتأخير — وأي تصحيح يتدفق عبر طبقة رسوم 5% و
      طبقة ضريبة القيمة المضافة بنسبة 5% معًا.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. الفئات المطبقة: كيف يغير رمز HS الفاتورة</h2>
      <p>
        رمز HS هو الرافعة التي تغير مكون الرسوم في التكلفة ويمكن أن تؤثر على معاملة ضريبة القيمة المضافة
        وتدفع فحص المحظورات/القيود. أساس CIF الخليجي بنسبة 5% وضريبة القيمة المضافة بنسبة 5% هما
        الافتراضي، لكن البضائع الخاصة بعُمان قد تكون على بنود تعريفة مختلفة أو معاملات ضريبة قيمة مضافة
        غير منشورة في اللقطة الموثقة.
      </p>

      <DataTable locale={locale}
        columns={[
          { key: 'category', label: 'فئة المنتج / المعاملة' },
          { key: 'duty', label: 'معاملة الرسوم' },
          { key: 'vat', label: 'معاملة ضريبة القيمة المضافة' },
          { key: 'note', label: 'ملاحظة' },
          { key: 'confidence', label: 'الثقة', type: 'confidence' },
        ]}
        rows={categoryRows}
        caption="معاملة الفئات مستمدة من رسوم دول مجلس التعاون الخليجي المشتركة ولقطة ضريبة القيمة المضافة العُمانية بنسبة 5%. يجب تأكيد البنود الجمركية والإعفاءات وحالة البضائع المقيدة الخاصة بعُمان مع الجمارك العُمانية."
      />
      <SourceList locale={locale} sources={taxSources} title="المصادر — معاملة الفئات ورموز HS" />

      <div class="note mt-2">
        <strong>قاعدة التصنيف:</strong> احسم رمز HS الحدودي قبل الشحن. تغيير
        عند الحدود يمكن أن يحرك بند الرسوم ويغير معاملة ضريبة القيمة المضافة ويطلق تصريحًا أو يحول شحنة
        عادية إلى شحنة محظورة.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>7. نقاط الامتثال التي يجب مراعاتها</h2>

    <h3>التكلفة هي رسوم زائد ضريبة قيمة مضافة، وليست رسومًا فقط</h3>
    <p>
      لمعظم البضائع، التكلفة القانونية للوصول هي <strong>CIF × 1.1025</strong>. وهذا يختلف عن
      قطر والكويت (CIF × 1.05، بدون ضريبة قيمة مضافة عامة) وهو بنفس شكل الإمارات (CIF × 1.05 ×
      1.05). لا تنسخ حاسبة رسوم فقط من قطر أو الكويت في عرض سعر عُماني.
    </p>

    <h3>رمز HS أولاً</h3>
    <p>
      بند الرسوم ومعاملة ضريبة القيمة المضافة ومتطلبات التصاريح والتعرض للمحظورات/القيود كلها تنبع من
      رمز HS. صنف مع مخلص جمركي أو حكم كتابي قبل عرض السعر، واجعل وصف الفاتورة
      محددًا بما يكفي للدفاع عن الرمز.
    </p>

    <h3>تقييم CIF يجب أن يكون كاملاً</h3>
    <p>
      التكلفة والتأمين والشحن كلها جزء من الأساس. قيمة معلنة منخفضة أو مكون شحن مفقود
      يخلق خطر إعادة التقييم، وأي تصحيح للقيمة يتدفق عبر طبقة رسوم 5% و
      ضريبة القيمة المضافة بنسبة 5% معًا.
    </p>

    <h3>البضائع المقيدة خطر حدودي وليست تفصيلة ضريبية</h3>
    <p>
      تفحص عُمان الكحول والتبغ والمخدرات والأسلحة والبضائع المقلدة والمواد الخطرة و
      المواد الحساسة ثقافيًا/دينيًا بدقة، لكن القائمة الدقيقة للمحظورات/القيود العُمانية
      غير منشورة في اللقطة الموثقة. أكد حالة السلعة قبل الشحن؛ مفاجأة
      بعد الوصول يمكن أن تعني الرفض أو الإتلاف أو تأخير التصريح أو غرامة تأخير شديدة.
    </p>

    <h3>الجمارك العُمانية تحتاج المستندات جاهزة</h3>
    <p>
      تصريح البيان جيد بقدر جودة الفاتورة وقائمة التعبئة وبوليصة الشحن
      أو بوليصة الشحن الجوي وشهادة المنشأ وبيانات رمز HS الأساسية. جهز المجموعة قبل الوصول حتى
      يمكن تقديم التصريح ولا تبدأ ساعة فترة السماح.
    </p>

    <h3>لا SABER أو SASO لعُمان</h3>
    <p>
      SABER وSASO نظاما مطابقة خاصان بالسعودية فقط. لا يجب أن يتضمن عرض السعر العُماني خطوة
      SABER/SASO السعودية. لدى عُمان نظام المعايير والمطابقة الخاص بها، والذي قد يتطلب
      شهادات خاصة بالمنتج لبعض البضائع، لكن تلك التفاصيل غير منشورة في
      اللقطة الموثقة — أكد العملية العُمانية المطبقة على منتجك قبل الوصول.
    </p>

    <h3>ضريبة القيمة المضافة والرسوم ليست الفاتورة كاملة</h3>
    <p>
      الوساطة والمعالجة الإلكترونية العُمانية والمطابقة والفحص والتسليم وغرامة التأخير والاحتجاز تبقى
      تكاليف تشغيلية منفصلة. لا تنشر اللقطة البحثية مبالغها، لذا اطلب جدول رسوم مفصلاً
      بدلاً من افتراض أن التكلفة القانونية هي التكلفة الإجمالية للوصول كاملة.
    </p>

    <h3>المعدلات قابلة للتغيير</h3>
    <p>
      أساس رسوم 5% وضريبة القيمة المضافة بنسبة 5% من لقطة مؤرخة. تعامل مع كل رقم هنا كمدخل تخطيط
      وتحقق من بند الرسوم الحالي ومعاملة ضريبة القيمة المضافة والإعفاءات وقواعد البضائع المقيدة
      مع الجمارك العُمانية والهيئة الضريبية العُمانية قبل إنهاء عرض سعر التكلفة الإجمالية للوصول.
    </p>

