    a: 'تشمل المجموعة القياسية الفاتورة التجارية، وبوليصة الشحن، وقائمة التعبئة، وشهادة المنشأ، بالإضافة إلى وثائق المطابقة مثل دليل CE للبضائع الخاضعة للتنظيم. صنّف البضائع برمز HS الصحيح قبل تقديم عرض السعر، لأن الرمز الخاطئ بموجب DDP يعني أن الرسوم الجمركية وضريبة القيمة المضافة المضمنة في سعرك الشامل خاطئة أيضًا.',
  },
  {
    q: 'هل غرامة التأخير ورسوم الاحتجاز مشمولة في عرض سعر DDP؟',
    a: 'عادةً لا، بعد المهلة المجانية. تفرض المحطة غرامة التأخير ويفرض الناقل رسوم الاحتجاز بمجرد تجاوز الحاوية للمهلة المجانية، وهذه الرسوم اليومية عادةً ما تكون مستبعدة أو محدودة السقف في تسعير DDP. تأكد من سياسة المهلة المجانية وأي معدلات يومية كتابيًا قبل الحجز.',
  },
  {
    q: 'هل أحتاج إلى مستورد سجل في الإمارات مع DDP؟',
    a: 'عادةً ما يوفر وكيل الشحن DDP الذي لديه شريك محلي قدرة التخليص في الإمارات، لكن الإجابة العملية تعتمد على الهيكل المحلي لوكيل الشحن وترخيص منتجك. يستخدم بعض المزودين مستورد سجل خاص بهم أو يعملون مع الترخيص التجاري للمشتري. تأكد من ذلك قبل الشحنة الأولى لأنه يؤثر على البيان الجمركي، وتسوية الرسوم الجمركية / ضريبة القيمة المضافة، ومعاملة المنطقة الحرة مقابل البر الرئيسي.',
  },
  {
    q: 'كيف أقارن DDP بشحنة CIF أو DAP مرتبة ذاتيًا؟',
    a: 'ابنِ نفس هيكل التكلفة الإجمالية للوصول لكلاهما: الشحن، والرسوم في المنشأ، ورسوم المناولة والميناء في الوجهة، والتخليص والوساطة، والرسوم الجمركية، وضريبة القيمة المضافة، والنقل البري النهائي، بالإضافة إلى مخاطر غرامة التأخير / رسوم الاحتجاز. من الأسهل مقارنة DDP عندما تطلب عرض سعر شامل ومفصل ثم تضيف تكلفة الوقت والامتثال الخاصة بك إلى بديل CIF/DAP.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن DDP من الصين إلى الإمارات: ماذا يشمل "الرسوم مدفوعة" حقًا (August 2026)',
      description:
        'شرح الشحن DDP من الصين إلى الإمارات: من يدفع الرسوم الجمركية 5% وضريبة القيمة المضافة 5%، ومعايير الشحن الجوي / LCL الاسترشادية، ومقارنة DDP مع DAP/EXW/FOB، ومعاملة المنطقة الحرة مقابل البر الرئيسي، والرسوم الخفية التي يجب تأكيدها قبل الحجز.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
