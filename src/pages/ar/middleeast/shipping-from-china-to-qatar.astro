};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'الشحن من الصين إلى قطر: التوجيه عبر ميناء حمد والأسعار ومدة النقل والرسوم (September 2026)',
      description:
        'دليل الشحن من الصين إلى قطر: شنغهاي ونينغبو-تشوشان وشنتشن إلى ميناء حمد، مدة النقل البحري النموذجية 22 يومًا، أسعار LCL/الجوي الاسترشادية، رسوم 5% بدون ضريبة قيمة مضافة عامة، وقرار النقل البحري/الجوي.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'ar',
      mainEntityOfPage: {
        '@type': 'WebPage',
