    a: 'الإطار القطري الحالي للاستيراد لا يتضمن ضريبة قيمة مضافة عامة. الرسوم القانونية الرئيسية على الاستيراد هي الرسوم الجمركية 5% على قيمة CIF. هذا استنتاج بثقة MEDIUM للوضع الحالي ويجب التحقق منه مع الهيئة العامة للجمارك أو المخلص الجمركي قبل وضع اللمسات الأخيرة على عرض التكلفة الإجمالية للوصول.',
  },
  {
    q: 'ما الفرق بين ميناء حمد وميناء الدوحة؟',
    a: 'كان ميناء الدوحة هو الميناء التجاري التاريخي لقطر. انتقلت حركة الحاويات إلى ميناء حمد الجديد بعد افتتاحه، ومنذ ذلك الحين أُعيد تطوير ميناء الدوحة كمحطة للرحلات البحرية السياحية. بالنسبة لشحنات الصين، ميناء حمد هو البوابة التجارية الحديثة وميناء الدوحة ليس الوجهة لشحنات الحاويات الجديدة.',
  },
  {
    q: 'ما المستندات التي أحتاجها للشحن من الصين إلى قطر؟',
    a: 'المجموعة القياسية هي الفاتورة التجارية وبوليصة الشحن أو بوليصة الشحن الجوي وقائمة التعبئة وشهادة المنشأ، مع رموز HS الصحيحة ومعلومات بلد المنشأ. تتطلب تراخيص أو تصاريح استيراد للسلع المقيدة، لذا تأكد من المتطلبات المحددة قبل الشحن.',
  },
  {
    q: 'ما هي النافذة الموحدة وكيف يعمل التخليص الجمركي القطري؟',
    a: 'النافذة الموحدة هي نظام التخليص الجمركي الإلكتروني القطري. يقدم المستورد أو المخلص الجمركي البيان الجمركي عبر النافذة الموحدة، ويرفق المستندات المطلوبة، ويدفع الرسوم الجمركية 5% المقدرة على أساس CIF، ويستلم الإفراج بعد اكتمال أي فحوصات أو تصاريح.',
  },
  {
    q: 'ما السلع المقيدة أو المحظورة في قطر؟',
    a: 'قطر صارمة بشأن الكحول والتبغ ولحم الخنزير وأي سلع تتعارض مع القيم الإسلامية. كما أن المخدرات والأسلحة والبضائع المقلدة والمواد الخطرة وبعض المنتجات الحيوانية/النباتية خاضعة لرقابة صارمة أو محظورة. تحقق من السلعة مع الهيئة العامة للجمارك قبل الحجز.',
  },
  {
    q: 'كيف يعمل الشحن من الباب إلى الباب من الصين إلى قطر؟',
    a: 'يقوم وكيل الشحن بتحصيل البضائع من المورد، ويتولى التخليص الجمركي للتصدير من الصين، وينقلها بحرًا أو جوًا إلى ميناء حمد أو الدوحة، ويقدم البيان الجمركي للاستيراد القطري، ويدفع الرسوم الجمركية 5% على أساس CIF، وينظم النقل البري للميل الأخير إلى العنوان المحدد. بموجب DDP يتحمل البائع أو وكيل الشحن هذه التكاليف؛ بينما بموجب EXW أو DAP يتولى المشتري جزءًا أكبر من جانب الاستيراد.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
