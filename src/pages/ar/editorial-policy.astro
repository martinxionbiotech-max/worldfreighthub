---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_URL } from '../../site';
import { t, type Locale } from '../../i18n/ui';

const locale = 'ar' as const;
---

<BaseLayout locale={locale}
  title="السياسة التحريرية"
  description="المعايير التحريرية لـ WorldFreightHub: الاستقلال، وسلامة البيانات، وعملية التصحيح، والإفصاح عن أي محتوى ممول."
  canonical={`${SITE_URL}/ar/editorial-policy/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale} items={[{ label: 'السياسة التحريرية' }]} />
      <h1>السياسة التحريرية</h1>
      <p class="lead">
        المعايير التي تحكم كل صفحة على WorldFreightHub — الاستقلال والدقة والأمانة والمساءلة.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>الاستقلال التحريري</h2>
    <p>
      WorldFreightHub مصدر معلومات، لا وكيل شحن، ولا يبيع خدمات الشحن. لا تتأثر قرارات المحتوى بأي ناقل أو وكيل شحن أو معلن: لا نوصي بمزود لأنه يدفع لنا، ولا نلين أي حقيقة لأنها غير مريحة. يدرج الدليل المزودين على أساس التحقق أولًا — وتُوسم القائمة «موثقة» بالدليل فقط، لا بالدفع أبدًا.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>الدقة والتوثيق</h2>
      <ul>
        <li>
          <strong>كل حقيقة قابلة للتتبع.</strong> الأرقام الخاصة بالأسعار والرسوم وضريبة القيمة المضافة ومدد النقل مرتبطة بمصدر أساسي — سلطة ميناء أو سلطة جمركية أو ناقل أو سجل رسمي — وتحمل مستوى موثوقية.
        </li>
        <li>
          <strong>لا بيانات مختلقة.</strong> لا نختلق أبدًا سعرًا أو مدة نقل أو مراجعة أو تقييمًا. الرقم الذي لا يمكن توثيقه يُوسم منخفض الموثوقية ويُعلَّم «تحقق قبل الاعتماد»، أو يُحجب بالكامل.
        </li>
        <li>
          <strong>التقديرات موسومة.</strong> أي شيء يعد تقديرًا لا حقيقة مؤكدة يُوسم بذلك، مع إظهار مستوى الموثوقية على الصفحة.
        </li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>التصحيحات</h2>
    <p>
      تتغير قواعد الشحن — تُراجع معدلات ضريبة القيمة المضافة وتتحرك حدود الإعفاء وتتقادم تفاصيل الموانئ. وعند اكتشاف خطأ أو رقم قديم، يُصحح ويكون التصحيح قابلًا للتتبع عبر علامة آخر تحديث للصفحة. للإبلاغ عن مشكلة:
    </p>
    <ol>
      <li>اذهب إلى صفحة التواصل وصف الخطأ.</li>
      <li>أدرج رابط الصفحة، وعند الإمكان الرقم الصحيح ومصدره.</li>
      <li>تُراجع المعلومة مقابل المصدر؛ وإذا كانت خاطئة تُصحح ويُعاد وسمها.</li>
    </ol>
    <p>
      <a class="btn btn-secondary" href="/ar/contact/">
        أبلغ عن تصحيح
      </a>
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>الإفصاح</h2>
      <ul>
        <li>
          <strong>المواضع الممولة موسومة.</strong> إذا كانت قائمة الدليل موضعًا مدفوعًا، تُوسم دائمًا «ممول» وتُطبق عليها معايير الدقة نفسها كبقية القوائم.
        </li>
        <li>
          <strong>الادعاءات ذاتية الإبلاغ موسومة.</strong> البيانات القادمة من مزود أو قائمة سوق تُوسم «ذاتية الإبلاغ» ولا تُعرض كموثقة بشكل مستقل.
        </li>
        <li>
          <strong>لا توجيه بالعمولة.</strong> لا يتقاضى الموقع عمولة مقابل توجيه طلب عرض سعر، ونموذج اطلب عرض سعر بلا التزام على المستخدم.
        </li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>إيقاع التحديث</h2>
    <p>
      تُحدَّث البيانات عندما يتغير مصدر أساسي — مثل معدل ضريبة قيمة مضافة مُراجع أو قاعدة جمركية جديدة. أما الأسعار ومدد النقل المتغيرة باستمرار فتُنشر عمدًا كتقديرات موسومة لا قيمًا ثابتة، وتحمل كل صفحة علامة آخر تحديث لترى مدى حداثة الرقم.
    </p>
  </section>
</BaseLayout>
