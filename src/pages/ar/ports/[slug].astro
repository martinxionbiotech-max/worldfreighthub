---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Card from '../../../components/Card.astro';
import SourceList from '../../../components/SourceList.astro';
import Cta from '../../../components/Cta.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { gccPortsAr, chinaPortsAr, getArPortBySlug } from '../../../data/ports.ar';
import { routesAr } from '../../../data/routes.ar';
import { portSourceIds, sourcesByIds } from '../../../data/sources';
import { t } from '../../../i18n/ui';
import { SITE_URL } from '../../../site';

export function getStaticPaths() {
  return [...chinaPortsAr, ...gccPortsAr].map((port) => ({
    params: { slug: port.slug },
    props: { port },
  }));
}

const { port } = Astro.props;
const locale = 'ar' as const;
const isChinaPort = port.countrySlug === 'china';

const portRoutes = isChinaPort
  ? routesAr.filter((route) => route.originPort === port.slug)
  : routesAr.filter((route) => route.destPort === port.slug);

const portSources = sourcesByIds(portSourceIds[port.slug] ?? []);

const schema = [
  {
    type: 'Place',
    data: {
      name: port.name,
      url: `${SITE_URL}/ar/ports/${port.slug}/`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: port.country,
      },
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: port.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`${port.name} — ملف الميناء`}
  description={`ملف ميناء ${port.name} (${port.country}): المشغل والمواصفات الرئيسية والنطاق الجغرافي ومسارات الشحن من الصين. ${port.tldr.slice(0, 120)}`}
  canonical={`${SITE_URL}/ar/ports/${port.slug}/`}
  locale={locale}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        locale={locale}
        items={[
          { label: t(locale, 'nav.ports'), href: '/ar/ports/' },
          { label: port.name },
        ]}
      />
      <h1>{port.name}</h1>
      <p class="lead">ملف الميناء لممر الشحن من الصين.</p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">الدولة</span>
        <span class="fact-value">
          <a href={`/ar/countries/${port.countrySlug}/`}>{port.country}</a>
        </span>
      </div>
      <div class="fact">
        <span class="fact-label">النوع</span>
        <span class="fact-value">{port.type === 'dry-port' ? t(locale, 'country.dryPort') : t(locale, 'country.seaport')}</span>
      </div>
      <div class="fact">
        <span class="fact-label">UN/LOCODE</span>
        <span class="fact-value">{port.unlocode ?? '—'}</span>
      </div>
      <div class="fact">
        <span class="fact-label">المشغل</span>
        <span class="fact-value">{port.operator}</span>
      </div>
    </div>
    {port.note && <div class="note mt-3"><strong>ملاحظة:</strong> {port.note}</div>}
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>{t(locale, 'tldr')}:</strong> {port.tldr}</p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>{t(locale, 'section.keySpecs')}</h2>
    <div class="fact-grid">
      {port.specs.map((spec) => (
        <div class="fact">
          <span class="fact-label">{spec.label}</span>
          <span class="fact-value">{spec.value}</span>
        </div>
      ))}
    </div>
    <p class="muted mt-2">
      أرقام الإنتاجية والغاطس استرشادية وتتغير من عام لآخر. أكد الأرقام الحالية مع
      سلطة الميناء قبل الاعتماد عليها.
    </p>
  </section>

  <section class="section container">
    <h2>{t(locale, 'section.hinterland')}</h2>
    <p>{port.hinterland}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{isChinaPort ? 'المسارات من هذا المنشأ' : 'المسارات من الصين إلى هذا الميناء'}</h2>
      {portRoutes.length > 0 ? (
        <div class="grid grid--3 mt-2">
          {portRoutes.map((route) => (
            <Card
              locale={locale}
              title={`${getArPortBySlug(route.originPort)?.name ?? route.originPort} → ${getArPortBySlug(route.destPort)?.name ?? route.destPort}`}
              description={`مدة النقل النموذجية ${route.transitDays.typical} يومًا (تقديري).`}
              href={`/ar/routes/${route.slug}/`}
            />
          ))}
        </div>
      ) : (
        <p class="muted">لا توجد مسارات منشورة لهذا الميناء بعد.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>{t(locale, 'section.whatGuidesSkip')}</h2>
    <p>{port.insight}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'section.faq')}</h2>
      <FaqBlock items={port.faqs} />
    </div>
  </section>

  <section class="section container">
    <h2>{t(locale, 'section.keyTakeaways')}</h2>
    <ol>
      {port.keyTakeaways.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SourceList locale={locale} sources={portSources} title="مصادر سلطة الميناء والجمارك" />
    <p class="muted">
      حقائق الميناء استرشادية وتتغير بمرور الوقت. أكد دائمًا التفاصيل التشغيلية
      الحالية مع سلطة الميناء المختصة قبل اتخاذ قرارات تجارية.
    </p>
  </section>

  <section class="section container">
    <Cta locale={locale} />
  </section>
</BaseLayout>
