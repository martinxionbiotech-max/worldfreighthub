---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL, SITE_NAME, SITE_TAGLINE } from '../../site';
import { t, type Locale } from '../../i18n/ui';

const locale = 'ar' as const;
---

<BaseLayout locale={locale}
  title="من نحن — WorldFreightHub"
  description="WorldFreightHub مرجع محايد لبيانات الشحن في ممر الصين إلى الخليج — مسارات وموانئ ودول مدعومة بمصادر، ودليل مزودين يضع التحقق أولاً."
  canonical={`${SITE_URL}/ar/about/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale} items={[{ label: 'من نحن' }]} />
      <h1>من نحن — {SITE_NAME}</h1>
      <p class="lead">{SITE_TAGLINE}</p>
    </div>
  </div>

  <section class="section container">
    <h2>ماذا نفعل</h2>
    <p>
      WorldFreightHub مرجع يعتمد على البيانات للمستوردين والمصدرين ووكلاء الشحن والمخلصين الجمركيين الذين ينقلون البضائع بين الصين ومجلس التعاون الخليجي. ننظم مسارات الشحن والموانئ ودول الوجهة وطرق الشحن والأدوات العملية في مصدر واحد منظم جيدًا — ليجد المستورد الجديد ووكيل الشحن الخبير الحقائق الموثقة نفسها في مكان واحد.
    </p>
    <p>
      تغطي التغطية الممر بالكامل: ست دول وجهة خليجية مع قواعد الرسوم وضريبة القيمة المضافة والامتثال؛ و21 مسارًا من الصين إلى الخليج مع مدد نقل ونطاقات تكلفة استرشادية؛ و19 ملفًا للموانئ من شنغهاي ونينغبو-تشوشان إلى جدة وجبل علي؛ ومسردًا للشحن؛ ودليلًا يضم 103 مزودي شحن، كل منهم موسوم كموثق أو غير موثق.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>لماذا يختلف WorldFreightHub</h2>
      <p>
        معظم مواقع الشحن يكتبها وكلاء الشحن لبيع خدماتهم — ولهذا يوجهك كثير من محتوى الشحن بهدوء نحو مورد معين. بُني WorldFreightHub بالعكس: إنه مرجع محايد لا يبيع الشحن. هذا الاستقلال هو المغزى كله.
      </p>
      <ul>
        <li>
          <strong>لا مورد نحميه.</strong> لسنا وكيل شحن، فلا حافز لدينا لتضخيم مسار أو إخفاء رسوم أو تفضيل مزود على آخر.
        </li>
        <li>
          <strong>مدعوم بمصادر لا بالتخمين.</strong> كل سعر وقاعدة ورقم مدة نقل مرتبط بمصدر أساسي — سلطة ميناء أو سلطة جمركية أو ناقل أو سجل رسمي.
        </li>
        <li>
          <strong>صريحون بشأن عدم اليقين.</strong> الأرقام التي لا يمكن التحقق منها موسومة «منخفضة الموثوقية» ومعلَّمة «تحقق قبل الاعتماد» بدلًا من تزيينها برقم يبدو مقنعًا.
        </li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>مبادئنا</h2>
    <ul>
      <li>
        <strong>الثبات أولًا.</strong> صفحات سريعة وموثوقة مبنية دون تشغيل زائد من جانب العميل — يعرض الموقع نظيفًا ويحمل بسرعة على أي جهاز.
      </li>
      <li>
        <strong>مدفوع بالبيانات.</strong> تُنشأ كل صفحة من بيانات مصدرية منظمة، فلا تُكتب الحقيقة نفسها مرتين ولا تُناقض عبر الصفحات.
      </li>
      <li>
        <strong>صفر بيانات مختلقة.</strong> لا نختلق أسعارًا أو مدد نقل أو مراجعات أو تقييمات. كل رقم إما أن يكون مصدره سلطة أساسية أو موسومًا بوضوح كتقدير بمستوى موثوقية.
      </li>
      <li>
        <strong>التحقق أولًا.</strong> تُنشر قوائم الدليل وبيانات الاتصال فقط بعد تأكيد مستقل، وكل ما يُبلغ عنه ذاتيًا يُوسم بذلك.
      </li>
    </ul>
    <p>
      <a class="btn btn-secondary" href="/ar/methodology/">
        اقرأ المنهجية كاملة
      </a>
    </p>
  </section>

  <section class="section container">
    <h2>ما لا نفعله</h2>
    <p>
      لا ننشر أسعارًا أو جداول أو عروض أسعار مباشرة، ولا نختلق مراجعات أو تقييمات أو أرقامًا. لسنا وكيل شحن ولا مخلصًا جمركيًا ولا سوقًا — نحن مصدر معلومات. عندما تحتاج سعرًا مؤكدًا، يوجه نموذج اطلب عرض سعر طلبك إلى مزود على الممر، وذلك المزود يسعّر شحنتك المحددة.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>التصحيحات والمساءلة</h2>
      <p>
        إذا لاحظت خطأ أو رقمًا قديمًا أو قائمة تحتاج تصحيحًا، فنريد أن نسمع منك. تُعالج التصحيحات وفق سياستنا التحريرية الموثقة، وكل إصلاح قابل للتتبع.
      </p>
      <p>
        <a class="btn btn-secondary" href="/ar/editorial-policy/">
          اقرأ السياسة التحريرية
        </a>
        {' '}
        <a class="btn btn-secondary" href="/ar/contact/">
          الإبلاغ عن مشكلة
        </a>
      </p>
    </div>
  </section>

  <section class="section container">
    <Cta locale={locale} />
  </section>
</BaseLayout>
