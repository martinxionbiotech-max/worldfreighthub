  <section class="section container">
    <h2>حاسبة تكلفة الشحن: من الصين إلى الخليج</h2>
    <div class="tool-grid">
      <div>
        <form class="form-card" id="freight-cost-form" aria-label="مدخلات حاسبة تكلفة الشحن من الصين إلى الخليج">
          <div class="form-grid">
            <div class="grid grid--2">
              <div class="field">
                <label for="origin">ميناء المنشأ في الصين</label>
                <select id="origin">
                  <option value="shanghai">شانغهاي</option>
                  <option value="ningbo-zhoushan">نينغبو-تشوشان</option>
                  <option value="shenzhen">شنتشن (يانتان / شيكو)</option>
                  <option value="guangzhou">قوانغتشو</option>
                  <option value="qingdao">تشينغداو</option>
                  <option value="tianjin">تيانجين</option>
                  <option value="xiamen">شيامن</option>
                </select>
              </div>
              <div class="field">
                <label for="destination">ميناء الوجهة في الخليج</label>
                <select id="destination">
                  <option value="jeddah">جدة</option>
                  <option value="dammam">الدمام</option>
                  <option value="jebel-ali">جبل علي</option>
                  <option value="khalifa-port-abu-dhabi">ميناء خليفة (أبوظبي)</option>
                  <option value="hamad">حمد</option>
                  <option value="shuwaikh">الشويخ</option>
                  <option value="sohar">صحار</option>
                  <option value="khalifa-bin-salman">خليفة بن سلمان</option>
                </select>
              </div>
              <div class="field">
                <label for="mode">وسيلة الشحن</label>
                <select id="mode">
                  <option value="fcl20">FCL 20 قدمًا</option>
                  <option value="fcl40">FCL 40 قدمًا</option>
                  <option value="lcl">LCL (لكل CBM)</option>
                  <option value="air">الشحن الجوي (كجم قابل للتحصيل)</option>
                </select>
              </div>
              <div class="field">
                <label for="size">حجم الشحنة</label>
                <input id="size" type="number" min="0" step="any" inputmode="decimal" placeholder="مثال: 1" />
                <p class="small muted" id="size-hint">عدد الحاويات لـ FCL · CBM لـ LCL · الكجم القابل للتحصيل للشحن الجوي.</p>
              </div>
              <div class="field">
                <label for="goods-value">قيمة البضاعة (USD)</label>
                <input id="goods-value" type="number" min="0" step="any" inputmode="decimal" placeholder="مثال: 50000" />
              </div>
              <div class="field">
                <label for="hold-days">أيام الاحتجاز لغرامة التأخير/الاحتجاز</label>
                <input id="hold-days" type="number" min="0" step="1" inputmode="numeric" value="0" />
              </div>
              <div class="field">
                <label for="insurance-rate">معدل التأمين (%)</label>
                <input id="insurance-rate" type="number" min="0" step="any" inputmode="decimal" value="0.3" />
                <p class="small muted">
                  افتراضياً ≈0.3% من القيمة شاملة الشحن — معيار صناعي، غير وارد في اللقطة
                  <ConfidenceBadge level="LOW" locale={locale} />. اجعله 0 إذا كنت لا تحتاج تغطية بحرية للبضائع.
                </p>
              </div>
            </div>
            <p class="form-error" id="cost-error" role="alert" hidden></p>
            <div class="form-actions">
              <button type="button" class="btn btn-primary" id="cost-calculate">احسب</button>
              <button type="button" class="btn btn-secondary" id="cost-reset">إعادة تعيين</button>
            </div>
          </div>
        </form>

        <div class="formula-box mt-2">
          <h3>كيف يُبنى التقدير</h3>
          <p><code>CIF = قيمة البضاعة + منتصف الشحن + التأمين</code></p>
          <p><code>التأمين = (قيمة البضاعة + منتصف الشحن) × معدل التأمين</code></p>
          <p><code>الرسوم = 5% × CIF</code></p>
          <p><code>ضريبة القيمة المضافة = نسبة ضريبة الوجهة% × (CIF + الرسوم)</code></p>
          <p><code>أيام غرامة التأخير = max(0، أيام الاحتجاز − 5 أيام إعفاء)</code></p>
        </div>
      </div>

      <div>
        <div class="result-panel" aria-live="polite">
