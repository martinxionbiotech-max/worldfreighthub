---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Card from '../../../components/Card.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import Cta from '../../../components/Cta.astro';
import { SITE_URL } from '../../../site';
import { t, type Locale } from '../../../i18n/ui';

const locale = 'ar' as const;

const tools = [
  {
    name: 'حاسبة CBM',
    description: 'حوّل أبعاد الكراتين إلى أمتار مكعبة — وهي أساس تسعير الشحن البحري LCL.',
    href: '/ar/tools/cbm-calculator/',
  },
  {
    name: 'حاسبة تحميل الحاوية',
    description: 'قدّر عدد الكراتين أو الطبالات التي تتسع لها حاوية 20 قدمًا أو 40 قدمًا.',
    href: '/ar/tools/container-loading-calculator/',
  },
  {
    name: 'حاسبة الوزن الحجمي',
    description: 'احسب الوزن الحجمي والوزن القابل للتحصيل لأغراض فوترة الشحن الجوي والشحن السريع.',
    href: '/ar/tools/volumetric-weight-calculator/',
  },
  {
    name: 'حاسبة تكلفة الشحن',
    description: 'قدّر التكلفة الإجمالية للوصول لشحنة من الصين إلى دول مجلس التعاون الخليجي — الشحن والرسوم وضريبة القيمة المضافة ورسوم الوجهة التي تغفلها معظم عروض الأسعار.',
    href: '/ar/tools/freight-cost-calculator/',
  },
];

const faqs = [
  {
    q: 'أي أداة ينبغي أن أستخدم أولاً؟',
    a: 'ابدأ بحاسبة CBM للحصول على الحجم الإجمالي لشحنتك. إذا كان الحجم أقل من نحو 15 CBM، فمن المرجح أن شحنتك تعمل بنظام LCL ويكون رقم CBM هو أساس التسعير لديك. وإذا كان أعلى من 15 CBM، فاستخدم حاسبة تحميل الحاوية لمعرفة عدد الكراتين التي تملأ حاوية 20 قدمًا أو 40 قدمًا. ثم شغّل حاسبة الوزن الحجمي لأي جزء جوي، واختم بحاسبة تكلفة الشحن لتحويل الحجم والوزن والقيمة إلى تقدير للتكلفة الإجمالية للوصول.',
  },
  {
    q: 'هل تفرض هذه الحاسبات رسوماً عليّ؟',
    a: 'لا. الأدوات الأربع مجانية، وتعمل بالكامل في متصفحك، ولا ترسل بياناتك إلى أي خادم أبداً. وهي أدوات تخطيط وليست عروض أسعار — استخدمها للتقدير، ثم أكد الأرقام مع وكيل شحن مرخص قبل الحجز.',
  },
  {
    q: 'ما مدى دقة النتائج؟',
    a: 'هي تقديرات تخطيطية. يعتمد الحجم الفعلي القابل للتحميل على التغليف وصلابة الكراتين وطريقة الرص على الطبالات ومدى تراصّ البضاعة، ولذلك تتسع الحاوية عملياً لأقل مما يوحي به الحجم الخام. تعامل مع كل نتيجة كنقطة انطلاق، لا التزاماً.',
  },
  {
    q: 'ما الفرق بين CBM والوزن الحجمي؟',
    a: 'يقيس CBM الحجم الفعلي بالمتر المكعب ويحرك تسعير الشحن البحري LCL. أما الوزن الحجمي فيحوّل الأبعاد إلى رقم كيلوجرام افتراضي ويحرك فوترة الشحن الجوي والشحن السريع — إذ يحاسب الناقل على الأعلى من الوزن الفعلي والوزن الحجمي.',
  },
  {
    q: 'هل تنطبق الحاسبات على ممر الصين – الخليج تحديداً؟',
    a: 'المعادلات عامة، لكن الحاسبات مضبوطة على واقع الممر: تتسع حاوية 20 قدمًا لحوالي 28 CBM وحاوية 40 قدمًا لحوالي 58 CBM من البضاعة العملية، ويستخدم الشحن الجوي مقسوم اياتا 6000 للوزن الحجمي، وتطبّق حاسبة تكلفة الشحن شرائح الشحن والرسوم وضريبة القيمة المضافة المنشورة لممر الصين – الخليج. اقرأ صفحات الممر ذات الصلة لفهم السياق وراء كل رقم.',
  },
];

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'أدوات وحاسبات الشحن',
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        url: `${SITE_URL}${tool.href}`,
      })),
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  locale={locale}
  title="أدوات وحاسبات الشحن"
  description="حاسبات مجانية لحساب CBM وتحميل الحاوية والوزن الحجمي وتكلفة الشحن من الصين إلى الخليج، مع إرشادات حول الأداة التي ينبغي استخدامها أولاً."
  canonical={`${SITE_URL}/ar/tools/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale} items={[{ label: 'الأدوات' }]} />
      <h1>أدوات وحاسبات الشحن</h1>
      <p class="lead">
        أربع حاسبات مجانية تعمل في المتصفح لتخطيط شحنة من الصين – الخليج — الحجم
        وتحميل الحاوية والوزن القابل للتحصيل والتكلفة الإجمالية للوصول، بالترتيب
        الذي تحتاجها فيه فعلياً.
      </p>
    </div>
  </div>

  <section class="section container">
    <div class="grid grid--3">
      {tools.map((tool) => <Card locale={locale} title={tool.name} description={tool.description} href={tool.href} />)}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>أي أداة لأي مهمة</h2>
      <div class="fact-grid">
        <div class="fact">
          <span class="fact-label">حاسبة CBM</span>
          <span class="fact-value">حجم شحنتك بالمتر المكعب — أساس تسعير الشحن البحري LCL تحت حوالي 15 CBM.</span>
        </div>
        <div class="fact">
          <span class="fact-label">حاسبة تحميل الحاوية</span>
          <span class="fact-value">عدد الكراتين أو الطبالات التي تملأ حاوية 20 قدمًا أو 40 قدمًا — أساس القرار بنظام FCL فوق حوالي 15 CBM.</span>
        </div>
        <div class="fact">
          <span class="fact-label">حاسبة الوزن الحجمي</span>
          <span class="fact-value">الوزن القابل للتحصيل للشحن الجوي (÷6000) والسريع (÷5000) — أساس الفوترة عندما تكون السرعة مهمة.</span>
        </div>
        <div class="fact">
          <span class="fact-label">حاسبة تكلفة الشحن</span>
          <span class="fact-value">تقدير التكلفة الإجمالية للوصول: نطاق الشحن والرسوم وضريبة القيمة المضافة والتأمين ورسوم الوجهة التي تغفلها معظم عروض الأسعار.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>مسار تخطيط من أربع خطوات</h2>
    <ol>
      <li>
        <strong>قس الحجم.</strong> أدخل أبعاد الكرتونة في حاسبة CBM للحصول على
        إجمالي الأمتار المكعبة للشحنة. هذا الرقم الوحيد يحدد LCL مقابل FCL: تحت
        حوالي 15 CBM تشارك حاوية (LCL)، وفوقه تحجز حاوية كاملة (FCL).
      </li>
      <li>
        <strong>خطط للتحميل.</strong> إذا كان الحجم يشير إلى FCL، فاستخدم حاسبة
        تحميل الحاوية لمعرفة عدد الكراتين التي تتسع لها حاوية 20 قدمًا أو 40 قدمًا —
        مع تذكر أن حاوية 20 قدمًا تتسع عملياً لحوالي 28 CBM وحاوية 40 قدمًا لحوالي
        58 CBM، وليس وفق الحساب الخام.
      </li>
      <li>
        <strong>تحقق من الوزن القابل للتحصيل.</strong> إذا كانت أي مرحلة تتحرك جواً
        أو بالشحن السريع، فشغّل حاسبة الوزن الحجمي. البضاعة الخفيفة كبيرة الحجم هي
        الفخ الكلاسيكي هنا — إذ تُفوتر العلبة الكبيرة على حجمها لا على وزنها الفعلي،
        والحاسبة تجعل ذلك واضحاً قبل أن تلزم نفسك بعرض سعر.
      </li>
      <li>
        <strong>احسب التكلفة الإجمالية للوصول.</strong> خذ الحجم أو عدد الحاويات أو
        الوزن القابل للتحصيل من الأدوات الثلاث الأولى وأدخله في حاسبة تكلفة الشحن مع
        قيمة البضاعة وميناء الوجهة وأيام الاحتجاز. تضيف الحاسبة شريحة الشحن المنشورة
        ورسوم الخليج البالغة 5% وضريبة القيمة المضافة على الوجهة والتأمين وبند رسوم
        الوجهة/الرسوم المحلية الذي ما زال يتطلب جدولاً من وكيل الشحن.
      </li>
    </ol>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>الأسئلة الشائعة</h2>
      <FaqBlock items={faqs} />
    </div>
  </section>

  <section class="section container">
    <Cta locale={locale} href="/ar/get-quote/" />
  </section>
</BaseLayout>
