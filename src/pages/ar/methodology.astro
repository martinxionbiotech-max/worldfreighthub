---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { SITE_URL } from '../../site';
import { t, type Locale } from '../../i18n/ui';

const locale = 'ar' as const;

const faqs = [
  {
    q: 'كيف يُحصَّل رقم سعر الشحن؟',
    a: 'يُسحب السعر أولًا من مصدر أساسي — تعريفة ناقل أو منشور سلطة ميناء أو مستند جمركي. وإذا لم يوجد مصدر أساسي، يُوسم الرقم منخفض الموثوقية ويُعلَّم «تحقق قبل الاعتماد». لا يُختلق رقم أبدًا لملء فجوة.',
  },
  {
    q: 'ماذا يعني وسم LOW منخفض الموثوقية؟',
    a: 'يعني أن الرقم تقدير غير موثق — غالبًا لأن السعر أو القاعدة الأساسية غير منشورة علنًا، أو لأنها تتغير بسرعة كبيرة بحيث يصعب تثبيتها. تعامل مع الأرقام منخفضة الموثوقية كنقطة بداية وأكدها مع ناقل أو سلطة قبل الاعتماد عليها.',
  },
  {
    q: 'كم مرة تُحدَّث البيانات؟',
    a: 'تحمل كل صفحة علامة آخر تحديث، وتُحدَّث البيانات عندما يتغير مصدر أساسي — مثل معدل ضريبة قيمة مضافة جديد أو قاعدة جمركية معدلة. أما الأسعار ومدد النقل المتغيرة باستمرار فتُوسم عمدًا كتقديرات لا قيمًا ثابتة.',
  },
  {
    q: 'كيف تتحققون من مزود الشحن في الدليل؟',
    a: 'لا يُوسم المزود «موثق» إلا بعد تأكيد هويته التجارية وبيانات الاتصال وادعاءات الخدمة بشكل مستقل مقابل مصدر أساسي — ترخيص رسمي (NVOCC أو FMC أو ما يعادله) أو سجل حكومي أو بيانات اعتماد المزود المنشورة. وحتى ذلك الحين يبقى «غير موثق».',
  },
];

const schema = [
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout locale={locale}
  title="المنهجية"
  description="كيف يجمع WorldFreightHub بيانات الشحن ويتحقق منها، ويحدد مستويات الموثوقية، ويجعل كل رقم قابلًا للتتبع إلى مصدر أساسي."
  canonical={`${SITE_URL}/ar/methodology/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb locale={locale} items={[{ label: 'المنهجية' }]} />
      <h1>المنهجية</h1>
      <p class="lead">
        كيف نجمع وننظم ونتحقق من البيانات وراء WorldFreightHub.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>المصادر الأساسية أولًا</h2>
    <p>
      نفضل المصادر الأساسية: سلطات الجمارك والضرائب الحكومية وسلطات الموانئ والناقلين. وتُستخدم البيانات الثانوية أو المجمعة للتحقق المتبادل فقط، ولا تكون أبدًا الأساس الوحيد لرقم منشور. ترتيب المصادر هو:
    </p>
    <ul>
      <li>
        <strong>الجهات الحكومية / سلطات الموانئ</strong> — سلطات الجمارك والضرائب (ZATCA وDubai Customs وQatar Customs وغيرها) وسلطات الموانئ (Mawani وDP World وSIPG) والإشعارات الرسمية.
      </li>
      <li>
        <strong>الناقل / المشغل</strong> — التعريفات والجداول وأدلة الخدمة المنشورة من خطوط الشحن ومشغلي المحطات.
      </li>
      <li>
        <strong>الجهات الصناعية / المنظمات</strong> — الهيئات التجارية ومنظمات المعايير (ICC وIATA وFIATA) والمراجع الصناعية المعترف بها.
      </li>
    </ul>
    <p>
      عندما يأتي أي معلومة من قائمة سوق أو صفحة منافس أو مصدر غير منسوب، تُوسم وفقًا لذلك وتُعامل كغير موثقة.
    </p>
  </section>

  <section class="section container">
    <h2>مستويات الموثوقية</h2>
    <p>
      يحمل كل تقدير مستوى موثوقية ليعرف القراء مقدار الثقل الذي يمنحونه له.
    </p>
    <ul>
      <li>
        <ConfidenceBadge locale={locale} level="HIGH" /> — مؤكد من مصدر أساسي. مثال: معدل ضريبة قيمة مضافة منشور من سلطة ضرائب وطنية.
      </li>
      <li>
        <ConfidenceBadge locale={locale} level="MEDIUM" /> — مدعوم بعدة مصادر ثانوية، أو مصدر أساسي يمثل لقطة لا رقمًا مباشرًا. مثال: نطاق سعر شحن مبني من عدة مراجع ناقلين.
      </li>
      <li>
        <ConfidenceBadge locale={locale} level="LOW" /> — تقدير غير موثق دون مصدر أساسي منشور. مثال: مهلة الميناء الحرة التي تختلف حسب المحطة وليست منشورة علنًا.
      </li>
    </ul>
    <p>
      وسم LOW ليس فشلًا — بل إقرار صادق بأن الرقم لا يمكن ربطه بمصدر، وبأنه ينبغي تأكيده قبل الاعتماد عليه.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>الأسعار ومدد النقل</h2>
      <p>
        تتقلب أسعار الشحن ومدد النقل مع الوقود والموسم والمخاطر الجيوسياسية، لذا تُنشر كـ <strong>تقديرات استرشادية بمستوى موثوقية</strong>، وليس كعروض أسعار مباشرة. ونطاق السعر مثل «20ft FCL: $1,500–$6,200» لقطة للفارق المحتمل، وليس التزامًا — فالنطاق الواسع على مسارات الخليج معلومات حقيقية بذاته، ويعكس مدى تحريك علاوات مخاطر الحرب والطلب للسوق.
      </p>
      <p>
        لا يظهر أي تسعير مباشر في أي مكان على الموقع. وعندما تحتاج رقمًا مؤكدًا، يوجه نموذج اطلب عرض سعر طلبك إلى مزود يمكنه تسعير شحنتك المحددة.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>سير عمل التحقق</h2>
    <ol>
      <li>
        <strong>اجمع.</strong> تُسحب المعلومة من أفضل مصدر متاح، مع تسجيل المصدر.
      </li>
      <li>
        <strong>وسم.</strong> يُمنح الرقم مستوى موثوقية بناء على كيفية الحصول عليه — HIGH للتأكيد الأساسي، وLOW للتقدير غير الموثق.
      </li>
      <li>
        <strong>تحقق متبادل.</strong> تُرقى الأرقام التي يمكن دعمها بمصدر أساسي مستقل؛ وكل ما لا يمكن التحقق منه يبقى موسومًا كتقدير.
      </li>
      <li>
        <strong>انشر أو احجب.</strong> يُنشر الرقم فقط إذا كان موثقًا أو موسومًا بوضوح. وإذا تعذر توثيقه أو وسمه بأمانة، يُحجب بدلًا من اختلاقه.
      </li>
    </ol>
    <p>
      ينطبق الانضباط نفسه على دليل المزودين: لا تُوسم القائمة «موثقة» إلا بعد تأكيد هويتها وبيانات الاتصال بشكل مستقل، وكل ما يُبلغ عنه ذاتيًا يُوسم بذلك.
    </p>
  </section>

  <section class="section container">
    <h2>الأسئلة الشائعة</h2>
    <FaqBlock items={faqs} />
  </section>
</BaseLayout>
