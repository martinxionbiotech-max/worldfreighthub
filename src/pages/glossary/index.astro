---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import { glossary } from '../../data/glossary';
import { SITE_URL } from '../../site';

const termCount = glossary.length;

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'Freight glossary',
      itemListElement: glossary.map((term, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: term.term,
        url: `${SITE_URL}/glossary/${term.slug}/`,
      })),
    },
  },
];
---

<BaseLayout
  title="Freight & Customs Glossary"
  description="Freight & customs glossary covering China–GCC and China–Europe terms: EORI, TARIC, CE Marking, REACH, UKCA, FCL, LCL and more."
  canonical={`${SITE_URL}/glossary/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Glossary' }]} />
      <h1>Freight & customs glossary</h1>
      <p class="lead">
        Key terms used across the China–GCC and China–Europe freight corridors.
      </p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> This glossary defines {termCount} freight and customs terms across the China–GCC and China–Europe corridors. The terms that change cost most are chargeable weight (÷6000 vs ÷5000), demurrage/detention, GCC landed-cost multipliers like Saudi Arabia at ×1.2075 versus Qatar at ×1.05, and EU/UK cash-flow moves such as UK import VAT deferred at 20% on £10,000 CIF = £2,000 shifted to the next VAT return. The reason each term matters is the number it changes — not the acronym.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <div class="grid grid--3">
      {glossary.map((term) => (
        <Card
          title={term.term}
          description={term.definition}
          href={`/glossary/${term.slug}/`}
        />
      ))}
    </div>
  </section>
</BaseLayout>
