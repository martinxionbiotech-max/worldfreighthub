---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { gccPorts } from '../../data/gcc-ports';
import { chinaPorts } from '../../data/china-ports';
import { SITE_URL } from '../../site';

const chinaRows = chinaPorts.map((port) => ({
  port: { href: `/ports/${port.slug}/`, label: port.name },
  country: port.country,
  type: port.type === 'dry-port' ? 'Dry port' : 'Seaport',
  operator: port.operator,
  unlocode: port.unlocode ?? '—',
}));

const gccRows = gccPorts.map((port) => ({
  port: { href: `/ports/${port.slug}/`, label: port.name },
  country: port.country,
  type: port.type === 'dry-port' ? 'Dry port' : 'Seaport',
  operator: port.operator,
  unlocode: port.unlocode ?? '—',
}));

const columns = [
  { key: 'port', label: 'Port', type: 'link' },
  { key: 'country', label: 'Country' },
  { key: 'type', label: 'Type' },
  { key: 'operator', label: 'Operator' },
  { key: 'unlocode', label: 'UN/LOCODE' },
];

const faqs = [
  {
    q: 'Which ports does the directory cover?',
    a: 'Seven China origin ports — Shanghai, Ningbo-Zhoushan, Shenzhen, Guangzhou, Qingdao, Tianjin and Xiamen — and twelve GCC ports, from Jeddah and Dammam in Saudi Arabia to Jebel Ali, Hamad, Sohar and Khalifa bin Salman, plus the Riyadh Dry Port.',
  },
  {
    q: 'What is the difference between a seaport and a dry port?',
    a: 'A seaport is a coastal terminal where vessels discharge cargo, while a dry port is an inland container hub like Riyadh Dry Port — reached by rail or road from a coastal port — where cargo clears customs closer to its final destination. Riyadh’s dry port sits roughly 400 km from Dammam and 950 km from Jeddah, which is why the rail leg changes clearance timing and cost.',
  },
  {
    q: 'How do I choose the right destination port?',
    a: 'Choose by final destination region, not just gateway name: Jeddah’s ~4.9m TEU serves western Saudi Arabia, Dammam’s ~2m+ TEU serves the east and Riyadh via rail, and Jebel Ali’s ~14.5m TEU is the UAE and re-export hub. Hamad, Shuwaikh/Shuaiba, Sohar and Khalifa bin Salman serve Qatar, Kuwait, Oman and Bahrain respectively.',
  },
  {
    q: 'What does UN/LOCODE mean?',
    a: 'UN/LOCODE is the UN’s standard five-letter code identifying a port or location — for example, SAJED for Jeddah, AEJEA for Jebel Ali, CNSHA for Shanghai. It is the unambiguous identifier used on bills of lading and customs documents.',
  },
];

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'China loading ports',
      itemListElement: chinaPorts.map((port, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: port.name,
        url: `${SITE_URL}/ports/${port.slug}/`,
      })),
    },
  },
  {
    type: 'ItemList',
    data: {
      name: 'GCC ports and terminals',
      itemListElement: gccPorts.map((port, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: port.name,
        url: `${SITE_URL}/ports/${port.slug}/`,
      })),
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title="Ports & Terminals"
  description="China loading ports and GCC seaports and dry ports served by the China freight corridor, from Shanghai to Jebel Ali, with operator and UN/LOCODE details."
  canonical={`${SITE_URL}/ports/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Ports' }]} />
      <h1>Ports & terminals</h1>
      <p class="lead">
        China loading ports and GCC destinations on the freight corridor — 19
        port profiles with operators, key specifications and routing notes.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> Port choice is a throughput/concentration call: China’s Shanghai moves ~47m TEU versus Xiamen’s ~12m TEU, and in the GCC Jebel Ali’s ~14.5m TEU dwarfs Jeddah’s ~4.9m TEU. Those gaps — 35m TEU at origin and 9.6m TEU at destination — mean schedule density and congestion differ sharply by gateway. The port you pick decides how many sailings you can realistically book and how long cargo can wait.</p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>China loading ports</h2>
    <DataTable
      columns={columns}
      rows={chinaRows}
      caption="China origin ports — verify with the relevant authority before relying on these details."
    />
  </section>

  <section class="section container">
    <h2>GCC ports & terminals</h2>
    <DataTable
      columns={columns}
      rows={gccRows}
      caption="GCC destination ports — verify with the relevant authority before relying on these details."
    />
  </section>

  <section class="section container">
    <h2>Frequently asked questions</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
