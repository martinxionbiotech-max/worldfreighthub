---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import SourceList from '../../components/SourceList.astro';
import Cta from '../../components/Cta.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { gccPorts } from '../../data/gcc-ports';
import { chinaPorts } from '../../data/china-ports';
import { routes } from '../../data/routes';
import { portSourceIds, sourcesByIds } from '../../data/sources';
import { getCountryBySlug, portName } from '../../data/lookup';
import { SITE_URL } from '../../site';

export function getStaticPaths() {
  return [...chinaPorts, ...gccPorts].map((port) => ({
    params: { slug: port.slug },
    props: { port },
  }));
}

const { port } = Astro.props;
const isChinaPort = port.countrySlug === 'china';

const portRoutes = isChinaPort
  ? routes.filter((route) => route.originPort === port.slug)
  : routes.filter((route) => route.destPort === port.slug);

const portSources = sourcesByIds(portSourceIds[port.slug] ?? []);
const country = getCountryBySlug(port.countrySlug);

const schema = [
  {
    type: 'Place',
    data: {
      name: port.name,
      url: `${SITE_URL}/ports/${port.slug}/`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: port.country,
      },
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: port.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`${port.name} — Port Profile`}
  description={`${port.name} (${port.country}) port profile: operator, key specifications, hinterland and China freight routes. ${port.tldr.slice(0, 120)}`}
  canonical={`${SITE_URL}/ports/${port.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Ports', href: '/ports/' },
          { label: port.name },
        ]}
      />
      <h1>{port.name}</h1>
      <p class="lead">Port profile for the China freight corridor.</p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Country</span>
        {country ? (
          <span class="fact-value">
            <a href={`/countries/${country.slug}/`}>{port.country}</a>
          </span>
        ) : (
          <span class="fact-value">{port.country}</span>
        )}
      </div>
      <div class="fact">
        <span class="fact-label">Type</span>
        <span class="fact-value">{port.type === 'dry-port' ? 'Dry port' : 'Seaport'}</span>
      </div>
      <div class="fact">
        <span class="fact-label">UN/LOCODE</span>
        <span class="fact-value">{port.unlocode ?? '—'}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Operator</span>
        <span class="fact-value">{port.operator}</span>
      </div>
    </div>
    {port.note && <div class="note mt-3"><strong>Note:</strong> {port.note}</div>}
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>TL;DR:</strong> {port.tldr}</p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>Key specifications</h2>
    <div class="fact-grid">
      {port.specs.map((spec) => (
        <div class="fact">
          <span class="fact-label">{spec.label}</span>
          <span class="fact-value">{spec.value}</span>
        </div>
      ))}
    </div>
    <p class="muted mt-2">
      Throughput and draft figures are indicative and change year to year.
      Confirm current figures with the port authority before relying on them.
    </p>
  </section>

  <section class="section container">
    <h2>Hinterland</h2>
    <p>{port.hinterland}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{isChinaPort ? 'Routes from this origin' : 'China routes to this port'}</h2>
      {portRoutes.length > 0 ? (
        <div class="grid grid--3 mt-2">
          {portRoutes.map((route) => (
            <Card
              title={`${portName(route.originPort)} → ${portName(route.destPort)}`}
              description={`Typical transit ${route.transitDays.typical} days (estimate).`}
              href={`/routes/${route.slug}/`}
            />
          ))}
        </div>
      ) : (
        <p class="muted">No routes published for this port yet.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>What most guides skip</h2>
    <p>{port.insight}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={port.faqs} />
    </div>
  </section>

  <section class="section container">
    <h2>Key takeaways</h2>
    <ol>
      {port.keyTakeaways.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SourceList sources={portSources} title="Port authority & customs sources" />
    <p class="muted">
      Port facts are indicative and change over time. Always confirm current
      operational details with the relevant port authority before making
      commercial decisions.
    </p>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
