---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Cta from '../../components/Cta.astro';
import { methods } from '../../data/methods';
import { SITE_NAME, SITE_URL } from '../../site';

export function getStaticPaths() {
  return methods.map((method) => ({
    params: { slug: method.slug },
    props: { method },
  }));
}

const { method } = Astro.props;

const schema = [
  {
    type: 'Article',
    data: {
      headline: method.name,
      url: `${SITE_URL}/methods/${method.slug}/`,
      description: method.summary,
      author: {
        '@type': 'Organization',
        name: SITE_NAME,
        url: SITE_URL,
      },
      datePublished: '2026-08-30',
      dateModified: '2026-08-30',
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        url: SITE_URL,
        logo: {
          '@type': 'ImageObject',
          url: `${SITE_URL}/og.png`,
        },
      },
    },
  },
];
---

<BaseLayout
  title={method.name}
  description={method.summary}
  canonical={`${SITE_URL}/methods/${method.slug}/`}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Methods', href: '/methods/' },
          { label: method.name },
        ]}
      />
      <h1>{method.name}</h1>
      <p class="lead">{method.summary}</p>
    </div>
  </div>

  <section class="section container">
    <div class="note">
      <strong>Note:</strong> this page is a definitional overview. Specific rates
      and transit times are published on individual route pages and are always
      marked as estimates.
    </div>
    <p class="mt-3">
      <a class="btn btn-secondary" href="/routes/">Browse routes</a>
    </p>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
