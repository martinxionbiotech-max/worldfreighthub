  },
  {
    item: 'Customs clearance / brokerage',
    who: 'Licensed broker / Directorate General of Customs',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Documentation',
    who: 'Forwarder / broker',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'Directorate General of Customs',
    magnitude: '5% of CIF value',
    confidence: 'HIGH',
