    role: 'Major regional transshipment and freighter hub',
    confidence: 'LOW',
  },
];

const omanAirportRows = [
  {
    gateway: 'Muscat International (MCT)',
    role: 'Oman arrival gateway for China air cargo',
    confidence: 'LOW',
  },
];

const omanPortRows = [
  {
    gateway: 'Sohar (OMSOH)',
    role: 'Oman primary container gateway — industrial deep-water port + free zone, Port of Rotterdam JV, outside the Strait of Hormuz',
    confidence: 'HIGH',
  },
