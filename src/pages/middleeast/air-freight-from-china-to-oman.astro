---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/air-freight-from-china-to-oman/`;

const iata: Source = {
  id: 'iata',
  name: 'IATA — air cargo chargeable weight guidance',
  url: 'https://www.iata.org',
  type: 'organization',
};

const wfhMethodData: Source = {
  id: 'wfh-air-method-data',
  name: 'WorldFreightHub methods data — air freight and sea context rate bands and transit windows',
  url: `${SITE_URL}/methods/`,
  type: 'organization',
};

const wfhCountryData: Source = {
  id: 'wfh-air-country-data',
  name: 'WorldFreightHub GCC country data — Oman VAT, duty and compliance profile (HIGH confidence)',
  url: `${SITE_URL}/countries/`,
  type: 'organization',
};

const omanCustoms = sourcesByIds(['oman-customs']);

const rateSources: Source[] = [wfhMethodData, ...omanCustoms];
const transitSources: Source[] = [wfhMethodData];
const chargeableSources: Source[] = [iata, wfhMethodData];
const airportSources: Source[] = [iata, wfhMethodData, ...omanCustoms];
const comparisonSources: Source[] = [wfhMethodData, wfhCountryData, ...omanCustoms];
const costSources: Source[] = [wfhMethodData, wfhCountryData, ...omanCustoms];
const complianceSources: Source[] = [...omanCustoms, wfhCountryData];

const airRateRows = [
  {
    service: 'Air freight · China → GCC corridor reference',
    benchmark: '$4.3 – $11.0 / kg',
    transit: '3–7 days airport-to-airport',
    basis: 'WorldFreightHub methods data (generic China→GCC band)',
    confidence: 'MEDIUM',
  },
  {
    service: 'Air freight · China → Oman country-specific',
    benchmark: 'Not published — request a per-kg quote',
    transit: '3–7 days planning range',
    basis: 'No verified Oman air benchmark in the snapshot',
    confidence: 'LOW',
  },
  {
    service: 'Express courier · China → Oman',
    benchmark: '$6.9 – $11.0 / kg (generic China→GCC corridor band)',
    transit: '3–7 days door-to-door',
    basis: 'WorldFreightHub methods data (MEDIUM); Oman-specific express rate not published',
    confidence: 'LOW',
  },
  {
    service: 'DDP air · China → Oman',
    benchmark: 'Not published — request a per-kg quote',
    transit: '~10–15 days door-to-door',
