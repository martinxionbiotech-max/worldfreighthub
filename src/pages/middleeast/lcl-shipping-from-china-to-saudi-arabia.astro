const lclVsFclRows = [
  {
    factor: 'Best-fit volume',
    lcl: 'Small shipments, commonly below ~15 CBM (planning heuristic)',
    fcl: 'Most of a container — 20GP ~33 CBM, 40GP ~67 CBM nominal',
