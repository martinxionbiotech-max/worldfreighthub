const costRows = [
  {
    item: 'Ocean freight (LCL)',
    who: 'Ocean carrier / forwarder',
    magnitude: 'See LCL rate table — per CBM with a minimum charge',
    confidence: 'LOW',
  },
  {
    item: 'Origin CFS receiving & consolidation',
    who: 'China forwarder / warehouse',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Destination CFS deconsolidation / handling',
    who: 'Jeddah / Dammam CFS operator',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Destination THC & port charges',
    who: 'Jeddah / Dammam terminal',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Customs clearance & brokerage',
    who: 'Saudi customs broker / agent',
