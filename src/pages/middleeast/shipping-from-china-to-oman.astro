const costSources: Source[] = [...omanCustomsSources, wfhMethodology];
const complianceSources: Source[] = [...omanCustomsSources, wfhMethodology];
const marketSources: Source[] = [...omanCustomsSources, wfhMethodology];

const rateRows = [
  {
    service: 'LCL ocean — China to Sohar / Salalah',
