const portSources = sourcesByIds(['mawani']);
const facilitySources = sourcesByIds(['mawani', 'dp-world']);
const transitSources: Source[] = [cargofromchina, ddpchain, freightos];
const routingSources: Source[] = [cargofromchina, freightos, ddpchain];
const costSources: Source[] = [
