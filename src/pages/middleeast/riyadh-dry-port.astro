    note: 'Usually reached through King Abdulaziz Port Dammam discharge',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'UN/LOCODE',
    value: '—',
    note: 'Use SADMM (Dammam) on the bill of lading; the dry port has no seaport code',
    confidence: 'MEDIUM',
  },
