const faqs = [
  {
    q: 'What is Riyadh Dry Port?',
    a: 'Riyadh Dry Port is Saudi Arabia’s inland container depot (ICD) serving the capital region. It is not a seaport; containers are discharged at a coastal port, usually King Abdulaziz Port Dammam, and moved inland by rail or road for customs clearance and final distribution around Riyadh and central Saudi Arabia.',
  },
  {
    q: 'Is Riyadh Dry Port a seaport?',
    a: 'No. It is an inland container depot, so the bill of lading uses the coastal seaport code. For a Dammam-served corridor that is SADMM; Riyadh Dry Port itself has no seaport UN/LOCODE in the verified snapshot.',
  },
  {
    q: 'How does cargo reach Riyadh Dry Port from China?',
    a: 'The usual routing is ocean freight from China to King Abdulaziz Port Dammam, followed by an inland rail or road transfer to Riyadh Dry Port, where the container is cleared and delivered to the final consignee. Confirm the exact inland mode and handover point with your forwarder.',
  },
  {
    q: 'Why use Riyadh Dry Port instead of clearing at Dammam?',
    a: 'The main reasons are inland clearance close to the Riyadh consumer base, shorter final trucking, and a route that avoids some coastal-port congestion and cross-country delivery after release. It is a hinterland decision: if the goods are destined for Riyadh or central Saudi Arabia, the dry-port flow is usually the conventional choice.',
  },
  {
    q: 'How long does China to Riyadh Dry Port take?',
    a: 'Indicative planning is about 20 days typical for the China–Dammam ocean leg and roughly 30–45 days for the full sea plus inland corridor. Freightos puts the Shanghai–Riyadh FCL corridor around 30–40 days. The Dammam–Riyadh rail/road segment itself was not published in the verified snapshot, so confirm it with the operator.',
  },
  {
    q: 'What destination code do I use for a Riyadh Dry Port shipment?',
    a: 'Use the coastal port code on the bill of lading, typically SADMM for Dammam, and name Riyadh Dry Port as the final place of delivery. Ask the carrier to confirm the precise B/L destination and the inland handover instructions.',
  },
  {
    q: 'Can I clear customs at Riyadh Dry Port?',
    a: 'Riyadh Dry Port can function as an inland clearance point under Saudi Arabia’s FASAH single-window system. Confirm with your broker whether the shipment clears at Dammam or at Riyadh Dry Port, because that changes the document timing and the inland handover point.',
  },
  {
    q: 'What costs are added by the inland leg to Riyadh?',
    a: 'The inland rail or trucking charge, the dry-port ICD handling and any CFS or storage charges are added on top of the ocean freight and destination THC. Specific amounts were not published in the verified snapshot, so request an all-in destination quote from your forwarder.',
  },
  {
    q: 'Do SABER rules apply to Riyadh Dry Port shipments?',
    a: 'Yes. Regulated goods need the Product Conformity Certificate (PC) per product and the Shipment Conformity Certificate (SC) per shipment. Since 1 January 2025 the SC must be obtained before cargo arrival or clearance fails, regardless of whether the cargo clears at Dammam or at Riyadh Dry Port.',
  },
  {
    q: 'What import taxes apply at Riyadh Dry Port?',
    a: 'The baseline import duty is 5% of CIF value under the GCC Common External Tariff, and Saudi import VAT is 15%, calculated on CIF value plus customs duty. Excise tax can add 100% on tobacco, 50% on energy drinks and 50% on carbonated drinks where applicable.',
  },
  {
    q: 'How do demurrage and detention work for Riyadh cargo?',
    a: 'Demurrage is charged when the imported container stays inside the coastal terminal or dry port beyond free time after discharge. Detention is charged by the ocean carrier when the container stays outside beyond free time. Finish clearance and book the inland leg before discharge to avoid both.',
  },
  {
    q: 'Which goods suit the Riyadh Dry Port route?',
    a: 'Goods destined for Riyadh and central Saudi Arabia — especially consumer goods, retail distribution, LCL consolidations and regular FCL flows — usually suit the Dammam → Riyadh Dry Port corridor. Western-KSA and Red Sea cargo is normally better served through Jeddah instead.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Riyadh Dry Port — China Shipping Guide: ICD Routing, Dammam Rail Transfer & Saudi Clearance (August 2026)',
      description:
        'Riyadh Dry Port (Riyadh inland container depot) intelligence for China freight: ICD role, Dammam rail transfer, Riyadh inland clearance, transit and cost composition, and SABER/VAT compliance.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
  {
    type: 'Place',
    data: {
      name: 'Riyadh Dry Port',
      url: pageUrl,
      additionalType: 'DryPort',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Riyadh',
        addressCountry: 'SA',
      },
      description:
        'Riyadh Dry Port is the inland container depot of the Riyadh region, served by rail and road transfer from coastal ports such as King Abdulaziz Port Dammam.',
    },
  },
];
---

<BaseLayout
  title="Riyadh Dry Port — China Shipping Guide: ICD Routing, Dammam Rail Transfer & Saudi Clearance (August 2026)"
  description="Riyadh Dry Port (Riyadh inland container depot) intelligence for China freight: ICD role, Dammam rail transfer, Riyadh inland clearance, transit and cost composition, and SABER/VAT compliance."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Riyadh Dry Port' },
        ]}
      />
      <span class="badge badge--amber">August 2026 updated</span>
      <h1>Riyadh Dry Port: China freight guide for the Saudi inland container depot</h1>
      <p class="lead">
        A port-intelligence page for shippers routing China freight to Riyadh and central Saudi
        Arabia. This page explains what Riyadh Dry Port is as an inland container depot (ICD), how
        cargo reaches it through the Dammam rail/road corridor, why inland clearance can beat
        coastal discharge for Riyadh cargo, what the corridor costs, and the SABER/VAT rules that
        still apply at the inland gate.
      </p>
      <p class="small muted">
        Confidence badges separate verified figures from indicative market and port snapshots. Treat
        every LOW-confidence transit, facility and fee note as indicative, verify with Mawani or your
        carrier before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Saudi import VAT</span>
          <span class="fact-value">15% <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline import duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER SC rule</span>
          <span class="fact-value">Before arrival <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Facility type</span>
          <span class="fact-value">Inland ICD <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Served via</span>
          <span class="fact-value">Dammam rail/road <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">China → Riyadh corridor</span>
          <span class="fact-value">30–45 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Mawani total</span>
          <span class="fact-value">8.3M TEU (2025) <ConfidenceBadge level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Why Riyadh Dry Port matters for China freight</h2>
    <p>
      Riyadh Dry Port is the inland container depot that turns a Dammam discharge into a Riyadh
      delivery. It is not a seaport — no vessel calls there — but it is where the economics of a
      central-Saudi shipment are decided. A container discharged at Dammam can be moved inland by
      rail or road, cleared under FASAH, and released close to the capital’s consumer base instead of
      being collected hundreds of kilometres away at the coast.
    </p>
    <p>
      The commercial logic is one of final delivery. Riyadh is the country’s capital, its largest
      inland market, and the distribution centre for the central provinces. When your consignee is in
      Riyadh, the dry-port flow shortens the final trucking leg, keeps clearance close to the buyer,
      and reduces the risk of a container sitting at a congested coastal terminal while the inland
      leg is arranged. For consumer goods, retail replenishment and regular FCL/LCL flows, that
      inland proximity is often worth more than a marginal ocean-rate difference.
    </p>
    <p>
      The verified research snapshot does not publish a depot-specific throughput or an inland
      transit figure for Riyadh Dry Port. It does confirm the Mawani total: Saudi ports handled
      <strong>8.3 million TEU in 2025</strong>, up 10.6% year-on-year. Depot capacity, rail capacity
      and the Dammam–Riyadh transfer time are therefore marked LOW and attributed to the Saudi Ports
      Authority (Mawani) in the tables below rather than invented.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Riyadh Dry Port parameters</h2>
      <p>
        Use this table as an orientation, not a capacity guarantee. Because Riyadh Dry Port is an
        inland facility, its parameters are about the inland corridor and clearance function rather
        than berths and drafts. Specific capacity, rail and throughput figures were not published in
        the verified research snapshot, so those rows stay deliberately empty of invented numbers.
      </p>

      <DataTable
        columns={[
          { key: 'parameter', label: 'Parameter' },
          { key: 'value', label: 'Value' },
          { key: 'note', label: 'Planning note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={parameterRows}
        caption="Dry-port parameters — verify inland transfer, capacity and throughput with the Saudi Ports Authority (Mawani) or the operator before relying on these details."
      />
      <SourceList sources={portSources} title="Sources — Riyadh Dry Port parameters" />

      <div class="note mt-2">
        <strong>Inland-capacity cargo:</strong> if your Riyadh consignment depends on a specific rail
        wagon window, container yard capacity or bonded storage, request the current inland schedule
        and restrictions from Mawani, the rail/road operator or your forwarder before booking. The
        verified snapshot does not supply those numbers.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. China to Riyadh transit windows</h2>
    <p>
      Transit to Riyadh Dry Port is always a two-stage figure: the ocean leg to Dammam, then the
      inland rail or road transfer to the dry port. Quoting the ocean leg alone understates the true
      door time, so treat the figures below as planning ranges and confirm the vessel, voyage and
      inland handover before committing a delivery date.
    </p>

    <DataTable
      columns={[
        { key: 'origin', label: 'Origin' },
        { key: 'service', label: 'Service' },
        { key: 'transit', label: 'Indicative transit' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={transitRows}
      caption="Indicative transit windows only — verify with the relevant carrier and inland operator before relying on these figures."
    />
    <SourceList sources={transitSources} title="Sources — China to Riyadh Dry Port transit times" />

    <div class="note mt-2">
      <strong>Port-to-port vs Riyadh door:</strong> about 20 days typical for the China–Dammam ocean
      leg is not the same as total door time to Riyadh. Add the Dammam discharge, the inland rail or
      road transfer, dry-port clearance and final trucking; Freightos and market context put the
      Shanghai–Riyadh corridor around 30–45 days.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Riyadh Dry Port vs direct coastal discharge: when the ICD wins</h2>
      <p>
        This is the decision that determines most of the inland cost and transit. The dry port wins
        when the goods are destined for Riyadh and central Saudi Arabia; a direct coastal discharge
        wins when the consignee is already in the Eastern Province, or when the cargo belongs to the
        western corridor. The table below gives the common scenarios from the Riyadh side.
      </p>

      <DataTable
        columns={[
          { key: 'scenario', label: 'Scenario' },
          { key: 'bestPort', label: 'Best-fit flow' },
          { key: 'why', label: 'Why' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={decisionRows}
        caption="Routing heuristics, not guaranteed schedules. Confirm the inland leg, clearance point and cost before choosing the flow."
      />
      <SourceList sources={decisionSources} title="Sources — Riyadh Dry Port routing context" />

      <div class="grid grid--2 mt-2">
        <Card title="Choose Riyadh Dry Port when...">
          <ul>
            <li>The consignee is in Riyadh or the central Saudi provinces.</li>
            <li>The cargo is consumer goods, retail or regular FCL/LCL distribution.</li>
            <li>Inland clearance close to the buyer is more valuable than coastal release.</li>
            <li>You want the established Dammam → Riyadh Dry Port corridor.</li>
          </ul>
        </Card>
        <Card title="Choose a different flow instead when...">
          <ul>
            <li>The consignee is in Dammam, Khobar, Jubail or the Eastern Province.</li>
            <li>The cargo is western-KSA, Makkah, Madinah or Red Sea trade.</li>
            <li>The shipment is time-critical and rail transfer time is unacceptable.</li>
            <li>Your carrier or broker confirms a cleaner direct coastal release.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Facilities, inland connection and the Riyadh hinterland</h2>
    <p>
      Riyadh Dry Port functions as a container yard, clearance point and central-KSA distribution
      hub rather than a deep-water terminal. The verified snapshot does not enumerate a rail operator
      timetable, CFS directory or specific capacity, so this list is an operational orientation marked
      LOW and should be confirmed against Mawani and your forwarder for the actual move.
    </p>

    <DataTable
      columns={[
        { key: 'facility', label: 'Facility' },
        { key: 'function', label: 'Function' },
        { key: 'note', label: 'Planning note' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={facilityRows}
      caption="Facility orientation, not a terminal directory. Confirm operator, inland-transfer and CFS details with Mawani before booking."
    />
    <SourceList sources={facilitySources} title="Sources — Riyadh Dry Port facilities & inland connection" />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. Post-arrival cost composition at Riyadh Dry Port</h2>
      <p>
        The ocean rate is only one line, and for Riyadh cargo the inland leg is the extra line that
        coastal-only shipments may not carry. Destination THC, the Dammam–Riyadh rail or trucking
        charge, ICD handling, clearance, SABER conformity, and per-day demurrage/detention charges
        together decide the landed cost — which is why “all-in to Riyadh” is the only useful
        comparison number.
      </p>

      <h3>Demurrage and detention</h3>
      <p>
        <strong>Demurrage</strong> is charged when an imported container stays inside the coastal
        terminal or dry port beyond the free time after discharge. <strong>Detention</strong> is
        charged by the ocean carrier when the container stays outside beyond the free time after
        collection. Free-time allowances and per-day rates differ by location, line and terminal and
        were not published in the verified snapshot, so always request the fee schedule before booking.
      </p>
      <p>
        The practical way to avoid both is to finish clearance before the container arrives: submit
        the FASAH pre-arrival declaration, obtain the SABER SC before arrival, keep documents ready,
        and book the inland rail or trucking leg before the container is discharged at Dammam.
      </p>

