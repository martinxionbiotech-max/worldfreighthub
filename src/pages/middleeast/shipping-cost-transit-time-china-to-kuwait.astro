    fcl: 'Simpler sealed move, usually faster to release',
    lcl: 'Adds consolidation and deconsolidation handling',
    confidence: 'LOW',
  },
  {
    factor: 'Planning rule',
    fcl: 'Stronger as cargo approaches a meaningful share of a box',
    lcl: 'Stronger for small, low-volume shipments',
    confidence: 'LOW',
  },
];

const nodeRows = [
  {
    node: 'Shanghai (CNSHA)',
    role: 'Top China container origin; 55.06M TEU (2025)',
    note: 'Origin terminal and export documentation',
    confidence: 'HIGH',
  },
  {
    node: 'Ningbo-Zhoushan (CNNGB)',
