---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import { rates } from '../../data/rates';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-cost-transit-time-china-to-kuwait/`;

const shuwaikhPort = gccPorts.find((item) => item.slug === 'shuwaikh');
const shuaibaPort = gccPorts.find((item) => item.slug === 'shuaiba');
const shuwaikhUnlocode = shuwaikhPort?.unlocode ?? '—';
const shuaibaUnlocode = shuaibaPort?.unlocode ?? '—';

const wfhRouteData: Source = {
  id: 'wfh-kuwait-cost-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Shuwaikh (typical 24 days, range 15–30; LOW confidence estimate)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};
const wfhMethodology: Source = {
  id: 'wfh-kuwait-cost-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};
const tonlexingKuwait: Source = {
  id: 'tonlexing-kuwait',
  name: 'Tonlexing — China→Kuwait container shipping cost guide (June 2026)',
  url: 'https://www.tonlexing.com/20ft-40ft-container-shipping-costs-from-china-to-kuwait/',
  type: 'industry',
};
const pwcKuwait: Source = {
  id: 'pwc-kuwait-tax',
  name: 'PwC Worldwide Tax Summaries — Kuwait: other taxes (VAT status; 5% GCC tariff on CIF; reviewed July 2026)',
  url: 'https://taxsummaries.pwc.com/kuwait/corporate/other-taxes',
  type: 'organization',
};
const mytaxmanGcc: Source = {
  id: 'mytaxman-gcc-vat',
  name: 'MyTaxMan — GCC countries and VAT: 2026 rates and rules (Kuwait: no VAT law passed as of April 2026)',
  url: 'https://mytaxman.ae/gcc-countries-and-vat',
  type: 'organization',
};
const kintsugiKuwait: Source = {
  id: 'kintsugi-kuwait-vat',
  name: 'Kintsugi — Kuwait VAT guide 2026: no VAT in force, none expected before 2028',
  url: 'https://trykintsugi.com/sales-tax-guides/middle-east/kuwait',
  type: 'organization',
};
const kpaShuwaikh: Source = {
  id: 'kpa-shuwaikh',
  name: 'Kuwait Ports Authority — Shuwaikh Port (2024 statistics: 613,093 TEU; 21 berths)',
  url: 'https://www.kpa.gov.kw/en/shuwaikh-port',
  type: 'port-authority',
};
const kpaShuaiba: Source = {
  id: 'kpa-shuaiba',
  name: 'Kuwait Ports Authority — Shuaiba Port (2024 statistics: 282,870 TEU; 20 berths)',
  url: 'https://www.kpa.gov.kw/en/shuaiba-port',
  type: 'port-authority',
};
const freightAmigoPorts: Source = {
  id: 'freightamigo-kuwait-ports',
  name: 'FreightAmigo — Kuwait ports guide: Shuwaikh and Shuaiba compared (berths, depths, cargo fit)',
  url: 'https://www.freightamigo.com/en/blog/logistics/kuwait-port-name-a-complete-guide-to-shuwaikh-and-shuaiba-ports',
  type: 'industry',
};

const kuwaitCustomsSources = sourcesByIds(['kuwait-customs']);
const rateSources: Source[] = [tonlexingKuwait, wfhRouteData, wfhMethodology];
const taxSources: Source[] = [pwcKuwait, mytaxmanGcc, kintsugiKuwait, ...kuwaitCustomsSources];
const transitSources: Source[] = [wfhRouteData, tonlexingKuwait];
const modeSources: Source[] = [wfhRouteData, wfhMethodology];
const portSources: Source[] = [kpaShuwaikh, kpaShuaiba, freightAmigoPorts, wfhMethodology];
const costSources: Source[] = [...taxSources, wfhMethodology, wfhRouteData];

const usd = (value: number) => `$${value.toLocaleString('en-US')}`;
const rateRange = (amountLow: number | undefined, amountHigh: number | undefined, amount: number) =>
  amountLow && amountHigh ? `${usd(amountLow)}–${usd(amountHigh)}` : usd(amount);

const kwRates = rates.filter((rate) => rate.route.includes('shuwaikh'));
const sh20 = kwRates.find((rate) => rate.id === 'r-401');
const sh40 = kwRates.find((rate) => rate.id === 'r-402');
const sz20 = kwRates.find((rate) => rate.id === 'r-403');
const sz40 = kwRates.find((rate) => rate.id === 'r-404');
const kwLcl = kwRates.find((rate) => rate.id === 'r-405');

const rateSheetRows = [
  {
    lane: 'FCL 20GP · Shanghai → Shuwaikh',
    benchmark: sh20 ? `${rateRange(sh20.amountLow, sh20.amountHigh, sh20.amount)} (Jun 2026 sheet)` : 'Not published',
    read: 'Paired with a 22–38 day transit in the source. The 20ft band is the one to test first against your LCL alternative.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'FCL 40GP / 40HQ · Shanghai → Shuwaikh',
    benchmark: sh40 ? `${rateRange(sh40.amountLow, sh40.amountHigh, sh40.amount)} (Jun 2026 sheet)` : 'Not published',
    read: 'The source quotes 40HQ lane-wide at $2,400–$4,800; 40ft is the benchmark size for established importers.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'FCL 20GP · Shenzhen → Shuwaikh',
    benchmark: sz20 ? `${rateRange(sz20.amountLow, sz20.amountHigh, sz20.amount)} (Jun 2026 sheet)` : 'Not published',
    read: 'South-China sheet paired with 20–35 days; a July-2026 cross-check quote sat at $2,250 per 20ft.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'FCL 40GP / 40HQ · Shenzhen → Shuwaikh',
    benchmark: sz40 ? `${rateRange(sz40.amountLow, sz40.amountHigh, sz40.amount)} (Jun 2026 sheet)` : 'Not published',
    read: 'South-China 40ft band; the two origin sheets differ by less than you would expect, so pick on service, not geography.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'LCL · per CBM',
    benchmark: kwLcl ? `${rateRange(kwLcl.amountLow, kwLcl.amountHigh, kwLcl.amount)} (Jun 2026 sheet)` : 'Not published',
    read: 'Paired with 25–45 days. Regional guides quote up to $80–$150/CBM — confirm whether a quote is base freight or all-in.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'Corridor reference brackets · all modes',
    benchmark: 'LCL $20–$180/CBM; 20ft $1,500–$6,200 (corridor-wide research)',
    read: 'Wider all-GCC brackets kept as sanity bounds only. If a quote falls outside them, the basis is probably different — not the market.',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    lane: 'Shanghai → Shuwaikh',
    mode: 'Sea port-to-port',
    transit: 'Typical 24 days (15–30 range); carrier sheet pairs 22–38 days',
    basis: 'WorldFreightHub route data; Tonlexing Jun-2026 sheet',
    confidence: 'LOW',
  },
  {
    lane: 'Ningbo-Zhoushan → Shuwaikh',
    mode: 'Sea port-to-port',
    transit: 'Typical 24 days (15–30 range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'LOW',
  },
  {
    lane: 'Shenzhen → Shuwaikh',
    mode: 'Sea port-to-port',
    transit: 'Typical 24 days (15–30 range); carrier sheet pairs 20–35 days',
    basis: 'WorldFreightHub route data; Tonlexing Jun-2026 sheet',
    confidence: 'LOW',
  },
  {
    lane: 'China → Shuaiba',
    mode: 'Sea port-to-port',
    transit: 'Not published — request carrier transit for the industrial port',
    basis: 'No Shuaiba-specific sea transit in the verified snapshot',
    confidence: 'LOW',
  },
  {
    lane: 'China → Kuwait corridor',
    mode: 'Air freight',
    transit: 'Not published in verified snapshot — request routing quote',
    basis: 'No verified Kuwait air transit in the snapshot',
    confidence: 'LOW',
  },
  {
    lane: 'China → Kuwait door',
    mode: 'Door-to-door after sea or air',
    transit: 'Not published — add discharge, Kuwait clearance, inspection and last-mile trucking',
    basis: 'No door-to-door figure in the verified snapshot',
    confidence: 'LOW',
  },
];

const cifRows = [
  {
    layer: 'Goods / invoice value',
    calc: 'From the supplier invoice',
    amount: 'Use the actual declared value',
    note: 'The starting point for Kuwait customs duty',
    confidence: 'LOW',
  },
  {
    layer: 'Freight (sea or air)',
    calc: 'Carrier / forwarder quote',
    amount: 'See the rate sheet',
    note: 'Ocean or air line item',
    confidence: 'LOW',
  },
  {
    layer: 'Insurance',
    calc: 'Insurer or forwarder quote',
    amount: 'Not published in snapshot',
    note: 'Usually a small percentage of cargo value',
    confidence: 'LOW',
  },
  {
    layer: 'CIF value',
    calc: 'Cost + insurance + freight',
    amount: '$10,000.00 illustrative',
    note: 'Illustrative round figure; replace with your CIF',
    confidence: 'LOW',
  },
  {
    layer: 'Customs duty (baseline)',
    calc: 'CIF × 5%',
    amount: '$500.00',
    note: 'GCC Common External Tariff, ad valorem on CIF',
    confidence: 'MEDIUM',
  },
  {
    layer: 'General VAT',
    calc: 'No general VAT in force',
    amount: '$0.00',
    note: 'Kuwait signed the GCC framework but has not implemented VAT — no confirmed timeline',
    confidence: 'MEDIUM',
  },
  {
    layer: 'Statutory landed cost',
    calc: 'CIF × 1.05',
    amount: '$10,500.00',
    note: '= 1.05 × CIF at the baseline duty rate — the border stops here',
    confidence: 'MEDIUM',
  },
  {
    layer: 'Destination fees',
    calc: 'THC + docs + clearance + inspection + inland + demurrage/detention',
    amount: 'Not published — request schedule',
    note: 'Added on top of the statutory stack',
    confidence: 'LOW',
  },
  {
    layer: 'Total landed cost',
    calc: 'Statutory landed cost + destination fees',
    amount: '$10,500.00 + destination fees',
    note: 'The all-in figure to benchmark quotes against',
    confidence: 'MEDIUM',
  },
];

const portCompareRows = [
  {
    dimension: 'Role',
    shuwaikh: 'Kuwait’s main commercial port — containers, general cargo and consumer goods for the capital',
    shuaiba: 'Kuwait’s industrial port — heavy equipment, raw materials, chemicals and petrochemical traffic',
    confidence: 'MEDIUM',
  },
  {
    dimension: 'Location',
    shuwaikh: 'Shuwaikh Industrial Area, adjacent to Kuwait City (north)',
    shuaiba: 'Al Ahmadi Governorate, roughly 45 km south of the capital',
    confidence: 'MEDIUM',
  },
  {
    dimension: 'Berths',
    shuwaikh: '21 berths (KPA)',
    shuaiba: '20 berths (KPA)',
    confidence: 'HIGH',
  },
  {
    dimension: 'Approximate berth depths',
    shuwaikh: 'About 6.7–10 m — shallower water',
    shuaiba: 'About 10–14 m — deeper water for larger industrial tonnage',
    confidence: 'MEDIUM',
  },
  {
    dimension: 'Containers handled (2024)',
    shuwaikh: '613,093 TEU across 1,419 vessel calls',
    shuaiba: '282,870 TEU across 2,908 vessel calls',
    confidence: 'HIGH',
  },
  {
    dimension: 'Cargo fit',
    shuwaikh: 'Retail, consumer, general and project-linked cargo for the capital market',
    shuaiba: 'Industrial, chemical, bulk and project-heavy cargo for the southern belt',
    confidence: 'MEDIUM',
  },
  {
    dimension: 'Planning note',
    shuwaikh: 'Congestion is a known constraint — build buffer into schedules and trucking',
    shuaiba: 'Deeper berths; pick it when the cargo and consignee sit in the industrial south',
    confidence: 'MEDIUM',
  },
];

const crossoverRows = [
  {
    scenario: 'Corridor rule (legacy reference)',
    arithmetic: '15 CBM × $180 top corridor LCL = $2,700 vs a $1,500 20ft floor',
    breakeven: 'Box wins by $1,200 at 15 CBM',
    read: 'The widely quoted ~15 CBM breakpoint works when the box is cheap and the LCL rate is at the corridor’s high end.',
  },
  {
    scenario: 'Kuwait top LCL vs 20ft floor',
    arithmetic: '$75 × volume vs $1,500',
    breakeven: '$1,500 ÷ $75 = 20.0 CBM',
    read: 'With the Jun-2026 Kuwait LCL top rate, the practical breakpoint shifts up to 20 CBM.',
  },
  {
    scenario: 'Kuwait top LCL vs 20ft high',
    arithmetic: '$75 × volume vs $2,900',
    breakeven: '$2,900 ÷ $75 = 38.7 CBM',
    read: 'If the box prices at the top of its band, LCL stays competitive to nearly 39 CBM — more than a 20ft holds.',
  },
  {
    scenario: 'Kuwait low LCL vs 20ft floor',
    arithmetic: '$35 × volume vs $1,500',
    breakeven: '$1,500 ÷ $35 = 42.9 CBM',
    read: 'At the low LCL bracket the box only wins past 42.9 CBM — beyond a 20ft’s usable volume.',
  },
  {
    scenario: 'Full-box reality check',
    arithmetic: '20ft ≈ 33 CBM usable; 40ft ≈ 67 CBM usable',
    breakeven: '33 CBM × $75 = $2,475 LCL vs a $1,500–$2,900 box',
    read: 'A full 20ft of LCL at the top rate overlaps the box band — the box decision turns on your actual quote pair.',
  },
  {
    scenario: '40ft vs top LCL',
    arithmetic: '$75 × volume vs $2,200–$4,400',
    breakeven: '$2,200 ÷ $75 = 29.3 CBM to $4,400 ÷ $75 = 58.7 CBM',
    read: 'A 40ft generally wins past roughly 30–59 CBM at top LCL rates, depending on the box price.',
  },
];

const bookingRows = [
  {
    stage: 'Booking stage',
    lock: 'Named service and routing via your chosen discharge port',
    why: 'Two discharge ports and fewer sailings than Dubai mean the routing decision is made here, not at the destination',
    confidence: 'LOW',
  },
  {
    stage: 'Documentation stage',
    lock: 'HS code, certificate of origin, and PAI certification for regulated goods',
    why: 'Kuwait clearance is document-heavy — fixes made now are free; fixes made at the port are not',
    confidence: 'MEDIUM',
  },
  {
    stage: 'Pre-arrival stage',
    lock: 'Import declaration filed before the vessel arrives',
    why: 'Protects free time; inspection slots fill around vessel calls on a lower-frequency lane',
    confidence: 'LOW',
  },
  {
    stage: 'Discharge stage',
    lock: 'Trucking booked and delivery appointment set',
    why: 'Shuwaikh sits in the urban capital area with known congestion — the container needs to leave on schedule',
    confidence: 'LOW',
  },
  {
    stage: 'Closing stage',
    lock: 'Free-time count and per-day rates written into the booking confirmation',
    why: 'Unpublished fee schedules make the booking document your only evidence if a clock starts running',
    confidence: 'LOW',
  },
];

const costRows = [
  {
    item: 'Destination THC and port service fees',
    who: 'Shuwaikh / Shuaiba terminal and port operator',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Documentation / bill of lading fees',
    who: 'Carrier / forwarder',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Kuwait Customs clearance and brokerage',
    who: 'Kuwait General Administration of Customs / licensed broker',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Customs inspection',
    who: 'Kuwait Customs / inspection agency',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'PAI certification (regulated goods)',
    who: 'Public Authority for Industry',
    magnitude: 'Not published — confirm scope and cost for your HS code',
    confidence: 'LOW',
  },
  {
    item: 'Port storage / demurrage',
    who: 'Terminal (after free time)',
    magnitude: 'Per-day charge; free time is not published — verify',
    confidence: 'LOW',
  },
  {
    item: 'Detention',
    who: 'Ocean carrier (after free time)',
    magnitude: 'Per-day charge; free time is not published — verify',
    confidence: 'LOW',
  },
  {
    item: 'LCL extras: CFS handling and minimum charge',
    who: 'CFS / consolidator',
    magnitude: 'Minimum charge not published — ask before choosing LCL',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'Kuwait General Administration of Customs',
    magnitude: '5% of CIF value (GCC Common External Tariff)',
    confidence: 'MEDIUM',
  },
  {
    item: 'General VAT',
    who: 'Kuwait tax framework',
    magnitude: 'No general VAT in force — watch item only, not a budget line',
    confidence: 'MEDIUM',
  },
];

const airRows = [
  {
    option: 'Air freight · chargeable kg',
    benchmark: 'Indicative $4.6–$8.2/kg (corridor snapshots)',
    note: 'Billed on chargeable weight — the higher of actual and volumetric (÷6000 convention) — not on scale weight alone',
    confidence: 'MEDIUM',
  },
  {
    option: 'DDP air · door-to-door bundle',
    benchmark: 'Usually priced inside the same $4.6–$8.2/kg band',
    note: 'Bundles clearance, the 5% duty and delivery; compare the bundle against a self-clearance quote before accepting it',
    confidence: 'MEDIUM',
  },
  {
    option: 'Express courier · small parcels',
    benchmark: 'Not published separately',
    note: 'For samples and small urgent consignments; the per-unit rate falls as weight rises',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'How much does shipping cost from China to Kuwait?',
    a: 'The June 2026 forwarder benchmarks put Shanghai→Kuwait at $1,500–$2,900 per 20ft and $2,200–$4,400 per 40ft, Shenzhen at $1,550–$3,000 and $2,300–$4,500, and LCL at $35–$75 per CBM. Those are port-to-port, dated June 2026. On top sits the statutory stack: 5% duty on CIF with no general VAT (CIF × 1.05). Request a current all-in quote, because rates move and these sheets predate the latest Gulf premium moves.',
  },
  {
    q: 'How long does it take to ship from China to Kuwait?',
    a: 'WorldFreightHub route data records a typical 24 days with a 15–30 day planning range from Shanghai, Ningbo-Zhoushan or Shenzhen to Shuwaikh (LOW confidence). The June 2026 forwarder sheets pair Shanghai with 22–38 days, Shenzhen with 20–35, and LCL with 25–45. Build your plan on the slow end of that spread, not the typical figure.',
  },
  {
    q: 'Why is the China-to-Kuwait lane cost-sensitive despite the short distance?',
    a: 'Schedule density, not geography. Kuwait is served by fewer strings than Dubai or Jeddah — most services transship via Singapore or a regional hub — so the 15–30 day window hides real variability, and carrier sheets stretch it further (22–38 days from Shanghai). Fewer sailings also means less pressure on destination fees. The 0% VAT is a genuine advantage; the schedule is what you pay for it.',
  },
  {
    q: 'How is the Kuwait landed cost calculated?',
    a: 'On a $10,000 CIF, Kuwait’s baseline statutory landed cost is $10,500: 5% duty on CIF, with no general VAT in force, so the stack is CIF × 1.05. Add destination THC, documentation, clearance, inspection, inland trucking and any demurrage/detention on top of that. The border is the cheap part; the destination side is where quotes diverge.',
  },
  {
    q: 'Does Kuwait charge VAT on imports?',
    a: 'No. Kuwait signed the GCC Unified VAT Framework in 2017 but has not implemented VAT — no law had passed as of April 2026, and current guidance does not expect it before 2028. The GCC framework itself was amended in May 2026 and Qatar has started moving toward implementation, so a future VAT remains a question worth watching — but today the Kuwait import stack stops at 5% duty. Verify the current position with Kuwait Customs before finalising a long-term budget.',
  },
  {
    q: 'Does the 5% Kuwait duty apply to freight and insurance?',
    a: 'Yes — every $1 of freight or insurance adds 5 cents of duty, because the charge applies to the full CIF value, not just the invoice. What you do not pay is a second tax on that duty: with no VAT layer, raising the duty rate by one point on a $10,000 CIF costs $100, not $105 as it would in a 5%-VAT state.',
  },
  {
    q: 'What hidden fees should I expect on a Kuwait shipment?',
    a: 'Duty is the only quantified statutory line (5% of CIF); every other Kuwait fee amount was not published, so budget the destination stack as structured unknowns and make the provider itemise: origin charges, destination THC and port service fees, documentation, brokerage, inspection if selected, storage, inland transport, and demurrage/detention after free time. Ask for the free-time count in writing — it is the line most likely to cost you later.',
  },
  {
    q: 'Is FCL or LCL better for shipping to Kuwait?',
    a: 'Use your quote pair, not a slogan. The corridor’s legacy rule breaks even around 15 CBM; with the June 2026 Kuwait rates, a 20ft box at the bottom of its band breaks even against top-rate LCL at 20 CBM, and against a high-priced box the breakpoint stretches to ~39 CBM. Below the breakpoint LCL wins; above it, FCL does — and a 40ft box generally wins somewhere past 30–59 CBM at top LCL rates. Request both quotes at your actual volume.',
  },
  {
    q: 'What is the cheapest way to ship from China to Kuwait?',
    a: 'For steady volumes, sea freight with a discipline problem solved: consolidate past your crossover so you are buying container space, not per-CBM space, and compare the two discharge ports honestly. Air freight (indicative $4.6–$8.2/kg corridor snapshots) is rarely the cheapest option and is justified by urgency or value density — not by cost. DDP air bundles clearance and duty into one rate, which is convenient and easy to overpay for.',
  },
  {
    q: 'Which port should be used in the landed-cost quote?',
    a: 'Shuwaikh (UN/LOCODE KWSWK) for general containerised cargo, consumer goods and anything bound for Kuwait City — it is Kuwait’s main commercial port. Shuaiba (UN/LOCODE KWSHB) for industrial, chemical, bulk and project cargo tied to the southern industrial belt, with deeper berths that suit heavier tonnage. Confirm the discharge port with the carrier and receiver before the bill of lading is cut — the port choice changes the inland leg, the fee schedule and the clearance path.',
  },
  {
    q: 'How should I quote transit time from China to Kuwait?',
    a: 'Quote 24 days port-to-port to Shuwaikh as the planning default, then add discharge, Kuwait clearance, any inspection and last-mile trucking for the door-to-door figure. Ask the forwarder to split the port-to-port and door-to-door dates so the ocean leg is not mistaken for the delivery promise — on a lane where carrier sheets stretch to 38 days, the gap between those two numbers is where missed commitments live.',
  },
  {
    q: 'How can I reduce the landed cost on the China-to-Kuwait route?',
    a: 'The biggest single saving is consolidating past your FCL/LCL crossover so you stop buying per-CBM space at top rates. Then: classify the HS code correctly before booking, sort PAI certification early if your goods need it, file the import declaration before arrival to protect free time, and negotiate the destination fee schedule rather than accepting a bundled number. The duty side is already as light as the GCC gets — the savings left on this lane are in logistics, not tax.',
  },
  {
    q: 'Do I need SABER or SASO to import into Kuwait?',
    a: 'No. SABER and SASO are Saudi-only conformity systems — do not copy them into a Kuwait import. Kuwait runs its own requirements instead: documentation through Kuwait Customs, and PAI (Public Authority for Industry) certification for certain regulated products. Confirm the applicable regime for your specific HS code before shipment.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'China to Kuwait Shipping Cost & Transit Time: the 5% Duty Lane, Two Ports and a 15 CBM Question (September 2026)',
      description:
        'China-to-Kuwait cost guide: June 2026 rate benchmarks, the 5% duty stack with no general VAT (CIF × 1.05), Shuwaikh vs Shuaiba, a Kuwait-specific FCL/LCL crossover and booking windows for a low-frequency lane.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-16',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

