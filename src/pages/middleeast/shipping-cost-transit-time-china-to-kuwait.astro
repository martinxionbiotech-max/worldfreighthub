  id: 'wfh-kuwait-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};

const kuwaitCustomsSources = sourcesByIds(['kuwait-customs']);
const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const rateSources: Source[] = [wfhRouteData, wfhMethodology];
const taxSources: Source[] = [...kuwaitCustomsSources, wfhMethodology];
const transitSources: Source[] = [wfhRouteData];
const modeSources: Source[] = [wfhRouteData, wfhMethodology];
const costSources: Source[] = [...kuwaitCustomsSources, wfhMethodology, wfhRouteData];
const nodeSources: Source[] = [...chinaPortSources, ...kuwaitCustomsSources, wfhMethodology];

const seaRateRows = [
  {
    mode: 'LCL ocean · China → Shuwaikh / Shuaiba',
    benchmark: 'Not published in verified snapshot — request an all-in per-CBM quote',
    basis: 'No verified Kuwait LCL rate appears in the research snapshot',
    note: 'Per-CBM shared-container basis; minimum charge may apply',
