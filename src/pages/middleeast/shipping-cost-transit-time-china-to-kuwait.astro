---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-cost-transit-time-china-to-kuwait/`;

const shuwaikhPort = gccPorts.find((item) => item.slug === 'shuwaikh');
const shuaibaPort = gccPorts.find((item) => item.slug === 'shuaiba');
const shuwaikhUnlocode = shuwaikhPort?.unlocode ?? '—';
const shuaibaUnlocode = shuaibaPort?.unlocode ?? '—';

const wfhRouteData: Source = {
  id: 'wfh-kuwait-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Shuwaikh (typical 24 days, range 15–30; LOW confidence estimate)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};
