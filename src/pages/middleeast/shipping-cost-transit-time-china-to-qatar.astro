];

const airRateRows = [
  {
    mode: 'Air freight · China → Qatar market bracket',
    benchmark: 'USD 4.5–7.5 per kg',
    basis: 'Presou China→Qatar air snapshot',
    note: 'Billed on chargeable weight, not actual weight alone',
    confidence: 'LOW',
  },
  {
    mode: 'Air freight · airport-to-airport planning range',
    benchmark: 'Not published as a per-kg floor/ceiling — request a quote',
