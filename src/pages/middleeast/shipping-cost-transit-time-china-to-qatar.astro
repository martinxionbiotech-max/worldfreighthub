};
const wfhRouteData: Source = {
  id: 'wfh-qatar-cost-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Hamad Port (typical 22 days, range 15–30)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};
const wfhMethodology: Source = {
  id: 'wfh-qatar-cost-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};

const qatarPortSources: Source[] = [mwani, ...sourcesByIds(['qatar-customs'])];
const rateSources: Source[] = [sinoQatar, goodhopeQatar, cogoportQatar, presou, chinabestfreight];
const floorSources: Source[] = [presou, sinoQatar, wfhMethodology];
const taxSources: Source[] = [...sourcesByIds(['qatar-customs']), traddal, goodsacrossborders];
const gatewaySources: Source[] = [mwani, windwardReroute, lloydsPorts, wfhMethodology];
const transitSources: Source[] = [wfhRouteData, chinabestfreight];
const costSources: Source[] = [...taxSources, presou, chinabestfreight, wfhRouteData];

const fclRateRows = [
  {
    ref: 'r-301',
    lane: 'Shanghai → Hamad',
    size: '20GP',
    benchmark: '$4,365–$5,354',
    basis: 'Sino Shipping Sep-2026 quote set; the source itself flags roughly +25% month-on-month and a Hormuz risk premium. Confirm the charge basis (port-to-port vs all-in).',
    confidence: 'MEDIUM',
  },
  {
    ref: 'r-302',
    lane: 'Shanghai → Hamad',
    size: '40GP / 40HQ',
    benchmark: '$6,485–$8,204',
    basis: 'Same Sep-2026 set (40GP quoted; 40HQ usually at parity). A South-China sheet quoted $2,150/40HQ in July — a reminder that basis and service windows move these numbers more than most people expect.',
    confidence: 'MEDIUM',
  },
  {
    ref: 'r-303',
    lane: 'Ningbo-Zhoushan → Hamad',
    size: 'FCL (size not stated)',
    benchmark: '$7,862–$9,910',
    basis: 'Platform “indicative freight” that bundles more than base ocean and omits container size — useful as a ceiling signal, not comparable with port-to-port rows.',
    confidence: 'LOW',
  },
  {
    ref: 'r-304',
    lane: 'Shenzhen (Shekou/Yantian) → Hamad',
    size: '20GP',
    benchmark: '$1,750–$1,954',
    basis: 'Goodhope port-to-port sheet dated 6 July 2026; carrier card undated. Pre-escalation vintage — verify before modelling.',
    confidence: 'LOW',
  },
  {
    ref: 'r-305',
    lane: 'Shenzhen → Hamad',
    size: '40GP / 40HQ',
    benchmark: '$2,150–$2,956',
    basis: 'Same July sheet ($2,150/40HQ) plus a carrier card at $2,650–$2,956. Confirm service and date.',
    confidence: 'LOW',
  },
];

const lclAirRows = [
  {
    ref: 'r-306',
    mode: 'LCL · Shanghai → Hamad (per CBM)',
    benchmark: '$75–$150',
    basis: 'Sino: $75/CBM stable (Sep 2026); the top of the range comes from a regional LCL guide ($80–150). Across published snapshots the floor is $70 — a structural small-market premium, not a distance effect.',
    confidence: 'MEDIUM',
  },
  {
    ref: 'r-307',
    mode: 'Air · China → Doha (per kg)',
    benchmark: '$3.76–$4.62',
    basis: 'Goodhope air card QAR 13.7–16.8/kg (converted at the source’s implied rate); Sino quotes $3.95/kg above 1,000 kg. Trade listings run $2.50–$4.50/kg at a 45 kg minimum.',
    confidence: 'MEDIUM',
  },
];

const chargeableWeightRows = [
  {
    volume: '0.5 CBM',
    chargeable: '≈ 83 kg',
    air: '$313–$385',
    lcl: '$70–$150 (1-CBM minimum billing)',
    reading: 'The multiple narrows to roughly 2–6× because LCL minimums stop the per-CBM maths from helping small parcels.',
    confidence: 'MEDIUM',
  },
  {
    volume: '1 CBM',
    chargeable: '≈ 167 kg',
    air: '$627–$770',
    lcl: '$70–$150',
    reading: 'Roughly 4–11× — the standard gap for a small-but-bulky shipment.',
    confidence: 'MEDIUM',
  },
  {
    volume: '2 CBM',
    chargeable: '≈ 333 kg',
    air: '$1,253–$1,540',
    lcl: '$140–$300',
    reading: 'Roughly 4–11×. The air premium in dollars (about $950–$1,400) is what buys back two to three weeks.',
    confidence: 'MEDIUM',
  },
];

const stackCompareRows = [
  {
    destination: 'Qatar',
    stack: '×1.05 (5% duty, no VAT)',
    landed: '$10,500',
    gap: '—',
    note: 'The GCC’s lightest statutory landing stack in the current framework',
    confidence: 'MEDIUM',
  },
  {
    destination: 'Kuwait',
    stack: '×1.05 (5% duty, no VAT)',
    landed: '$10,500',
    gap: '$0',
    note: 'Level with Qatar on the statutory layer',
    confidence: 'MEDIUM',
  },
  {
    destination: 'UAE',
    stack: '×1.1025 (5% duty + 5% VAT)',
    landed: '$11,025',
    gap: '+$525',
    note: 'VAT compounds on the duty-inclusive base',
    confidence: 'MEDIUM',
  },
  {
    destination: 'Saudi Arabia',
    stack: '×1.2075 (5% duty + 15% VAT)',
    landed: '$12,075',
    gap: '+$1,575',
    note: 'The comparison that makes Qatar’s 0% VAT tangible',
    confidence: 'MEDIUM',
  },
];

const fclVsLclRows = [
  {
    factor: 'Pricing unit',
    fcl: 'Per container (20GP / 40GP / 40HQ)',
    lcl: 'Per CBM, with a minimum charge on small volumes',
    confidence: 'LOW',
  },
  {
    factor: 'Published Qatar benchmark',
    fcl: '$4,365–$5,354 (20GP, Sep); $1,750–$1,954 (20GP, Jul South-China sheet)',
    lcl: '$75–$150/CBM (floor $70 across snapshots)',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Crossover math',
    fcl: 'Crossover CBM = FCL rate ÷ LCL rate',
    lcl: 'Depends on which sheet you read: ≈12–26 CBM (Jul) vs ≈29–71 CBM (Sep)',
    confidence: 'LOW',
  },
  {
    factor: 'Hidden destination cost',
    fcl: 'THC, port charges, demurrage/detention if free time is missed',
    lcl: 'THC, CFS deconsolidation, minimum charge, storage after free time',
    confidence: 'LOW',
  },
  {
    factor: 'Planning rule',
    fcl: 'Stronger near and above a full box; fight for FCL terms past ~25 CBM',
    lcl: 'Stronger below ~12 CBM on any reading; keep comparing in between',
