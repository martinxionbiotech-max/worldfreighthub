  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const qatarPortSources: Source[] = [mwani, ...sourcesByIds(['qatar-customs'])];
const rateSources: Source[] = [presou, chinabestfreight];
const taxSources: Source[] = [...sourcesByIds(['qatar-customs']), traddal, goodsacrossborders];
const transitSources: Source[] = [wfhRouteData, chinabestfreight];
const costSources: Source[] = [...taxSources, presou, chinabestfreight, wfhRouteData];

const seaRateRows = [
  {
    mode: 'LCL ocean · China → Hamad Port / Doha',
    benchmark: 'USD 70–155 per CBM',
    basis: 'Presou China→Qatar LCL snapshot',
    note: 'Per-CBM shared-container basis; minimum charge may apply',
    confidence: 'LOW',
  },
  {
    mode: 'FCL 20GP · China → Hamad Port',
    benchmark: 'Not published — request an all-in quote',
    basis: 'No verified Qatar 20GP rate appeared in the research snapshot',
    note: 'Priced per container; differs by line and season',
    confidence: 'LOW',
  },
  {
    mode: 'FCL 40GP / 40HQ · China → Hamad Port',
    benchmark: 'Not published — request an all-in quote',
    basis: 'No verified Qatar 40GP/40HQ rate appeared in the research snapshot',
    note: '40ft is usually the volume benchmark for established importers',
    confidence: 'LOW',
  },
  {
    mode: 'FCL · China → Hamad Port project/oversized cargo',
    benchmark: 'Not published — request a project-specific quote',
