const cogoportQatar: Source = {
  id: 'cogoport-qatar',
  name: 'Cogoport — Ningbo→Hamad indicative platform freight (bundled basis; not a port-to-port quote)',
  url: 'https://www.cogoport.com/lt-LT/rates/ningbo-pt-sp-to-hamad-sp',
  type: 'industry',
};
const windwardReroute: Source = {
  id: 'windward-reroute',
  name: 'Windward — Maritime intelligence daily: Qatar designates Sohar, Salalah and Duqm as alternatives to Hamad (Mar 2026)',
  url: 'https://windward.ai/blog/march-27-maritime-intelligence-daily/',
  type: 'industry',
};
const lloydsPorts: Source = {
  id: 'lloydslist-update',
  name: 'Lloyd’s List — Middle East port operational update (12 Mar 2026)',
  url: 'https://www.lloydslist.com/LL1156595/Middle-East-port-operational-update-Thursday-March-12',
