  },
];

const factorRows = [
  {
    factor: 'Fuel, bunker and surcharges',
    effect: 'BAF / CAF / peak-season surcharges are added to the base rate',
    note: 'Request the full surcharge schedule, not just the headline rate',
    confidence: 'LOW',
  },
  {
    factor: 'Season and capacity',
    effect: 'Peak season, holidays and tight capacity raise rates',
    note: 'Timing is a major cost lever',
    confidence: 'LOW',
  },
  {
    factor: 'Routing: direct vs transshipment',
    effect: 'A transshipped box adds another terminal handling point',
    note: 'Direct loops are faster but less frequent on a smaller corridor',
    confidence: 'LOW',
  },
  {
    factor: 'Qatar market size',
    effect: 'Lower volume than Dubai raises per-shipment cost absorption',
    note: 'Expect less schedule density and more per-unit cost sensitivity',
    confidence: 'LOW',
  },
  {
    factor: 'Single-gateway concentration',
    effect: 'All container cargo clears through Hamad; there is no in-country fallback port',
    note: 'Crisis routing shifts to Omani ports plus overland legs — plan the contingency',
    confidence: 'LOW',
  },
  {
    factor: 'Commodity and HS code',
    effect: 'Changes the duty line, permit and restricted-goods exposure',
