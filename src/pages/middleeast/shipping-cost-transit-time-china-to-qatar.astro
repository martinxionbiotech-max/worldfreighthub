const pageUrl = `${SITE_URL}/middleeast/shipping-cost-transit-time-china-to-qatar/`;
const hamadPort = gccPorts.find((item) => item.slug === 'hamad');
const unlocode = hamadPort?.unlocode ?? '—';

const mwani: Source = {
  id: 'mwani-hamad',
  name: 'Mwani Qatar — Hamad Port',
  url: 'https://www.mwani.com.qa/English/ports/hamadport/Pages/default.aspx',
  type: 'port-authority',
};
const traddal: Source = {
  id: 'traddal-qatar',
  name: 'Traddal — Calculate duties and taxes for imports to Qatar',
  url: 'https://traddal.com/resources/calculate-duties-taxes-imports-qatar',
  type: 'organization',
};
const goodsacrossborders: Source = {
  id: 'goodsacrossborders-qatar',
  name: 'Goods Across Borders — Qatar import duty and tax guide',
  url: 'https://goodsacrossborders.com/countries/qatar',
  type: 'organization',
};
const presou: Source = {
  id: 'presou-qatar',
  name: 'Presou — How much does it cost to ship from China to Qatar',
  url: 'https://presou.com/how-much-does-it-cost-to-ship-from-china-to-qatar/',
  type: 'industry',
};
const chinabestfreight: Source = {
  id: 'chinabestfreight-qatar',
  name: 'China Best Freight — Shipping from China to Qatar',
