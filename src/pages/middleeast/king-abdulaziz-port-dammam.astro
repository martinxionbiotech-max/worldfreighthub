---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/king-abdulaziz-port-dammam/`;
const port = gccPorts.find((item) => item.slug === 'dammam');
const unlocode = port?.unlocode ?? '—';

const cargofromchina: Source = {
  id: 'cargofromchina',
  name: 'Cargo From China — China to Saudi Arabia guide',
  url: 'https://cargofromchina.com/china-saudiarabia/',
  type: 'industry',
};
const ddpchain: Source = {
  id: 'ddpchain',
  name: 'DDP Chain — China to Saudi Arabia',
  url: 'https://ddpchain.com/saudi-arabia/',
  type: 'industry',
};
const freightos: Source = {
  id: 'freightos',
  name: 'Freightos — Shanghai to Riyadh route data',
  url: 'https://www.freightos.com',
  type: 'industry',
};
const commenda: Source = {
  id: 'commenda',
  name: 'Commenda — Saudi Arabia import VAT guide',
  url: 'https://www.commenda.io/saudi-arabia/import-vat',
  type: 'organization',
};
const fuxinCcpt: Source = {
  id: 'fuxin-ccpit',
  name: 'Liaoning CCPIT — SABER SC certificate notice (26 Dec 2024)',
  url: 'https://www.fuxin.gov.cn/content/2024/962553.html',
  type: 'government',
};
const worldcargonews: Source = {
  id: 'worldcargonews',
  name: 'World Cargo News — Mawani ports handle 8.3m TEU in 2025',
  url: 'https://www.worldcargonews.com/ports-terminals/2026/01/mawani-ports-handle-8-3m-teu-in-2025/',
  type: 'industry',
};

const portSources = sourcesByIds(['mawani']);
const facilitySources = sourcesByIds(['mawani', 'dp-world']);
const transitSources: Source[] = [cargofromchina, ddpchain, freightos];
const routingSources: Source[] = [cargofromchina, freightos, ddpchain];
const costSources: Source[] = [
  ...sourcesByIds(['zatca', 'mawani']),
  commenda,
  fuxinCcpt,
  freightos,
];
const complianceSources = sourcesByIds(['zatca', 'mawani']);
const decisionSources: Source[] = [cargofromchina, freightos, ddpchain, worldcargonews];

const parameterRows = [
  {
    parameter: 'Country',
    value: 'Saudi Arabia',
    note: 'GCC member; freight moves on the China–GCC corridor',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Coast / region',
    value: 'Arabian Gulf, eastern Saudi Arabia',
    note: 'Serves the Eastern Province, Riyadh and central Saudi Arabia',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Port role',
    value: 'Main Arabian Gulf gateway',
    note: 'Principal eastern gateway for container and industrial cargo',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'UN/LOCODE',
    value: unlocode,
    note: 'Seaport code used on the bill of lading',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Berths',
    value: 'Not published in verified snapshot',
    note: 'Verify berth count and operator allocation with Mawani',
    confidence: 'LOW',
  },
  {
    parameter: 'Maximum water depth',
    value: 'Not published in verified snapshot',
    note: 'Verify approach channel and alongside depth with Mawani',
    confidence: 'LOW',
  },
  {
    parameter: 'Annual throughput (port-specific)',
    value: 'Not published per-port',
    note: 'Mawani total across Saudi ports was 8.3M TEU in 2025',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    origin: 'Shanghai',
    service: 'Sea port-to-port',
    transit: '~20 days typical (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'LOW',
  },
  {
    origin: 'Ningbo-Zhoushan',
    service: 'Sea port-to-port',
    transit: '~20 days typical (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'LOW',
  },
  {
    origin: 'Shenzhen (Yantian / Shekou)',
    service: 'Sea port-to-port',
    transit: '~20 days typical (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'LOW',
  },
  {
    origin: 'Shanghai → Riyadh (via Dammam)',
    service: 'FCL corridor',
    transit: '~30–40 days',
    basis: 'Freightos Shanghai–Riyadh FCL route data',
    confidence: 'LOW',
  },
  {
    origin: 'China → Dammam / Riyadh Dry Port',
    service: 'Sea plus inland leg',
    transit: '~30–45 days',
    basis: 'Freightos and market corridor context',
    confidence: 'LOW',
  },
];

const decisionRows = [
  {
    scenario: 'Eastern Province consignees (Dammam, Khobar, Jubail)',
    bestPort: 'Dammam',
    why: 'Arabian Gulf location sits inside the Eastern Province industrial corridor',
    confidence: 'LOW',
  },
  {
    scenario: 'Riyadh and central Saudi Arabia',
    bestPort: 'Dammam + Riyadh Dry Port',
    why: 'Established rail/road inland transfer to the capital region',
    confidence: 'LOW',
  },
  {
    scenario: 'Oil & gas equipment and project cargo',
    bestPort: 'Dammam',
    why: 'Closest major gateway to Eastern Province energy and industrial sites',
    confidence: 'LOW',
  },
  {
    scenario: 'Oversized or heavy industrial machinery',
    bestPort: 'Dammam',
    why: 'Eastern industrial hinterland and Riyadh corridor handle project traffic',
    confidence: 'LOW',
  },
  {
    scenario: 'Western KSA consignees (Jeddah, Makkah, Madinah)',
    bestPort: 'Jeddah',
    why: 'Red Sea gateway keeps the western inland leg short',
    confidence: 'LOW',
  },
  {
    scenario: 'Makkah / Madinah religious and Hajj cargo',
    bestPort: 'Jeddah',
    why: 'Nearest major container gateway to the two holy cities',
    confidence: 'LOW',
  },
];

const facilityRows = [
  {
    facility: 'Container terminals',
    function: 'Deep-sea container handling for Arabian Gulf services',
    note: 'Operator and berth detail not enumerated in snapshot — verify with Mawani',
    confidence: 'LOW',
  },
  {
    facility: 'General cargo and RoRo',
    function: 'Breakbulk, vehicles, rolling stock and mixed cargo',
    note: 'Typical commercial-port capability; verify service availability',
    confidence: 'LOW',
  },
  {
    facility: 'Bulk and breakbulk',
    function: 'Eastern Province industrial and commodity traffic',
    note: 'Serves the energy and industrial hinterland',
    confidence: 'LOW',
  },
  {
    facility: 'Rail link to Riyadh Dry Port',
    function: 'Inland container transfer to the Riyadh area',
    note: 'Rail/road corridor noted in WorldFreightHub port data',
    confidence: 'LOW',
  },
  {
    facility: 'Oil & gas project cargo',
    function: 'Heavy and oversized energy-sector handling',
    note: 'Verify lift capacity and laydown area before booking',
    confidence: 'LOW',
  },
  {
    facility: 'Road hinterland',
    function: 'Trucking to Eastern Province, Riyadh and central KSA',
    note: 'Inland distance and rate are route-dependent',
    confidence: 'LOW',
  },
];

const costRows = [
  {
    item: 'Destination THC and port charges',
    who: 'Dammam terminal',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Customs clearance and brokerage',
    who: 'Saudi customs broker / agent',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'SABER PC and SC conformity fees',
    who: 'SASO / SABER platform + laboratories',
    magnitude: 'PC per product + SC per shipment; not published — request quote',
    confidence: 'LOW',
  },
  {
    item: 'Demurrage',
    who: 'Terminal (after free time)',
    magnitude: 'Per-day charge; free time varies by terminal and line',
    confidence: 'LOW',
  },
  {
    item: 'Detention',
    who: 'Ocean carrier (after free time)',
    magnitude: 'Per-day charge; free time varies by carrier',
    confidence: 'LOW',
  },
  {
    item: 'Inland trucking / rail to Riyadh',
    who: 'Trucking or rail operator',
    magnitude: 'Not published in verified snapshot — request destination quote',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'ZATCA',
    magnitude: '5% of CIF value (GCC Common External Tariff)',
    confidence: 'MEDIUM',
  },
  {
    item: 'Import VAT',
    who: 'ZATCA',
    magnitude: '15% on CIF value + customs duty',
    confidence: 'HIGH',
  },
  {
    item: 'Excise tax (if applicable)',
    who: 'ZATCA',
    magnitude: 'Tobacco 100%; energy drinks 50%; carbonated drinks 50%',
    confidence: 'MEDIUM',
  },
];

const faqs = [
  {
    q: 'Where is King Abdulaziz Port Dammam located?',
    a: 'King Abdulaziz Port is eastern Saudi Arabia’s Arabian Gulf gateway, where the Saudi ×1.2075 stack means a $10,000 CIF shipment clears at $12,075. It serves the eastern industrial region plus Riyadh through inland transfer.',
  },
  {
    q: 'What is the UN/LOCODE for Dammam port?',
    a: 'The UN/LOCODE is SADMM. Use it on the bill of lading and customs paperwork when the destination is King Abdulaziz Port Dammam.',
  },
  {
    q: 'How long does sea freight take from China to Dammam?',
    a: 'Indicative transit is about 20 days typical for Shanghai, Ningbo-Zhoushan and Shenzhen routes, with a 15–30 day planning range. When the cargo continues to Riyadh, plan roughly 30–45 days for the sea plus inland leg. These are LOW-confidence estimates — verify with your carrier.',
  },
  {
    q: 'Why is Dammam the usual choice for Riyadh cargo?',
    a: 'Dammam is the established Gulf-side gateway to Riyadh Dry Port, cutting the full China–Riyadh corridor to roughly 30–45 days versus Jeddah’s ~18-day ocean plus a long cross-country haul. The rail/road inland corridor is the conventional routing for central Saudi Arabia, while Jeddah is the Red Sea alternative for the western region.',
  },
  {
    q: 'What is Riyadh Dry Port and how does it relate to Dammam?',
    a: 'Riyadh Dry Port is an inland facility served by rail/road from Dammam, adding an inland leg to the ~20-day China–Dammam ocean transit for a 30–45 day full corridor. Containers discharge at Dammam and move inland for customs and final distribution around the capital.',
  },
  {
    q: 'Is Dammam the right port for oil and gas equipment?',
    a: 'Usually yes: Dammam sits inside the Eastern Province, Saudi Arabia’s oil and gas heartland, and offers the same ×1.2075 duty+VAT stack as Jeddah while keeping energy-sector cargo close to the final site. Confirm lift capacity, laydown area and route clearances for oversized pieces before booking.',
  },
  {
    q: 'Do I need SABER certificates for a Dammam shipment?',
    a: 'Yes, if your goods are regulated. Obtain the Product Conformity Certificate (PC) per product, then the Shipment Conformity Certificate (SC) per shipment. Since 1 January 2025 the SC must be obtained before cargo arrival or clearance fails, regardless of which Saudi port you use.',
  },
  {
    q: 'What import taxes apply at Dammam?',
    a: 'The baseline import duty is 5% of CIF value under the GCC Common External Tariff, and Saudi import VAT is 15%, calculated on CIF value plus customs duty. Excise tax can add 100% on tobacco, 50% on energy drinks and 50% on carbonated drinks where applicable.',
  },
  {
    q: 'What documents are needed for customs clearance at Dammam?',
    a: 'The standard set is a commercial invoice, bill of lading, packing list, certificate of origin, and a SABER conformity certificate for regulated goods. Classify the goods with the correct HS code and submit the pre-arrival declaration through the FASAH single window.',
  },
  {
    q: 'What is FASAH and how does it apply at Dammam?',
    a: 'FASAH is Saudi Arabia’s single-window system that calculates the 5% duty + 15% VAT and connects importers, brokers, terminals and ZATCA in one flow. Filing before the vessel arrives helps keep demurrage and detention off the final invoice.',
  },
  {
    q: 'How do demurrage and detention work at Dammam?',
    a: 'Demurrage is charged by the terminal when an imported container stays inside the port beyond free time after discharge. Detention is charged by the carrier when the container stays outside the port beyond free time. Finish clearance and book trucking or rail before discharge to avoid both.',
  },
  {
    q: 'How should I compare Dammam and Jeddah?',
    a: 'Compare by final inland leg and not tax, because both Saudi ports share the ×1.2075 stack. Dammam suits the Eastern Province, Riyadh via Riyadh Dry Port, and oil & gas project cargo; Jeddah suits the western region, Makkah/Madinah and Red Sea trade. Always confirm the inland distance, cost and transit before choosing.',
  },
  {
    q: 'Are the berth and throughput figures on this page verified?',
    a: 'Port-specific berth, depth and throughput are not published, but the verified aggregate is 8.3M TEU in 2025, and the Saudi ×1.2075 stack is independent of the port. Confirm current port-specific figures with Mawani before planning capacity-sensitive cargo.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'King Abdulaziz Port Dammam — China Shipping Guide: Routing, Riyadh Transit & Saudi Clearance (August 2026)',
      description:
        'King Abdulaziz Port Dammam intelligence for China freight: Arabian Gulf location, port parameters, China transit windows, Dammam vs Jeddah routing, Riyadh Dry Port transfer, post-arrival costs and SABER/VAT compliance.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
  {
    type: 'Place',
    data: {
      name: 'King Abdulaziz Port Dammam',
      url: pageUrl,
      additionalType: 'Seaport',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Dammam',
        addressCountry: 'SA',
      },
      description:
        'King Abdulaziz Port Dammam is the main Arabian Gulf gateway of Saudi Arabia, serving the Eastern Province, Riyadh through Riyadh Dry Port, and the oil & gas industrial hinterland.',
    },
  },
];
---

<BaseLayout
  title="King Abdulaziz Port Dammam — China Shipping Guide: Routing, Riyadh Transit & Saudi Clearance (August 2026)"
  description="King Abdulaziz Port Dammam intelligence for China freight: Arabian Gulf location, port parameters, China transit windows, Dammam vs Jeddah routing, Riyadh Dry Port transfer, post-arrival costs and SABER/VAT compliance."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'King Abdulaziz Port Dammam' },
        ]}
      />
      <span class="badge badge--amber">August 2026 updated</span>
      <h1>King Abdulaziz Port Dammam: China freight guide for the Arabian Gulf gateway</h1>
      <p class="lead">
        A port-intelligence page for shippers routing China freight to eastern and central Saudi
        Arabia. This page explains what King Abdulaziz Port Dammam is, why it wins Eastern Province
        and Riyadh cargo, how long China ocean moves take, what the port costs after arrival, and
        the SABER/VAT clearance rules that apply at the gate.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> King Abdulaziz Port Dammam serves the Eastern Province and Riyadh, but its Saudi stack is the same &#215;1.2075 (5% duty + 15% VAT) as Jeddah, producing $12,075 on a $10,000 CIF shipment. For Riyadh cargo, the shorter Dammam inland haul can outweigh a lower Jeddah ocean rate; the full China&#8211;Riyadh corridor via Dammam is roughly 30&#8211;45 days versus Jeddah&#8217;s ~18-day ocean leg to a much longer cross-country haul. Dammam&#8217;s ~20-day typical China ocean leg is ~2 days slower than Jeddah&#8217;s ~18 days, so the winner is decided by whether the inland leg saves more than that 2-day margin.</p>
      </blockquote>
      <p class="small muted">
        Confidence badges separate verified figures from indicative market and port snapshots. Treat
        every LOW-confidence transit, facility and fee note as indicative, verify with Mawani or your
        carrier before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Saudi import VAT</span>
          <span class="fact-value">15% <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline import duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER SC rule</span>
          <span class="fact-value">Before arrival <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">UN/LOCODE</span>
          <span class="fact-value">{unlocode} <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">China sea transit</span>
          <span class="fact-value">~20 days typical <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Riyadh via Dammam</span>
          <span class="fact-value">30–45 days <ConfidenceBadge level="LOW" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Why Dammam matters for China freight</h2>
    <p>
      King Abdulaziz Port Dammam is the anchor of Saudi Arabia’s Arabian Gulf side. For China–Saudi
      ocean freight, it is the natural first choice when the consignee is in the Eastern Province —
      the country’s oil and gas heartland — or when the goods need to reach Riyadh and central Saudi
      Arabia through the Riyadh Dry Port inland corridor.
    </p>
    <p>
      The commercial logic is one of hinterland. Dammam sits inside the eastern industrial region,
      close to energy, petrochemical and project-cargo activity, and it feeds the rail/road corridor
      into the capital. That makes the port the conventional gateway for Riyadh, even though Jeddah
      is geographically closer to the western region. Choosing the right discharge port is therefore
      usually an inland-leg decision: Jeddah for the west, Dammam for the east and the Riyadh
      corridor.
    </p>
    <p>
      The verified research snapshot does not publish a port-specific throughput number for Dammam.
      It does confirm the Mawani total: Saudi ports handled <strong>8.3 million TEU in 2025</strong>,
      up 10.6% year-on-year. Dammam’s specific berth, depth and TEU figures are therefore marked LOW
      and attributed to Mawani in the parameter table below rather than invented.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. King Abdulaziz Port Dammam parameters</h2>
      <p>
        Use this table as an orientation, not a capacity guarantee. Port-specific berth and depth
        figures were not published in the verified research snapshot, so those rows stay deliberately
        empty of invented numbers and point you to Mawani for the current value.
      </p>

      <DataTable
        columns={[
          { key: 'parameter', label: 'Parameter' },
          { key: 'value', label: 'Value' },
          { key: 'note', label: 'Planning note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={parameterRows}
        caption="Port parameters — verify berth, depth and per-port throughput with the Saudi Ports Authority (Mawani) before relying on these details."
      />
      <SourceList sources={portSources} title="Sources — Dammam port parameters" />

      <div class="note mt-2">
        <strong>Capacity-sensitive cargo:</strong> if your consignment depends on a specific berth
        length, draft, crane capability or heavy-lift availability, request the current terminal
        schedule and restrictions from Mawani or your forwarder before booking. The verified snapshot
        does not supply those numbers.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. China to Dammam transit windows</h2>
    <p>
      Transit to Dammam is usually quoted as a window, not a promise. The Arabian Gulf routing has
      an extra inland leg for Riyadh cargo, so the port-to-port figure and the Riyadh door figure
      should not be confused. Confirm the vessel, voyage, transhipment points and inland handover
      before you commit a delivery date.
    </p>

    <DataTable
      columns={[
        { key: 'origin', label: 'Origin' },
        { key: 'service', label: 'Service' },
        { key: 'transit', label: 'Indicative transit' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={transitRows}
      caption="Indicative transit windows only — verify with the relevant carrier before relying on these figures."
    />
    <SourceList sources={transitSources} title="Sources — China to Dammam transit times" />

    <div class="note mt-2">
      <strong>Port-to-port vs Riyadh door:</strong> about 20 days typical for the ocean leg is not
      the same as total door time to Riyadh. Add the Dammam discharge, customs or dry-port transfer
      and final trucking; Freightos and market context put the Shanghai–Riyadh corridor around 30–45
      days.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Dammam vs Jeddah: which discharge port fits your consignment?</h2>
      <p>
        This is the decision that determines most of the destination cost and transit. Dammam wins
        the east and the Riyadh corridor; Jeddah wins the west and the Makkah–Madinah corridor. The
        table below gives the common scenarios from the Dammam side, and the two cards summarise the
        rule that will be expanded in a dedicated Jeddah vs Dammam comparison page.
      </p>

      <DataTable
        columns={[
          { key: 'scenario', label: 'Scenario' },
          { key: 'bestPort', label: 'Best-fit port' },
          { key: 'why', label: 'Why' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={decisionRows}
        caption="Routing heuristics, not guaranteed carrier schedules. Confirm the inland leg and cost before choosing the discharge port."
      />
      <SourceList sources={decisionSources} title="Sources — Dammam vs Jeddah routing context" />

      <div class="grid grid--2 mt-2">
        <Card title="Choose Dammam when...">
          <ul>
            <li>The consignee is in Dammam, Khobar, Jubail or the Eastern Province.</li>
            <li>The cargo is oil &amp; gas, industrial, heavy or project freight.</li>
            <li>You want the established Dammam → Riyadh Dry Port inland corridor.</li>
            <li>The eastern Arabian Gulf routing better matches your origin or carrier.</li>
          </ul>
        </Card>
        <Card title="Choose Jeddah instead when...">
          <ul>
            <li>The consignee is in Jeddah, Makkah, Madinah, Tabuk or the western region.</li>
            <li>The cargo serves pilgrimage, religious or Red Sea trade flows.</li>
            <li>A shorter western inland leg beats a cross-country rail/road move.</li>
            <li>You are comparing direct vs transhipped Red Sea service options.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Terminals, facilities and the Riyadh hinterland</h2>
    <p>
      Dammam operates as a commercial seaport serving both container traffic and the Eastern
      Province’s industrial base. The verified snapshot does not enumerate a terminal-by-terminal
      operator list or specific berth counts, so this list is an operational orientation marked LOW
      and should be confirmed against Mawani and your forwarder for the actual call.
    </p>

    <DataTable
      columns={[
        { key: 'facility', label: 'Facility' },
        { key: 'function', label: 'Function' },
        { key: 'note', label: 'Planning note' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={facilityRows}
      caption="Facility orientation, not a terminal directory. Confirm operator, berth and inland-transfer details with Mawani before booking."
    />
    <SourceList sources={facilitySources} title="Sources — Dammam facilities & terminals" />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. Post-arrival cost composition at Dammam</h2>
      <p>
        The ocean rate is only one line. Destination THC, clearance, SABER conformity, and the
        per-day charges that appear when a container is not collected in time are the costs that
        surprise first-time importers — and the reason “all-in” is the only useful comparison number.
        For Riyadh cargo, the inland rail or trucking leg is an additional line Jeddah shipments may
        not carry.
      </p>

      <h3>Demurrage and detention</h3>
      <p>
        <strong>Demurrage</strong> is charged by the terminal when an imported container stays inside
        the port beyond the free time after discharge. <strong>Detention</strong> is charged by the
        ocean carrier when the container stays outside the port beyond the free time after collection.
        Free-time allowances and per-day rates differ by line and terminal and were not published in
        the verified snapshot, so always request the fee schedule before booking.
      </p>
      <p>
        The practical way to avoid both is to finish clearance before the vessel arrives: submit the
        FASAH pre-arrival declaration, obtain the SABER SC before arrival, keep documents ready, and
        book trucking or rail before the container is discharged.
      </p>

