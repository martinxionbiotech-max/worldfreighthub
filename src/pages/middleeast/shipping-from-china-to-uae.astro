---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-from-china-to-uae/`;

const cargofromchinaUae: Source = {
  id: 'cargofromchina-uae',
  name: 'Cargo From China — China to UAE guide',
  url: 'https://cargofromchina.com/china-uae/',
  type: 'industry',
};
const docshipper: Source = {
  id: 'docshipper-uae',
  name: 'China DocShipper — China to UAE freight guide',
  url: 'https://china.docshipper.com/en/freight-shipping-china-uae/',
  type: 'industry',
};
const fta: Source = {
  id: 'fta-uae-vat',
  name: 'UAE Federal Tax Authority — VAT',
  url: 'https://tax.gov.ae/en/taxes/Vat.aspx',
  type: 'government',
};
const numeral: Source = {
  id: 'numeral-uae-vat',
  name: 'Numeral — UAE VAT rates and compliance',
  url: 'https://www.numeral.com/blog/uae-vat-rates-and-compliance',
  type: 'organization',
};
const wfhRouteData: Source = {
  id: 'wfh-uae-route-data',
  name: 'WorldFreightHub route data — Shanghai to Jebel Ali (typical 21 days, range 15–30)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const uaePortSources = sourcesByIds(['dp-world', 'abu-dhabi-ports', 'dubai-customs']);
const complianceSources = [...sourcesByIds(['dubai-customs']), fta, numeral];
const rateSources: Source[] = [cargofromchinaUae];
const transitSources: Source[] = [wfhRouteData, cargofromchinaUae];
const modeSources: Source[] = [cargofromchinaUae, docshipper];
const costSources: Source[] = [
  ...sourcesByIds(['dubai-customs']),
  fta,
  numeral,
  cargofromchinaUae,
  docshipper,
];

const rateRows = [
  {
    service: 'LCL ocean — Dubai / Jebel Ali',
    benchmark: 'AED 880–980 per CBM',
    basis: 'cargofromchina China→UAE LCL snapshot (Dubai)',
    confidence: 'LOW',
  },
  {
    service: 'Air freight / express',
    benchmark: 'AED 20–23.5 per kg',
    basis: 'cargofromchina China→UAE air snapshot',
    confidence: 'LOW',
  },
  {
    service: 'FCL ocean — 20GP / 40GP / 40HQ',
    benchmark: 'Not published in verified snapshot — request an all-in quote',
    basis: 'No verified UAE FCL rate appeared in the research snapshot',
    confidence: 'LOW',
  },
  {
    service: 'Express courier',
    benchmark: 'Not published in verified snapshot — request a per-kg quote',
    basis: 'Courier pricing is weight/zone dependent; not stated in snapshot',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    destination: 'Jebel Ali (Dubai)',
    mode: 'Sea',
    transit: 'Typical 21 days (range 15–30)',
    basis: 'WorldFreightHub route data for Shanghai–Jebel Ali',
    confidence: 'MEDIUM',
  },
  {
    destination: 'Dubai / UAE corridor',
    mode: 'Sea',
    transit: '14–18 days',
    basis: 'cargofromchina China→UAE sea snapshot',
    confidence: 'LOW',
  },
  {
    destination: 'Dubai / UAE corridor',
    mode: 'Air express',
    transit: '2–4 days',
    basis: 'cargofromchina China→UAE express snapshot',
    confidence: 'LOW',
  },
  {
    destination: 'Dubai / UAE corridor',
    mode: 'DDP air door-to-door',
    transit: '3–6 days',
    basis: 'cargofromchina DDP air note',
    confidence: 'LOW',
  },
];

const modeRows = [
  {
    mode: 'Sea (FCL / LCL)',
    bestFor: 'Large, heavy or cost-sensitive cargo; full pallets and containers',
    indicativeTime: '14–18 days (LOW); Shanghai–Jebel Ali typical 21 days (MEDIUM)',
    indicativeCost: 'LCL AED 880–980/CBM; FCL by quote (LOW)',
    confidence: 'LOW',
  },
  {
    mode: 'Air freight',
    bestFor: 'Time-critical, light or high-value cargo',
    indicativeTime: '2–4 days (LOW)',
    indicativeCost: 'AED 20–23.5/kg (LOW)',
    confidence: 'LOW',
  },
  {
    mode: 'Express courier',
    bestFor: 'Small urgent parcels, samples and documents',
    indicativeTime: '2–4 days (LOW)',
    indicativeCost: 'By quote, weight/zone dependent (LOW)',
    confidence: 'LOW',
  },
];

const chinaPortRows = [
  {
    port: 'Shanghai',
    throughput: '55.06M TEU (2025)',
    note: 'World #1 container port, 16th consecutive year',
    confidence: 'HIGH',
  },
  {
    port: 'Ningbo-Zhoushan',
    throughput: '43M TEU (2025)',
    note: '#3 container port; first port above 1.4bn tonnes cargo',
    confidence: 'HIGH',
  },
  {
    port: 'Shenzhen (Yantian / Shekou)',
    throughput: 'Not published in snapshot',
    note: 'South China gateway',
    confidence: 'LOW',
  },
  {
    port: 'Guangzhou',
    throughput: 'Not published in snapshot',
    note: 'South China origin named across UAE freight guides',
    confidence: 'LOW',
  },
];

const uaePortRows = [
  {
    factor: 'Emirate / coast',
    jebelAli: 'Dubai — Arabian Gulf',
    khalifa: 'Abu Dhabi — Arabian Gulf',
    sharjah: 'Sharjah — Arabian Gulf',
    confidence: 'MEDIUM',
  },
  {
    factor: 'UN/LOCODE',
    jebelAli: 'AEJEA',
    khalifa: 'AEKHL',
    sharjah: 'AESHJ',
    confidence: 'HIGH',
  },
  {
    factor: 'Main role',
    jebelAli: "Middle East's largest container port; DP World operated",
    khalifa: 'Semi-automated deep-water Abu Dhabi gateway',
    sharjah: 'Container gateway for Sharjah and the northern emirates',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Typical use case',
    jebelAli: 'Primary China import gateway + GCC/regional transshipment',
    khalifa: 'Abu Dhabi consignees + industrial/project cargo',
    sharjah: 'Sharjah/northern emirates + cost-sensitive cargo',
    confidence: 'LOW',
  },
];

const costRows = [
  {
    item: 'Ocean or air freight',
    who: 'Carrier / forwarder',
    magnitude: 'See rate table',
    confidence: 'LOW',
  },
  {
    item: 'Origin charges (China)',
    who: 'Forwarder / terminals',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Destination THC & port charges',
    who: 'Jebel Ali / Khalifa / Sharjah terminal',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'UAE customs clearance & brokerage',
    who: 'Dubai Customs / local broker',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'Dubai Customs / FTA',
    magnitude: '5% of CIF value (GCC Common External Tariff)',
    confidence: 'MEDIUM',
  },
  {
    item: 'Import VAT',
    who: 'Federal Tax Authority',
    magnitude: '5% on CIF value + customs duty',
    confidence: 'MEDIUM',
  },
  {
    item: 'Demurrage',
    who: 'Terminal (after free time)',
    magnitude: 'Per-day charge; free time varies by terminal and line',
    confidence: 'LOW',
  },
  {
    item: 'Detention',
    who: 'Ocean carrier (after free time)',
    magnitude: 'Per-day charge; free time varies by carrier',
    confidence: 'LOW',
  },
  {
    item: 'Cargo insurance (optional)',
    who: 'Insurer / forwarder',
    magnitude: 'Optional; typically a small percentage of cargo value',
    confidence: 'LOW',
  },
];

const factorRows = [
  {
    factor: 'Peak season / general rate increases',
    effect: 'Higher ocean and air rates; tighter space',
    direction: 'Cost up, transit risk up',
    confidence: 'LOW',
  },
  {
    factor: 'Fuel / bunker adjustment factor',
    effect: 'Adds a variable surcharge to the base freight rate',
    direction: 'Cost up',
    confidence: 'LOW',
  },
  {
    factor: 'LCL consolidation & CFS handling',
    effect: 'Extra origin/destination warehouse handling vs FCL',
    direction: 'Transit up vs FCL',
    confidence: 'LOW',
  },
  {
    factor: 'Free zone vs mainland final leg',
    effect: 'Changes duty/VAT treatment and delivery routing',
    direction: 'Cost/compliance variable',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Documents & HS code readiness',
    effect: 'Late or wrong documents delay clearance and start demurrage',
    direction: 'Transit up, cost up',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Port choice (Jebel Ali vs Khalifa vs Sharjah)',
    effect: 'Shifts transit, destination THC and inland distance',
    direction: 'Cost/time variable',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'How long does shipping from China to the UAE take?',
    a: 'Sea transit splits between 14–18 days (cargofromchina, LOW) and the 21-day typical with a 15–30 day range for Shanghai–Jebel Ali (MEDIUM), while air express at 2–4 days can cut the slowest sea leg by up to 93%. DDP air adds 3–6 days door-to-door (LOW); verify all figures with your carrier before relying on them.',
  },
  {
    q: 'How much does shipping from China to the UAE cost?',
    a: 'The snapshot prices LCL ocean at AED 880–980/CBM (AED 8,800–9,800 for 10 CBM) and air at AED 20–23.5/kg (AED 2,000–2,350 for 100 kg), both LOW-confidence. Verified UAE FCL rates were not published, so request an all-in container quote; confirm figures with a forwarder before booking.',
  },
  {
    q: 'What is the UAE VAT rate on imports?',
    a: 'The UAE standard VAT rate is 5% on the duty-inclusive CIF value, so with the 5% baseline duty the landed-cost multiplier is ×1.1025 — 10.25% above CIF. It was introduced on 1 January 2018, and you should confirm the rate with the Federal Tax Authority before relying on it.',
  },
  {
    q: 'What is the standard UAE import duty?',
    a: 'The baseline import duty is 5% of CIF — US$500 on a US$10,000 CIF shipment — under the GCC Common External Tariff; specific goods can attract higher protective or anti-dumping rates, so classify your HS code correctly before quoting.',
  },
  {
    q: 'Which UAE port should I use — Jebel Ali, Khalifa or Sharjah?',
    a: 'Jebel Ali is the default China import gateway, with the page’s route data recording a 21-day typical (15–30 day range) for Shanghai–Jebel Ali. Khalifa Port Abu Dhabi is a semi-automated deep-water option for Abu Dhabi consignees, and Port Khalid in Sharjah suits the northern emirates; match the discharge port to your consignee and confirm the inland delivery leg.',
  },
  {
    q: 'Why is Jebel Ali considered the Middle East’s hub?',
    a: 'Jebel Ali, operated by DP World, is the region’s largest container port, and its 21-day typical Shanghai transit (15–30 day range) plus free-zone duty deferral make it a natural consolidation and transshipment point for the GCC, Middle East, Africa and Indian subcontinent — not just a Dubai gateway.',
  },
  {
    q: 'Is there a de minimis threshold for UAE imports?',
    a: 'Secondary sources set the duty/tax-free line at AED 1,000 and gifts at AED 3,000 — a 3× gap between the two thresholds. This is a secondary-source figure, so confirm with Dubai Customs or the FTA before you rely on it.',
  },
  {
    q: 'What documents do I need to import into the UAE?',
    a: 'The minimum import set is four documents — commercial invoice, bill of lading, packing list and certificate of origin — plus correct HS classification; regulated goods may add conformity documentation such as CE evidence, since the 5% duty, 5% VAT and conformity requirements all key off the HS code.',
  },
  {
    q: 'Do I need an ISF filing to ship to the UAE?',
    a: 'No — ISF is a US-only filing, so the UAE import path has zero ISF requirement; instead the 5% duty and 5% VAT are assessed through the pre-arrival declaration via Dubai Customs / the FTA, supported by the commercial invoice, packing list and bill of lading.',
  },
  {
    q: 'How does door-to-door shipping from China to the UAE work?',
    a: 'Door-to-door consolidates the 5% duty + 5% VAT into one 10.25% landed-cost layer on CIF (×1.1025), then adds collection, China export clearance, sea/air freight to Jebel Ali/Khalifa/Sharjah, the UAE import declaration and last-mile trucking. Under DDP the seller/forwarder carries those costs; under DAP or EXW the buyer handles more of the import side.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Shipping from China to the UAE: Costs, Transit Times & Compliance (August 2026)',
      description:
        'Verified China to UAE freight guide: 5% VAT, 5% baseline duty, Jebel Ali/Khalifa/Sharjah routing, Dubai gateway context, indicative LCL and air rates plus transit times.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="Shipping from China to the UAE: Costs, Transit Times & Compliance (August 2026)"
  description="Verified China to UAE freight guide: 5% VAT, 5% baseline duty, Jebel Ali/Khalifa/Sharjah routing, Dubai gateway context, indicative LCL and air rates plus transit times."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Shipping from China to the UAE' },
        ]}
      />
      <span class="badge badge--amber">August 2026 updated</span>
      <h1>Shipping from China to the UAE: costs, transit times &amp; compliance</h1>
      <p class="lead">
        A one-page freight brief for importers moving cargo from Shanghai, Ningbo-Zhoushan, Shenzhen
        or Guangzhou to Jebel Ali, Khalifa Port Abu Dhabi and Sharjah — with indicative LCL/air rates,
        transit windows, the sea/air/express decision, and the 5% VAT and 5% duty rules that shape
        your landed cost.
      </p>
      <p class="small muted">
        Confidence badges separate verified figures from indicative market snapshots. Treat every
        LOW-confidence rate and transit number as an indicative figure to verify with your carrier
        before relying on it.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> The UAE’s 5% duty + 5% VAT multiplies to a CIF × 1.1025 landed-cost multiplier, so imports clear 10.25% above CIF — exactly 10.5 percentage points below Saudi Arabia’s 20.75% stack. On a US$10,000 CIF shipment that is US$1,025 of duty + VAT (US$500 + US$525), landing at US$11,025 versus US$12,075 in Saudi Arabia — a US$1,050 tax saving for the same CIF value. The mode breakpoint is steep: sea’s 15–30 days versus air express’s 2–4 days means air can cut the slowest sea transit by up to 93%, while LCL’s AED 880–980/CBM translates to AED 8,800–9,800 for a 10 CBM shipment.</p>
      </blockquote>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">UAE import VAT</span>
          <span class="fact-value">5% <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline import duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Currency</span>
          <span class="fact-value">AED <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Sea transit</span>
          <span class="fact-value">14–18 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Air transit</span>
          <span class="fact-value">2–4 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Shanghai 2025</span>
          <span class="fact-value">55.06M TEU <ConfidenceBadge level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Indicative freight rates from China to the UAE</h2>
    <p>
      Ocean and air pricing moves weekly with capacity, fuel and peak season, so this page deliberately
      labels market figures as LOW confidence rather than presenting them as guaranteed prices. The
      UAE corridor is anchored by Jebel Ali, the region’s largest container port, which gives
      importers deep schedule choice — but the headline rate still has to be locked with an all-in
      quote, not an advertised number.
    </p>

    <DataTable
      columns={[
        { key: 'service', label: 'Service' },
        { key: 'benchmark', label: 'Indicative benchmark' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={rateRows}
      caption="Indicative market snapshots, not carrier quotes. FCL and courier rates were not published in the verified snapshot — request an all-in quote."
    />
    <SourceList sources={rateSources} title="Sources — UAE rates" />

    <div class="note mt-2">
      <strong>Why FCL is shown as “request a quote”:</strong> the research snapshot published LCL
      and air benchmarks but no verified UAE FCL container rate. Never back into a container price
      from the LCL figure — request the equipment type, surcharges and destination fees itemised
      in writing.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Transit times by port and mode</h2>
      <p>
        UAE transit times vary more than a single “average” suggests. Jebel Ali is the deepest and
        most direct container option for most China imports, while Khalifa and Sharjah can add or
        remove inland time depending on where the consignee actually is. The figures below are
        corridor-level research findings, not schedule guarantees.
      </p>

      <DataTable
        columns={[
          { key: 'destination', label: 'Destination' },
          { key: 'mode', label: 'Mode' },
          { key: 'transit', label: 'Indicative transit' },
          { key: 'basis', label: 'Basis' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={transitRows}
        caption="The Shanghai–Jebel Ali typical 21 days comes from WorldFreightHub route data; the 14–18 day corridor figure is a LOW-confidence secondary snapshot. Verify with the carrier."
      />
      <SourceList sources={transitSources} title="Sources — transit times" />

      <div class="note mt-2">
        <strong>Two different sea windows, explained:</strong> the 14–18 day figure is a market
        guide that assumes a fast direct sailing and no delay, while the 21-day typical with a
        15–30 day range is a planning figure that absorbs schedule and port variability. Use the
        wider range for commercial planning and the fast window only as a best case.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. Sea vs air vs express: which should you book?</h2>
    <p>
      The UAE is unusual because its short-haul China corridor makes air and express genuinely
      attractive for more than just emergency cargo. The right choice is a landed-cost and
      delivery-priority decision: sea wins on cost per CBM, air wins on days, and express wins on
      simplicity for parcels.
    </p>

    <DataTable
      columns={[
        { key: 'mode', label: 'Mode' },
        { key: 'bestFor', label: 'Best for' },
        { key: 'indicativeTime', label: 'Indicative time' },
        { key: 'indicativeCost', label: 'Indicative cost' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={modeRows}
      caption="Mode decision overview. Time and cost figures are indicative and LOW confidence except the Shanghai–Jebel Ali typical, which is MEDIUM from route data."
    />
    <SourceList sources={modeSources} title="Sources — mode comparison" />

    <div class="grid grid--2 mt-2">
      <Card title="Choose sea when...">
        <ul>
          <li>Your cargo is heavy, bulky or fills most of a pallet or container.</li>
          <li>You are restocking a warehouse or FBA/noon plan on a predictable schedule.</li>
          <li>Unit cost per CBM matters more than a few extra days.</li>
          <li>You are shipping large industrial, project or free-zone cargo.</li>
        </ul>
      </Card>
      <Card title="Choose air or express when...">
        <ul>
          <li>The product is light, high-value or time-critical.</li>
          <li>You are testing a market with a small launch quantity.</li>
          <li>A production delay means the sea window no longer works.</li>
          <li>You need door-to-door speed for samples or urgent parcels.</li>
        </ul>
      </Card>
    </div>

    <p class="mt-2">
      There is no fixed verified crossover in the research snapshot, so ask for both an LCL/FCL
      all-in quote and an air quote on the same CBM/chargeable-weight basis. The crossover depends
      on the route, the surcharges and the destination fees — not on the mode label alone.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Ports: Shanghai, Ningbo-Zhoushan, Shenzhen &amp; Guangzhou to Jebel Ali, Khalifa &amp; Sharjah</h2>
      <p>
        China’s biggest container gateways anchor the corridor. Shanghai and Ningbo-Zhoushan are the
        throughput leaders, while Shenzhen (Yantian/Shekou) and Guangzhou are the South China options
        closest to the Pearl River Delta export base.
      </p>

      <DataTable
        columns={[
          { key: 'port', label: 'China port' },
          { key: 'throughput', label: '2025 throughput' },
          { key: 'note', label: 'Note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={chinaPortRows}
        caption="Shanghai and Ningbo-Zhoushan figures are verified; Shenzhen and Guangzhou throughput were not stated in the research snapshot."
      />
      <SourceList sources={chinaPortSources} title="Sources — China ports" />

      <h3 class="mt-3">UAE destination ports</h3>
      <p>
        Jebel Ali is the Middle East’s largest container port and DP World-operated hub, Khalifa
        Port Abu Dhabi is a semi-automated deep-water gateway, and Port Khalid serves Sharjah and the
        northern emirates. Jebel Ali and Khalifa Port profiles are HIGH-confidence; Sharjah
        positioning is a secondary finding to verify with your forwarder.
      </p>

      <DataTable
        columns={[
          { key: 'factor', label: 'Factor' },
          { key: 'jebelAli', label: 'Jebel Ali' },
          { key: 'khalifa', label: 'Khalifa Port' },
          { key: 'sharjah', label: 'Sharjah / Port Khalid' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={uaePortRows}
        caption="Jebel Ali as the Middle East’s largest container port (DP World) and Khalifa Port’s semi-automated operations are HIGH-confidence; routing and use-case columns are MEDIUM/LOW and should be verified."
      />
      <SourceList sources={uaePortSources} title="Sources — UAE ports" />

      <div class="note mt-2">
        <strong>Jebel Ali vs Khalifa vs Sharjah in one line:</strong> pick Jebel Ali for the deepest
        schedule and regional transshipment, Khalifa for Abu Dhabi and industrial/project cargo, and
        Sharjah for the northern emirates. Confirm the final inland leg and cost before you pick the
        discharge port.
      </div>

      <h3 class="mt-3">Door-to-door process from China to the UAE</h3>
      <ol>
        <li>Supplier prepares the commercial invoice, packing list and certificate of origin.</li>
        <li>Forwarder collects the cargo and completes China export clearance.</li>
        <li>Cargo moves by sea or air to Jebel Ali, Khalifa Port or Sharjah.</li>
        <li>Importer/broker files the UAE import declaration with the correct HS code and value.</li>
        <li>Dubai Customs / the FTA assess the 5% duty and 5% VAT; free-zone vs mainland decides treatment.</li>
        <li>The consignment is released and trucked to the named address or transshipped onward.</li>
      </ol>
    </div>
  </section>

  <section class="section container">
    <h2>5. Landed cost and the factors that move it</h2>
    <p>
      The ocean or air rate is only one line of the landed cost. THC, destination port charges,
      clearance and brokerage, demurrage and detention are the costs that surprise first-time
      importers — and the reason “all-in” is the only useful comparison number.
    </p>

    <p>
      <strong>THC (terminal handling charge)</strong> is levied at both ends for moving the container
      through the terminal, while UAE destination charges can also include port service fees,
      customs inspection handling and delivery/clearance charges. None of these destination fee
      amounts were published in the verified research snapshot, so ask the forwarder to itemise them
      in writing.
    </p>

    <h3>Tax stack and a worked example</h3>
    <p>
      The UAE import duty baseline is <strong>5% of CIF</strong> and import VAT is
      <strong>5% on the CIF value plus duty</strong>. In formula terms that is
      <code>CIF × 1.05 (duty) × 1.05 (VAT)</code>, or <code>CIF × 1.1025</code> for a standard-rate
      shipment. For example, AED 10,000 CIF gives AED 500 duty, then AED 525 VAT on the
      duty-inclusive base — AED 11,525 total before other fees. Rates are subject to change; verify
      with the FTA before relying on this calculation.
    </p>

