---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-from-china-to-saudi-arabia/`;

const freightos: Source = {
  id: 'freightos',
  name: 'Freightos — Shanghai to Riyadh route data',
  url: 'https://www.freightos.com',
  type: 'industry',
};
const sinoShipping: Source = {
  id: 'sino-shipping',
  name: 'Sino Shipping — China to Saudi freight snapshots (August 2026)',
  url: 'https://www.sino-shipping.com',
  type: 'industry',
};
const cargofromchina: Source = {
  id: 'cargofromchina',
  name: 'Cargo From China — China to Saudi Arabia guide',
  url: 'https://cargofromchina.com/china-saudiarabia/',
  type: 'industry',
};
const ddpchain: Source = {
  id: 'ddpchain',
  name: 'DDP Chain — China to Saudi Arabia',
  url: 'https://ddpchain.com/saudi-arabia/',
  type: 'industry',
};
const chinaddpshipping: Source = {
  id: 'chinaddpshipping',
  name: 'China DDP Shipping — DDP shipping China to Saudi Arabia',
  url: 'https://www.chinaddpshipping.com/ddp-shipping-from-china-to-saudi-arabia/',
  type: 'industry',
};
const commenda: Source = {
  id: 'commenda',
  name: 'Commenda — Saudi Arabia import VAT guide',
  url: 'https://www.commenda.io/saudi-arabia/import-vat',
  type: 'organization',
};
const fuxinCcpt: Source = {
  id: 'fuxin-ccpit',
  name: 'Liaoning CCPIT — SABER SC certificate notice (26 Dec 2024)',
  url: 'https://www.fuxin.gov.cn/content/2024/962553.html',
  type: 'government',
};
const worldcargonews: Source = {
  id: 'worldcargonews',
  name: 'World Cargo News — Mawani ports handle 8.3m TEU in 2025',
  url: 'https://www.worldcargonews.com/ports-terminals/2026/01/mawani-ports-handle-8-3m-teu-in-2025/',
  type: 'industry',
};

const primaryPortSources = sourcesByIds([
  'mawani',
  'sipg',
  'ningbo-zhoushan-port',
  'shenzhen-port-group',
]);
const complianceSources = sourcesByIds(['zatca', 'mawani']);
const rateSources: Source[] = [freightos, sinoShipping];
const transitSources: Source[] = [cargofromchina, ddpchain, freightos, chinaddpshipping];
const costSources: Source[] = [
  ...sourcesByIds(['zatca', 'mawani']),
  commenda,
  fuxinCcpt,
  freightos,
];

const fclRows = [
  {
    container: 'FCL 20GP',
    freightos: '$3,333–$4,443',
    sino: '$5,085–$6,215',
    confidence: 'LOW',
  },
  {
    container: 'FCL 40GP',
    freightos: '$4,623–$6,164',
    sino: '$6,615–$8,085',
    confidence: 'LOW',
  },
  {
    container: 'FCL 40HQ',
    freightos: '$4,623–$6,164',
    sino: 'Not published',
    confidence: 'LOW',
  },
];

const lclRows = [
  {
    volume: 'LCL 1 CBM',
    total: '$716–$955',
    perCbm: '$716–$955 / CBM',
    confidence: 'LOW',
  },
  {
    volume: 'LCL 5 CBM',
    total: '$1,650–$2,200',
    perCbm: '$330–$440 / CBM',
    confidence: 'LOW',
  },
  {
    volume: 'LCL 10 CBM',
    total: '$2,669–$3,559',
    perCbm: '$267–$356 / CBM',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    destination: 'Jeddah',
    mode: 'Sea',
    transit: '~20–35 days',
    basis: 'cargofromchina ~20 days average (Shenzhen–Jeddah); ddpchain 20–35 days',
    confidence: 'LOW',
  },
  {
    destination: 'Dammam / Riyadh Dry Port',
    mode: 'Sea',
    transit: '30–45 days',
    basis: 'Freightos Shanghai–Riyadh: FCL 30–40 days, LCL 32–45 days',
    confidence: 'LOW',
  },
  {
    destination: 'Jeddah & Dammam',
    mode: 'Air',
    transit: '2–10 days',
    basis: 'cargofromchina 2–5 business days; ddpchain / Freightos 6–10 days',
    confidence: 'LOW',
  },
];

const chinaPortRows = [
  {
    port: 'Shanghai',
    throughput: '55.06M TEU (2025)',
    note: 'World #1 container port, 16th consecutive year',
    confidence: 'HIGH',
  },
  {
    port: 'Ningbo-Zhoushan',
    throughput: '43M TEU (2025)',
    note: '#3 container port; first port above 1.4bn tonnes cargo',
    confidence: 'HIGH',
  },
  {
    port: 'Shenzhen (Yantian / Shekou)',
    throughput: 'Not published in snapshot',
    note: 'South China gateway',
    confidence: 'LOW',
  },
];

const saudiPortRows = [
  {
    factor: 'Coast / region',
    jeddah: 'Red Sea, western Saudi Arabia',
    dammam: 'Arabian Gulf, eastern Saudi Arabia',
    riyadh: 'Inland (served by coastal ports)',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Main role',
    jeddah: 'Principal container gateway',
    dammam: 'Main Gulf port serving Riyadh + Eastern/Central provinces',
    riyadh: 'Inland dry port for Riyadh metro distribution',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Typical use case',
    jeddah: 'Western/Central Saudi consignees',
    dammam: 'Riyadh + Eastern Province consignees',
    riyadh: 'Door deliveries around Riyadh',
    confidence: 'LOW',
  },
];

const costRows = [
  {
    item: 'Ocean freight (FCL or LCL)',
    who: 'Ocean carrier / forwarder',
    magnitude: 'See rate table',
    confidence: 'LOW',
  },
  {
    item: 'Origin charges (China)',
    who: 'Forwarder / terminals',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Destination THC & port charges',
    who: 'Jeddah / Dammam terminal',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Customs clearance & cargo service fees',
    who: 'Saudi customs broker / agent',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'SABER / SASO conformity fees',
    who: 'SASO / SABER platform + laboratories',
    magnitude: 'PC per product + SC per shipment; not published — request quote',
    confidence: 'LOW',
  },
  {
    item: 'Demurrage',
    who: 'Terminal (after free time)',
    magnitude: 'Per-day charge; free time varies by terminal and line',
    confidence: 'LOW',
  },
  {
    item: 'Detention',
    who: 'Ocean carrier (after free time)',
    magnitude: 'Per-day charge; free time varies by carrier',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'ZATCA',
    magnitude: '5% of CIF value (GCC Common External Tariff)',
    confidence: 'MEDIUM',
  },
  {
    item: 'Import VAT',
    who: 'ZATCA',
    magnitude: '15% on CIF value + customs duty',
    confidence: 'HIGH',
  },
  {
    item: 'Excise tax (if applicable)',
    who: 'ZATCA',
    magnitude: 'Tobacco 100%; energy drinks 50%; carbonated drinks 50%',
    confidence: 'MEDIUM',
  },
  {
    item: 'Cargo insurance (optional)',
    who: 'Insurer / forwarder',
    magnitude: 'Optional; typically a small percentage of cargo value',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'How long does sea freight take from China to Saudi Arabia?',
    a: 'The corridor-level research snapshot gives roughly 20–45 days. Jeddah is commonly reported around 20–35 days, while Dammam/Riyadh Dry Port moves are commonly reported around 30–45 days (Freightos FCL 30–40 days, LCL 32–45 days). These are indicative figures, verify with your carrier before relying on them.',
  },
  {
    q: 'How much does shipping from China to Saudi Arabia cost?',
    a: 'Indicative August 2026 market snapshots put FCL 20GP around $3,333–$5,085, FCL 40GP around $4,623–$8,085, and LCL roughly $267–$955 per CBM depending on volume. These are collected from public marketplaces on different route/date bases, not carrier quotes — verify with a forwarder before booking.',
  },
  {
    q: 'What is Saudi Arabia’s VAT rate on imports?',
    a: 'Saudi import VAT is 15%, effective since 1 July 2020. It is calculated on the CIF value plus customs duty, not just on the product price.',
  },
  {
    q: 'What is the standard Saudi import duty?',
    a: 'The baseline import duty is 5% of the CIF value under the GCC Common External Tariff. Protective or anti-dumping duties can raise this to 15–25% on specific goods, so classify your HS code correctly before quoting.',
  },
  {
    q: 'What is the difference between SABER PC and SC certificates?',
    a: 'A PC (Product Conformity Certificate) covers a product, is usually valid for about one year, and involves product testing followed by pre-shipment inspection. An SC (Shipment Conformity Certificate) is issued per shipment and requires the bill of lading to confirm the cargo is in transit.',
  },
  {
    q: 'Do I need the SABER SC certificate before my cargo arrives?',
    a: 'Yes. Since 1 January 2025, regulated goods must have the batch SC certificate obtained before cargo arrival. An SC applied after arrival is treated as void and clearance fails, so start the SC process as soon as the bill of lading is available.',
  },
  {
    q: 'Which Saudi port should I use — Jeddah or Dammam?',
    a: 'Jeddah is the principal Red Sea gateway and usually suits western and central Saudi consignees. Dammam is the main Arabian Gulf port and is the natural choice for Riyadh and Eastern Province, with Riyadh Dry Port handling inland distribution by rail/road. Match the port to your consignee’s region.',
  },
  {
    q: 'What are demurrage and detention, and how do I avoid them?',
    a: 'Demurrage is charged by the terminal when a container stays inside the port beyond free time; detention is charged by the carrier when the container stays outside the port beyond free time. Avoid them by filing the FASAH pre-arrival declaration, completing the SC before arrival, having documents ready, and booking inland trucking before discharge.',
  },
  {
    q: 'What documents do I need to import into Saudi Arabia?',
    a: 'The standard set includes a commercial invoice, bill of lading, packing list, certificate of origin, and a SABER conformity certificate for regulated goods. Saudi Customs operates the FASAH single-window, which is used for pre-arrival declarations.',
  },
  {
    q: 'Do I need an HS code and an ISF filing?',
    a: 'You need the correct HS code because duty and conformity requirements depend on the classification. ISF (Importer Security Filing) is a United States requirement and does not apply to Saudi Arabia; Saudi’s equivalent advance-filing step is the pre-arrival customs declaration through FASAH.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Shipping from China to Saudi Arabia: Costs, Transit Times & Compliance (August 2026)',
      description:
        'Verified freight intelligence for the China to Saudi Arabia corridor: 15% VAT, 5% baseline duty, SABER SC rules, Jeddah vs Dammam routing, and indicative FCL/LCL rates.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="Shipping from China to Saudi Arabia: Costs, Transit Times & Compliance (August 2026)"
  description="Verified China to Saudi Arabia freight guide: 15% VAT, 5% baseline duty, SABER SC before arrival, Jeddah vs Dammam routing, indicative FCL/LCL rates and transit times."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Shipping from China to Saudi Arabia' },
        ]}
      />
      <span class="badge badge--amber">August 2026 updated</span>
      <h1>Shipping from China to Saudi Arabia: costs, transit times &amp; compliance</h1>
      <p class="lead">
        A one-page freight brief for importers moving cargo from Shanghai, Ningbo-Zhoushan or Shenzhen
        to Jeddah, Dammam and Riyadh Dry Port — with indicative FCL/LCL rates, transit windows, port
        routing, landed-cost breakdown, and the SABER/SASO rules that decide whether your cargo clears.
      </p>
      <p class="small muted">
        Confidence badges separate verified figures from indicative market snapshots. Treat every
        LOW-confidence rate and transit number as an indicative figure to verify with your carrier
        before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Saudi import VAT</span>
          <span class="fact-value">15% <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline import duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER SC rule</span>
          <span class="fact-value">Before arrival <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Sea transit</span>
          <span class="fact-value">20–45 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Air transit</span>
          <span class="fact-value">2–10 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Shanghai 2025</span>
          <span class="fact-value">55.06M TEU <ConfidenceBadge level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Indicative freight rates from China to Saudi Arabia</h2>
    <p>
      Ocean rates move weekly with capacity, fuel, peak season and the Red Sea security situation, so
      this page deliberately labels market figures as LOW confidence rather than presenting them as
      guaranteed prices. The two snapshots below use different route and date bases and are not meant
      to be averaged together.
    </p>
    <p>
      Demand on the corridor keeps growing: Mawani-operated Saudi ports handled 8.3 million TEU in
      2025, up 10.6% year on year, while Shanghai (55.06M TEU) and Ningbo-Zhoushan (43M TEU) remain
      the world’s busiest container gateways. For importers, that means schedule depth is usually
      good — but pricing still has to be locked with an all-in quote, not an advertised headline rate.
    </p>

    <h3>Full container load (FCL)</h3>
    <DataTable
      columns={[
        { key: 'container', label: 'Container' },
        { key: 'freightos', label: 'Freightos · Shanghai–Riyadh' },
        { key: 'sino', label: 'Sino-shipping · China–Saudi (Aug 2026)' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={fclRows}
      caption="Indicative market snapshots, not carrier quotes. Verify with a forwarder before relying on these figures."
    />
    <SourceList sources={rateSources} title="Sources — FCL rates" />

    <h3 class="mt-3">Less than container load (LCL)</h3>
    <DataTable
      columns={[
        { key: 'volume', label: 'Volume' },
        { key: 'total', label: 'Total (Freightos · Shanghai–Riyadh)' },
        { key: 'perCbm', label: 'Indicative per CBM' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={lclRows}
      caption="LCL unit cost falls as volume rises. Indicative figures — verify with your forwarder."
    />
    <SourceList sources={rateSources} title="Sources — LCL rates" />

    <div class="note mt-2">
      <strong>Why the ranges are wide:</strong> LCL is priced on a per-CBM basis with a minimum
      charge, so small shipments (1 CBM) carry a much higher unit cost than consolidated volumes
      (10 CBM). Always ask for the all-in quote: ocean freight + origin and destination fees + duty
      + VAT, not just the ocean leg.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Transit times by port and mode</h2>
      <p>
        Saudi transit times vary more than a single “average” suggests. Jeddah is reached
        from the Red Sea side, while Dammam and Riyadh Dry Port sit on the Gulf side and add inland
        handling for Riyadh deliveries. The figures below are corridor-level research findings, not
        schedule guarantees.
      </p>

      <DataTable
        columns={[
          { key: 'destination', label: 'Destination' },
          { key: 'mode', label: 'Mode' },
          { key: 'transit', label: 'Indicative transit' },
          { key: 'basis', label: 'Basis' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={transitRows}
        caption="Indicative transit windows only — verify with the relevant carrier before relying on these figures."
      />
      <SourceList sources={transitSources} title="Sources — transit times" />

      <div class="note mt-2">
        <strong>Air and DDP benchmarks for context:</strong> the same research snapshot records air
        cargo around 2–5 business days (cargofromchina) or 6–10 days (ddpchain/Freightos), and
        door-to-door DDP around 30–35 days by sea and 10–15 days by air (chinaddpshipping). All are
        LOW confidence and indicative, verify with carrier.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. FCL vs LCL: which should you book?</h2>
    <p>
      The decision is a landed-cost and delivery-priority question, not just a volume question. FCL
      gives you an exclusive container and usually a faster, simpler clearance; LCL lets you pay for
      only the space you use on smaller volumes. Use the LCL per-CBM table above against the FCL
      all-in quote — at higher CBM volumes there is normally a crossover point where FCL becomes the
      cheaper option per cubic metre.
    </p>

    <div class="grid grid--2 mt-2">
      <Card title="Choose FCL when...">
        <ul>
          <li>Your cargo fills most of a container or is dense and heavy.</li>
          <li>You need predictable transit and a single clearance entry.</li>
          <li>Goods are fragile, high-value, or should not be consolidated with other cargo.</li>
          <li>You are moving oversized or hazardous cargo that needs a dedicated unit.</li>
        </ul>
      </Card>
      <Card title="Choose LCL when...">
        <ul>
          <li>Your shipment is small — commonly well below a full container.</li>
          <li>You want to avoid paying for unused container space.</li>
          <li>You are testing a market or restocking slowly with multiple SKUs.</li>
          <li>You accept extra consolidation/deconsolidation handling and slightly longer transit.</li>
        </ul>
      </Card>
    </div>

    <p class="mt-2">
      For LCL, cargo is consolidated at an origin CFS warehouse and deconsolidated at the destination
      CFS, so the door-to-door time includes extra handling at both ends. That handling is why LCL is
      not always slower by the same margin at every port — ask whether your forwarder runs a direct
      or transhipped consolidation before comparing LCL against FCL.
    </p>

    <p class="mt-2">
      There is no single verified break-even CBM in the research snapshot, so ask your forwarder for
      both an LCL quote at your actual volume and an FCL all-in quote before deciding. The crossover
      depends on the route, the surcharges and the destination fees — not on container size alone.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Ports: Shanghai, Ningbo-Zhoushan &amp; Shenzhen to Jeddah, Dammam &amp; Riyadh Dry Port</h2>
      <p>
        China’s three biggest container gateways anchor this corridor. Shanghai and Ningbo-Zhoushan
        are the throughput leaders, while Shenzhen (Yantian/Shekou) is the South China option.
      </p>

      <DataTable
        columns={[
          { key: 'port', label: 'China port' },
          { key: 'throughput', label: '2025 throughput' },
          { key: 'note', label: 'Note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={chinaPortRows}
        caption="Shanghai and Ningbo-Zhoushan figures are verified; Shenzhen throughput was not stated in the research snapshot."
      />
      <SourceList sources={primaryPortSources} title="Sources — China ports" />

      <h3 class="mt-3">Saudi destination ports</h3>
      <p>
        Mawani-operated Saudi ports handled <strong>8.3 million TEU in 2025</strong> (+10.6% year on
        year), a MEDIUM-confidence figure from trade press because mawani.gov.sa was unavailable
        during research. Saudi Arabia has nine major ports (six commercial plus three industrial);
        Jeddah and Dammam are the two that matter for most China imports.
      </p>

      <DataTable
        columns={[
          { key: 'factor', label: 'Factor' },
          { key: 'jeddah', label: 'Jeddah' },
          { key: 'dammam', label: 'Dammam' },
          { key: 'riyadh', label: 'Riyadh Dry Port' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={saudiPortRows}
        caption="Port roles are secondary-source findings; verify routing with your forwarder."
      />
      <SourceList
        sources={[...primaryPortSources, worldcargonews]}
        title="Sources — Saudi ports"
      />

      <div class="note mt-2">
        <strong>Jeddah vs Dammam in one line:</strong> pick Jeddah for western and central Saudi
        consignees, and Dammam (then Riyadh Dry Port by rail/road) for Riyadh and Eastern Province
        consignees. Confirm the final inland leg and cost before you pick the discharge port.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Landed cost: the fees competitors skip</h2>
    <p>
      The ocean rate is only one line of the landed cost. Demurrage, detention, THC, clearance
      handling and SABER conformity fees are the costs that surprise first-time importers — and the
      reason WorldFreightHub treats “all-in” as the only useful comparison number.
    </p>

    <p>
      <strong>THC (terminal handling charge)</strong> is levied at both ends for moving the container
      through the terminal, while Saudi destination charges can also include a cargo service fee,
      customs inspection handling and delivery/clearance charges. SABER conformity fees are separate
      again: you normally pay for product testing and the per-product PC, then a per-shipment SC.
      None of these destination fee amounts were published in the verified research snapshot, so ask
      the forwarder to itemise them in writing.
    </p>

    <h3>Demurrage and detention</h3>
    <p>
      <strong>Demurrage</strong> is charged by the terminal when an imported container stays inside
      the port beyond the free time allowed after discharge. <strong>Detention</strong> is charged by
      the ocean carrier when the container stays outside the port beyond the free time allowed after
      collection. Free-time allowances and per-day rates differ by line and terminal and were not
      published in the verified research snapshot, so always request the fee schedule before booking.
    </p>
    <p>
      The practical way to avoid both is to finish clearance before the vessel arrives: submit the
      FASAH pre-arrival declaration, obtain the SABER SC before arrival (mandatory since 1 January
      2025), keep the commercial invoice, packing list, bill of lading and certificate of origin
      ready, and book trucking before the container is discharged. DDP forwarders with a local bonded
      partner are a useful alternative if you are not established in Saudi Arabia.
    </p>

    <h3>Full cost stack</h3>
    <DataTable
      columns={[
        { key: 'item', label: 'Cost component' },
        { key: 'who', label: 'Who charges it' },
        { key: 'magnitude', label: 'Indicative magnitude' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={costRows}
      caption="Only VAT (15%) and baseline duty (5% CIF) are verified. Unquantified fees are LOW confidence because the research snapshot did not publish specific amounts — request a fee schedule."
    />
    <SourceList sources={costSources} title="Sources — cost & customs" />

    <h3 class="mt-3">DDP (double clearance, tax-inclusive) as an alternative</h3>
    <p>
      Many China-to-Saudi sellers use DDP, where the forwarder handles both export clearance and
      Saudi import clearance, pays duty and VAT, and arranges last-mile delivery. The research
      snapshot records a door-to-door benchmark around 45 RMB/kg for Guangzhou/Shenzhen-to-Saudi DDP,
      with door-to-door sea DDP commonly quoted at 30–35 days and air DDP at 10–15 days. Treat
      those as LOW-confidence examples, and confirm exactly which fees are included before comparing
      DDP with your own CIF or DAP landed cost.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. Compliance: VAT, duty, SABER/SASO, FASAH &amp; HS codes</h2>

      <h3>Tax and duty</h3>
      <p>
        Saudi import VAT is <strong>15%</strong>, effective since 1 July 2020, and is calculated on
        the CIF value <em>plus</em> customs duty. The baseline import duty is <strong>5% of CIF</strong>
        under the GCC Common External Tariff, with protective or anti-dumping tariffs of 15–25%
        possible on specific goods. Excise tax adds 100% on tobacco, 50% on energy drinks and 50% on
        carbonated drinks where applicable.
      </p>
      <p>
        One discrepancy is flagged rather than hidden: some secondary sources state a SAR 1,000
        de minimis exemption for personal courier shipments, while another says Saudi Arabia has no
        such exemption. Treat that point as unresolved and confirm with ZATCA for low-value imports.
      </p>

      <h3>SABER / SASO in the correct order</h3>
      <ol>
        <li>Register the importer and product on the SABER conformity platform.</li>
        <li>Obtain the <strong>PC (Product Conformity Certificate)</strong> — product testing first, then pre-shipment inspection; validity is about one year and it is issued once per product.</li>
        <li>Once the bill of lading is available, apply for the <strong>SC (Shipment Conformity Certificate)</strong> for that specific shipment.</li>
        <li>Receive the SC <strong>before cargo arrival</strong> — since 1 January 2025, an SC applied after arrival is void and clearance fails.</li>
        <li>Submit the pre-arrival customs declaration through <strong>FASAH</strong>, Saudi Arabia’s single-window system, with the SC attached.</li>
      </ol>

      <h3>Documents and classification</h3>
      <p>
        Standard documents are the commercial invoice, bill of lading, packing list, certificate of
        origin and the SABER conformity certificate for regulated goods. Classify goods with the
        correct <strong>HS code</strong> before quoting, because both duty and conformity requirements
        depend on it. Note that <strong>ISF</strong> is a United States requirement and does not apply
        to Saudi Arabia; Saudi Arabia’s equivalent advance-filing step is the FASAH pre-arrival
        declaration.
      </p>
    <p>
      FASAH is the single window that connects importers, customs brokers, terminals and ZATCA, so
      the pre-arrival declaration, duty/VAT assessment and clearance status all sit in one flow. In
      practice, that means clearing before discharge is realistic when the SC and documents are
      ready, which is the single most effective way to keep demurrage and detention off the final
      invoice.
    </p>

