  type: 'industry',
};

const bahrainCustomsSources = sourcesByIds(['bahrain-customs']);
const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const rateSources: Source[] = [tonlexingBahrain, scfiGulf, xenetaSep, wfhRouteData, wfhMethodology];
