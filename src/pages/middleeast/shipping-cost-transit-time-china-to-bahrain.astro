    confidence: 'LOW',
  },
  {
    lane: 'LCL ocean · China → Khalifa bin Salman (per CBM)',
    benchmark: 'Not published — request an all-in per-CBM quote',
    read: 'No Bahrain LCL print exists in the verified snapshot. Corridor forwarder snapshots land at $48–$85/m³, but that band is not Bahrain-verified.',
    confidence: 'LOW',
  },
  {
    lane: 'Air freight · China → Bahrain (per kg)',
    benchmark: 'Not published per kg — request an all-in quote',
    read: 'Forwarder snapshots for the corridor sit at an indicative $4.8–$8.4/kg. Chargeable weight, not actual weight, drives the bill.',
    confidence: 'MEDIUM',
  },
  {
    lane: 'DDP air / express courier · China → Bahrain',
    benchmark: 'Not published separately — request a bundled rate',
    read: 'DDP and express pricing usually falls inside the same $4.8–$8.4/kg indicative band, with clearance, duty and VAT bundled into the price.',
    confidence: 'MEDIUM',
  },
];

