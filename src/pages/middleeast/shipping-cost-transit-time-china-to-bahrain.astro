---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import { rates } from '../../data/rates';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-cost-transit-time-china-to-bahrain/`;

const khalifaPort = gccPorts.find((item) => item.slug === 'khalifa-bin-salman');
const khalifaUnlocode = khalifaPort?.unlocode ?? '—';

const wfhRouteData: Source = {
  id: 'wfh-bahrain-cost-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Khalifa bin Salman (typical 22 days, range 15–30; LOW confidence estimate)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};
const wfhMethodology: Source = {
  id: 'wfh-bahrain-cost-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};
const tonlexingBahrain: Source = {
  id: 'tonlexing-bahrain',
  name: 'Tonlexing — Cost of 20ft and 40ft container shipping from China to Bahrain (February 2025 estimate)',
  url: 'https://www.tonlexing.com/cost-of-20ft-and-40ft-container-shipping-from-china-to-bahrain/',
  type: 'industry',
};
const scfiGulf: Source = {
  id: 'scfi-gulf-2026-09',
  name: 'Shanghai Shipping Exchange (SCFI) via CCCME — Shanghai→Persian Gulf $6,311/TEU (11 September 2026)',
  url: 'https://www.cccme.org.cn/news/details.aspx?id=45B2AF7028B85EBFBDDFE7D8D98FDB58&classid=8C92359A9456952E&xgid=F868932F64EB7AAF',
  type: 'industry',
};
const xenetaSep: Source = {
  id: 'xeneta-2026-09-10',
  name: 'Xeneta Weekly Ocean Update (10 September 2026) — China→Jeddah $10,870/FEU, +256% versus February 2026',
  url: 'https://www.xeneta.com/news/xeneta-weekly-ocean-container-shipping-market-update-10.09.26',
  type: 'industry',
};
const bahrainNbr: Source = {
  id: 'bahrain-nbr',
  name: 'Bahrain National Bureau for Revenue (NBR) — VAT authority and import guidance',
  url: 'https://www.nbr.gov.bh',
  type: 'government',
};
const vatUpdate: Source = {
  id: 'vatupdate-bahrain-2026',
  name: 'VATupdate — Bahrain updates VAT deposit recovery rules for imports and exports (NBR Imports & Exports VAT Guide v1.5, March 2026)',
  url: 'https://www.vatupdate.com/2026/03/18/bahrain-updates-vat-deposit-recovery-rules-for-imports-and-exports-in-new-nbr-guidance',
  type: 'organization',
};
const apmBahrain: Source = {
  id: 'apm-terminals-bahrain',
  name: 'APM Terminals Bahrain — operator of Khalifa bin Salman Port (port and terminal information)',
  url: 'https://www.apmterminals.com/en/bahrain',
  type: 'industry',
};
const uniscoKbsp: Source = {
  id: 'unisco-kbsp',
  name: 'UNISCO — Khalifa Bin Salman port profile (capacity, quay length, draft, operator)',
  url: 'https://www.unisco.com/international-ports/khalifa-bin-salman-bahrain',
  type: 'industry',
};
const porttechKbsp: Source = {
  id: 'porttech-kbsp',
  name: 'Port Technology — Bahrain Gateway: Khalifa Bin Salman Port profile (2009 handover and concession)',
