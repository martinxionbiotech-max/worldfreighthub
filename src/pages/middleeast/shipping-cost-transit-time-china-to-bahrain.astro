const rfqItems = [
  {
    ask: 'An all-in quote at your exact volume — 20ft, 40ft, or LCL per CBM with the minimum charge stated',
    why: 'Bahrain has no current published benchmark, so the only comparable number is a quote built on your actual volume and commodity',
