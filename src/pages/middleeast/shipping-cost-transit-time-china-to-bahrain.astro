const transitSources: Source[] = [wfhRouteData, tonlexingBahrain];
const modeSources: Source[] = [wfhRouteData, wfhMethodology];
const portSources: Source[] = [apmBahrain, uniscoKbsp, porttechKbsp, wfhMethodology];
const causewaySources: Source[] = [causewayWiki, causewayClosure, causewayReopen];
const complianceSources: Source[] = [...bahrainCustomsSources, bahrainNbr, oreemParcels, wfhMethodology];
const costSources: Source[] = [wfhRouteData, wfhMethodology, tonlexingBahrain];
const nodeSources: Source[] = [...chinaPortSources, ...portSources];

const usd = (value: number) => `$${value.toLocaleString('en-US')}`;
const rateRange = (amountLow: number | undefined, amountHigh: number | undefined, amount: number) =>
  amountLow && amountHigh ? `${usd(amountLow)}–${usd(amountHigh)}` : usd(amount);

const kbsRates = rates.filter((rate) => rate.route.includes('khalifa-bin-salman'));
const shRate20 = kbsRates.find((rate) => rate.id === 'r-601');
const shRate40 = kbsRates.find((rate) => rate.id === 'r-602');
const szRate20 = kbsRates.find((rate) => rate.id === 'r-603');
const szRate40 = kbsRates.find((rate) => rate.id === 'r-604');

const rateFileRows = [
  {
    lane: 'FCL 20GP · Shanghai → Khalifa bin Salman',
    benchmark: shRate20 ? `${rateRange(shRate20.amountLow, shRate20.amountHigh, shRate20.amount)} (Feb 2025 print)` : 'Not published',
    read: 'Pre-crisis print from the Tonlexing Feb-2025 sheet. Treat it as a floor, not a forecast — the 2026 Gulf re-rating has passed this number by.',
    confidence: 'LOW',
  },
  {
    lane: 'FCL 40GP / 40HQ · Shanghai → Khalifa bin Salman',
    benchmark: shRate40 ? `${rateRange(shRate40.amountLow, shRate40.amountHigh, shRate40.amount)} (Feb 2025 print)` : 'Not published',
    read: 'Same sheet; the source also lists undated 40ft sample points around $1,500–$1,636. Verify both at booking.',
    confidence: 'LOW',
  },
  {
    lane: 'FCL 20GP · Shenzhen → Khalifa bin Salman',
