---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/oman-customs-duty/`;

const wfhMethodology: Source = {
  id: 'wfh-oman-customs-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};

const omanCustomsSources = sourcesByIds(['oman-customs']);
const taxSources: Source[] = [...omanCustomsSources, wfhMethodology];
const timelineSources: Source[] = [...omanCustomsSources, wfhMethodology];
const restrictedSources: Source[] = [...omanCustomsSources, wfhMethodology];

const dutyRows = [
  {
    component: 'Baseline import duty',
    who: 'Oman Customs',
    rate: '5% of CIF value',
    basis: 'GCC Common External Tariff, ad valorem on CIF',
    confidence: 'MEDIUM',
  },
  {
    component: 'VAT',
    who: 'Oman tax authority',
    rate: '5% on the duty-inclusive base',
    basis: 'Oman VAT at 5%; applied on CIF + duty',
    confidence: 'MEDIUM',
  },
  {
    component: 'Specific tariff lines / exemptions',
    who: 'Oman Customs',
    rate: 'Not published in verified snapshot — verify HS code',
    basis: 'Oman-specific duty lines and exemptions are not stated in the snapshot',
    confidence: 'LOW',
  },
  {
    component: 'Restricted / prohibited goods',
    who: 'Oman Customs',
    rate: 'N/A if entry is refused',
    basis: 'Oman-specific restricted/prohibited list is not published in verified snapshot — verify',
    confidence: 'LOW',
  },
  {
    component: 'Customs brokerage / clearance fee',
    who: 'Licensed Oman customs broker',
    rate: 'Not published in verified snapshot — request schedule',
    basis: 'Service fee, not a statutory tax',
    confidence: 'LOW',
  },
  {
    component: 'Oman Customs e-processing charge',
    who: 'Oman Customs / service provider',
    rate: 'Not published in verified snapshot — request schedule',
    basis: 'Electronic processing and service fees (Bayan)',
    confidence: 'LOW',
  },
  {
    component: 'Conformity / certification fees',
    who: 'Oman Customs / relevant agency',
    rate: 'Not published in verified snapshot — request schedule',
    basis: 'Oman uses its own conformity regime; SABER/SASO are Saudi-only',
    confidence: 'LOW',
  },
  {
    component: 'Storage, demurrage or detention',
    who: 'Terminal / airport / carrier',
    rate: 'Per-day after free time',
    basis: 'Oman free time is not published in verified snapshot — verify',
    confidence: 'LOW',
  },
];

const calcTimelineRows = [
  {
    step: 'Classify the goods with the correct HS code',
    when: 'Before quoting or booking',
    basis: 'The code decides the duty line, VAT treatment, permits and prohibited/restricted screening',
    confidence: 'LOW',
  },
  {
    step: 'Establish the CIF value',
    when: 'Before the declaration',
    basis: 'Cost + insurance + freight; the base for Oman customs duty',
    confidence: 'MEDIUM',
  },
  {
    step: 'Screen for prohibited, restricted or permit goods',
    when: 'Before shipment',
    basis: 'Oman-specific restricted/prohibited list is not published in verified snapshot — verify',
    confidence: 'LOW',
  },
  {
    step: 'Assess customs duty',
    when: 'At declaration',
    basis: 'CIF value × duty rate; baseline 5%',
    confidence: 'MEDIUM',
  },
  {
    step: 'Assess VAT on the duty-inclusive base',
    when: 'At declaration',
    basis: '(CIF + duty) × 5%',
    confidence: 'MEDIUM',
  },
  {
    step: 'File the Oman Customs electronic declaration',
    when: 'Before release',
    basis: 'Bayan electronic declaration with invoice, packing list, B/L or AWB and certificate of origin',
    confidence: 'LOW',
  },
  {
    step: 'Pay duty, VAT and service charges',
    when: 'Before release',
    basis: 'Duty and VAT are statutory; brokerage and processing fees are separate',
    confidence: 'LOW',
  },
  {
    step: 'Release and deliver the cargo',
    when: 'After payment and any inspection',
    basis: 'Goods release once duty, VAT, documents and permit checks are complete',
    confidence: 'LOW',
  },
];

const ddpVsSelfRows = [
  {
    factor: 'Who pays the 5% duty and 5% VAT',
    selfPay: 'The importer pays Oman Customs directly at clearance',
    ddp: 'The seller or forwarder pays and builds the cost into one price',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Tax visibility',
    selfPay: 'Full line-item visibility on the Oman Customs duty and VAT assessment',
    ddp: 'Duty, VAT and service fees are embedded in one all-in price',
    confidence: 'LOW',
  },
  {
    factor: 'HS code and valuation risk',
    selfPay: 'The importer owns classification and any audit exposure',
    ddp: 'The forwarder handles filing, but a wrong HS code still changes the final cost',
    confidence: 'LOW',
  },
  {
    factor: 'Cash-flow timing',
    selfPay: 'Duty and VAT are settled at clearance, after the goods arrive',
    ddp: 'Duty and VAT are included in the upfront delivered price',
    confidence: 'LOW',
  },
  {
    factor: 'Restricted-goods responsibility',
    selfPay: 'The importer owns permits and prohibited/restricted screening',
    ddp: 'The forwarder can manage it, but the legal responsibility still follows the importer',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Usually best for',
    selfPay: 'Established Oman importers with a broker and HS-code discipline',
    ddp: 'First-time importers, small parcels and buyers who want one provider',
    confidence: 'LOW',
  },
];

const categoryRows = [
  {
    category: 'General merchandise at the GCC baseline',
    duty: '5% of CIF',
    vat: '5% on duty-inclusive base',
    note: 'The default planning position for most goods without an Oman-specific special line',
    confidence: 'MEDIUM',
  },
  {
    category: 'Oman-specific tariff lines or exemptions',
    duty: 'Not published in verified snapshot — verify',
    vat: '5% (subject to zero-rating/exemption rules)',
    note: 'The snapshot does not establish Oman-specific duty rates for food, tobacco, alcohol or other special lines',
    confidence: 'LOW',
  },
  {
    category: 'Zero-rated or exempt VAT goods',
    duty: 'Same duty line for the HS code',
    vat: 'May be zero-rated or exempt — verify',
    note: 'Oman VAT zero-rating/exemption specifics are not published in the snapshot',
    confidence: 'LOW',
  },
  {
    category: 'Prohibited / restricted goods',
    duty: 'N/A if entry is refused',
    vat: 'N/A',
    note: 'Oman-specific list not published in verified snapshot — screen the commodity before shipping',
    confidence: 'LOW',
  },
  {
    category: 'Standards / conformity-sensitive goods',
    duty: 'Same duty line for the HS code',
    vat: '5% on duty-inclusive base',
    note: 'SABER/SASO are Saudi-only; Oman conformity requirements are not published in the snapshot',
    confidence: 'LOW',
  },
];

const landedCostRows = [
  {
    line: 'CIF value',
    formula: 'Cost + insurance + freight',
    example: '10,000.00',
    confidence: 'MEDIUM',
  },
  {
    line: 'Customs duty',
    formula: 'CIF value × 5%',
    example: '500.00',
    confidence: 'MEDIUM',
  },
  {
    line: 'Duty-inclusive base',
    formula: 'CIF value + customs duty',
    example: '10,500.00',
    confidence: 'MEDIUM',
  },
  {
    line: 'VAT',
    formula: 'Duty-inclusive base × 5%',
    example: '525.00',
    confidence: 'MEDIUM',
  },
  {
    line: 'Total statutory landed cost',
    formula: 'CIF × 1.05 × 1.05',
    example: '11,025.00',
    confidence: 'MEDIUM',
  },
  {
    line: 'Operational fees',
    formula: 'Brokerage + e-processing + inspection + delivery + storage',
    example: 'Request itemised schedule',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'What is the Oman import duty rate?',
    a: 'The baseline import duty is 5% of the CIF value — cost, insurance and freight — under the shared GCC Common External Tariff framework. Treat the 5% as MEDIUM confidence and verify the exact line for your HS code with Oman Customs.',
  },
  {
    q: 'Does Oman charge VAT on imports?',
    a: 'Yes. Oman applies a 5% VAT in the current framework shown in this site’s country data. For imports, VAT is applied on the duty-inclusive base (CIF + duty), so the baseline statutory stack is CIF × 1.05 × 1.05 = CIF × 1.1025. Verify the current rate and any zero-rating or exemption with the Oman tax authority before finalising a landed-cost quote.',
  },
  {
    q: 'How is Oman customs duty and VAT calculated?',
    a: 'For most goods, customs duty is calculated as CIF value × 5%. VAT is then calculated as (CIF + duty) × 5%. The two-step baseline is CIF × 1.05 × 1.05 = CIF × 1.1025, which is structurally the same duty-plus-VAT compound as the UAE but with Oman’s own conformity regime.',
  },
  {
    q: 'What is the combined landed-cost multiplier for Oman duty and VAT?',
    a: 'At the 5% duty and 5% VAT baselines, the statutory landed cost is CIF × 1.1025. A CIF value of 10,000 USD becomes 11,025 before operational fees. This is arithmetic based on the GCC baseline and Oman VAT rate, not a binding Oman assessment — rates are subject to change and should be verified with Oman Customs and the Oman tax authority.',
  },
  {
    q: 'Can you show a worked example for a CIF 10,000 USD Oman shipment?',
    a: 'Yes: customs duty is 10,000 × 5% = 500, giving a duty-inclusive base of 10,500. VAT is 10,500 × 5% = 525. The total before operational fees is 11,025. Operational fees such as brokerage, Oman e-processing, inspection and delivery sit on top and should be requested as an itemised schedule.',
  },
  {
    q: 'How does the HS code affect Oman import duty and VAT?',
    a: 'The HS code decides the duty line — the 5% GCC baseline, a possible Oman-specific exemption or higher line, or a prohibited/restricted classification — and can also affect VAT treatment (zero-rating or exemption). Oman-specific tariff lines are not published in the verified snapshot, so classify before quoting and confirm the line with Oman Customs.',
  },
  {
    q: 'What goods are prohibited or restricted in Oman?',
    a: 'Oman screens the same high-risk categories strictly — alcohol, tobacco, narcotics, weapons and counterfeit goods — while the statutory stack remains 5% duty + 5% VAT (CIF × 1.1025) for dutiable goods. The exact Oman prohibited/restricted list is not published in the verified research snapshot, so do not rely on the Saudi or UAE list — check the commodity with Oman Customs before shipment.',
  },
  {
    q: 'What electronic system does Oman use for customs clearance?',
    a: 'Oman clearance is handled through Bayan, where the importer or broker pays the assessed 5% duty and 5% VAT before release. The declaration and required documents move through one electronic flow. The exact system flow and processing fees are not published in the verified snapshot, so confirm with a licensed Oman broker.',
  },
  {
    q: 'What documents are needed for Oman customs clearance?',
    a: 'The standard set is a commercial invoice, bill of lading or air waybill, packing list and certificate of origin, with the correct HS codes and country-of-origin information. Certificate of origin requirements can differ for GCC-origin versus non-GCC goods, and import licences or permits are required for restricted goods.',
  },
  {
    q: 'What is the difference between DDP and paying Oman duty myself?',
    a: 'Self-payment keeps the importer as the taxpayer on the same 5% duty + 5% VAT and gives full Oman Customs line-item visibility, while DDP packages both charges into one all-in price. DDP moves the payment to the seller or forwarder, but the underlying rates do not change — only who pays, how visible the tax is, and how the cash flow is structured.',
  },
  {
    q: 'Is there a de minimis threshold for Oman imports?',
    a: 'No reliable Oman de minimis threshold is published in the verified research snapshot. Do not assume a low-value exemption for courier or personal shipments without confirming the current position with Oman Customs.',
  },
  {
    q: 'Do I need an import licence to clear goods in Oman?',
    a: 'Not for all goods, but regulated and restricted products may require an import licence or approval from the relevant Oman agency. Confirm the permit requirement for your HS code and commodity before shipment rather than waiting until arrival.',
  },
  {
    q: 'Do I need SABER or SASO to import into Oman?',
    a: 'No. SABER and SASO are Saudi-only conformity systems. Do not copy a Saudi SABER/SASO step into an Oman quote. Oman uses its own standards and conformity regime, which may require product-specific certification for certain goods, but those specifics are not published in the verified snapshot — confirm the applicable Oman process for your product.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Oman Customs Clearance & Import Duty Guide: The CIF × 1.1025 Duty + 5% VAT Stack (September 2026)',
      description:
        'Oman customs clearance and import duty guide: 5% CIF baseline duty, 5% VAT, Bayan filing, required documents, HS code treatment, restricted goods and the CIF × 1.1025 landed-cost example.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="Oman Customs Clearance & Import Duty Guide: The CIF × 1.1025 Duty + 5% VAT Stack (September 2026)"
  description="Oman customs clearance and import duty guide: 5% CIF baseline duty, 5% VAT, Bayan filing, required documents, HS code treatment, restricted goods and the CIF × 1.1025 landed-cost example."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Oman customs & import duty' },
        ]}
      />
      <span class="badge badge--amber">September 2026 updated</span>
      <h1>Oman customs clearance &amp; import duty: the CIF × 1.1025 duty + 5% VAT stack</h1>
      <p class="lead">
        A customs-first brief for China-to-Oman imports: the 5% CIF duty baseline, the 5% VAT layer,
        Oman’s Bayan electronic filing, the document set, HS-code treatment, restricted/prohibited
        goods, and the arithmetic that turns a CIF value into a statutory landed cost.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> Oman&#8217;s 5% VAT + 5% duty compounds to CIF &#215; 1.1025, identical to the UAE &#8212; a $10,000 CIF shipment clears at $11,025 versus $12,075 in Saudi Arabia and $10,500 in Qatar. On that same base, Oman adds $1,025 in statutory tax while Qatar adds $500, so Sohar&#8217;s ~19-day typical and lower congestion must be worth the $525 tax premium before Oman wins on landed cost. The differentiator is outside-Strait-of-Hormuz access and less congestion, not the tax line.</p>
      </blockquote>
      <p class="small muted">
        Confidence badges separate verified rules from indicative operational fees. The 5% duty and
        5% VAT are MEDIUM confidence; brokerage, processing and storage amounts were not published in
        the verified snapshot and must be requested as an itemised schedule.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Baseline import duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">VAT</span>
          <span class="fact-value">5% <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Clearance system</span>
          <span class="fact-value">Bayan <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Authority</span>
          <span class="fact-value">Oman Customs <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER / SASO</span>
          <span class="fact-value">Saudi-only <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Statutory stack</span>
          <span class="fact-value">CIF × 1.1025 <ConfidenceBadge level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. The Oman tax stack at a glance</h2>
    <p>
      Oman is the GCC member that combines a <strong>5% customs duty on the CIF value</strong> under
      the shared GCC Common External Tariff with a <strong>5% VAT</strong> on the duty-inclusive base.
      That makes the baseline statutory landed cost:
    </p>
    <div class="note">
      <strong>Total before operational fees = CIF × 1.05 × 1.05 = CIF × 1.1025.</strong><br />
      A CIF value of 10,000 USD attracts 500 duty (→ 10,500), then 5% VAT of 525, giving 11,025
      before destination fees.
    </div>
    <p class="mt-2">
      The operational reality is that “two five-percent layers” is not the same as “simple
      clearance”. Oman has its own prohibited/restricted goods rules, its own conformity regime
      (distinct from Saudi SABER/SASO) and a Bayan electronic clearance flow, so the risk is
      concentrated in commodity screening, HS-code classification, document readiness and destination
      fees rather than in the arithmetic itself.
    </p>
    <p class="small muted">
      The 5% CIF duty baseline and 5% VAT are MEDIUM confidence in the research snapshot — the GCC
      framework and Oman VAT rate are recorded in this site’s country data, but the shared framework
      is verified for other GCC states and Oman-specific confirmation is pending. Treat them as
      current-state planning inputs and verify the duty line and VAT treatment for your HS code with
      Oman Customs and the Oman tax authority before committing.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Duty, 5% VAT and the unverified Oman-specific lines</h2>
      <p>
        Only the GCC 5% baseline and the 5% VAT position are known with MEDIUM confidence.
        Oman-specific tariff lines, exemptions, VAT zero-rating, brokerage, e-processing, conformity
        and storage amounts were not published in the verified research snapshot, so this page refuses
        to invent a single Oman fee number. Request an itemised schedule for the operational lines
        from a licensed Oman broker or provider instead.
      </p>

      <DataTable
        columns={[
          { key: 'component', label: 'Cost component' },
          { key: 'who', label: 'Who charges it' },
          { key: 'rate', label: 'Rate or amount' },
          { key: 'basis', label: 'Basis' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={dutyRows}
        caption="Only the 5% GCC CIF duty and 5% VAT position are stated. Oman-specific tariff exceptions and operational fees are LOW and must be requested as an itemised schedule."
      />
      <SourceList sources={taxSources} title="Sources — Oman import duty & 5% VAT" />

      <div class="note mt-2">
        <strong>Tax checklist before booking:</strong> ask for the HS-code duty line, the CIF valuation
        used, any VAT zero-rating or exemption, any restricted-goods permit, plus brokerage, Oman
        e-processing, conformity, inspection and storage-free-time charges — in writing, on the same
        quote.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. The assessment timeline: from HS code to release</h2>
    <p>
      Oman duty and VAT are not a single percentage charged on arrival; they are an ordered
      calculation that starts with classification and commodity screening. If the first two steps are
      wrong, the clearance can stall at the border — and unlike a duty-only market, the correction
      flows through both the 5% duty and the 5% VAT layer.
    </p>

    <DataTable
      columns={[
        { key: 'step', label: 'Step' },
        { key: 'when', label: 'When' },
        { key: 'basis', label: 'What it depends on' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={calcTimelineRows}
      caption="Statutory duty/VAT order is anchored on the shared GCC 5% CIF rate and Oman 5% VAT; operational steps such as Bayan e-filing and inspection are LOW confidence."
    />
    <SourceList sources={timelineSources} title="Sources — assessment & payment timeline" />

    <div class="note mt-2">
      <strong>The order to remember:</strong> classify → screen restricted goods → value on CIF →
      duty at 5% → VAT at 5% on the duty-inclusive base → file Bayan → pay → release. Skipping
      commodity screening or HS classification is how a straightforward “1.1025” estimate turns into a
      border hold.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Self-paid duty vs DDP</h2>
      <p>
        DDP does not remove Oman’s 5% duty or 5% VAT; it changes who pays and how visible the tax is.
        The choice is about cash flow, compliance ownership and transparency, not about paying less
        statutory duty or VAT.
      </p>

      <DataTable
        columns={[
          { key: 'factor', label: 'Factor' },
          { key: 'selfPay', label: 'Self-paid duty' },
          { key: 'ddp', label: 'DDP all-in' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={ddpVsSelfRows}
        caption="The statutory 5% duty and 5% VAT are unchanged in either structure; only the payer, visibility, responsibility and cash-flow timing differ."
      />
      <SourceList sources={taxSources} title="Sources — self-paid vs DDP duty handling" />

      <div class="grid grid--2 mt-2">
        <Card title="Self-pay is usually better when...">
          <ul>
            <li>You are an established Oman importer with a licensed broker.</li>
            <li>You want line-item visibility of duty, VAT, Oman e-processing and operational fees.</li>
            <li>You already have HS-code discipline and permit readiness.</li>
            <li>Your volume is high enough to justify internal clearance work.</li>
          </ul>
        </Card>
        <Card title="DDP is usually better when...">
          <ul>
            <li>The buyer wants one all-in price and one provider to chase.</li>
            <li>You are not established with Oman Customs or a local broker.</li>
            <li>You sell small parcels or want the forwarder to manage clearance.</li>
            <li>You want the forwarder to manage duty, VAT and restricted-goods timing together.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Landed-cost structure and the CIF 10,000 worked example</h2>
    <p>
      Build the landed cost in this order: CIF value, duty, duty-inclusive base, VAT, then operational
      fees. The table below uses a <strong>10,000 USD CIF</strong> example only to keep the arithmetic
      transparent — it is not a market rate or a binding assessment.
    </p>

    <DataTable
      columns={[
        { key: 'line', label: 'Cost line' },
        { key: 'formula', label: 'Formula' },
        { key: 'example', label: 'Example (USD)' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={landedCostRows}
      caption="Worked example uses CIF 10,000 USD purely to show the calculation. Rates are subject to change — verify with Oman Customs and the Oman tax authority."
    />
    <SourceList sources={taxSources} title="Sources — landed-cost formula" />

    <div class="grid grid--2 mt-2">
      <Card title="The formula in one line">
        <p class="lead">
          <strong>CIF × (1 + duty rate) × (1 + VAT rate)</strong>
        </p>
        <p>
          Baseline: CIF × 1.05 × 1.05. Add brokerage, Oman e-processing, conformity, inspection,
          delivery and any storage beyond free time on top of that statutory figure.
        </p>
      </Card>
      <Card title="Why Oman differs from Qatar and Kuwait">
        <p>
          Qatar and Kuwait stop at CIF × 1.05 (no general VAT). Oman compounds 5% duty with 5% VAT
          to reach CIF × 1.1025 — the same shape as the UAE. The statutory stack is therefore a
          duty-plus-VAT compound, not a duty-only position.
        </p>
      </Card>
    </div>

    <div class="note mt-2">
      <strong>Under-declaration is not a saving:</strong> the CIF value must reflect cost, insurance
      and freight. An unrealistically low invoice value or missing freight component invites
      revaluation, penalties and delay — and any correction flows through both the 5% duty and the
      5% VAT layer.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. Applicable categories: how the HS code changes the bill</h2>
      <p>
        The HS code is the lever that changes the duty component of the stack, can affect VAT
        treatment, and drives the prohibited/restricted screen. The 5% GCC CIF baseline and 5% VAT are
        the default, but Oman-specific goods may sit on different tariff lines or VAT treatments that
        are not published in the verified snapshot.
      </p>

      <DataTable
        columns={[
          { key: 'category', label: 'Product category / treatment' },
          { key: 'duty', label: 'Duty treatment' },
          { key: 'vat', label: 'VAT treatment' },
          { key: 'note', label: 'Note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={categoryRows}
        caption="Category treatment is drawn from the shared GCC duty and Oman 5% VAT snapshot. Oman-specific tariff lines, exemptions and restricted-goods status must be confirmed with Oman Customs."
      />
      <SourceList sources={taxSources} title="Sources — category & HS-code treatment" />

      <div class="note mt-2">
        <strong>Classification rule:</strong> resolve a borderline HS code before shipping. A change at
        the border can move the duty line, change VAT treatment, trigger a permit or turn a normal
        consignment into a prohibited one.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>7. Compliance points to keep in view</h2>

    <h3>The stack is duty-plus-VAT, not duty-only</h3>
    <p>
      For most goods, the statutory landed cost is <strong>CIF × 1.1025</strong>. This differs from
      Qatar and Kuwait (CIF × 1.05, no general VAT) and is the same shape as the UAE (CIF × 1.05 ×
      1.05). Do not copy a Qatar or Kuwait duty-only calculator into an Oman quote.
    </p>

    <h3>HS code first</h3>
    <p>
      Duty line, VAT treatment, permit requirements and prohibited/restricted exposure all flow from
      the HS code. Classify with a broker or a written ruling before quoting, and keep the invoice
      description specific enough to defend the code.
    </p>

    <h3>CIF valuation must be complete</h3>
    <p>
      Cost, insurance and freight are all part of the base. A low declared value or a missing freight
      component creates revaluation risk, and any value correction flows through both the 5% duty and
      the 5% VAT.
    </p>

    <h3>Restricted goods are a border risk, not a tax detail</h3>
    <p>
      Oman screens alcohol, tobacco, narcotics, weapons, counterfeit goods, hazardous materials and
      cultural/religious-sensitive items strictly, but the exact Oman prohibited/restricted list is
      not published in the verified snapshot. Confirm the commodity status before shipment; a
      post-arrival surprise can mean refusal, destruction, permit delay or severe demurrage.
    </p>

    <h3>Oman Customs needs the documents ready</h3>
    <p>
      The Bayan declaration is only as good as the underlying invoice, packing list, bill of lading
      or air waybill, certificate of origin and HS-code data. Prepare the set before arrival so the
      declaration can be filed and the free-time clock does not start.
    </p>

    <h3>No SABER or SASO for Oman</h3>
    <p>
      SABER and SASO are Saudi-only conformity systems. An Oman quote should not include a Saudi
      SABER/SASO step. Oman has its own standards and conformity regime, which may require
      product-specific certification for certain goods, but those specifics are not published in the
      verified snapshot — confirm the applicable Oman process for your product before arrival.
    </p>

    <h3>VAT and duty are not the whole bill</h3>
    <p>
      Brokerage, Oman e-processing, conformity, inspection, delivery, demurrage and detention remain
      separate operational costs. The research snapshot does not publish their amounts, so request an
      itemised schedule rather than assuming the statutory stack is the full landed cost.
    </p>

    <h3>Rates are subject to change</h3>
    <p>
      The 5% duty baseline and 5% VAT are from a dated snapshot. Treat every figure here as a planning
      input and verify the current duty line, VAT treatment, exemptions and restricted-goods rules
      with Oman Customs and the Oman tax authority before finalising a landed-cost quote.
    </p>

    <SourceList sources={restrictedSources} title="Sources — Oman customs, duty, VAT & valuation" />
  </section>

