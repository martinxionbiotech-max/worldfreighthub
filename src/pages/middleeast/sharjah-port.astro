];

const decisionRows = [
  {
    scenario: 'Sharjah and northern-emirate consignees',
    bestPort: 'Port Khalid / Sharjah',
    why: 'Closest gateway to Sharjah and surrounding emirates',
    confidence: 'LOW',
  },
  {
    scenario: 'Sharjah industrial and free zones',
    bestPort: 'Port Khalid / Sharjah',
    why: 'Northern-emirate inland link for zones such as Hamriyah Free Zone',
    confidence: 'LOW',
  },
  {
    scenario: 'Dubai, re-export, distribution or e-commerce fulfilment',
    bestPort: 'Jebel Ali',
    why: 'Broader line connectivity, JAFZA and established Dubai distribution',
    confidence: 'LOW',
  },
  {
    scenario: 'Transhipment and Gulf relay flows',
    bestPort: 'Jebel Ali',
    why: 'The main Gulf relay point for China services',
    confidence: 'LOW',
  },
  {
    scenario: 'Abu Dhabi mainland or KIZAD consignees',
