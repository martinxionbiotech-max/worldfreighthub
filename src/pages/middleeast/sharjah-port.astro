const lclVsFclRows = [
  {
    factor: 'Best-fit volume',
    lcl: 'Small and mixed shipments, commonly below ~15 CBM (planning heuristic)',
    fcl: 'Most of a container — 20GP ~33 CBM, 40GP ~67 CBM nominal',
    confidence: 'LOW',
  },
  {
    factor: 'Pricing basis',
    lcl: 'Per chargeable CBM, with a minimum charge and CFS handling at both ends',
    fcl: 'Per container, regardless of how full the unit is',
    confidence: 'LOW',
  },
  {
    factor: 'Transit and handling',
    lcl: 'Slower: origin consolidation plus Sharjah/Jebel Ali deconsolidation',
    fcl: 'Usually faster and simpler: one sealed unit moves as one consignment',
    confidence: 'LOW',
  },
  {
    factor: 'Damage and mixing risk',
    lcl: 'Higher: cargo is handled at two CFS points and shares the box',
    fcl: 'Lower: the unit is sealed and not opened at the CFS',
    confidence: 'LOW',
  },
  {
    factor: 'Clearance entry',
    lcl: 'House bill with multiple consignees under one master bill',
    fcl: 'One container, one consignee, one clearance entry',
    confidence: 'LOW',
  },
  {
    factor: 'Best for Sharjah-bound cargo',
    lcl: 'Market testing, slow restocking, e-commerce and mixed SKUs',
