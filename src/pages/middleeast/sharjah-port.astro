---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/sharjah-port/`;
const port = gccPorts.find((item) => item.slug === 'port-khalid');
const unlocode = port?.unlocode ?? '—';

const cargofromchinaUae: Source = {
  id: 'cargofromchina-uae',
  name: 'Cargo From China — China to UAE guide',
  url: 'https://cargofromchina.com/china-uae/',
  type: 'industry',
};
const docshipper: Source = {
  id: 'docshipper-uae',
  name: 'China DocShipper — China to UAE freight guide',
  url: 'https://china.docshipper.com/en/freight-shipping-china-uae/',
  type: 'industry',
};
const fta: Source = {
  id: 'fta-uae-vat',
  name: 'UAE Federal Tax Authority — VAT',
  url: 'https://tax.gov.ae/en/taxes/Vat.aspx',
  type: 'government',
};
const numeral: Source = {
  id: 'numeral-uae-vat',
  name: 'Numeral — UAE VAT rates and compliance',
  url: 'https://www.numeral.com/blog/uae-vat-rates-and-compliance',
  type: 'organization',
};
const wfhRouteData: Source = {
  id: 'wfh-uae-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Jebel Ali (typical 21 days, range 15–30)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port']);
const portSources = sourcesByIds(['dubai-customs']);
const portListSources: Source[] = [docshipper, ...sourcesByIds(['dubai-customs'])];
const rateSources: Source[] = [cargofromchinaUae, wfhRouteData];
const transitSources: Source[] = [wfhRouteData, cargofromchinaUae];
const routingSources: Source[] = [
  ...sourcesByIds(['dubai-customs', 'dp-world', 'abu-dhabi-ports']),
  cargofromchinaUae,
  docshipper,
];
const facilitySources: Source[] = [...sourcesByIds(['dubai-customs']), docshipper];
const costSources: Source[] = [
  ...sourcesByIds(['dubai-customs']),
  fta,
  numeral,
  cargofromchinaUae,
  docshipper,
];
const complianceSources = [...sourcesByIds(['dubai-customs']), fta, numeral];

const parameterRows = [
  {
    parameter: 'Country',
    value: 'United Arab Emirates',
    note: 'GCC member on the China–UAE freight corridor',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Emirate',
    value: 'Sharjah',
    note: 'Northern emirate gateway for Sharjah and surrounding emirates',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Port name',
    value: 'Port Khalid / Sharjah Port',
    note: 'The Sharjah entry in the UAE port list used by China freight guides',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'UN/LOCODE',
    value: unlocode,
    note: 'Defined in WorldFreightHub GCC ports data as Sharjah / Port Khalid',
    confidence: 'MEDIUM',
  },
  {
    parameter: 'Port role',
    value: 'Container and cargo gateway for Sharjah and the northern emirates',
    note: 'Directional role — verify current terminal capability with the port authority',
    confidence: 'LOW',
  },
  {
    parameter: 'Operator / authority',
    value: 'Not published in verified snapshot',
    note: 'Verify the current port authority and terminal operator',
    confidence: 'LOW',
  },
  {
    parameter: 'Berths',
    value: 'Not published in verified snapshot',
    note: 'Verify berth count and terminal allocation with the port authority',
    confidence: 'LOW',
  },
  {
    parameter: 'Maximum water depth',
    value: 'Not published in verified snapshot',
    note: 'Verify approach channel and alongside depth with the port authority',
    confidence: 'LOW',
  },
  {
    parameter: 'Annual throughput',
    value: 'Not published in verified snapshot',
    note: 'Verify port-specific TEU figures with the port authority',
    confidence: 'LOW',
  },
  {
    parameter: 'UAE port list context',
    value: 'Jebel Ali, Khalifa, Zayed, Fujairah, Rashid, Sharjah',
    note: 'The six UAE ports named in the China DocShipper guide',
    confidence: 'MEDIUM',
  },
];

const rateRows = [
  {
    service: 'FCL ocean — China to Sharjah / Port Khalid',
    benchmark: 'Not published in verified snapshot — request an all-in carrier quote',
    basis: 'No verified China–UAE FCL dollar range appeared in the research snapshot',
    confidence: 'LOW',
  },
  {
    service: 'FCL ocean — UAE corridor context',
    benchmark: 'Not published — use Jebel Ali routing context only',
    basis: 'WorldFreightHub route data provides transit, not FCL pricing',
    confidence: 'LOW',
