    service: 'Sea port-to-port (direct call)',
    transit: 'Not published in verified snapshot — request carrier schedule',
    basis: 'No direct Sharjah route figure in the verified snapshot',
    confidence: 'LOW',
  },
  {
    origin: 'China → UAE corridor',
    service: 'Sea (fast direct-sailing guide)',
