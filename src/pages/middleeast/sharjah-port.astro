];

const facilityRows = [
  {
    facility: 'Port Khalid / Sharjah port complex',
    function: 'Container and general cargo gateway for Sharjah',
    note: 'Current operator, berth and terminal detail not in snapshot — verify with the port authority',
    confidence: 'LOW',
  },
  {
    facility: 'Sharjah CFS and bonded areas',
