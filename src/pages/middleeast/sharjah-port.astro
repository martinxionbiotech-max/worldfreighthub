  {
    service: 'LCL ocean — Dubai / Jebel Ali corridor benchmark',
    benchmark: 'AED 880–980 per CBM',
    basis: 'cargofromchina China→UAE LCL snapshot (Dubai); Sharjah-specific rate not published',
    confidence: 'LOW',
  },
  {
    service: 'LCL ocean — Sharjah CFS',
    benchmark: 'Not published in verified snapshot — request CFS tariff',
