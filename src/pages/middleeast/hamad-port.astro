    confidence: 'HIGH',
  },
  {
    parameter: 'Container terminals',
    value: 'Three planned; two operational at an optimum capacity of 5M TEU/year',
    note: 'Long-term capacity eventually above 7.5M TEU/year',
    confidence: 'HIGH',
  },
  {
    parameter: 'General cargo capacity',
    value: '7M tonnes',
    note: 'Breakbulk and general cargo capability',
    confidence: 'HIGH',
  },
  {
    parameter: 'Grain capacity',
    value: '1M tonnes',
    note: 'Bulk grain handling at the port complex',
    confidence: 'HIGH',
  },
  {
    parameter: 'Vehicle terminal capacity',
    value: '~500,000 vehicles/year',
    note: 'RoRo and vehicle-handling capability',
    confidence: 'HIGH',
  },
  {
    parameter: 'Customs inspection capacity',
    value: '5,600 containers/day',
    note: 'Rapid inspection area in the port zone',
    confidence: 'HIGH',
  },
  {
