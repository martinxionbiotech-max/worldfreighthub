const transitRows = [
  {
    origin: 'Shanghai',
    service: 'Sea port-to-port',
    transit: 'Typical 22 days (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'MEDIUM',
  },
  {
    origin: 'Ningbo-Zhoushan',
    service: 'Sea port-to-port',
    transit: 'Typical 22 days (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'MEDIUM',
  },
  {
    origin: 'Shenzhen (Yantian / Shekou)',
    service: 'Sea port-to-port',
    transit: 'Typical 22 days (15–30 day range)',
    basis: 'WorldFreightHub route data — verify with carrier',
    confidence: 'MEDIUM',
  },
  {
    origin: 'China → Qatar corridor',
    service: 'Sea market bracket',
    transit: '22–28 days',
    basis: 'China Best Freight Qatar sea snapshot',
    confidence: 'LOW',
  },
  {
    origin: 'China → Qatar corridor',
    service: 'Air freight',
    transit: '2–4 days',
    basis: 'China Best Freight Qatar air snapshot',
    confidence: 'LOW',
  },
];

const decisionRows = [
  {
    scenario: 'Containerised China imports for Doha and Qatar',
    bestChoice: 'Hamad Port',
    why: 'Modern container and general-cargo gateway; commercial traffic moved from Doha Port',
    confidence: 'HIGH',
  },
  {
    scenario: 'Cruise passengers or legacy waterfront development',
    bestChoice: 'Doha Port',
    why: 'Redeveloped as a cruise terminal after container traffic left',
