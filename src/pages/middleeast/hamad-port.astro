  type: 'organization',
};
const wfhRouteData: Source = {
  id: 'wfh-qatar-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Hamad Port (typical 22 days, range 15–30)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const portSources = sourcesByIds(['qatar-customs']);
const portFactSources: Source[] = [mwani, meed, constructionweek];
const transitSources: Source[] = [wfhRouteData, chinabestfreight];
const decisionSources: Source[] = [mwani, meed, chinabestfreight];
const facilitySources: Source[] = [mwani, meed, peninsula];
const costSources: Source[] = [...sourcesByIds(['qatar-customs']), traddal, presou];
const complianceSources: Source[] = [...sourcesByIds(['qatar-customs']), traddal];
const throughputSources: Source[] = [peninsula, mwani];

const parameterRows = [
  {
    parameter: 'Country',
    value: 'Qatar',
    note: 'GCC member; small, high-income market anchored by oil and gas',
