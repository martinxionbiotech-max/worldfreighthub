    function: 'Grain imports and bulk discharge',
    note: 'Capacity 1M tonnes',
    confidence: 'HIGH',
  },
  {
    facility: 'Vehicle terminal',
    function: 'RoRo and vehicle-handling capability',
    note: 'Capacity about 500,000 vehicles per year',
    confidence: 'HIGH',
  },
  {
    facility: 'Customs inspection area',
    function: 'Rapid customs screening and clearance in the port zone',
    note: 'Capacity 5,600 containers/day',
    confidence: 'HIGH',
  },
  {
    facility: 'Adjacent free zone',
    function: 'Logistics, re-export and industrial activity connected to the port',
    note: 'Free-zone treatment depends on the specific zone rules',
    confidence: 'MEDIUM',
  },
  {
    facility: 'Road hinterland',
    function: 'Trucking to Doha and across Qatar',
    note: 'Qatar is compact; most final deliveries are within a short inland leg',
    confidence: 'MEDIUM',
  },
];

const costRows = [
  {
    item: 'Destination THC and port charges',
    who: 'Hamad Port terminal / Mwani Qatar',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Customs clearance and brokerage',
    who: 'General Authority of Customs / licensed broker',
    magnitude: 'Not published in verified snapshot — request fee schedule',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'General Authority of Customs',
    magnitude: '5% of CIF value (GCC Common External Tariff)',
    confidence: 'MEDIUM',
  },
  {
    item: 'General VAT',
    who: 'Qatar tax framework',
    magnitude: 'No general VAT on imports in the current framework',
    confidence: 'MEDIUM',
  },
  {
    item: 'Demurrage',
    who: 'Terminal (after free time)',
    magnitude: 'Per-day charge; free time varies by terminal and line',
    confidence: 'LOW',
  },
  {
    item: 'Detention',
    who: 'Ocean carrier (after free time)',
    magnitude: 'Per-day charge; free time varies by carrier',
    confidence: 'LOW',
  },
