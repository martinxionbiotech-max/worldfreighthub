const meed: Source = {
  id: 'meed-hamad-opening',
  name: 'MEED — Doha’s Hamad Port to open on 1 December',
  url: 'https://www.meed.com/dohas-hamad-port-to-open-on-1-december/',
  type: 'industry',
};
const constructionweek: Source = {
  id: 'constructionweek-hamad',
  name: 'Construction Week — Hamad Port container traffic transition',
  url: 'https://www.constructionweekonline.com/projects-tenders/dohas-hamad-port-to-open-on-1-december',
  type: 'industry',
};
const peninsula: Source = {
  id: 'peninsula-qatar-ports',
  name: 'The Peninsula — Qatar ports container throughput hit 1.46 million TEUs in 2025',
  url: 'http://s.thepeninsula.qa/article/05/01/2026/qatars-ports-container-throughput-hit-146-million-teus-in-2025',
  type: 'industry',
