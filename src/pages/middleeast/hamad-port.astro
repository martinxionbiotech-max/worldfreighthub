];

const factorRows = [
  {
    factor: 'Vessel routing and transshipment',
    effect: 'A direct loop saves time; a transshipped box adds a handling point',
    direction: 'Transit and handling variable',
    confidence: 'LOW',
  },
  {
    factor: 'Qatar market size',
    effect: 'Smaller volume than Dubai or the Saudi Eastern Province raises per-shipment cost',
    direction: 'Cost up',
    confidence: 'LOW',
  },
  {
    factor: 'Single commercial gateway',
    effect: 'Hamad Port concentration gives focus but reduces port-choice flexibility',
    direction: 'Routing fixed',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Documents and Al-Nadeeb readiness',
    effect: 'Late or wrong documents delay clearance and start demurrage',
    direction: 'Transit up, cost up',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Restricted commodity screen',
    effect: 'Permit requirements can add inspection time',
    direction: 'Clearance risk up',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Port free-time discipline',
    effect: 'Demurrage/detention apply after free time',
    note: 'Book trucking before discharge',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'Where is Hamad Port located?',
    a: 'Hamad Port is on the Arabian Gulf coast of Qatar, south of Doha. It is the country’s primary commercial seaport and the destination for containerised and general cargo moving into Qatar.',
  },
  {
    q: 'What is the UN/LOCODE for Hamad Port?',
    a: 'The UN/LOCODE is QAHMD. Use it on the bill of lading and customs paperwork when the destination is Hamad Port.',
  },
  {
    q: 'When did Hamad Port open?',
    a: 'Operations began in December 2016, and the port was officially inaugurated on 5 September 2017. It was built to replace the commercial role of the old Doha Port.',
  },
  {
    q: 'Who operates Hamad Port?',
    a: 'Mwani Qatar manages Hamad Port under the Ministry of Transport. The port is the anchor of Qatar’s modern commercial port system.',
  },
  {
    q: 'How big is Hamad Port?',
    a: 'The port covers an area of 29 square kilometres. It has general cargo capacity of 7 million tonnes, grain capacity of 1 million tonnes and a vehicle terminal of about 500,000 vehicles per year.',
  },
  {
    q: 'What is Hamad Port’s container capacity?',
    a: 'Hamad Port has three planned container terminals, with two currently operational at an optimum capacity of 5 million TEU per year. Its long-term capacity is planned above 7.5 million TEU per year.',
  },
  {
    q: 'What is the difference between Hamad Port and Doha Port?',
    a: 'Doha Port was Qatar’s legacy commercial port. Container and general cargo traffic moved to the new Hamad Port, and Doha Port has since been redeveloped for cruise and waterfront use. New China container consignments should be booked to Hamad Port.',
  },
  {
    q: 'How long does sea freight take from China to Hamad Port?',
    a: 'WorldFreightHub route data records a typical 22 days with a 15–30 day planning range from Shanghai, Ningbo-Zhoushan or Shenzhen to Hamad Port (MEDIUM confidence). A secondary market guide gives a wider 22–28-day Qatar sea bracket (LOW). Verify with your carrier before relying on the figure.',
  },
  {
    q: 'What is Hamad Port’s 2025 throughput?',
    a: 'A trade-press report puts total Qatar ports container throughput at about 1.46 million TEUs in 2025, with Hamad Port transshipment reported at nearly half of the country’s container volume. The port-specific split is a secondary figure, so verify the current statistics with Mwani Qatar.',
  },
  {
    q: 'What import taxes apply at Hamad Port?',
    a: 'The baseline import duty is 5% of CIF value under the GCC Common External Tariff. Qatar has no general VAT on imports in the current framework. Specific goods may have different duty lines, and tobacco/alcohol can be heavily restricted.',
  },
  {
    q: 'What documents are needed for customs clearance at Hamad Port?',
    a: 'The standard set is a commercial invoice, bill of lading, packing list and certificate of origin, with the correct HS code and country-of-origin information. Restricted goods may require an import licence or permit before arrival.',
  },
  {
    q: 'How do demurrage and detention work at Hamad Port?',
    a: 'Demurrage is charged by the terminal when an imported container stays inside the port beyond free time after discharge. Detention is charged by the carrier when the container stays outside the port beyond free time. Finish Al-Nadeeb clearance and book trucking before discharge to avoid both.',
  },
  {
    q: 'Is there a free zone at Hamad Port?',
    a: 'Yes, Hamad Port has an adjacent free zone connected to the port area. Free-zone treatment depends on the specific zone rules and the commercial activity, so confirm the conditions with Mwani Qatar and the relevant authority before assuming a duty or regulatory benefit.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Hamad Port Qatar — China Shipping Guide: Modern Gateway, Transit Times & Clearance (September 2026)',
      description:
        'Hamad Port intelligence for China freight: Qatar’s modern commercial gateway, Mwani Qatar operation, Doha Port replacement, China transit windows, port facilities and 5% duty clearance.',
      datePublished: '2026-09-01',
      dateModified: '2026-09-01',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
  {
    type: 'Place',
    data: {
      name: 'Hamad Port',
      url: pageUrl,
      additionalType: 'Seaport',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Doha',
        addressCountry: 'QA',
      },
      description:
        'Hamad Port is Qatar’s primary commercial seaport, located south of Doha on the Arabian Gulf coast. Managed by Mwani Qatar, it replaced Doha Port as the country’s main container and general cargo gateway.',
    },
  },
];
---

<BaseLayout
  title="Hamad Port Qatar — China Shipping Guide: Modern Gateway, Transit Times & Clearance (September 2026)"
  description="Hamad Port intelligence for China freight: Qatar’s modern commercial gateway, Mwani Qatar operation, Doha Port replacement, China transit windows, port facilities and 5% duty clearance."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Hamad Port' },
        ]}
      />
      <span class="badge badge--amber">September 2026 updated</span>
      <h1>Hamad Port: China freight guide for Qatar’s modern commercial gateway</h1>
      <p class="lead">
        A port-intelligence page for shippers routing China freight to Qatar. This page explains what
        Hamad Port is, why it replaced Doha Port for commercial traffic, how the port is run by Mwani
        Qatar, how long China ocean moves take, what the destination cost stack looks like, and the
        5% duty clearance rules that apply at the gate.
      </p>
      <p class="small muted">
        Confidence badges separate verified port facts from indicative market and throughput figures.
        Treat every LOW-confidence transit, fee and throughput note as indicative, and verify with
        Mwani Qatar or your carrier before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Port role</span>
          <span class="fact-value">Primary seaport <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Operator</span>
          <span class="fact-value">Mwani Qatar <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">UN/LOCODE</span>
          <span class="fact-value">{unlocode} <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Opened</span>
          <span class="fact-value">2017 inaugurated <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">China sea transit</span>
          <span class="fact-value">Typical 22 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Why Hamad Port matters for China freight</h2>
    <p>
      Hamad Port is the anchor of Qatar’s modern maritime trade. It was purpose-built as a deep-water
      port complex south of Doha and took over the commercial cargo role from the old Doha Port,
      which was later repositioned for cruise and waterfront use. For China-to-Qatar ocean freight,
      that transition removes the old routing ambiguity: Hamad Port is the destination, and Doha Port
      is not a valid container discharge point for new commercial consignments.
    </p>
    <p>
      The strategic logic is both port modernisation and market fit. Qatar is a compact, high-income
      economy with strong energy-driven demand for project cargo, machinery, spare parts, vehicles,
      grain and consumer goods. Hamad Port concentrates that demand in one modern gateway with
      dedicated container, general cargo, bulk and vehicle capacity, plus a customs inspection area
      designed for rapid container screening. The port’s adjacent free zone extends that gateway into
      logistics, re-export and light industrial activity.
    </p>
    <p>
      The verified research snapshot does not provide a clean Hamad-specific 2025 container split.
      It does confirm a trade-press total of about <strong>1.46 million TEUs across Qatar ports in
      2025</strong>, with Hamad transshipment reported at nearly half of the country’s container
      volume. That number is secondary and marked LOW in the parameters table; Mwani Qatar is the
      authoritative source for the current port-specific figure.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Hamad Port parameters</h2>
      <p>
        Use this table as an orientation, not a capacity guarantee. The opening date, operator, port
        area and facility capacities are HIGH-confidence port-authority facts; the 2025 Qatar
        throughput total is a trade-press figure marked LOW until Mwani Qatar confirms the
        port-specific split.
      </p>

      <DataTable
        columns={[
          { key: 'parameter', label: 'Parameter' },
          { key: 'value', label: 'Value' },
          { key: 'note', label: 'Planning note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={parameterRows}
        caption="Port parameters — operational and capacity facts are sourced from Mwani Qatar; the 2025 throughput total is a trade-press figure to verify with Mwani Qatar."
      />
      <SourceList sources={portFactSources} title="Sources — Hamad Port parameters" />

      <div class="note mt-2">
        <strong>Capacity-sensitive cargo:</strong> if your consignment depends on a specific berth,
        draft, crane capability, heavy-lift availability or terminal window, request the current
        schedule and restrictions from Mwani Qatar or your forwarder before booking. The verified
        snapshot does not supply berth-by-berth operational constraints.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. China to Hamad Port transit windows</h2>
    <p>
      Transit to Hamad is usually quoted as a window, not a promise. The route data places Hamad
      slightly behind Jebel Ali on the China-to-GCC corridor: a typical 22 days with a 15–30 day
      planning range. The port-to-port figure should not be confused with door-to-door time to Doha,
      which adds discharge, clearance and final trucking.
    </p>

    <DataTable
      columns={[
        { key: 'origin', label: 'Origin' },
        { key: 'service', label: 'Service' },
        { key: 'transit', label: 'Indicative transit' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={transitRows}
      caption="Indicative transit windows only — verify with the relevant carrier before relying on these figures."
    />
    <SourceList sources={transitSources} title="Sources — China to Hamad Port transit times" />

    <div class="note mt-2">
      <strong>Port-to-port vs Doha door:</strong> typical 22 days for the ocean leg is not total door
      time. Add Hamad discharge, Al-Nadeeb clearance, any inspection and last-mile trucking before
      committing a delivery date to a Qatar consignee.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Hamad Port vs Doha Port: the modern replacement</h2>
      <p>
        The Hamad/Doha transition is the key decision context for Qatar freight. Hamad Port is the
        modern commercial gateway; Doha Port is the legacy name that still appears in some older
        freight material. The table below gives the common scenarios, and the two cards summarise
        the rule.
      </p>

      <DataTable
        columns={[
          { key: 'scenario', label: 'Scenario' },
          { key: 'bestChoice', label: 'Best-fit gateway' },
          { key: 'why', label: 'Why' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={decisionRows}
        caption="Routing heuristics, not guaranteed carrier schedules. Confirm the inland leg and service before choosing the discharge gateway."
      />
      <SourceList sources={decisionSources} title="Sources — Hamad vs Doha routing context" />

      <div class="grid grid--2 mt-2">
        <Card title="Book Hamad Port when...">
          <ul>
            <li>The consignment is containerised, general cargo, project freight, vehicles or grain.</li>
            <li>You are importing from China to Doha or any Qatar destination.</li>
            <li>You want the modern Mwani Qatar commercial gateway and its hinterland link.</li>
            <li>You want the port’s rapid inspection and free-zone-adjacent capability.</li>
          </ul>
        </Card>
        <Card title="Do not book Doha Port for commercial containers when...">
          <ul>
            <li>The shipment is a new containerised China import.</li>
            <li>Your forwarder still shows an old “Port of Doha” routing in the quote.</li>
            <li>You need a container terminal and customs inspection capacity.</li>
            <li>You want a discharge point that reflects the post-2017 Qatar port structure.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Terminals, facilities and the Doha hinterland</h2>
    <p>
      Hamad Port is a multi-cargo complex rather than a single terminal. The port-authority figures
      cover container, general cargo, bulk grain and vehicle handling, while the adjacent free zone
      extends the gateway into logistics and re-export activity. Confirm the specific terminal
      allocation and service availability with Mwani Qatar for the actual call.
    </p>

