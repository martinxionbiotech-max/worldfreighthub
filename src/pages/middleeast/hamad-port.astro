    facility: 'Container terminals',
    function: 'Deep-sea container handling on the Qatar gateway',
    note: 'Two terminals currently operational; optimum capacity 5M TEU/year',
    confidence: 'HIGH',
  },
  {
    facility: 'General cargo terminal',
    function: 'Breakbulk and general cargo handling',
    note: 'Capacity 7M tonnes',
    confidence: 'HIGH',
  },
  {
