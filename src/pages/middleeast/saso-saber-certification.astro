const faqs = [
  {
    q: 'What is the difference between SASO and SABER?',
    a: 'SASO sets the standards and SABER is the platform — a 2-part split where SASO is the rulemaker and SABER is the system you file through. In practical terms, SASO sets the technical requirements and SABER is the system you work through to prove the product meets them.',
  },
  {
    q: 'What is a SABER PC certificate?',
    a: 'PC is Product Conformity — one certificate per product model, valid about one year. It is issued once per product model after testing and, where required, pre-shipment inspection, and proves the product itself conforms to the applicable SASO standard.',
  },
  {
    q: 'What is a SABER SC certificate?',
    a: 'SC is Shipment Conformity — one certificate per shipment, tied to a specific bill of lading or air waybill and a valid PC. Each new shipment needs its own SC.',
  },
  {
    q: 'Do I need both a PC and an SC?',
    a: 'For regulated products, yes — the ratio is 1 reusable PC per product plus 1 non-reusable SC per shipment. You normally need the PC in place before shipment and the SC before the cargo arrives.',
  },
  {
    q: 'What changed on 1 January 2025 for SABER?',
    a: 'The SC must now be obtained before cargo arrival. An SC applied after the cargo has arrived is treated as void, which means clearance fails. This changed the practical timeline: the SC is a pre-arrival task, not something you can fix at the destination after discharge.',
  },
  {
    q: 'When should I apply for the SABER SC?',
    a: 'Apply in the 2-step sequence: finish the PC product work before shipment, then file the SC as soon as the B/L or AWB exists and receive it before arrival. Because the SC is shipment-specific and the transport document is needed to confirm in-transit status.',
  },
  {
    q: 'What happens if the SC is not obtained before arrival?',
    a: 'Clearance fails. Since 1 January 2025, an SC applied after arrival is void, so the shipment cannot clear until the conformity issue is resolved — which typically means storage, demurrage and delay. This is the single most important operational point for Saudi-bound regulated goods.',
  },
  {
    q: 'Which products require SABER certification?',
    a: 'The verified snapshot contains 0 authoritative complete product list, so the illustrative families are LOW confidence: electrical and electronic products, toys, textiles, cosmetics, food-contact materials, building materials, household appliances and certain safety components. Confirm your exact product against the official SABER scope before ordering.',
  },
  {
    q: 'How long is a SABER PC valid?',
    a: 'About one year, according to the verified research snapshot. Because validity is about one year and the PC is issued once per product, keep track of expiry before a repeat order ships — an expired PC blocks the SC application for the new shipment.',
  },
  {
    q: 'How much does SASO/SABER certification cost?',
    a: 'The verified snapshot publishes 0 specific registration/testing/PC/SC amounts, so the honest figure is “not published — request an itemised quote” for your product and shipment volume. Treat the cost structure as LOW confidence.',
  },
  {
    q: 'Can a freight forwarder handle SABER for me?',
    a: 'Many forwarders coordinate both PC and SC — 2 certificates — through local partners, but the responsibility split must be written down. Confirm who is responsible for product registration, testing, PC validity and the pre-arrival SC filing, especially because a missed SC after 1 January 2025 blocks clearance.',
  },
  {
    q: 'What are the most common SABER rejection or failure reasons?',
    a: 'Six failure patterns dominate — missing/expired PC, post-arrival SC, non-accredited or mismatched test report, model/SKU mismatch, wrong HS code, and B/L-consignee mismatch. These are practical patterns from the research snapshot, not an official SASO/SABER rejection list — confirm the current submission requirements with SABER.',
  },
  {
    q: 'Is SASO the same as the GCC G-Mark?',
    a: 'No — SASO/SABER and G-Mark are 2 separate conformity marks, and the snapshot covers 0 of the G-Mark requirements. Confirm the specific mark required for your product with the relevant authority.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
