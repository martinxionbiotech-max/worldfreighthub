const faqs = [
  {
    q: 'How much does shipping cost from China to Oman?',
    a: 'WHFI v1 (September 2026) publishes China→Oman benchmark rows, all LOW confidence: 20ft FCL $1,750–$2,500 to Sohar, 40ft $2,110–$3,680, LCL $110–$190/CBM and air $2.40–$3.50/kg. These are aggregated planning ranges, not quotes. On top of freight, Oman adds a ×1.1025 statutory stack (5% duty + 5% VAT), so a $10,000 CIF lands at $11,025 before destination fees. Verify every figure with a forwarder before booking.',
