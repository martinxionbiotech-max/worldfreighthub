    layer: 'CIF value',
    calc: 'Cost + insurance + freight',
    amount: '$10,000.00 illustrative',
    note: 'Illustrative round figure; replace with your CIF',
    confidence: 'LOW',
  },
  {
    layer: 'Customs duty (baseline)',
    calc: 'CIF × 5%',
    amount: '$500.00',
    note: 'GCC Common External Tariff, ad valorem on CIF',
    confidence: 'MEDIUM',
  },
  {
    layer: 'Duty-inclusive base',
    calc: 'CIF + duty',
    amount: '$10,500.00',
    note: 'The base on which Oman VAT is applied',
    confidence: 'MEDIUM',
