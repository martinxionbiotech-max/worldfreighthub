];

const cifRows = [
  {
    layer: 'Goods / invoice value',
    calc: 'From the supplier invoice',
    amount: 'Use the actual declared value',
    note: 'The starting point for Oman customs duty',
    confidence: 'LOW',
  },
  {
    layer: 'Freight (sea or air)',
    calc: 'Carrier / forwarder quote',
    amount: 'See rate tables',
    note: 'Ocean or air line item',
    confidence: 'LOW',
  },
  {
    layer: 'Insurance',
    calc: 'Insurer or forwarder quote',
    amount: 'Not published in snapshot',
    note: 'Usually a small percentage of cargo value',
    confidence: 'LOW',
  },
