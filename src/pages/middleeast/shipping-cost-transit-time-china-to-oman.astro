---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/shipping-cost-transit-time-china-to-oman/`;
const soharPort = gccPorts.find((item) => item.slug === 'sohar');
const salalahPort = gccPorts.find((item) => item.slug === 'salalah');
const soharUnlocode = soharPort?.unlocode ?? '—';
const salalahUnlocode = salalahPort?.unlocode ?? '—';

const wfhRouteData: Source = {
  id: 'wfh-oman-cost-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Sohar (typical 19 days, range 15–30; LOW confidence estimate)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};
const wfhMethodology: Source = {
  id: 'wfh-oman-cost-methodology',
  name: 'WorldFreightHub methodology — China→GCC research snapshot and confidence framework',
  url: `${SITE_URL}/methodology/`,
  type: 'organization',
};

const omanCustomsSources = sourcesByIds(['oman-customs']);
const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const omanPortSources: Source[] = [...omanCustomsSources, wfhMethodology];
const rateSources: Source[] = [wfhRouteData, wfhMethodology];
const taxSources: Source[] = [...omanCustomsSources, wfhMethodology];
const transitSources: Source[] = [wfhRouteData, wfhMethodology];
const costSources: Source[] = [...taxSources, wfhRouteData];

const seaRateRows = [
  {
    mode: 'LCL ocean · China → Sohar / Salalah',
    benchmark: 'Not published — request an all-in per-CBM quote',
    basis: 'No verified Oman LCL rate appeared in the research snapshot',
    note: 'Per-CBM shared-container basis; minimum charge may apply',
    confidence: 'LOW',
  },
  {
    mode: 'FCL 20GP · China → Sohar / Salalah',
    benchmark: 'Not published — request an all-in quote',
    basis: 'No verified Oman 20GP rate appeared in the research snapshot',
    note: 'Priced per container; differs by line and season',
    confidence: 'LOW',
  },
  {
    mode: 'FCL 40GP / 40HQ · China → Sohar / Salalah',
    benchmark: 'Not published — request an all-in quote',
    basis: 'No verified Oman 40GP/40HQ rate appeared in the research snapshot',
    note: '40ft is usually the volume benchmark for established importers',
    confidence: 'LOW',
  },
  {
    mode: 'FCL · China → Sohar / Salalah project/oversized cargo',
    benchmark: 'Not published — request a project-specific quote',
    basis: 'No verified project cargo rate in the snapshot',
    note: 'Project freight requires lift, laydown and route clearance checks',
    confidence: 'LOW',
  },
];

const airRateRows = [
  {
    mode: 'Air freight · China → Oman market bracket',
    benchmark: 'Not published — request a per-kg quote',
    basis: 'No verified Oman air rate appeared in the research snapshot',
    note: 'Billed on chargeable weight, not actual weight alone',
    confidence: 'LOW',
  },
  {
    mode: 'Air freight · airport-to-airport planning range',
    benchmark: 'Not published — request a quote',
    basis: 'Planning range for direct airport-to-airport moves to Muscat',
    note: 'Varies with chargeable weight, airport pair and season',
    confidence: 'LOW',
  },
  {
    mode: 'DDP air door-to-door',
    benchmark: 'Not published — request a per-kg quote',
    basis: 'No verified Oman DDP air rate in the snapshot',
    note: 'Embeds clearance, 5% duty, 5% VAT and delivery in one price',
    confidence: 'LOW',
  },
  {
    mode: 'Express courier · China → Oman',
    benchmark: 'Not published — request a per-kg quote',
    basis: 'No verified Oman express rate in the research snapshot',
    note: 'Best for small, urgent parcels; falls at higher weight',
    confidence: 'LOW',
