---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/fcl-vs-lcl/`;

const portRoles: Record<string, string> = {
  jeddah: 'Red Sea gateway, western Saudi Arabia',
  dammam: 'Arabian Gulf gateway, Eastern Province + Riyadh',
  'riyadh-dry-port': 'Inland dry port; rail/road extension of the Dammam corridor',
  'jebel-ali': 'Largest Middle East port; UAE re-export and free-zone hub',
  'khalifa-port-abu-dhabi': 'Abu Dhabi deep-water gateway',
  'port-khalid': 'Sharjah / Port Khalid gateway',
  hamad: 'Qatar’s sole commercial gateway',
  shuwaikh: 'Kuwait City general/container gateway',
  shuaiba: 'Kuwait industrial and bulk gateway',
  sohar: 'Northern Oman container gateway',
  salalah: 'Southern Oman transshipment gateway',
  'khalifa-bin-salman': 'Bahrain gateway; King Fahd Causeway link to Saudi',
};

const portRows = gccPorts.map((port) => ({
  port: port.name,
  unlocode: port.unlocode ?? '—',
  country: port.country,
  role: portRoles[port.slug] ?? port.hinterland,
  confidence: 'HIGH',
}));

const wfhRouteData: Source = {
  id: 'wfh-gcc-fcl-lcl-route-data',
  name: 'WorldFreightHub route data — China to the seven main GCC destination ports (FCL 20ft/40ft and LCL per-CBM ranges; MEDIUM confidence)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const wfhMethods: Source = {
  id: 'wfh-gcc-fcl-lcl-methods',
  name: 'WorldFreightHub methods data — FCL and LCL capacity, transit and demurrage benchmarks',
  url: `${SITE_URL}/methods/`,
  type: 'organization',
};

const wfhCountryData: Source = {
  id: 'wfh-gcc-country-data',
  name: 'WorldFreightHub GCC country data — VAT, duty and de minimis profiles',
  url: `${SITE_URL}/countries/`,
  type: 'organization',
};

const rateSources: Source[] = [wfhRouteData, wfhMethods];
const transitSources: Source[] = [wfhRouteData, wfhMethods];
const decisionSources: Source[] = [wfhRouteData, wfhMethods];
const portSources: Source[] = [
  ...sourcesByIds([
    'mawani',
    'dp-world',
    'abu-dhabi-ports',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
];
const costSources: Source[] = [
  ...sourcesByIds([
    'zatca',
    'dubai-customs',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
  wfhMethods,
  wfhCountryData,
];
const complianceSources: Source[] = [
  ...sourcesByIds([
    'zatca',
    'dubai-customs',
    'qatar-customs',
    'kuwait-customs',
    'oman-customs',
    'bahrain-customs',
  ]),
  wfhCountryData,
];

const rateRows = [
  {
    port: 'Jeddah Islamic Port (SAJED)',
    twenty: '$1,500 – $6,200',
    forty: '$1,900 – $8,100',
    lcl: '$20 – $110 per CBM',
    typical: '~18 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'King Abdulaziz Port Dammam (SADMM)',
    twenty: '$1,500 – $6,200',
    forty: '$1,900 – $8,100',
    lcl: '$20 – $110 per CBM',
    typical: '~20 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'Jebel Ali (AEJEA)',
    twenty: '$1,500 – $3,250',
    forty: '$2,200 – $3,950',
    lcl: '$60 – $180 per CBM',
    typical: '~21 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'Hamad (QAHMD)',
    twenty: '$1,700 – $2,500',
    forty: '$2,500 – $3,600',
    lcl: '$75 – $100 per CBM',
    typical: '~22 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'Shuwaikh (KWSWK)',
    twenty: '$1,500 – $2,500',
    forty: '$2,200 – $3,600',
    lcl: '$70 – $100 per CBM',
    typical: '~24 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'Sohar (OMSOH)',
    twenty: '$1,500 – $2,600',
    forty: '$2,200 – $3,800',
    lcl: '$60 – $110 per CBM',
    typical: '~19 days',
    confidence: 'MEDIUM',
  },
  {
    port: 'Khalifa bin Salman (BHKBS)',
    twenty: '$1,500 – $2,500',
    forty: '$2,200 – $3,600',
    lcl: '$75 – $100 per CBM',
    typical: '~22 days',
    confidence: 'MEDIUM',
  },
];

const transitRows = [
  {
    port: 'Jeddah (SAJED)',
    fcl: '~18 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Dammam (SADMM)',
    fcl: '~20 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Jebel Ali (AEJEA)',
    fcl: '~21 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Hamad (QAHMD)',
    fcl: '~22 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Shuwaikh (KWSWK)',
    fcl: '~24 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Sohar (OMSOH)',
    fcl: '~19 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
  {
    port: 'Khalifa bin Salman (BHKBS)',
    fcl: '~22 days typical · 14–30 day FCL planning range',
    lcl: 'FCL +5–10 days · 15–35 day LCL planning range',
    confidence: 'MEDIUM',
  },
];

const breakEvenRows = [
  {
    metric: '20ft nominal capacity',
    fcl: '≈ 33 CBM',
    lcl: 'Not applicable',
    confidence: 'MEDIUM',
  },
  {
    metric: '40ft nominal capacity',
    fcl: '≈ 67 CBM',
    lcl: 'Not applicable',
    confidence: 'MEDIUM',
  },
  {
    metric: '40ft vs 20ft economics',
    fcl: 'A 40ft costs ~30–50% more than a 20ft but holds ~2× the volume',
    lcl: 'Not applicable',
    confidence: 'MEDIUM',
  },
  {
    metric: 'Planning crossover',
    fcl: 'Usually wins above ~15 CBM',
    lcl: 'Usually wins below ~15 CBM',
    confidence: 'MEDIUM',
  },
  {
    metric: '15 CBM LCL — corridor benchmark',
    fcl: '20ft FCL $1,500–$6,200 by port',
    lcl: '15 CBM × $20–$110 = $300 – $1,650',
    confidence: 'MEDIUM',
  },
  {
    metric: '15 CBM LCL — Jebel Ali example',
    fcl: '20ft FCL $1,500–$3,250',
    lcl: '15 CBM × $60–$180 = $900 – $2,700',
    confidence: 'MEDIUM',
  },
];

const decisionRows = [
  {
    factor: 'Shipment size',
    fcl: 'A dedicated 20GP, 40GP or 40HQ for cargo large enough to justify exclusive use',
    lcl: 'A shared consolidated container, billed only for the volume you occupy',
    confidence: 'LOW',
  },
  {
    factor: 'Pricing basis',
    fcl: 'Per container — 20ft $1,500–$6,200 and 40ft $1,900–$8,100 across GCC gateways',
    lcl: 'Per cubic metre — $20–$180 per CBM depending on the destination port',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Break-even arithmetic',
    fcl: 'Wins once your cube makes the flat box rate cheaper than per-CBM pricing plus CFS fees',
    lcl: 'Below ~15 CBM usually wins; above ~15 CBM the full box usually wins',
    confidence: 'LOW',
  },
  {
    factor: 'Handling exposure',
    fcl: 'One sealed unit from shipper to receiver; less intermediate handling',
    lcl: 'Adds CFS consolidation, deconsolidation and short-term warehousing',
    confidence: 'LOW',
  },
  {
    factor: 'Transit experience',
    fcl: '14–30 day port-to-port window, with the per-port typical in the route data',
    lcl: '5–10 days slower on top of the same lane, because of consolidation windows',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Destination fee stack',
    fcl: 'OTHC/DTHC, documentation, bunker, inspection risk, demurrage and detention',
    lcl: 'Same stack plus CFS deconsolidation and per-CBM handling charges',
    confidence: 'LOW',
  },
  {
    factor: 'Geopolitical exposure',
    fcl: 'Red Sea vs Strait of Hormuz routing risk is priced into the wide Saudi ranges',
    lcl: 'Same routing exposure; LCL also carries the schedule risk of co-shippers',
    confidence: 'LOW',
  },
  {
    factor: 'Usual fit',
    fcl: 'Volume-heavy, heavy/dense, project or single-consignee cargo',
    lcl: 'Trial orders, mixed-SKU replenishment, samples and sub-container volumes',
    confidence: 'LOW',
  },
];

const vatRows = [
  { country: 'Saudi Arabia', vat: '15%', note: 'Highest GCC VAT; stacked on 5% duty', confidence: 'HIGH' },
  { country: 'United Arab Emirates', vat: '5%', note: 'Free zones can defer duty until mainland entry', confidence: 'HIGH' },
  { country: 'Qatar', vat: '0% (no VAT yet)', note: 'VAT expected ~5%; confirm timeline locally', confidence: 'HIGH' },
  { country: 'Kuwait', vat: '0% (no VAT)', note: 'Signed GCC agreement, not implemented', confidence: 'HIGH' },
  { country: 'Oman', vat: '5%', note: 'Same VAT as the UAE, less congested Sohar gateway', confidence: 'HIGH' },
  { country: 'Bahrain', vat: '10%', note: 'Second-highest GCC VAT; Causeway alternate into Saudi', confidence: 'HIGH' },
];

const costRows = [
  {
    item: 'Ocean freight — FCL',
    who: 'Carrier / forwarder',
    magnitude: '20ft $1,500–$6,200; 40ft $1,900–$8,100 by destination port',
    confidence: 'MEDIUM',
  },
  {
    item: 'Ocean freight — LCL',
    who: 'Carrier / forwarder',
    magnitude: '$20–$180 per CBM by destination port; 1 CBM minimum',
    confidence: 'MEDIUM',
  },
  {
    item: 'Origin terminal handling (OTHC)',
    who: 'China terminal / carrier',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Destination terminal handling (DTHC)',
    who: 'GCC terminal / carrier',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'CFS consolidation / deconsolidation (LCL)',
    who: 'CFS operator both ends',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Bunker / fuel adjustment',
    who: 'Ocean carrier',
    magnitude: 'Carrier surcharge; not separately published in the snapshot — request a breakdown',
    confidence: 'LOW',
  },
  {
    item: 'Documentation / bill of lading fee',
    who: 'Carrier / forwarder / broker',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Demurrage / detention',
    who: 'Terminal + ocean carrier',
    magnitude: '$75–$300/day after 3–7 free days at GCC terminals',
    confidence: 'MEDIUM',
  },
  {
    item: 'Hidden destination charges',
    who: 'Port / customs / inspection parties',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'What is the difference between FCL and LCL?',
    a: 'FCL (Full Container Load) gives you exclusive use of a 20GP, 40GP or 40HQ and is priced per container. LCL (Less-than-Container Load) consolidates your cargo with other importers in a shared container and is priced per cubic metre, usually with a 1 CBM minimum. On the China-to-GCC corridor, FCL fits large, heavy or palletised cargo, while LCL suits trial orders, mixed SKUs and sub-container volumes.',
  },
  {
    q: 'At what volume should I switch from LCL to FCL in the GCC?',
    a: 'The planning crossover is roughly 15 CBM: below about 15 CBM LCL usually wins, and above it FCL usually wins once CFS minimums and destination deconsolidation fees are priced in. It is not a rigid threshold — request quotes on both sides and compare the all-in landed cost before deciding.',
  },
  {
    q: 'How much does LCL shipping from China to the GCC cost?',
    a: 'The published per-CBM ranges vary by port: Jeddah and Dammam $20–$110, Jebel Ali $60–$180, Hamad $75–$100, Shuwaikh $70–$100, Sohar $60–$110, and Khalifa bin Salman $75–$100. These are MEDIUM-confidence benchmarks, not live quotes — confirm the current rate, minimum charge and destination CFS fees with your forwarder.',
  },
  {
    q: 'How much does FCL shipping from China to the GCC cost?',
    a: 'The published 20ft and 40ft ranges are: Jeddah $1,500–$6,200 / $1,900–$8,100, Dammam $1,500–$6,200 / $1,900–$8,100, Jebel Ali $1,500–$3,250 / $2,200–$3,950, Hamad $1,700–$2,500 / $2,500–$3,600, Shuwaikh $1,500–$2,500 / $2,200–$3,600, Sohar $1,500–$2,600 / $2,200–$3,800, and Khalifa bin Salman $1,500–$2,500 / $2,200–$3,600. All are MEDIUM confidence; Saudi ranges are widest because Red Sea and Strait of Hormuz risk is priced in.',
  },
  {
    q: 'Is LCL always cheaper for small shipments?',
    a: 'Usually, but not automatically. LCL wins below the ~15 CBM planning crossover because you only pay for the cube you use. Above that, FCL can become cheaper per cubic metre and avoids paying for a shared container with added CFS handling. Include the LCL minimum charge, destination deconsolidation fee and any demurrage risk in the comparison.',
  },
  {
    q: 'Why are Saudi FCL ranges so much wider than Jebel Ali’s?',
    a: 'Saudi gateways sit on two different geopolitical lanes: Jeddah on the Red Sea and Dammam on the Arabian Gulf via the Strait of Hormuz. The route data notes that war-risk premiums and fuel costs flex with the news cycle, which is why the Saudi 20ft range runs $1,500–$6,200 while Jebel Ali’s more competitive carrier market compresses its range to $1,500–$3,250.',
  },
  {
    q: 'How much slower is LCL than FCL?',
    a: 'LCL is 5–10 days slower than an equivalent FCL sailing on the same lane, because cargo must be consolidated before departure and deconsolidated after arrival. The methods data puts FCL transit at 14–30 days and LCL transit at 15–35 days, with the per-port typical in the route data.',
  },
  {
    q: 'What is the biggest hidden cost in FCL to the GCC?',
    a: 'Demurrage and detention. Free time at GCC terminals runs only 3–7 days, and daily charges run $75–$300 once that clock expires. A customs or SABER hold can add hundreds of dollars to a single container and quietly erase the per-unit savings that made FCL attractive. Plan clearance and trucking before the vessel arrives.',
  },
  {
    q: 'Does the FCL vs LCL decision change my GCC duty and VAT?',
    a: 'No. The mode does not change the tax treatment. The GCC unified baseline import duty is 5% of CIF value, and VAT is charged on the duty-inclusive value at the destination country rate: Saudi 15%, UAE 5%, Qatar 0%, Kuwait 0%, Oman 5% and Bahrain 10%. Classify the correct HS code first, because duty and VAT compound the same way for both modes.',
  },
  {
    q: 'Do I need SABER or SASO for an LCL shipment?',
    a: 'Yes, if the goods are regulated and Saudi Arabia is the destination. SABER/SASO conformity applies to Saudi Arabia only, not the rest of the GCC, and the SABER SC certificate must be obtained before arrival — effective 1 January 2025. The shipment mode (FCL or LCL) does not remove the requirement.',
  },
  {
    q: 'Does ISF apply to the GCC?',
    a: 'No. ISF (Importer Security Filing) is a United States program and does not apply to GCC imports. Saudi Arabia has its own pre-arrival requirement through SABER/FASAH, but you should not copy a US ISF step into a China-to-GCC FCL or LCL workflow.',
  },
  {
    q: 'How do I choose between a 20ft and a 40ft for GCC FCL?',
    a: 'Start with cube and weight, not nominal capacity. A 20ft holds roughly 33 CBM and a 40ft roughly 67 CBM. Because a 40ft costs only ~30–50% more than a 20ft but holds about double the volume, a 40ft is usually better value once you are approaching a full 20ft — verify the weight limit and the live rate on both before choosing.',
  },
  {
    q: 'Which GCC port should I use for the FCL vs LCL decision?',
    a: 'Match the port to the final consignee, not just the rate. Use Jeddah for western Saudi Arabia, Dammam for the Eastern Province and Riyadh, Jebel Ali for UAE re-export and free-zone entry, Hamad for Qatar, Shuwaikh for Kuwait, Sohar for northern Oman, and Khalifa bin Salman for Bahrain or as an alternate into eastern Saudi Arabia. Then compare FCL and LCL on that single gate.',
  },
  {
    q: 'Where can I get a real FCL and LCL comparison?',
    a: 'Request an itemised quote with the same origin, commodity, HS code, cube, weight and final GCC destination. Ask the provider to show ocean freight, OTHC/DTHC, CFS fees for LCL, bunker, documentation, demurrage/detention free time, duty, VAT and the inland leg together — the headline line is never the landed cost.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'FCL vs LCL Shipping from China to GCC (2026): Full Container vs Less-than-Container',
      description:
        'FCL versus LCL container shipping from China to the GCC: 20ft/40ft and per-CBM rates by port, transit, the ~15 CBM break-even rule, demurrage and hidden charges, SABER compliance, and which mode fits your shipment.',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="FCL vs LCL Shipping from China to GCC (2026): Full Container vs Less-than-Container"
  description="FCL versus LCL container shipping from China to the GCC: 20ft/40ft and per-CBM rates by port, transit, the ~15 CBM break-even rule, demurrage and hidden charges, SABER compliance, and which mode fits your shipment."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'FCL vs LCL' },
        ]}
      />
      <span class="badge badge--amber">September 2026 updated</span>
      <h1>FCL vs LCL shipping from China to the GCC</h1>
      <p class="lead">
        A corridor-wide decision guide for importers choosing between a full container load and a shared
        less-than-container load into Saudi Arabia, the UAE, Qatar, Kuwait, Oman and Bahrain — with the
        published 20ft/40ft and per-CBM ranges, the ~15 CBM planning crossover, the demurrage trap that
        erodes FCL savings, and the SABER/SASO gate that only Saudi Arabia imposes.
      </p>
      <p class="small muted">
        Confidence badges separate verified figures from indicative planning notes. The 20ft/40ft and LCL
        per-CBM ranges come from the WorldFreightHub GCC route data (MEDIUM), and capacity, demurrage and
        transit rules of thumb come from the methods data (MEDIUM). Unquantified destination fees and
        CFS/THC dollar values are LOW confidence and shown as request-for-quote rather than invented.
        Treat every LOW-confidence figure as indicative and verify with your forwarder before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">20ft nominal capacity</span>
          <span class="fact-value">≈ 33 CBM <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">40ft nominal capacity</span>
          <span class="fact-value">≈ 67 CBM <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Planning crossover</span>
          <span class="fact-value">≈ 15 CBM <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">FCL transit</span>
          <span class="fact-value">14–30 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">LCL transit</span>
          <span class="fact-value">15–35 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">LCL slowdown</span>
          <span class="fact-value">5–10 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">GCC duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Demurrage</span>
          <span class="fact-value">$75–$300/day <ConfidenceBadge level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Rates table: FCL and LCL benchmarks across the seven GCC gateways</h2>
    <p>
      The published GCC route data gives every main destination gateway three benchmark lines:
      <strong>20ft FCL</strong>, <strong>40ft FCL</strong> and <strong>LCL per CBM</strong>, all MEDIUM
      confidence. Use them to build the headline freight comparison, but remember these are ranges from
      the WorldFreightHub snapshot — not live carrier quotes. The widest spreads sit on the Saudi
      gateways because the Red Sea and Strait of Hormuz routing risks are priced into the range, not
      because the market is simply noisy.
    </p>

    <DataTable
      columns={[
        { key: 'port', label: 'Destination port' },
        { key: 'twenty', label: '20ft FCL' },
        { key: 'forty', label: '40ft FCL' },
        { key: 'lcl', label: 'LCL per CBM' },
        { key: 'typical', label: 'Typical transit' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={rateRows}
      caption="All FCL and LCL ranges are MEDIUM confidence from the WorldFreightHub GCC route data; verify live figures before relying on them."
    />
    <SourceList sources={rateSources} title="Sources — FCL vs LCL rates" />

    <div class="note mt-2">
      <strong>How to read the ranges:</strong> the 20ft line is the benchmark for a single full box, the
      40ft line covers a 40GP/40HQ, and the LCL line is the per-cubic-metre rate for cargo sharing a
      container. Compare all three on the same port, then add destination charges — the headline line is
      never the landed cost.
    </div>
  </section>

  <section class="section container">
    <h2>2. Transit-time table: FCL vs LCL by destination port</h2>
    <p>
      The FCL-versus-LCL decision does not change the main-carriage clock; it changes the handling
      buffers around it. The methods data puts <strong>FCL transit at 14–30 days</strong> and
      <strong>LCL transit at 15–35 days</strong>, with LCL running <strong>5–10 days slower</strong>
      because cargo is consolidated before sailing and deconsolidated after arrival. The per-port typical
      figures below come from the route data.
    </p>

    <DataTable
      columns={[
        { key: 'port', label: 'Destination port' },
