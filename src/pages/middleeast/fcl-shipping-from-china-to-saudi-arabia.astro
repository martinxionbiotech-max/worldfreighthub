const faqs = [
  {
    q: 'How much does FCL shipping from China to Saudi Arabia cost?',
    a: 'Indicative August 2026 market snapshots put FCL 20GP around $3,333–$5,085 and FCL 40GP around $4,623–$8,085, depending on the route and data source. Freightos shows Shanghai–Riyadh 20ft at $3,333–$4,443 and 40ft/40HQ at $4,623–$6,164, while Sino-shipping shows China–Saudi 20GP at $5,085–$6,215 and 40GP at $6,615–$8,085. These are LOW-confidence market figures, not carrier quotes — verify before booking.',
  },
  {
    q: 'How long does FCL take from China to Saudi Arabia?',
    a: 'Indicative windows are 30–40 days for FCL Shanghai–Riyadh, 32–45 days for LCL Shanghai–Riyadh, roughly 20–35 days to Jeddah, and 30–45 days to Dammam/Riyadh Dry Port. Air is around 2–10 days. These are LOW-confidence research findings, verify with the carrier.',
  },
  {
    q: 'What are the 20GP, 40GP and 40HQ dimensions and load capacity?',
    a: 'Nominal ISO 668/ISO 1496 figures are roughly 33 CBM and 28,200 kg payload for a 20GP, 67 CBM and 26,500 kg for a 40GP, and 76 CBM and 26,300 kg for a 40HQ. Actual tare weight, payload and interior dimensions vary by container age and manufacturer, and Saudi road-weight limits also apply, so verify with your line before load planning.',
  },
  {
    q: 'FCL or LCL — which is cheaper for my cargo?',
    a: 'There is no fixed verified break-even CBM, but the planning rule is ~15 CBM — below that LCL usually wins per CBM, above it FCL usually becomes cheaper as you stop paying consolidation handling. Use the LCL per-CBM table against an FCL all-in quote for your actual volume, and ask for both quotes before deciding.',
  },
  {
    q: 'What is VGM and when do I submit it?',
    a: 'VGM is the Verified Gross Mass of the packed container, required under the SOLAS rule so the vessel can plan stowage safely. The shipper must declare the verified weight before the carrier’s VGM cutoff; submit it early because a missed cutoff means the container is rolled to the next vessel.',
  },
  {
    q: 'What weight limits apply to an FCL shipment to Saudi Arabia?',
    a: 'The operative limit is usually the Saudi road-legal weight, not the container rating — a 20GP is rated around 28,200 kg payload, but the trucker’s axle limits and road corridor often bind first. Confirm the container payload, the trucker’s axle limits and the road corridor before loading, especially for dense goods in a 20GP.',
  },
  {
    q: 'Can I ship dangerous goods in an FCL container?',
    a: 'Yes, but only with a correctly declared IMDG class, UN number, packing group, dangerous goods declaration and container packing certificate, and the right placards. Undeclared dangerous goods can be rejected at the port and expose the shipper to penalties and delays.',
  },
  {
    q: 'Should I palletise or floor-load my FCL container?',
    a: 'Palletised cargo is faster to load, unload and inspect but adds 15–25 kg of tare per pallet and consumes volume, while floor-loading maximises cube but needs blocking and bracing and is slower to handle. Match the choice to your product, destination labour and whether the consignee can handle either type.',
  },
  {
    q: 'What hidden fees should I expect on an FCL shipment?',
    a: 'Beyond ocean freight, expect a 5% CIF duty plus 15% VAT on CIF-plus-duty — a ×1.2075 landed-cost multiplier — then origin charges, destination THC and port charges, clearance and cargo service fees, SABER PC/SC conformity fees, and potential demurrage/detention after free time. Specific fee amounts were not published in the verified snapshot — request an itemised schedule.',
  },
  {
    q: 'Do I need SABER certificates for an FCL shipment?',
    a: 'Yes, if your goods are regulated. Obtain the Product Conformity Certificate (PC) per product, then the Shipment Conformity Certificate (SC) per shipment. Since 1 January 2025 the SC must be obtained before cargo arrival or clearance fails.',
  },
  {
    q: 'Which Saudi port should I use for FCL — Jeddah or Dammam?',
    a: 'Jeddah is the principal Red Sea gateway for western/central Saudi consignees, Dammam serves Riyadh and the Eastern Province, and Riyadh Dry Port covers the inland leg — with FCL transit of 30–40 days, so inland trucking cost often decides the port. Match the discharge port to your consignee and confirm inland trucking cost.',
  },
  {
    q: 'How do demurrage and detention work on an FCL container?',
    a: 'Demurrage is charged by the terminal when the container stays inside the port beyond free time after discharge; detention is charged by the carrier when the container stays outside the port beyond free time. Avoid both by filing the FASAH pre-arrival declaration, obtaining the SC before arrival and booking trucking before discharge.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'FCL Shipping from China to Saudi Arabia: Container Sizes, Rates & Loading Rules (August 2026)',
      description:
        'FCL shipping from China to Saudi Arabia explained: 20GP/40GP/40HQ sizes and load capacity, indicative FCL/LCL rates and transit times, FCL vs LCL, VGM, weight limits and dangerous goods.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
