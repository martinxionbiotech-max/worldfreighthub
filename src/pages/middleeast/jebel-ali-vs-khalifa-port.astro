];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Jebel Ali vs Khalifa Port — Which UAE Gateway Should Your Gulf Freight Use? (September 2026)',
      description:
        'Jebel Ali vs Khalifa Port destination comparison for China-to-GCC freight: re-export hub vs Abu Dhabi industrial gateway, draft, hinterland, free zones and a cargo-based decision framework.',
      datePublished: '2026-09-12',
      dateModified: '2026-09-12',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
  {
    type: 'Place',
    data: {
      name: 'Jebel Ali',
      url: `${SITE_URL}/ports/jebel-ali/`,
      additionalType: 'Seaport',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Dubai',
        addressCountry: 'AE',
      },
      description:
        'Jebel Ali is the Middle East’s largest container port and re-export hub, backed by the JAFZA free zone and serving Dubai and the wider GCC.',
    },
  },
  {
    type: 'Place',
    data: {
      name: 'Khalifa Port Abu Dhabi',
      url: `${SITE_URL}/ports/khalifa-port-abu-dhabi/`,
      additionalType: 'Seaport',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Abu Dhabi',
        addressCountry: 'AE',
      },
      description:
        'Khalifa Port Abu Dhabi is the UAE’s deep-water, semi-automated industrial gateway and the anchor of the KIZAD industrial zone.',
    },
