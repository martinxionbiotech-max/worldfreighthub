    confidence: 'HIGH',
  },
  {
    factor: 'Automation / terminal',
    jebelAli: 'JAFZA free-zone hub',
    khalifa: 'Semi-automated terminal',
    note: 'Automation is highlighted only in the Khalifa profile',
    confidence: 'HIGH',
  },
  {
    factor: 'Free / industrial zone',
    jebelAli: 'JAFZA — duty deferral and re-export flexibility',
    khalifa: 'KIZAD — energy, metals, logistics and light industry',
    note: 'Choose the zone that matches the business model',
    confidence: 'HIGH',
  },
  {
    factor: 'Operator',
    jebelAli: jebelAli?.operator ?? 'Not published',
    khalifa: khalifa?.operator ?? 'Not published',
    note: 'Different operator groups serve the two UAE facilities',
