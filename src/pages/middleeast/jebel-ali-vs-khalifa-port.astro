    note: 'JAFZA is distribution-led; KIZAD is industrial-led',
    confidence: 'HIGH',
  },
  {
    parameter: 'Hinterland',
    jebelAli: 'Dubai and the wider GCC re-export region',
    khalifa: 'Abu Dhabi emirate and the KIZAD industrial zone',
    note: 'The final destination and onward-leg logic decide the gate',
