  },
  {
    factor: 'Congestion / capacity posture',
    jebelAli: 'Re-export hub and lowest-friction entry point',
    khalifa: 'Newer, deeper and less congested capacity play',
    note: 'Confirm terminal congestion and free time before booking',
    confidence: 'MEDIUM',
  },
];

const costRows = [
  {
    item: 'Destination THC / port charges',
    jebelAli: 'Not published in port profile',
    khalifa: 'Not published in port profile',
    note: 'Request the terminal fee schedule at booking',
    confidence: 'LOW',
  },
  {
    item: 'Free-zone / storage handling',
    jebelAli: 'JAFZA allows duty-deferred consolidation and re-export',
    khalifa: 'KIZAD suits assembly, storage and distribution',
