import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { gccPorts } from '../../data/gcc-ports';

const pageUrl = `${SITE_URL}/middleeast/jebel-ali-vs-khalifa-port/`;
const jebelAli = gccPorts.find((item) => item.slug === 'jebel-ali');
const khalifa = gccPorts.find((item) => item.slug === 'khalifa-port-abu-dhabi');
const jebelAliCode = jebelAli?.unlocode ?? '—';
const khalifaCode = khalifa?.unlocode ?? '—';
const jebelAliUpdated = jebelAli?.updated ?? 'not published';
const khalifaUpdated = khalifa?.updated ?? 'not published';

const portSources = sourcesByIds(['dp-world', 'abu-dhabi-ports']);

const comparisonRows = [
  {
    parameter: 'Port role',
    jebelAli: 'Middle East’s flagship port and re-export hub',
    khalifa: 'Abu Dhabi’s deep-water, semi-automated flagship',
