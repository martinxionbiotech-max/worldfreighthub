    confidence: 'HIGH',
  },
  {
    cargo: 'Assembly, storage or distribution inside KIZAD',
    bestPort: 'Khalifa Port + KIZAD',
    why: 'KIZAD is attractive for importers doing UAE-based assembly or distribution',
    confidence: 'MEDIUM',
  },
  {
    cargo: 'Shippers who find Jebel Ali expensive or congested',
    bestPort: 'Khalifa Port',
    why: 'The profile calls Khalifa a newer, deeper and less congested alternative',
    confidence: 'MEDIUM',
  },
];

const facilityRows = [
  {
    factor: 'Container scale',
