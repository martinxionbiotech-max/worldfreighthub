  },
];

const decisionRows = [
  {
    cargo: 'GCC re-export, consolidation and consumer goods',
    bestPort: 'Jebel Ali',
    why: 'Jebel Ali is the region’s re-export engine, backed by JAFZA duty-deferred flexibility',
    confidence: 'HIGH',
  },
  {
    cargo: 'Dubai and wider UAE distribution',
    bestPort: 'Jebel Ali',
    why: 'The profile positions Jebel Ali as the lowest-friction UAE entry point',
