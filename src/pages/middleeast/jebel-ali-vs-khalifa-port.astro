    confidence: 'HIGH',
  },
  {
    parameter: 'Container scale',
    jebelAli: '≈ 14.5m TEU (2023)',
    khalifa: 'Design capacity ≈ 9m+ TEU (post-expansion)',
    note: 'Not identical metrics — throughput versus design capacity',
    confidence: 'HIGH',
  },
