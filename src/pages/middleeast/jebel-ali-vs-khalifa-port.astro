  },
  {
    parameter: 'Operator',
    jebelAli: jebelAli?.operator ?? 'Not published',
    khalifa: khalifa?.operator ?? 'Not published',
    note: 'Different port groups operate the two facilities',
    confidence: 'HIGH',
  },
