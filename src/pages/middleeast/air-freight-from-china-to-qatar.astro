---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/air-freight-from-china-to-qatar/`;

const iata: Source = {
  id: 'iata',
  name: 'IATA — air cargo chargeable weight guidance',
  url: 'https://www.iata.org',
  type: 'organization',
};

const wfhMethodData: Source = {
  id: 'wfh-air-method-data',
  name: 'WorldFreightHub methods data — air freight and sea context rate bands and transit windows',
  url: `${SITE_URL}/methods/`,
  type: 'organization',
};

const wfhCountryData: Source = {
  id: 'wfh-air-country-data',
  name: 'WorldFreightHub GCC country data — Qatar VAT, duty and compliance profile (HIGH confidence)',
  url: `${SITE_URL}/countries/`,
  type: 'organization',
};

const qatarCustoms = sourcesByIds(['qatar-customs']);

const rateSources: Source[] = [wfhMethodData, ...qatarCustoms];
const transitSources: Source[] = [wfhMethodData];
const chargeableSources: Source[] = [iata, wfhMethodData];
const airportSources: Source[] = [iata, wfhMethodData, ...qatarCustoms];
const comparisonSources: Source[] = [wfhMethodData, wfhCountryData, ...qatarCustoms];
const costSources: Source[] = [wfhMethodData, wfhCountryData, ...qatarCustoms];
const complianceSources: Source[] = [...qatarCustoms, wfhCountryData];

const airRateRows = [
  {
    service: 'Air freight · China → GCC corridor reference',
    benchmark: '$4.3 – $11.0 / kg',
    transit: '3–7 days airport-to-airport',
    basis: 'WorldFreightHub methods data (generic China→GCC band)',
    confidence: 'MEDIUM',
  },
  {
    service: 'Air freight · China → Qatar country-specific',
    benchmark: 'Not published — request a per-kg quote',
    transit: '3–7 days planning range',
    basis: 'No verified Qatar air benchmark in the snapshot',
    confidence: 'LOW',
  },
  {
    service: 'Express courier · China → Qatar',
    benchmark: 'Not published — request a per-kg quote',
    transit: '3–7 days door-to-door',
    basis: 'Express transit is MEDIUM from methods data; per-kg rate not published',
    confidence: 'LOW',
  },
  {
    service: 'DDP air · China → Qatar',
    benchmark: 'Not published — request a per-kg quote',
    transit: '~10–15 days door-to-door',
    basis: 'DDP air transit from methods data; per-kg rate not published',
    confidence: 'LOW',
  },
];

const seaContextRows = [
  {
    item: 'FCL container capacity',
    value: '20ft ≈ 33 CBM · 40ft ≈ 67 CBM',
    basis: 'WorldFreightHub methods data',
    confidence: 'MEDIUM',
  },
  {
    item: '40ft vs 20ft premium',
    value: '~30–50% more than a 20ft',
    basis: 'WorldFreightHub methods data',
    confidence: 'MEDIUM',
  },
  {
    item: 'FCL vs LCL crossover',
    value: 'FCL beats LCL above ~15 CBM',
    basis: 'WorldFreightHub methods data',
    confidence: 'MEDIUM',
  },
  {
    item: 'Demurrage after free time',
    value: '$75–300/day after 3–7 free days',
    basis: 'WorldFreightHub methods data',
    confidence: 'MEDIUM',
  },
  {
    item: 'Sea rate · China → Qatar lane',
    value: 'Not published — request a per-container / per-CBM quote',
    basis: 'No verified Qatar sea benchmark in the snapshot',
    confidence: 'LOW',
  },
];

const airTransitRows = [
  {
    method: 'Air freight (airport-to-airport)',
    window: '3–7 days',
    note: 'Flight is hours; origin pickup, export handling, clearance and delivery sit on top',
    confidence: 'MEDIUM',
  },
  {
    method: 'Express courier (door-to-door)',
    window: '3–7 days',
    note: 'Simplest, fully tracked, highest per-kg cost',
    confidence: 'MEDIUM',
  },
  {
    method: 'DDP air (door-to-door)',
    window: '~10–15 days',
    note: 'Adds destination clearance and final delivery to the air leg',
    confidence: 'LOW',
  },
  {
    method: 'By origin airport (PVG/SZX/CAN/HKG → DOH)',
    window: 'Not published',
    note: 'No airport-specific day is published in the snapshot — request a lane estimate',
    confidence: 'LOW',
  },
];

const airVsSeaRows = [
  {
    factor: 'Indicative transit',
    air: '3–7 days airport-to-airport',
    sea: 'Slower than air — exact Qatar sailing window not published; request a schedule',
    confidence: 'LOW',
  },
  {
    factor: 'Unit basis',
    air: 'Per chargeable kilogram (actual or volumetric, whichever is higher)',
    sea: 'Per container for FCL; per CBM for LCL',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Cost pattern',
    air: 'High unit cost that rises with weight, volume and urgency',
    sea: 'Lowest unit cost once a box is reasonably full',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Volume crossover',
    air: 'Best for small, time-critical consignments',
    sea: 'FCL beats LCL above ~15 CBM; 20ft ≈ 33 CBM / 40ft ≈ 67 CBM',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Hidden time cost',
    air: 'Airport storage after free time (amounts not published)',
    sea: 'Demurrage $75–300/day after 3–7 free days',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Tax position',
    air: 'Same 5% CIF duty and 0% VAT apply',
    sea: 'Same 5% CIF duty and 0% VAT apply — sea does not remove paperwork',
    confidence: 'HIGH',
  },
];

const volumetricRows = [
  {
    example: 'Light, bulky carton',
    actualWeight: '20 kg',
    dimensions: '80 × 50 × 40 cm',
    volumetricWeight: '80 × 50 × 40 ÷ 6000 = 26.7 kg',
    chargeableWeight: '26.7 kg',
    note: 'You pay for 26.7 kg, not 20 kg',
  },
  {
    example: 'Same carton by courier / express',
    actualWeight: '20 kg',
    dimensions: '80 × 50 × 40 cm',
    volumetricWeight: '80 × 50 × 40 ÷ 5000 = 32 kg',
    chargeableWeight: '32 kg',
    note: 'Couriers charge more for bulky light cargo',
  },
];

const chinaGatewayRows = [
  {
    gateway: 'Shanghai Pudong (PVG)',
    role: 'East China anchor for Gulf-bound air freight',
    confidence: 'LOW',
  },
  {
    gateway: 'Shenzhen Bao’an (SZX)',
    role: 'South China / Pearl River Delta electronics gateway',
    confidence: 'LOW',
  },
  {
    gateway: 'Guangzhou Baiyun (CAN)',
    role: 'South China air alternative',
    confidence: 'LOW',
  },
  {
    gateway: 'Hong Kong (HKG)',
    role: 'Major regional transshipment and freighter hub',
    confidence: 'LOW',
  },
];

const qatarAirportRows = [
  {
    gateway: 'Doha Hamad International (DOH)',
    role: 'Qatar arrival gateway for China air cargo',
    confidence: 'LOW',
  },
];

const qatarPortRows = [
  {
    gateway: 'Hamad Port (QAHMD)',
    role: "Qatar's sole commercial gateway — opened 2017, ~7.5m TEU design capacity, operator Mwani Qatar",
    confidence: 'HIGH',
  },
];

const costRows = [
  {
    item: 'Air freight (chargeable weight)',
    who: 'Airline / forwarder',
    magnitude: 'Generic $4.3 – $11.0/kg corridor band (MEDIUM); Qatar lane not published',
    confidence: 'LOW',
  },
  {
    item: 'Fuel surcharge',
    who: 'Airline',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Security surcharge',
    who: 'Airline',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Terminal / airline handling',
    who: 'Origin / destination handler',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Airport storage after free time',
    who: 'Ground handler',
    magnitude: 'Not published in the verified snapshot — request the free-time window and per-day rate',
    confidence: 'LOW',
  },
  {
    item: 'Customs clearance / brokerage',
    who: 'Licensed broker / General Authority of Customs',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Documentation',
    who: 'Forwarder / broker',
    magnitude: 'Not published in the verified snapshot — request an itemised quote',
    confidence: 'LOW',
  },
  {
    item: 'Import duty (baseline)',
    who: 'General Authority of Customs',
    magnitude: '5% of CIF value',
    confidence: 'HIGH',
  },
  {
    item: 'Import VAT',
    who: 'Qatar tax authority',
    magnitude: '0% today (VAT signed but not implemented)',
    confidence: 'HIGH',
  },
];

const hiddenChargeCards = [
  {
    title: 'Fuel surcharge',
    text: 'An airline-imposed variable added on top of the base per-kg rate. It moves with fuel and is frequently buried in the quote line, which is why the all-in figure matters.',
  },
  {
    title: 'Security surcharge',
    text: 'Covers security screening and related compliance steps. Specific amounts were not published in the verified snapshot, so ask for it as a separate line.',
  },
  {
    title: 'Terminal handling',
    text: 'Origin and destination handlers charge for receiving, screening and staging the cargo. This is usually a fixed line that competitors fold into the headline rate.',
  },
  {
    title: 'Airport storage after free time',
    text: 'Air cargo gets a limited free-storage window at DOH; days beyond that become chargeable. The exact window and per-day rate are not published — request them.',
  },
  {
    title: 'Clearance & brokerage',
    text: 'Customs brokerage and clearance are separate from the airline bill and depend on the broker, HS code and permit requirements.',
  },
  {
    title: 'Documentation',
    text: 'AWB, commercial invoice, packing list, certificate of origin and any product-specific permit work all add handling time and fees.',
  },
];

const faqs = [
  {
    q: "What is air freight from China to Qatar?",
    a: "Air freight from China to Qatar typically moves on the $4.3–$11.0/kg corridor band in 3–7 days to Doha Hamad International (DOH), billed on chargeable weight — the higher of actual and volumetric weight. It is used when speed, shelf life or value density justify the higher cost.",
  },
  {
    q: "How is air freight charged — actual weight or volumetric weight?",
    a: "Air freight is billed on the higher of actual gross weight and volumetric weight, where volumetric weight is L × W × H (cm) ÷ 6,000. A light, bulky carton can therefore be billed at far more than its actual weight, while a dense carton is billed at actual weight.",
  },
  {
    q: "How do I calculate volumetric weight for Qatar air freight?",
    a: "Volumetric weight is L × W × H (cm) ÷ 6,000, so an 80 × 50 × 40 cm carton is 160,000 cm³ ÷ 6,000 = 26.7 kg. If its actual weight is 20 kg, you pay for 26.7 kg — a 33.5% uplift. Couriers use ÷ 5,000, which makes the same carton 32 kg — a 60% uplift.",
  },
  {
    q: "What does air freight from China to Qatar cost?",
    a: "The verified generic China→GCC corridor band is $4.3–$11.0/kg (MEDIUM confidence). A country-specific Qatar per-kg benchmark is not published in the verified snapshot, so request an itemised quote for your actual lane, dimensions and weight rather than relying on a borrowed figure.",
  },
  {
    q: "How long does air freight from China to Doha take?",
    a: "A planning range of 3–7 days is reasonable for direct airport-to-airport moves. Express courier is also 3–7 days door-to-door, and DDP air is ~10–15 days because it adds destination clearance and final delivery. Airport-specific days are not published — confirm the pair and transit point with your carrier.",
  },
  {
    q: "Which Qatar airport should I use for air freight?",
    a: "Doha Hamad International (DOH) is the Qatar arrival gateway for China air cargo, sitting under the same $4.3–$11.0/kg, 3–7 day corridor band — match the arrival airport to your consignee and confirm the final-mile leg, because DOH's storage and handling terms are not published.",
  },
  {
    q: "When should I choose air freight instead of sea freight for Qatar?",
    a: "Air wins on time — 3–7 days versus 14–30 by sea — while sea wins on volume, since FCL beats LCL above ~15 CBM with a 20ft at ≈ 33 CBM and a 40ft at ≈ 67 CBM. Choose air when the cargo is urgent, high-value, perishable, fragile or needed to avoid a stockout; choose sea when volume is large.",
  },
  {
    q: "Does air freight to Qatar save me duty or VAT?",
    a: "No. Air freight shortens transit but does not waive the 5% CIF import duty. Qatar currently has 0% VAT, which is a landed-cost advantage today, but that saving applies equally to sea freight — it is not an air-specific benefit.",
  },
  {
    q: "Is SABER or SASO certification required for Qatar air freight?",
    a: "No — SABER/SASO is a Saudi-only conformity programme, so Qatar clearance instead runs on a 5% CIF duty and 0% VAT basis. Qatar instead applies 10-digit HS classification, import declaration via the General Authority of Customs, and product-specific permits for regulated categories.",
  },
  {
    q: "What documents and taxes apply to a Qatar air freight import?",
    a: "A Qatar air freight import carries 5% CIF duty plus 0% VAT — a ×1.05 landed-cost multiplier — with an air waybill, commercial invoice, packing list, certificate of origin and correct 10-digit HS classification. De minimis is not published — confirm with the General Authority of Customs before shipping low-value goods.",
  },
  {
    q: "What hidden fees should I expect on Qatar air freight?",
    a: "Beyond the per-kg rate: fuel and security surcharges, terminal handling, airport storage after free time, customs clearance and brokerage, and documentation. Specific amounts were not published in the verified snapshot, so request an itemised schedule for every line.",
  },
  {
    q: "How does Qatar's 0% VAT change the air vs sea decision?",
    a: "The 0% VAT rate lowers Qatar's landed cost versus Saudi Arabia's 15% and Bahrain's 10% VAT (HIGH-confidence GCC country data), but it applies to both air and sea. That makes the slower sea option more attractive for cost-sensitive cargo, while air remains the choice when speed, perishability, stockout risk or high value-per-kg justify the premium.",
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline:
        'Air Freight from China to Qatar: DOH/Hamad Gateways, Chargeable Weight & Rates (September 2026 Updated)',
      description:
        'Air freight from China to Qatar: DOH/Hamad gateway context, the 6,000-divisor chargeable weight rule, the generic $4.3–$11.0/kg corridor band, 3–7 day transit planning, hidden charges and Qatar compliance.',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="Air Freight from China to Qatar: DOH/Hamad Gateways, Chargeable Weight & Rates (September 2026 Updated)"
  description="Air freight from China to Qatar: DOH/Hamad gateway context, the 6,000-divisor chargeable weight rule, the generic $4.3–$11.0/kg corridor band, 3–7 day transit planning, hidden charges and Qatar compliance."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Air freight from China to Qatar' },
        ]}
      />
      <span class="badge badge--amber">September 2026 updated</span>
      <h1>Air freight from China to Qatar: DOH/Hamad gateways, chargeable weight &amp; rates (September 2026 updated)</h1>
      <p class="lead">
        Air freight to Doha is fast, but the invoice depends on a number most shippers never
        measure: chargeable weight. This page explains the 6,000-divisor rule that makes bulky
        cargo expensive, the DOH/Hamad gateway context, the generic corridor per-kg band, 3–7 day
        transit planning, and the Qatar compliance points — including why SABER/SASO does not apply.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> Air to Qatar (Doha DOH) runs the $4.3–$11.0/kg corridor band at 3–7 days versus 14–30 days by sea, but Qatar's own per-kg benchmark is not published — quote the lane before comparing rates. Chargeable weight is the first multiplier: an 80 × 50 × 40 cm carton bills at 26.7 kg (÷6,000) or 32 kg (÷5,000) against 20 kg actual — a 33.5–60% uplift. Qatar's 0% VAT + 5% duty is ×1.05 on CIF — the lowest GCC stack — so a $10,000 CIF shipment adds just $500, which makes air viable for higher-value goods because the tax saving partly offsets the premium.</p>
      </blockquote>
      <p class="small muted">
        Confidence badges separate verified figures from indicative planning context. Treat every
        LOW-confidence rate and routing note as indicative, and request an itemised quote for
        unpublished lanes. Qatar has no country-specific air benchmark in the verified snapshot.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Generic air rate</span>
          <span class="fact-value">$4.3 – $11.0/kg <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Qatar air rate</span>
          <span class="fact-value">Not published <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Air transit</span>
          <span class="fact-value">3–7 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Chargeable divisor</span>
          <span class="fact-value">÷6000 (air) / ÷5000 (courier) <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">DOH</span>
          <span class="fact-value">Hamad International <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Qatar VAT</span>
          <span class="fact-value">0% <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Baseline duty</span>
          <span class="fact-value">5% CIF <ConfidenceBadge level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Air freight rates from China to Qatar: what is published and what is not</h2>
    <p>
      Air pricing moves weekly with fuel, capacity, season and airport pairing, so this page
      deliberately separates the verified generic corridor band from the country-specific lane.
      Qatar has <strong>no published per-kg air benchmark</strong> in the verified snapshot, so that
      cell is shown as “not published” rather than padded with a borrowed Saudi or UAE figure.
    </p>

    <DataTable
      columns={[
        { key: 'service', label: 'Air service' },
        { key: 'benchmark', label: 'Indicative benchmark' },
        { key: 'transit', label: 'Indicative transit' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={airRateRows}
      caption="The generic China→GCC air band is MEDIUM confidence from the methods data. Qatar country-specific, express and DDP per-kg rates were not published — request a quote."
    />
    <SourceList sources={rateSources} title="Sources — Qatar air rates" />

    <h3 class="mt-3">Sea context for the “should you fly or sail” decision</h3>
    <p>
      Sea freight is the comparison that decides whether air is worth it. The container economics
      below are MEDIUM confidence from the methods data; the Qatar-lane sea rate itself is not
      published, so request it before comparing landed costs.
    </p>

    <DataTable
      columns={[
        { key: 'item', label: 'Sea context' },
        { key: 'value', label: 'Verified value' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={seaContextRows}
      caption="Container capacity, the 40ft premium, the ~15 CBM crossover and demurrage are MEDIUM confidence. The Qatar sea rate itself is not published — request a quote."
    />
    <SourceList sources={[wfhMethodData]} title="Sources — sea comparison context" />

    <div class="note mt-2">
      <strong>Do not average the rows together.</strong> The $4.3–$11.0/kg figure is a generic
      China→GCC band on an unpublished chargeable-weight base. Compare quotes on total chargeable
      kilograms and the all-in line items, never on the headline per-kg rate alone.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Typical air transit windows from China to Doha</h2>
      <p>
        The Qatar corridor is short enough that air transit is measured in days, not weeks. The
        planning ranges below cover direct airport-to-airport moves, express services and
        door-to-door DDP air; all depend on schedule, customs and the final-mile leg.
      </p>

      <DataTable
        columns={[
          { key: 'method', label: 'Method' },
          { key: 'window', label: 'Transit window' },
          { key: 'note', label: 'What drives the window' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={airTransitRows}
        caption="Air and express windows are MEDIUM confidence from the methods data; DDP air is LOW confidence. Airport-specific days are not published."
      />
      <SourceList sources={transitSources} title="Sources — air transit times" />

      <div class="note mt-2">
        <strong>Airport pair matters.</strong> The China gateways (PVG/SZX/CAN/HKG) and Doha Hamad
        (DOH) are operational routing context, not verified in the snapshot — confirm the airport
        pair and transit point with your carrier before relying on a specific day count.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. Air vs sea vs express for Qatar: the decision framework</h2>
    <p>
      Qatar's tax position changes the air-vs-sea math. With <strong>0% VAT</strong> today, the
      landed cost is already lower than Saudi Arabia's 15% or Bahrain's 10% VAT (HIGH confidence GCC country data) — but that saving
      applies to both modes. The decision is therefore speed versus per-unit cost, with the
      chargeable-weight rule deciding how wide the gap really is.
    </p>

    <DataTable
      columns={[
        { key: 'factor', label: 'Factor' },
        { key: 'air', label: 'Air freight' },
        { key: 'sea', label: 'Sea freight' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={airVsSeaRows}
      caption="Transit and pricing are indicative; the ~15 CBM crossover and demurrage are MEDIUM confidence. The 5% duty and 0% VAT apply equally to both modes."
    />
    <SourceList sources={comparisonSources} title="Sources — air vs sea for Qatar" />

    <h3 class="mt-3">When the air premium pays off</h3>
    <div class="grid grid--2 mt-2">
      <Card title="Choose air freight when...">
        <ul>
          <li>Cargo is perishable or has a short shelf life.</li>
          <li>A stockout costs more than the freight premium.</li>
          <li>Goods are high-value per kilogram, so freight is a small share of value.</li>
          <li>Spare parts must reach a stopped operation quickly.</li>
        </ul>
      </Card>
      <Card title="Choose sea freight when...">
        <ul>
          <li>Volume is large — FCL beats LCL above ~15 CBM.</li>
          <li>Cargo is dense, heavy or low-value.</li>
          <li>The 0% VAT advantage should be captured on the slower, cheaper mode.</li>
          <li>You can plan around the longer transit without a stockout.</li>
        </ul>
      </Card>
    </div>

    <div class="grid grid--2 mt-2">
      <Card title="Choose express courier when...">
        <ul>
          <li>Parcels are small, urgent and door-to-door tracking matters.</li>
          <li>One booking is worth more than managing an airport-to-airport move.</li>
          <li>You want the courier to handle clearance.</li>
          <li>You accept the ÷5000 divisor for bulky light parcels.</li>
        </ul>
      </Card>
    </div>

    <div class="note mt-2">
      <strong>The tax angle is honest, not a shortcut.</strong> Qatar's 0% VAT lowers landed cost
      versus Saudi (15%) and Bahrain (10%), but it does not favour air over sea. If the shipment is
      cost-sensitive and can wait, the tax saving is a reason to choose the slower sea option, not
      to overspend on air.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Airports and ports: China gateways to DOH and Hamad</h2>
      <p>
