---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import { gccCountries } from '../../data/gcc-countries';
import { SITE_URL } from '../../site';

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'Middle East destination countries',
      itemListElement: gccCountries.map((country, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: country.name,
        url: `${SITE_URL}/countries/${country.slug}/`,
      })),
    },
  },
];
---

<BaseLayout
  title="Middle East Freight — China to GCC"
  description="WorldFreightHub Middle East: freight intelligence for the China to GCC corridor, covering Saudi Arabia, UAE, Qatar, Kuwait, Oman and Bahrain."
  canonical={`${SITE_URL}/middleeast/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Middle East' }]} />
      <h1>Middle East freight intelligence</h1>
      <p class="lead">
        A dedicated view of the China → GCC corridor, covering routes, ports and
        customs profiles for the six Gulf Cooperation Council states.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>Destination countries</h2>
    <div class="grid grid--3 mt-2">
      {gccCountries.map((country) => (
        <Card
          title={country.name}
          description={`Capital ${country.capital} · Currency ${country.currency} · VAT ${
            country.vatRate === null ? 'none' : `${country.vatRate}%`
          }.`}
          href={`/countries/${country.slug}/`}
        />
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Start exploring</h2>
      <div class="grid grid--3 mt-2">
        <Card
          title="Saudi Arabia route pillar"
          description="FCL/LCL rates, transit times, SABER compliance and Jeddah vs Dammam routing."
          href="/middleeast/shipping-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia DDP shipping"
          description="What Delivered Duty Paid includes: duty, 15% VAT, SABER fees and hidden destination costs."
          href="/middleeast/ddp-shipping-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia FCL shipping"
          description="20GP/40GP/40HQ load planning, VGM, weight limits and FCL vs LCL decision support."
          href="/middleeast/fcl-shipping-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia LCL shipping"
          description="Per-CBM pricing, CFS consolidation, hidden destination fees and the LCL vs FCL crossover."
          href="/middleeast/lcl-shipping-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia sea freight"
          description="FCL vs LCL overview, sea vs air decision framework, transit windows, routing and landed cost."
          href="/middleeast/sea-freight-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia air freight"
          description="Chargeable vs volumetric weight, indicative per-kg rates, 3-7 day transit and the air vs sea decision."
          href="/middleeast/air-freight-from-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia customs clearance"
          description="FASAH workflow, required documents, SABER SC timing, self-clearance vs broker and hidden fees."
          href="/middleeast/saudi-customs-clearance/"
        />
        <Card
          title="Saudi Arabia import duty & VAT"
          description="How the 5% CIF duty and 15% VAT stack: the CIF × 1.05 × 1.15 landed-cost formula and a worked example."
          href="/middleeast/saudi-arabia-import-duty-vat/"
        />
        <Card
          title="SASO & SABER certification"
          description="PC vs SC, the step-by-step registration flow, and the 2025 rule that SC must be obtained before arrival."
          href="/middleeast/saso-saber-certification/"
        />
        <Card
          title="Jeddah Islamic Port"
          description="Red Sea gateway intelligence: port parameters, China transit, Jeddah vs Dammam routing, costs and SABER/VAT clearance."
          href="/middleeast/jeddah-islamic-port/"
        />
        <Card
          title="King Abdulaziz Port Dammam"
          description="Arabian Gulf gateway intelligence: Eastern Province, Riyadh Dry Port transfer, oil & gas cargo, costs and SABER/VAT clearance."
          href="/middleeast/king-abdulaziz-port-dammam/"
        />
        <Card
          title="Riyadh Dry Port"
          description="Saudi inland container depot intelligence: Dammam rail transfer, Riyadh inland clearance, transit, costs and SABER/VAT compliance."
          href="/middleeast/riyadh-dry-port/"
        />
        <Card
          title="Jeddah vs Dammam"
          description="Which Saudi port should your China freight use? Red Sea vs Arabian Gulf, transit, cost and the hinterland decision framework."
          href="/middleeast/jeddah-vs-dammam/"
        />
        <Card
          title="Saudi Arabia shipping cost"
          description="Complete landed-cost breakdown: sea/air freight, THC, documents, clearance, SABER fees, 5% duty and 15% VAT."
          href="/middleeast/shipping-cost-china-to-saudi-arabia/"
        />
        <Card
          title="Saudi Arabia transit time"
          description="Jeddah vs Dammam sea windows, FCL vs LCL differences, air/express transit and the delays that stretch the clock."
          href="/middleeast/transit-time-china-to-saudi-arabia/"
        />
        <Card
          title="UAE route pillar"
          description="FCL/LCL/air rates, Jebel Ali/Khalifa/Sharjah routing, 5% VAT and 5% duty, and the sea/air/express decision."
          href="/middleeast/shipping-from-china-to-uae/"
        />
        <Card
          title="UAE DDP shipping"
          description="What Delivered Duty Paid includes: 5% duty, 5% VAT, free zone vs mainland treatment and hidden destination costs."
          href="/middleeast/ddp-shipping-from-china-to-uae/"
        />
        <Card
          title="UAE FCL shipping"
          description="20GP/40GP/40HQ load planning, 20ft vs 40ft unit-cost crossover, VGM, weight limits and Jebel Ali transshipment."
          href="/middleeast/fcl-shipping-china-to-uae/"
        />
        <Card
          title="UAE LCL shipping"
          description="Per-CBM pricing, the chargeable CBM trap, Jebel Ali CFS consolidation, hidden destination fees and the LCL vs FCL crossover."
          href="/middleeast/lcl-shipping-china-to-uae/"
        />
        <Card
          title="UAE sea freight"
          description="Shanghai/Ningbo/Shenzhen to Jebel Ali routings, the typical 21-day transit, the 12-step FCL chain and THC/B/L fees."
          href="/middleeast/sea-freight-from-china-to-uae/"
        />
        <Card
          title="UAE air freight"
          description="DXB/DWC gateways, the 6,000-divisor chargeable weight rule, indicative AED/kg rates, 3-7 day transit and lithium limits."
          href="/middleeast/air-freight-from-china-to-uae/"
        />
        <Card
          title="UAE customs clearance"
          description="Mirsal 2 workflow, required documents, HS classification, free zone vs mainland treatment and common hold reasons."
          href="/middleeast/uae-customs-clearance/"
        />
        <Card
          title="UAE import duty & VAT"
          description="How the 5% CIF duty and 5% VAT stack: the CIF × 1.05 × 1.05 landed-cost formula, reverse charge and a worked example."
          href="/middleeast/uae-import-duty-vat/"
        />
        <Card
          title="UAE shipping cost"
          description="Complete landed-cost breakdown: sea/air freight, THC, documents, Mirsal 2 clearance, free zone differences, 5% duty and 5% VAT."
          href="/middleeast/shipping-cost-china-to-uae/"
        />
        <Card
          title="UAE transit time"
          description="Jebel Ali's typical 21-day sea window, Khalifa and Sharjah port notes, 3-7 day air freight and the delays that stretch the clock."
          href="/middleeast/transit-time-china-to-uae/"
        />
        <Card
          title="UAE sea vs air freight"
          description="Cost, 21-day vs 3-7 day transit, CBM vs chargeable weight, the 6,000-divisor rule, lithium risks and a hybrid sea-plus-air plan."
          href="/middleeast/sea-vs-air-freight-china-to-uae/"
        />
        <Card
          title="Jebel Ali Port"
          description="Middle East container hub intelligence: DP World, JAFZA integration, China transit, UAE routing and 5% duty/VAT clearance."
          href="/middleeast/jebel-ali-port/"
        />
        <Card
          title="Khalifa Port Abu Dhabi"
          description="Abu Dhabi deep-water gateway intelligence: semi-automated CSP terminal, KIZAD, Abu Dhabi vs Dubai routing and 5% duty/VAT."
          href="/middleeast/khalifa-port-abu-dhabi/"
        />
        <Card
          title="Sharjah Port (Port Khalid)"
          description="Northern-emirate gateway intelligence: AESHJ, Sharjah vs Jebel Ali vs Khalifa routing, China transit, LCL/FCL choice and hidden destination fees."
          href="/middleeast/sharjah-port/"
        />
        <Card
          title="Amazon FBA UAE & noon"
          description="Shipping from China to amazon.ae FBA and noon.com fulfilment centres: FBA vs noon, inventory lead times, prep/labelling and the full factory-to-FC cost stack."
          href="/middleeast/amazon-fba-uae-noon/"
        />
        <Card
          title="Qatar route pillar"
          description="Shanghai/Ningbo/Shenzhen to Hamad Port and Doha: indicative LCL/air rates, typical 22-day sea transit, 5% duty and no general VAT."
          href="/middleeast/shipping-from-china-to-qatar/"
        />
        <Card
          title="Hamad Port"
          description="Qatar's modern commercial gateway: Mwani Qatar operation, Doha Port replacement, port facilities, China transit and 5% duty clearance."
          href="/middleeast/hamad-port/"
        />
        <Card
          title="Qatar customs & import duty"
          description="How the 5% CIF duty and no-general-VAT position work: Al-Nadeeb filing, HS codes, restricted goods and the CIF × 1.05 landed-cost example."
          href="/middleeast/qatar-customs-duty/"
        />
        <Card
          title="Kuwait route pillar"
          description="Shuwaikh vs Shuaiba routing, the typical 24-day sea estimate, 5% GCC duty with no general VAT, and the sea/air/express decision."
          href="/middleeast/shipping-from-china-to-kuwait/"
        />
        <Card
          title="Kuwait customs & import duty"
          description="Kuwait clearance and the 5% CIF duty baseline with no general VAT: documents, HS codes, restricted goods and the CIF × 1.05 landed-cost example."
          href="/middleeast/kuwait-customs-duty/"
        />
        <Card
          title="Kuwait ports"
          description="Shuwaikh (KWSWK) vs Shuaiba (KWSHB): port roles, facilities, China transit windows, 5% duty clearance and the two-port routing decision."
          href="/middleeast/kuwait-ports/"
        />
        <Card
          title="Kuwait shipping cost & transit time"
          description="Complete China-to-Kuwait landed-cost breakdown: typical 24-day Shuwaikh transit, 5% CIF duty with no general VAT, hidden charges and the FCL/LCL/air decision."
          href="/middleeast/shipping-cost-transit-time-china-to-kuwait/"
        />
        <Card
          title="Qatar shipping cost & transit time"
          description="Complete China-to-Qatar landed-cost breakdown: sea/air benchmarks, typical 22-day Hamad transit, 5% duty and small-market cost optimisation."
          href="/middleeast/shipping-cost-transit-time-china-to-qatar/"
        />
        <Card
          title="Shipping routes"
          description="China to GCC corridors with indicative transit times."
          href="/routes/"
        />
        <Card
          title="GCC ports"
          description="Major seaports and dry ports across the region."
          href="/ports/"
        />
        <Card
          title="Get a quote"
          description="Request a quote for your China to GCC shipment."
          href="/get-quote/"
        />
      </div>
    </div>
  </section>
</BaseLayout>
