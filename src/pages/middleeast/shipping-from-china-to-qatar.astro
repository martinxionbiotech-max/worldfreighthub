  },
  {
    service: 'Express courier — China to Qatar',
    benchmark: 'Not published in verified snapshot — request a per-kg quote',
    basis: 'Courier pricing is weight/zone dependent; not stated in snapshot',
    confidence: 'LOW',
  },
  {
    service: 'DDP door-to-door — China to Qatar',
    benchmark: 'Not published in verified snapshot — request an all-in quote',
    basis: 'DDP embeds freight, clearance, duty and delivery',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    destination: 'Hamad Port (Doha)',
    mode: 'Sea',
    transit: 'Typical 22 days (range 15–30)',
    basis: 'WorldFreightHub route data for Shanghai / Ningbo-Zhoushan / Shenzhen to Hamad',
    confidence: 'MEDIUM',
  },
  {
    destination: 'Qatar corridor',
    mode: 'Sea',
    transit: '22–28 days',
    basis: 'China Best Freight China→Qatar sea market snapshot',
    confidence: 'LOW',
  },
  {
    destination: 'Qatar corridor',
    mode: 'Air freight',
