const faqs = [
  {
    q: 'How long does shipping from China to Qatar take?',
    a: 'WorldFreightHub route data records a typical 22 days with a 15–30 day planning range from Shanghai, Ningbo-Zhoushan or Shenzhen to Hamad Port (MEDIUM confidence). A secondary freight guide gives a Qatar-corridor sea window of 22–28 days and air freight of 2–4 days (LOW). All figures are indicative — verify with your carrier before relying on them.',
