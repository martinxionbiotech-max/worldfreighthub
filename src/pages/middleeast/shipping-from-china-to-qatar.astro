const wfhRouteData: Source = {
  id: 'wfh-qatar-route-data',
  name: 'WorldFreightHub route data — Shanghai, Ningbo-Zhoushan and Shenzhen to Hamad Port (typical 22 days, range 15–30)',
  url: `${SITE_URL}/routes/`,
  type: 'industry',
};

const qatarCustomsSources = sourcesByIds(['qatar-customs']);
const chinaPortSources = sourcesByIds(['sipg', 'ningbo-zhoushan-port', 'shenzhen-port-group']);
const qatarPortSources: Source[] = [mwani, ...qatarCustomsSources];
const rateSources: Source[] = [presou, chinabestfreight];
const transitSources: Source[] = [wfhRouteData, chinabestfreight];
const modeSources: Source[] = [chinabestfreight, presou];
const costSources: Source[] = [
  ...qatarCustomsSources,
  traddal,
  goodsacrossborders,
  presou,
  chinabestfreight,
];
const complianceSources: Source[] = [...qatarCustomsSources, traddal, goodsacrossborders];
const marketSources: Source[] = [mwani, meed];

const rateRows = [
  {
    service: 'LCL ocean — China to Hamad Port / Doha',
    benchmark: 'USD 70–155 per CBM',
    basis: 'Presou China→Qatar LCL market snapshot',
    confidence: 'LOW',
  },
  {
    service: 'Air freight — China to Hamad International Airport (Doha)',
    benchmark: 'USD 4.5–7.5 per kg',
    basis: 'Presou China→Qatar air market snapshot',
    confidence: 'LOW',
