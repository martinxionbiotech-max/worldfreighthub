---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';
import { routes } from '../../data/routes';
import type { Source } from '../../data/types';

const pageUrl = `${SITE_URL}/middleeast/transit-time-china-to-saudi-arabia/`;

const freightos: Source = {
  id: 'freightos',
  name: 'Freightos — Shanghai to Riyadh route data',
  url: 'https://www.freightos.com',
  type: 'industry',
};
const cargofromchina: Source = {
  id: 'cargofromchina',
  name: 'Cargo From China — China to Saudi Arabia guide',
  url: 'https://cargofromchina.com/china-saudiarabia/',
  type: 'industry',
};
const ddpchain: Source = {
  id: 'ddpchain',
  name: 'DDP Chain — China to Saudi Arabia',
  url: 'https://ddpchain.com/saudi-arabia/',
  type: 'industry',
};
const chinaddpshipping: Source = {
  id: 'chinaddpshipping',
  name: 'China DDP Shipping — DDP shipping China to Saudi Arabia',
  url: 'https://www.chinaddpshipping.com/ddp-shipping-from-china-to-saudi-arabia/',
  type: 'industry',
};
const sinoShipping: Source = {
  id: 'sino-shipping',
  name: 'Sino Shipping — China to Saudi freight snapshots (August 2026)',
  url: 'https://www.sino-shipping.com',
  type: 'industry',
};
const commenda: Source = {
  id: 'commenda',
  name: 'Commenda — Saudi Arabia import VAT guide',
  url: 'https://www.commenda.io/saudi-arabia/import-vat',
  type: 'organization',
};
const fuxinCcpt: Source = {
  id: 'fuxin-ccpit',
  name: 'Liaoning CCPIT — SABER SC certificate notice (26 Dec 2024)',
  url: 'https://www.fuxin.gov.cn/content/2024/962553.html',
  type: 'government',
};
const worldcargonews: Source = {
  id: 'worldcargonews',
  name: 'World Cargo News — Mawani ports handle 8.3m TEU in 2025',
  url: 'https://www.worldcargonews.com/ports-terminals/2026/01/mawani-ports-handle-8-3m-teu-in-2025/',
  type: 'industry',
};
const sasoInfo: Source = {
  id: 'saso-info',
  name: 'SASO conformity process notes — product testing then pre-shipment inspection',
  url: 'http://www.saso-gov.com/index.php?znhcjwt.html',
  type: 'industry',
};

const primaryPortSources = sourcesByIds([
  'mawani',
  'sipg',
  'ningbo-zhoushan-port',
  'shenzhen-port-group',
]);
const complianceSources = sourcesByIds(['zatca', 'mawani']);
const seaTransitSources: Source[] = [freightos, cargofromchina, ddpchain, chinaddpshipping];
const airTransitSources: Source[] = [freightos, ddpchain, cargofromchina, chinaddpshipping, sinoShipping];
const comparisonSources: Source[] = [freightos, ddpchain, cargofromchina];
const factorSources: Source[] = [
  ...sourcesByIds(['mawani', 'zatca']),
  cargofromchina,
  ddpchain,
  freightos,
  fuxinCcpt,
];

const seaTransitRows = [
  {
    destination: 'Jeddah',
    service: 'Sea port-to-port',
    transit: '~20–35 days',
    basis: 'cargofromchina ~20 days average (Shenzhen–Jeddah); ddpchain 20–35 days',
    confidence: 'LOW',
  },
  {
    destination: 'Dammam / Riyadh Dry Port',
    service: 'Sea port-to-port',
    transit: '30–45 days',
    basis: 'Freightos Shanghai–Riyadh corridor',
    confidence: 'LOW',
  },
  {
    destination: 'Riyadh (Shanghai origin)',
    service: 'FCL',
    transit: '30–40 days',
    basis: 'Freightos Shanghai–Riyadh FCL route data',
    confidence: 'LOW',
  },
  {
    destination: 'Riyadh (Shanghai origin)',
    service: 'LCL',
    transit: '32–45 days',
    basis: 'Freightos Shanghai–Riyadh LCL route data',
    confidence: 'LOW',
  },
];

const planningRows = routes
  .filter((route) => route.country === 'saudi-arabia')
  .map((route) => ({
    origin: route.originPort,
    destination: route.destPort,
    typical: `${route.transitDays.typical} days`,
    range: `${route.transitDays.range[0]}–${route.transitDays.range[1]} days`,
    note: route.note,
    confidence: route.confidence,
  }));

const airTransitRows = [
  {
    lane: 'Shanghai → Riyadh',
    service: 'Air airport-to-airport',
    transit: '6–10 days',
    basis: 'Freightos Shanghai–Riyadh air route data',
    confidence: 'LOW',
  },
  {
    lane: 'China → Saudi Arabia (route examples)',
    service: 'Air airport-to-airport',
    transit: '6–10 days',
    basis: 'ddpchain route examples',
    confidence: 'LOW',
  },
  {
    lane: 'China → Saudi Arabia (market brackets)',
    service: 'Air freight',
    transit: '2–5 business days',
    basis: 'cargofromchina air freight guide',
    confidence: 'LOW',
  },
  {
    lane: 'China → Saudi Arabia (planning shorthand)',
    service: 'Air airport-to-airport',
    transit: '3–7 days',
    basis: 'Planning range for direct airport-to-airport moves; verify with carrier',
    confidence: 'LOW',
  },
  {
    lane: 'China → Saudi Arabia (DDP air)',
    service: 'Door-to-door DDP air',
    transit: '10–15 days',
    basis: 'chinaddpshipping DDP air benchmark',
    confidence: 'LOW',
  },
  {
    lane: 'Express courier',
    service: 'Door delivery',
    transit: '3–6 working days',
    basis: 'ddpchain DHL example; Freightos express 3–6 days; Sino express 3–5 days',
    confidence: 'LOW',
  },
];

const seaVsAirRows = [
  {
    factor: 'Indicative transit',
    sea: '18–45 days port-to-port across planning and research ranges',
    air: '2–10 days airport-to-airport (full research range)',
    confidence: 'LOW',
  },
  {
    factor: 'Time variability',
    sea: 'Wider range; schedule, transhipment and congestion stretch the clock',
    air: 'Narrower range, but clearance and SABER still gate release',
    confidence: 'LOW',
  },
  {
    factor: 'Unit basis',
    sea: 'Per container (FCL) or per CBM / chargeable weight (LCL)',
    air: 'Per chargeable kilogram',
    confidence: 'LOW',
  },
  {
    factor: 'Best for',
    sea: 'Non-urgent, high-volume, stable-demand cargo',
    air: 'Urgent, perishable, fragile, high-value or stockout-critical cargo',
    confidence: 'LOW',
  },
  {
    factor: 'Compliance gate',
    sea: 'SABER PC/SC and FASAH pre-arrival declaration required',
    air: 'Same rules apply; air shortens transport, not paperwork',
    confidence: 'MEDIUM',
  },
];

const stageRows = [
  {
    stage: 'Origin pick-up and China export clearance',
    effect: 'Adds time before the vessel or aircraft departs',
    note: 'Timing depends on origin gateway and documentation readiness',
    confidence: 'LOW',
  },
  {
    stage: 'Vessel / flight cut-off and loading',
    effect: 'Cargo waits for the scheduled departure',
    note: 'Fewer sailings or flights means more dwell',
    confidence: 'LOW',
  },
  {
    stage: 'International transit',
    effect: 'Jeddah ~20–35 days; Dammam/Riyadh ~30–45 days by sea',
    note: 'Air is 2–10 days by comparison',
    confidence: 'LOW',
  },
  {
    stage: 'Transhipment (if applicable)',
    effect: 'Adds terminal handling and waiting at the hub',
    note: 'Direct services are usually faster but less frequent',
    confidence: 'LOW',
  },
  {
    stage: 'Discharge and terminal availability',
    effect: 'Container or cargo becomes available after discharge',
    note: 'Terminal congestion can extend this step',
    confidence: 'LOW',
  },
  {
    stage: 'Saudi customs release',
    effect: 'FASAH pre-arrival declaration plus SABER SC',
    note: 'A late SC or document hold stops the clock at the border',
    confidence: 'MEDIUM',
  },
  {
    stage: 'Inland delivery',
    effect: 'Trucking from Jeddah/Dammam to the final address',
    note: 'Riyadh cargo may transfer through Riyadh Dry Port',
    confidence: 'LOW',
  },
];

const factorRows = [
  {
    factor: 'Sailing / flight schedule and frequency',
    effect: 'Fewer departures create longer dwell at origin or hub',
    note: 'Confirm the actual vessel, voyage and cut-off',
    confidence: 'LOW',
  },
  {
    factor: 'Direct vs transhipped routing',
    effect: 'Transhipment adds handling and waiting time',
    note: 'Direct loops are faster but less frequent',
    confidence: 'LOW',
  },
  {
    factor: 'Peak season and capacity',
    effect: 'Congestion and space pressure extend both sea and air',
    note: 'Book earlier during peak windows',
    confidence: 'LOW',
  },
  {
    factor: 'Port congestion',
    effect: 'Jeddah/Dammam throughput pressure can delay discharge',
    note: 'Mawani ports handled 8.3m TEU in 2025',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Red Sea security situation',
    effect: 'Routing changes have at times extended transit',
    note: 'Confirmed by the research snapshot',
    confidence: 'LOW',
  },
  {
    factor: 'Customs and SABER readiness',
    effect: 'A late SABER SC, HS error or missing document holds cargo',
    note: 'Obtain the SC before arrival; file FASAH early',
    confidence: 'MEDIUM',
  },
  {
    factor: 'Inland leg to final destination',
    effect: 'Dammam/Riyadh and inland delivery add time after discharge',
    note: 'Match the discharge port to the consignee',
    confidence: 'LOW',
  },
];

const faqs = [
  {
    q: 'How long does shipping from China to Saudi Arabia take?',
    a: 'Indicative planning windows are roughly 20–45 days by sea and 2–10 days by air. Jeddah sea freight is usually around 20–35 days, while Dammam and Riyadh Dry Port are around 30–45 days. These are LOW-confidence research findings, not schedule guarantees — verify with the carrier and check for transhipment.',
  },
  {
    q: 'What is the sea freight transit time to Jeddah?',
    a: 'Research snapshots put Jeddah sea freight at roughly 20–35 days, with one source averaging about 20 days on a Shenzhen–Jeddah example. Treat that as an indicative port-to-port window and confirm the vessel, voyage and any transhipment points before booking.',
  },
  {
    q: 'How long does sea freight take to Dammam or Riyadh?',
    a: 'Indicative windows are 30–45 days to Dammam / Riyadh Dry Port. Freightos shows FCL Shanghai–Riyadh at 30–40 days and LCL at 32–45 days. Riyadh cargo often discharges at Dammam and then moves inland by rail or road, so the final delivery point matters.',
  },
  {
    q: 'How fast is air freight from China to Saudi Arabia?',
    a: 'Airport-to-airport air freight is usually 3–7 days as a planning shorthand, with published ranges of 2–5 business days and 6–10 days depending on the source and route. Door-to-door DDP air adds time and is often quoted at 10–15 days.',
  },
  {
    q: 'Is FCL faster than LCL from China to Saudi Arabia?',
    a: 'Yes — Freightos puts FCL Shanghai\u2013Riyadh at 30\u201340 days versus 32\u201345 for LCL, a 2\u20135 day FCL edge. The sealed container moves as one consignment; LCL adds consolidation and deconsolidation handling, which can also add scheduling risk.',
  },
  {
    q: 'Why is there a gap between vessel arrival and cargo release?',
    a: 'The gap is the difference between the 20\u201345-day sailing clock and the release clock, which adds FASAH processing, SABER SC verification and duty/VAT settlement before cargo is free. A late SABER SC, HS-code issue or missing document turns a day gap into a multi-day hold.',
  },
  {
    q: 'What most often delays a China to Saudi shipment?',
    a: 'The published windows already embed a 10-day port gap (Jeddah 20\u201335 vs Dammam/Riyadh 30\u201345) plus 15 days of spread within each window, and transhipment, congestion and clearance holds sit on top of that. Planning the compliance work before arrival removes the controllable part of the delay.',
  },
  {
    q: 'How can I shorten transit time from China to Saudi Arabia?',
    a: 'Choose a direct service to cut the transhipment wait, obtain the SABER SC before arrival and file FASAH early to protect the 20\u201335-day Jeddah window from clearance holds. Also classify the HS code correctly, book trucking before discharge, and use air freight only when the time saving is worth the premium.',
  },
  {
    q: 'What is the difference between port-to-port and door-to-door transit time?',
    a: 'Port-to-port shows only the 20\u201345-day sea leg, while door-to-door adds pre-carriage, clearance and delivery that can stretch the total beyond the sailing window. Door-to-door is the only timing that matters for when your buyer actually receives the goods.',
  },
  {
    q: 'Does SABER slow down my shipment?',
    a: 'Only if it is late — an SC applied after arrival is void (since 1 January 2025), which can turn a 20\u201335-day Jeddah sailing into a multi-day hold. If the PC and SC are done correctly before arrival, SABER is part of the clearance flow rather than a delay.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'Transit Time from China to Saudi Arabia: Sea, Air & Door-to-Door (August 2026)',
      description:
        'Transit time from China to Saudi Arabia explained: Jeddah vs Dammam sea windows, FCL vs LCL differences, air and express transit, port-to-port vs door-to-door, and the delays that stretch the clock.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];
---

<BaseLayout
  title="Transit Time from China to Saudi Arabia: Sea, Air & Door-to-Door (August 2026)"
  description="Transit time from China to Saudi Arabia: Jeddah vs Dammam sea windows, FCL vs LCL differences, air and express transit, port-to-port vs door-to-door, and the delays that stretch the clock."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Middle East', href: '/middleeast/' },
          { label: 'Transit time from China to Saudi Arabia' },
        ]}
      />
      <span class="badge badge--amber">August 2026 updated</span>
      <h1>Transit time from China to Saudi Arabia: sea, air and door-to-door</h1>
      <p class="lead">
        A single “20 days” number hides three different clocks: the sailing schedule, the actual
        arrival, and the customs release that lets your buyer take delivery. This page separates
        Jeddah from Dammam, FCL from LCL, and port-to-port from door-to-door.
      </p>

      <section class="section container">
        <blockquote class="tldr">
          <p>
            <strong>TL;DR:</strong> Sea transit to Saudi splits by port — Jeddah runs ~20&ndash;35 days
            versus Dammam/Riyadh at ~30&ndash;45 days, so gateway choice moves the clock by about 10
            days. Air shrinks the same lane to 2&ndash;10 days (3&ndash;7 days airport-to-airport),
            a speed gain of roughly 3&ndash;12× over the 20&ndash;35-day Jeddah sea window. FCL beats
            LCL by 2&ndash;5 days (30&ndash;40 vs 32&ndash;45 days Shanghai&ndash;Riyadh), but the SABER
            SC must be filed before arrival or it voids — so compliance timing, not sailing time, is
            the biggest controllable risk.
          </p>
        </blockquote>
      </section>

      <p class="small muted">
        Confidence badges separate verified figures from indicative market snapshots. Treat every
        LOW-confidence transit window as indicative, verify with carrier before relying on it.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Sea transit</span>
          <span class="fact-value">20–45 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Air transit</span>
          <span class="fact-value">2–10 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Jeddah by sea</span>
          <span class="fact-value">20–35 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Dammam / Riyadh</span>
          <span class="fact-value">30–45 days <ConfidenceBadge level="LOW" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">SABER SC rule</span>
          <span class="fact-value">Before arrival <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Shanghai 2025</span>
          <span class="fact-value">55.06M TEU <ConfidenceBadge level="HIGH" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <h2>1. Three clocks, not one</h2>
    <p>
      The headline transit time is usually the <strong>schedule clock</strong>: the published port-to-port
      sailing or flying time. The <strong>arrival clock</strong> is when the cargo actually reaches
      the Saudi terminal or airport after schedule changes, transhipment and congestion. The
      <strong>release clock</strong> is when Saudi customs releases the goods after FASAH processing,
      SABER verification, duty/VAT settlement and any inspection.
    </p>
    <p>
      Shippers usually plan against the first clock and get surprised by the third. That gap between
      arrival and release is the hidden water in every transit quote, and it is why a port-to-port
      number is not the same as a delivery promise.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Sea transit windows: Jeddah vs Dammam / Riyadh</h2>
      <p>
        Saudi transit times vary more than a single average suggests. Jeddah is reached from the Red
        Sea side, while Dammam and Riyadh Dry Port sit on the Gulf side and add inland handling for
        Riyadh deliveries. Use these windows for planning, then confirm the vessel schedule.
      </p>

      <DataTable
        columns={[
          { key: 'destination', label: 'Destination' },
          { key: 'service', label: 'Service' },
          { key: 'transit', label: 'Indicative transit' },
          { key: 'basis', label: 'Basis' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={seaTransitRows}
        caption="Indicative sea transit windows only — verify with the relevant carrier before relying on these figures."
      />
      <SourceList sources={seaTransitSources} title="Sources — sea transit times" />

      <h3 class="mt-3">WorldFreightHub planning dataset</h3>
      <p>
        The site’s internal route dataset keeps a simpler planning shorthand: Shanghai, Ningbo-Zhoushan
        and Shenzhen origins mapped to Jeddah and Dammam. These figures are planning estimates, not
        schedule guarantees, and are deliberately narrower than the wider research ranges above.
      </p>
      <DataTable
        columns={[
          { key: 'origin', label: 'Origin' },
          { key: 'destination', label: 'Destination' },
          { key: 'typical', label: 'Typical' },
          { key: 'range', label: 'Planning range' },
          { key: 'note', label: 'Note' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={planningRows}
        caption="Internal planning estimates from src/data/routes.ts. Treat as LOW-confidence planning shorthand and verify with the relevant carrier."
      />
      <SourceList sources={primaryPortSources} title="Sources — planning dataset origins" />
    </div>
  </section>

  <section class="section container">
    <h2>3. Air and express transit windows</h2>
    <p>
      Air freight shortens the transport clock but not the compliance clock. Airport-to-airport
      windows are measured in days, but the same FASAH declaration, SABER SC and HS classification
      still apply before release.
    </p>
    <DataTable
      columns={[
        { key: 'lane', label: 'Lane' },
        { key: 'service', label: 'Service' },
        { key: 'transit', label: 'Indicative transit' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={airTransitRows}
      caption="Indicative air and express windows on different route/date bases. Verify with a forwarder before relying on these figures."
    />
    <SourceList sources={airTransitSources} title="Sources — air & express transit" />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Sea vs air: the time decision</h2>
      <p>
        Sea is usually slower but far cheaper per unit; air is faster but expensive. The right test
        is not “air is always faster” — it is whether the inventory, cash and risk cost of waiting
        18–45 days exceeds the air premium for your specific cargo.
      </p>
      <DataTable
        columns={[
          { key: 'factor', label: 'Factor' },
          { key: 'sea', label: 'Sea freight' },
          { key: 'air', label: 'Air freight' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={seaVsAirRows}
        caption="Decision factors are heuristic; transit figures are LOW confidence. Verify with your forwarder for the actual shipment."
      />
      <SourceList sources={comparisonSources} title="Sources — sea vs air" />

      <div class="grid grid--2 mt-2">
        <Card title="Choose air freight when...">
          <ul>
            <li>The goods are urgent, perishable or stockout-critical.</li>
            <li>Value per kilogram is high and damage risk matters.</li>
            <li>A 3–7 day arrival cycle is worth the premium.</li>
            <li>The shipment is small and sea minimum charges are wasteful.</li>
          </ul>
        </Card>
        <Card title="Choose sea freight when...">
          <ul>
            <li>Cargo is large, dense, heavy or stable-demand.</li>
            <li>Unit cost matters more than transit time.</li>
            <li>The shipment fills a meaningful share of a container.</li>
            <li>The consignee can absorb an 18–45 day window.</li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Port-to-port vs door-to-door: which clock are you buying?</h2>
    <p>
      Port-to-port stops at the Saudi terminal and leaves pre-carriage, Saudi clearance and delivery
      to you. Door-to-door bundles the whole chain into one provider and one price. The quoted number
      means different things in each case, so always confirm where the clock starts and stops.
    </p>
    <DataTable
      columns={[
        { key: 'factor', label: 'Factor' },
        { key: 'portToPort', label: 'Port-to-port' },
        { key: 'doorToDoor', label: 'Door-to-door' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={[
        {
          factor: 'Service scope',
          portToPort: 'Ocean terminal to ocean terminal (or airport to airport)',
          doorToDoor: 'Origin warehouse to Saudi destination address',
          confidence: 'LOW',
        },
        {
          factor: 'What the time includes',
          portToPort: 'Main carriage only; pre-carriage and on-carriage are separate',
          doorToDoor: 'Pick-up, export, transit, Saudi import and final delivery bundled',
          confidence: 'LOW',
        },
        {
          factor: 'Timing visibility',
          portToPort: 'Cleaner comparison, but the real delivery date is incomplete',
          doorToDoor: 'One end-to-end window, but inclusions must be confirmed in writing',
          confidence: 'LOW',
        },
        {
          factor: 'Incoterm context',
          portToPort: 'Fits FOB / CFR / CIF negotiations',
          doorToDoor: 'Fits DAP / DDP arrangements',
          confidence: 'LOW',
        },
        {
          factor: 'Best for',
          portToPort: 'Established importers with a Saudi broker and trucker',
          doorToDoor: 'Sellers who want one provider and are not established locally',
          confidence: 'LOW',
        },
      ]}
      caption="Service-scope comparison is heuristic. Confirm exactly where the clock starts and stops on every quote."
    />

    <h3 class="mt-3">The stage-by-stage clock</h3>
    <p>
      Breaking the move into stages makes the hidden time visible. Stage-level day counts were not
      published in the verified research snapshot, so the table below shows where time is added
      rather than inventing per-stage numbers.
    </p>
