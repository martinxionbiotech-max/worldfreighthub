const schema = [
  {
    type: 'Article',
    data: {
      headline: 'DDP Shipping from China to the UAE: What Duty Paid Really Includes (August 2026)',
      description:
        'DDP shipping from China to the UAE explained: who pays the 5% duty and 5% VAT, indicative air/LCL benchmarks, DDP vs DAP/EXW/FOB, free zone vs mainland treatment, and the hidden fees to confirm before booking.',
      datePublished: '2026-08-31',
      dateModified: '2026-08-31',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
