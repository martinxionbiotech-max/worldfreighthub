---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import DataTable from '../../../components/DataTable.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import Cta from '../../../components/Cta.astro';
import { europeDirectoryProviders } from '../../../data/europe-directory';
import type { DirectoryProvider } from '../../../data/directory';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../../site';

export function getStaticPaths() {
  return europeDirectoryProviders.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props as { provider: DirectoryProvider };

const totalProviders = europeDirectoryProviders.length;
const verifiedProviders = europeDirectoryProviders.filter((item) => item.verification === 'verified').length;
const serviceCountryCount = provider.serviceCountries.length;
const methodCount = provider.methods.length;
const claimCount = provider.selfReportedClaims?.length ?? 0;

const countryLabels: Record<string, string> = {
  germany: 'Germany',
  'united-kingdom': 'United Kingdom',
  france: 'France',
  netherlands: 'Netherlands',
  spain: 'Spain',
  italy: 'Italy',
  poland: 'Poland',
  belgium: 'Belgium',
  austria: 'Austria',
  sweden: 'Sweden',
  portugal: 'Portugal',
  greece: 'Greece',
  ireland: 'Ireland',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

const verificationExplanations: Record<DirectoryProvider['verification'], string> = {
  verified:
    "Business identity, website and published claims have been checked against the provider's own official website. Direct contact details are reached via the provider's website or our Get Quote form.",
  unverified:
    'This provider was found in research, but its identity, contact details and service claims have not yet been independently confirmed.',
  claimed: 'The business has confirmed its own listing; self-reported details remain labelled until independently verified.',
  sponsored: 'This is a paid placement, always labelled as sponsored.',
};

const tableColumns = [
  { key: 'serviceCountries', label: 'Service countries' },
  { key: 'methods', label: 'Methods' },
  { key: 'verification', label: 'Verification' },
  { key: 'lastVerified', label: 'Last verified' },
  { key: 'source', label: 'Source', type: 'link' as const },
  { key: 'sourceType', label: 'Source type' },
];

const tableRows = [
  {
    serviceCountries: provider.serviceCountries.map(countryName).join(', '),
    methods: provider.methods.join(', '),
    verification: provider.verification,
    lastVerified: provider.lastVerified,
    source: {
      href: provider.source,
      label: provider.sourceName,
    },
    sourceType: provider.sourceType === 'own-website' ? 'Own website' : 'Directory listing',
  },
];

const faqs = [
  {
    q: 'How does WorldFreightHub verify this freight forwarder?',
    a: "Verification requires 3 checks — business identity, website and published service claims — confirmed against the provider's own official website. No licence-registry verification is claimed, because no single EU freight-forwarding licence registry exists; self-reported claims stay labelled as claims.",
  },
  {
    q: 'How should I choose a freight forwarder for China-to-Europe shipping?',
    a: 'Choose against 4 checks: a documented source for identity, proven experience on your specific lane, an itemised written quote that separates origin, freight and destination charges, and clarity on who acts as importer of record. Landed cost is CIF × (1 + duty) × (1 + VAT), so confirm the 10-digit TARIC classification — not the forwarder fee — as your biggest cost lever.',
  },
  {
    q: 'Why are no direct phone/email details published on this listing?',
    a: "WorldFreightHub publishes the provider's website and routes enquiries through its Get Quote form, so a request reaches the right contact without exposing a phone number or personal mailbox that could become outdated. You can also reach the provider directly through their published website.",
  },
];

const schema = [
  {
    type: 'LocalBusiness',
    data: {
      name: provider.name,
      ...(provider.website ? { url: provider.website } : {}),
      description: provider.description,
      areaServed: provider.serviceCountries.map(countryName),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  hreflang={false}
  title={`${provider.name} — China to Europe Freight Forwarder`}
  description={provider.description}
  canonical={`${SITE_URL}/europe/directory/${provider.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Europe', href: '/europe/' },
          { label: 'Directory', href: '/europe/directory/' },
          { label: provider.name },
        ]}
      />
      <h1>{provider.name}</h1>
      <p class="muted">{provider.description}</p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> This profile is {provider.verification}, with {serviceCountryCount} service
          countries and {methodCount} freight methods recorded from its source. {claimCount} self-reported
          claims are published only as claims, and direct phone/email details are not
          published on the listing — reach the provider through their website or our Get
          Quote form.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Verification status</span>
        <span class="fact-value">{provider.verification}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Headquarters</span>
        <span class="fact-value">{provider.hqCountry}</span>
      </div>
    </div>
    <div class="note mt-3">
      <strong>What this status means:</strong>{' '}
      {verificationExplanations[provider.verification]}
    </div>
  </section>

  <section class="section container">
    <h2>Listing summary</h2>
    <DataTable
      columns={tableColumns}
      rows={tableRows}
      caption="Service scope and claims reflect the published source and are independently verified before publication."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Self-reported claims</h2>
      <p>
        These statements come from the provider's own website. They are
        self-reported and are <strong>not independently verified</strong>.
      </p>
      {provider.selfReportedClaims && provider.selfReportedClaims.length > 0 ? (
        <ul>
          {provider.selfReportedClaims.map((claim) => (
            <li>{claim}</li>
          ))}
        </ul>
      ) : (
        <p class="muted">No self-reported claims have been recorded yet.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>Contact & verification</h2>
    <div class="note">
      <strong>Business identity verified.</strong>{' '}
      {provider.contactNote}
    </div>
    <p>
      WorldFreightHub has independently confirmed this provider's identity, website,
      service area and published claims against its own official website. Direct contact
      details (phone / email) are not published on the listing; reach the provider
      through their website or via our Get Quote form, which routes your request
      without adding any fee.
    </p>
    <p class="mt-2">
      <a class="btn btn-secondary" href="/contact/">
        Report an incorrect or outdated listing
      </a>
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={faqs} />
    </div>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
