---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Card from '../../../components/Card.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import Cta from '../../../components/Cta.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceList from '../../../components/SourceList.astro';
import { europeDirectoryProviders } from '../../../data/europe-directory';
import { sourcesByIds } from '../../../data/sources';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../../../site';

const landingSources = sourcesByIds(['eu-taric', 'gov-uk', 'hmrc']);

const totalProviders = europeDirectoryProviders.length;
const verifiedProviders = europeDirectoryProviders.filter((p) => p.verification === 'verified').length;
const verifiedPct = Math.round((verifiedProviders / totalProviders) * 100);

const countryLabels: Record<string, string> = {
  germany: 'Germany',
  'united-kingdom': 'United Kingdom',
  france: 'France',
  netherlands: 'Netherlands',
  spain: 'Spain',
  italy: 'Italy',
  poland: 'Poland',
  belgium: 'Belgium',
  austria: 'Austria',
  sweden: 'Sweden',
  portugal: 'Portugal',
  greece: 'Greece',
  ireland: 'Ireland',
};

const countryName = (slug: string) => countryLabels[slug] ?? slug;

// --- Calculated coverage: derived from the data, not asserted ---
const hasMethod = (m: string) => europeDirectoryProviders.filter((p) => p.methods.includes(m)).length;
const seaCount = hasMethod('Sea freight');
const airCount = hasMethod('Air freight');
const railCount = hasMethod('Rail freight');
const customsCount = hasMethod('Customs brokerage');

const euHqCountries = [
  'Germany', 'Denmark', 'France', 'Austria', 'Portugal', 'Czechia', 'Netherlands',
  'Spain', 'Italy', 'Poland', 'Belgium', 'Sweden', 'Greece', 'Ireland',
];
const euHqCount = europeDirectoryProviders.filter((p) => euHqCountries.includes(p.hqCountry)).length;

// Methods coverage table rows
const methodCoverageRows = [
  { method: 'Sea freight', count: `${seaCount} of ${totalProviders}`, pct: `${Math.round((seaCount / totalProviders) * 100)}%` },
  { method: 'Air freight', count: `${airCount} of ${totalProviders}`, pct: `${Math.round((airCount / totalProviders) * 100)}%` },
  { method: 'Rail freight', count: `${railCount} of ${totalProviders}`, pct: `${Math.round((railCount / totalProviders) * 100)}%` },
  { method: 'Customs brokerage', count: `${customsCount} of ${totalProviders}`, pct: `${Math.round((customsCount / totalProviders) * 100)}%` },
];

const methodColumns = [
  { key: 'method', label: 'Method' },
  { key: 'count', label: 'Listed coverage' },
  { key: 'pct', label: 'Share of directory' },
];

const verificationStatuses = [
  {
    status: 'Verified',
    description:
      "Business identity, website and published claims checked against a documented source — the provider's own official website. Direct contact details are reached via the provider's website or the Get Quote form.",
  },
  {
    status: 'Unverified',
    description: 'Found in research, business identity not yet independently audited.',
  },
  {
    status: 'Claimed',
    description: 'Business confirmed its own listing.',
  },
  {
    status: 'Sponsored',
    description: 'Paid placement, always labelled. Currently none.',
  },
];

const providerGroups = [
  {
    label: 'Global forwarders — sea, air and rail across all 13 markets',
    match: (p: (typeof europeDirectoryProviders)[number]) =>
      p.methods.includes('Sea freight') && p.methods.includes('Air freight') && p.methods.includes('Rail freight'),
  },
  {
    label: 'Sea & air forwarders without a rail product',
    match: (p: (typeof europeDirectoryProviders)[number]) =>
      p.methods.includes('Sea freight') && p.methods.includes('Air freight') && !p.methods.includes('Rail freight'),
  },
  {
    label: 'Rail specialists',
    match: (p: (typeof europeDirectoryProviders)[number]) =>
      !p.methods.includes('Sea freight') && p.methods.includes('Rail freight'),
  },
];

const faqs = [
  {
    q: 'How do I find a freight forwarder for shipping from China to Europe?',
    a: 'Start from a verified directory, not a search ad. 16 forwarders here are each checked against their own official website — 16 of 16 verified (100%), with 13 of 16 (81%) listing a China–Europe rail product and 14 of 16 (88%) listing sea freight. Match the forwarder to your method and destination, then ask for an itemised quote that separates freight, origin and destination charges so you can compare like for like.',
  },
  {
    q: 'How much does a freight forwarder charge from China to Europe?',
    a: 'Expect a forwarder fee of roughly $150–$400 per container on top of the ocean rate, or a per-CBM margin on LCL — on a $10,000 CIF shipment landed at $13,068 after 8% duty and 21% VAT, that fee is only 1.1%–3.1% of landed cost. The tax line is $3,068 (23.5% of landed), so optimising a $200 forwarder-fee difference saves 1.5% of landed cost while no forwarder can move the 23% tax line.',
  },
  {
    q: 'Which is the best freight forwarder for China to Europe rail freight?',
    a: '13 of 16 listed forwarders (81%) now carry a China–Europe rail product, but two are dedicated rail operators — Rail Cargo Group and ČD Cargo — versus the generalists like DB Schenker and DHL Global Forwarding who run rail as one lane among many. For rail LCL or an intermodal split at Małaszewicze, a rail specialist usually beats a generalist on price; for a mixed sea-plus-rail programme under one contract, the generalist wins.',
  },
  {
    q: 'Do I need a freight forwarder to import from China to Europe?',
    a: 'No — but you take on the work they do. A forwarder handles the 3 non-negotiable jobs of import: the EORI registration, the customs declaration and the TARIC HS-code classification that determines your duty rate. The landed-cost maths is CIF × (1 + duty) × (1 + VAT), so a wrong 10-digit TARIC code can move your duty from 0% to 8% — a $800 swing on a $10,000 shipment — far larger than any forwarder fee.',
  },
  {
    q: 'How do I verify a freight forwarder is legitimate?',
    a: 'Check 3 things: a documented source for their identity (their own official website, not a forum), a verifiable legal entity, and written quotes with a breakdown. 16 of 16 entries here are verified against their own official website as of 2026-09-08 — none are verified against a licence or registry, because no EU freight-forwarding licence registry exists, which is exactly why self-reported claims are always labelled as claims.',
  },
  {
    q: 'Should I use a China-based forwarder or a European forwarder?',
    a: "11 of 16 listed forwarders (69%) are EU-headquartered against 5 (31%) based in Switzerland, Japan or the US — and the split matters for one reason: the EU-headquartered forwarder holds the destination-side relationship with customs, terminals and last-mile carriers. Use a China-based forwarder for DDP door-to-door where the supplier's origin network is the constraint; use a European forwarder when destination compliance and VAT handling are the constraint.",
  },
  {
    q: 'Why does the Europe directory list fewer forwarders than the GCC directory?',
    a: 'The Europe directory lists 16 forwarders because that is how many completed identity verification in the 2026-09-08 pass, against 105 on the mature GCC corridor. Density is 16 forwarders over 13 destination markets — 1.2 forwarders per market — but 12 of 16 (75%) list all 13 markets, so the real choice is by method and headquarters, not by destination coverage.',
  },
];

const keyTakeaways = [
  '16 forwarders are listed, 16 of 16 verified against their own official website (100%) — 0 unverified, 0 sponsored.',
  '13 of 16 (81%) carry a China–Europe rail product and 14 of 16 (88%) carry sea freight, so rail is now a mainstream forwarder lane, not a niche.',
  'A forwarder fee of $150–$400 is 1.1%–3.1% of a $13,068 landed cost — the $3,068 tax line (23.5%) is the number to optimise, and no forwarder can change it.',
  'A wrong 10-digit TARIC code can move duty from 0% to 8% — an $800 swing on $10,000 — which dwarfs any forwarder-fee saving.',
  '11 of 16 forwarders (69%) are EU-headquartered; pick by whether origin-side DDP or destination-side compliance is your binding constraint.',
];

const schema = [
  {
    type: 'Organization',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/og.png` },
      sameAs: [SITE_URL],
    },
  },
  {
    type: 'ItemList',
    data: {
      name: 'China to Europe Freight Forwarder Directory',
      itemListElement: europeDirectoryProviders.map((provider) => ({
        '@type': 'Organization',
        name: provider.name,
        url: `${SITE_URL}/europe/directory/${provider.slug}/`,
        areaServed: provider.serviceCountries.map(countryName),
      })),
    },
  },
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
];
---

<BaseLayout
  hreflang={false}
  title="Freight Forwarders China to Europe — Verified Directory"
  description="16 verified freight forwarders shipping China to Europe — sea, air and rail. Why the forwarder fee is only 1.5% of landed cost but the tax line is 23%."
  canonical={`${SITE_URL}/europe/directory/`}
  ogType="website"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Europe', href: '/europe/' }, { label: 'Directory' }]} />
      <h1>Freight forwarders China to Europe</h1>
      <p class="lead">
        A verification-first directory of freight forwarders on the China to
        Europe corridor — every listing checked against the provider's own
        official website, with no paid placement.
      </p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> {totalProviders} forwarders are listed, {verifiedProviders} of {totalProviders} verified
          ({verifiedPct}%). {railCount} of {totalProviders} ({Math.round((railCount / totalProviders) * 100)}%) carry a China–Europe
          rail product and {seaCount} of {totalProviders} ({Math.round((seaCount / totalProviders) * 100)}%) carry sea freight. A
          forwarder fee of $150–$400 is only 1.1%–3.1% of a $13,068 landed cost, so the
          $3,068 tax line (23.5%) — fixed by duty and VAT, not by any forwarder — is the
          number that actually moves your total.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>The number most guides skip: the forwarder fee is the smallest line</h2>
    <p>
      On a $10,000 CIF shipment into the Netherlands, landed cost is
      <strong>10,000 × 1.08 × 1.21 = $13,068</strong> — that is 8% duty then 21%
      VAT multiplied, not added. The tax paid is <strong>$3,068</strong>, or
      <strong>23.5%</strong> of landed cost. A forwarder's own fee — the line
      item you are comparing when you shop forwarders — is typically
      <strong>$150–$400</strong> per container, or <strong>1.1%–3.1%</strong> of
      that same landed cost.
    </p>
    <p>
      The conclusion most directory pages never state: choosing a forwarder to
      save $200 on the freight line is optimising roughly <strong>1.5% of landed
      cost</strong>, while the tax line — which no forwarder, no matter how cheap,
      can change — is <strong>23.5%</strong>. A single 10-digit TARIC
      misclassification can move your duty from 0% to 8%, an <strong>$800
      swing</strong> on the same $10,000. That is four times the entire forwarder
      fee. Price the forwarder, but verify the classification.
    </p>
    <p class="mt-2">
      <a class="btn btn-secondary" href="/europe/data/">
        See the full landed-cost table by destination
      </a>
    </p>
  </section>

  <section class="section container">
    <h2>Landed-cost anatomy on a $10,000 CIF import</h2>
    <p>
      Here is where every dollar actually goes when the Netherlands (8% duty,
      21% VAT) is the destination. The numbers are a worked example, not a
      quote, and the formula is
      <strong>landed = CIF × (1 + duty) × (1 + VAT)</strong>:
    </p>
    <DataTable
      columns={[
        { key: 'line', label: 'Line item' },
        { key: 'calc', label: 'Calculation' },
        { key: 'value', label: 'Amount' },
        { key: 'share', label: 'Share of landed' },
      ]}
      rows={[
        { line: 'Goods + freight + insurance (CIF)', calc: 'given', value: '$10,000', share: '76.5%' },
        { line: 'Import duty', calc: '10,000 × 8%', value: '$800', share: '6.1%' },
        { line: 'VAT on duty-inclusive base', calc: '10,800 × 21%', value: '$2,268', share: '17.4%' },
        { line: 'Total landed', calc: '10,000 × 1.08 × 1.21', value: '$13,068', share: '100%' },
        { line: 'Forwarder fee (typical)', calc: 'separate, on top of freight', value: '$150–$400', share: '1.1%–3.1%' },
      ]}
      caption="Worked example only — duty rate varies by HS code and destination; VAT rate varies by member state."
    />
    <p class="mt-3">
      The $2,268 VAT line is the one to notice: it is VAT charged on
      <em>duty-inclusive</em> value (10,800 × 21%), not on the CIF alone. That
      tax-on-tax is why additive quotes understate landed cost — 8% + 21% = 29%
      is really ×1.08 × 1.21 = 30.68%. The forwarder fee row, at 1.1%–3.1%, is
      the only line a forwarder competition can actually move, which is the
      whole argument for verifying the classification and destination first and
      treating the fee as a tie-breaker.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Verification status</h2>
      <p class="lead">
        Every listing carries a status so you know how much independent
        confirmation sits behind it.
      </p>
      <div class="grid grid--2 mt-2">
        {verificationStatuses.map((item) => (
          <Card title={item.status} description={item.description} />
        ))}
      </div>
      <div class="note mt-3">
        <strong>Directory status:</strong> {totalProviders} providers are listed — all {verifiedProviders} verified against
        their own official website ({verifiedPct}%). 0 are sponsored and 0 are unverified, because this
        directory only publishes a listing once identity and claims are confirmed against a documented
        source. No licence-registry verification is claimed, because no single EU freight-forwarding
        licence registry exists.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Method coverage — computed from the listings, not asserted</h2>
    <p>
      The corridor's defining feature is that rail has gone mainstream: the
      China–Europe rail product (the New Silk Road land bridge) is now carried
      by {railCount} of {totalProviders} ({Math.round((railCount / totalProviders) * 100)}%) of listed forwarders,
      versus the China–GCC corridor where rail barely exists as an option. Here
      is the count by method:
    </p>
    <DataTable
      columns={methodColumns}
      rows={methodCoverageRows}
      caption="Coverage is derived from each listing's methods field and reflects what the provider publishes on its own website."
    />
    <p class="mt-3">
      The gap between sea ({Math.round((seaCount / totalProviders) * 100)}%) and rail ({Math.round((railCount / totalProviders) * 100)}%) is the
      forwarders that still sell ocean-only China–Europe services — a shrinking
      but real group. If you need the <strong>sea-versus-rail decision</strong>,
      see the <a href="/europe/sea-vs-rail/">sea vs rail guide</a>, where the
      break-even is an inventory-financing question, not a freight-rate one.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Providers by type</h2>
      <p>
        Grouped by method mix so you can shortlist against your lane, then check
        each listing's detail page for the source and self-reported claims.
      </p>
      {providerGroups.map((group) => (
        <div class="mt-3">
          <h3>{group.label}</h3>
          <div class="grid grid--2 mt-2">
            {europeDirectoryProviders.filter(group.match).map((provider) => (
              <Card
                title={provider.name}
                description={provider.description}
                href={`/europe/directory/${provider.slug}/`}
              />
            ))}
          </div>
        </div>
      ))}
      <p class="muted small mt-3">
        Directory data last reviewed 2026-09-08. Method and service-country
        groupings reflect each provider's self-reported scope unless otherwise
        noted.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>What most guides skip: three decisions the directory can't make for you</h2>
    <p>
      A directory answers <em>who is real</em>. It cannot answer <em>who is
      right for you</em> — that needs three decisions only you can price:
    </p>
    <ul>
      <li>
        <strong>Origin vs destination constraint.</strong> {euHqCount} of {totalProviders} ({Math.round((euHqCount / totalProviders) * 100)}%) are
        EU-headquartered and the rest are based in Switzerland, Japan or the US.
        A China-based or Asia-based forwarder wins when the supplier's origin
        network is the bottleneck (DDP door-to-door); an EU-headquartered
        forwarder wins when destination customs, EORI and VAT handling are the
        bottleneck.
      </li>
      <li>
        <strong>Sea, air or rail — and the ~15 CBM split.</strong> Below roughly
        15 CBM, LCL (shared container) is usually cheaper; above it, FCL wins.
        Rail sits in the middle on both price and time. See the
        <a href="/europe/fcl-vs-lcl/"> FCL vs LCL break-even</a> and
        <a href="/europe/sea-vs-air/"> sea vs air</a> guides for the arithmetic.
      </li>
      <li>
        <strong>Who is the importer of record.</strong> On DDP terms the forwarder
        acts as importer of record and pays the duty and VAT on your behalf — a
        convenience that carries a markup. The
        <a href="/europe/ioss-vs-vat-deferral/"> IOSS vs VAT deferral</a> guide
        explains the two mechanisms people most often confuse.
      </li>
    </ul>
  </section>

  <section class="section container">
    <h2>Directory FAQ</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Key takeaways</h2>
      <ul>
        {keyTakeaways.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section container">
    <SourceList sources={landingSources} title="Sources — duty, VAT and classification basis" />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
