---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { europeCountries } from '../../data/europe-countries';
import { europePorts } from '../../data/europe-ports';
import { europeRoutes } from '../../data/europe-routes';
import { portName } from '../../data/lookup';
import { SITE_URL } from '../../site';

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'China to Europe corridor',
      itemListElement: [...europeCountries, ...europePorts].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        url: `${SITE_URL}/europe/${item.countrySlug ? 'ports' : 'countries'}/${item.slug}/`,
      })),
    },
  },
  {
    type: 'ItemList',
    data: {
      name: 'China to Europe freight routes',
      itemListElement: europeRoutes.map((route, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${portName(route.originPort)} to ${portName(route.destPort)}`,
        url: `${SITE_URL}/europe/routes/${route.slug}/`,
      })),
    },
  },
];
---

<BaseLayout
  title="China to Europe Freight — Countries, Ports & Duty"
  description="China to Europe freight intelligence: eight destination countries, Europe ports, EU common duty, VAT and EORI requirements."
  canonical={`${SITE_URL}/europe/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Europe' }]} />
      <h1>China to Europe freight</h1>
      <p class="lead">
        The second corridor on the WorldFreightHub network — eight European
        destination markets with their VAT, EU common duty, EORI rules and
        entry ports.
      </p>
    </div>
  </div>

  <section class="section container">
    <h2>Freight routes</h2>
    <p class="muted">
      {europeRoutes.length} China → Europe routes — seven loading ports to
      eight gateways — with indicative transit times, cost ranges and routing
      notes.
    </p>
    <p class="mt-2">
      <a class="btn" href="/europe/routes/">Browse the route directory</a>
    </p>
  </section>

  <section class="section container">
    <h2>In-depth guides</h2>
    <div class="grid grid--3 mt-2">
      <Card
        title="Rail Freight"
        description="The New Silk Road land bridge — corridors, transit times and the Russia question."
        href="/europe/rail/"
      />
      <Card
        title="Sea vs Rail"
        description="When a 2–3× freight premium is worth buying back three weeks of transit."
        href="/europe/sea-vs-rail/"
      />
      <Card
        title="FCL vs LCL"
        description="Full container or shared LCL cargo? The ~15 CBM break-even rule for China-to-Europe."
        href="/europe/fcl-vs-lcl/"
      />
      <Card
        title="Sea vs Air"
        description="Value-of-time logic for choosing slow-and-cheap ocean versus fast-and-dear air."
        href="/europe/sea-vs-air/"
      />
      <Card
        title="Demurrage & Detention"
        description="The two free-time clocks at European ports and how to avoid per-day terminal and carrier charges."
        href="/europe/demurrage-detention/"
      />
      <Card
        title="Netherlands vs Germany"
        description="Rotterdam's VAT deferral versus Hamburg's rail terminus for your EU base."
        href="/europe/netherlands-vs-germany/"
      />
      <Card
        title="Direct vs Transshipment"
        description="Why Mediterranean ports transship, and the second schedule you can miss."
        href="/europe/direct-vs-transshipment/"
      />
      <Card
        title="IOSS vs VAT Deferral"
        description="The parcel tool versus the container tool — two VAT mechanisms people confuse."
        href="/europe/ioss-vs-vat-deferral/"
      />
    </div>
  </section>

  <section class="section container">
    <h2>Country shipping guides</h2>
    <p class="muted">
      Deep route pillars for the highest-volume China-to-Europe destinations,
      with cost, transit, compliance and EORI guidance in one place.
    </p>
    <div class="grid grid--3 mt-2">
      <Card
        title="Shipping from China to Germany"
        description="EORI, 19% VAT, Hamburg vs Rotterdam and the rail terminus question."
        href="/europe/shipping-from-china-to-germany/"
      />
      <Card
        title="Shipping from China to the United Kingdom"
        description="Post-Brexit customs, GB EORI, UKCA and Felixstowe as the gateway."
        href="/europe/shipping-from-china-to-united-kingdom/"
      />
      <Card
        title="Shipping from China to the Netherlands"
        description="Rotterdam, 21% VAT, Rhine-barge distribution and Article 23 VAT deferral."
        href="/europe/shipping-from-china-to-netherlands/"
      />
      <Card
        title="Shipping from China to France"
        description="Le Havre HAROPA, Seine-barge to Paris, 20% VAT and the Rotterdam trade-off."
        href="/europe/shipping-from-china-to-france/"
      />
      <Card
        title="Shipping from China to Spain"
        description="Valencia gateway, Iberian landed-cost logic, 21% VAT and the Valencia-vs-Rotterdam decision."
        href="/europe/shipping-from-china-to-spain/"
      />
      <Card
        title="Shipping from China to Italy"
        description="Genoa gateway, Europe's highest 22% VAT, Alpine inland total and the strike buffer."
        href="/europe/shipping-from-china-to-italy/"
      />
      <Card
        title="Shipping from China to Poland"
        description="Gdańsk deep-water DCT plus Małaszewicze rail — the fastest-growing sea-rail split hub."
        href="/europe/shipping-from-china-to-poland/"
      />
      <Card
        title="Shipping from China to Belgium"
        description="Antwerp chemicals and breakbulk gateway, 21% VAT and the Rotterdam congestion alternative."
        href="/europe/shipping-from-china-to-belgium/"
      />
    </div>
  </section>

  <section class="section container">
    <h2>Destination countries</h2>
    <div class="grid grid--3 mt-2">
      {europeCountries.map((country) => (
        <Card
          title={country.name}
          description={`${country.vatRate}% VAT · ${country.ports.length} port`}
          href={`/europe/countries/${country.slug}/`}
        />
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>Destination ports</h2>
    <div class="grid grid--3 mt-2">
      {europePorts.map((port) => (
        <Card
          title={port.name}
          description={`${port.country} · ${port.unlocode ?? ''}`}
          href={`/europe/ports/${port.slug}/`}
        />
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What makes Europe different from the GCC</h2>
      <p>
        Two things. First, the <strong>EU Common Customs Tariff</strong> means
        duty is uniform across member states — only VAT and local rules change,
        from Germany's 19% to Italy's 22%. Second, the <strong>New Silk Road
        rail</strong> gives Europe a middle option between sea and air that the
        Gulf does not have — and the UK sits outside both, with its own tariff
        and a GB EORI since Brexit.
      </p>
    </div>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
