---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Card from '../../../components/Card.astro';
import SourceList from '../../../components/SourceList.astro';
import Cta from '../../../components/Cta.astro';
import ConfidenceBadge from '../../../components/ConfidenceBadge.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { europeCountries } from '../../../data/europe-countries';
import { europePorts } from '../../../data/europe-ports';
import { SITE_URL } from '../../../site';

export function getStaticPaths() {
  return europeCountries.map((country) => ({
    params: { slug: country.slug },
    props: { country },
  }));
}

const { country } = Astro.props;

const countryPorts = country.ports
  .map((slug) => europePorts.find((port) => port.slug === slug))
  .filter((port) => port !== undefined);

const schema = [
  {
    type: 'Country',
    data: {
      name: country.name,
      url: `${SITE_URL}/europe/countries/${country.slug}/`,
      address: { addressCountry: country.iso2 },
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: country.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`Shipping to ${country.name} from China — Duty, VAT & Clearance`}
  description={`Freight and customs information for ${country.name}: ${country.vatRate === null ? 'no VAT' : `${country.vatRate}% VAT`}, EU import duty, de minimis, compliance and entry ports.`}
  canonical={`${SITE_URL}/europe/countries/${country.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Europe', href: '/europe/' },
          { label: 'Countries', href: '/europe/countries/' },
          { label: country.name },
        ]}
      />
      <h1>{country.name}</h1>
      <p class="lead">Destination profile for the China-to-Europe corridor.</p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">ISO code</span>
        <span class="fact-value">{country.iso2}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Capital</span>
        <span class="fact-value">{country.capital}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Currency</span>
        <span class="fact-value">{country.currency}</span>
      </div>
      <div class="fact">
        <span class="fact-label">VAT rate</span>
        <span class="fact-value">{country.vatRate === null ? 'None' : `${country.vatRate}%`}</span>
      </div>
    </div>
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>TL;DR:</strong> {country.tldr}</p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>Import duty &amp; VAT</h2>
    <p>
      <strong>Duty:</strong> {country.dutyRate}{' '}
      <ConfidenceBadge level="MEDIUM" />
    </p>
    <p class="muted">{country.dutyNote}</p>
    <p class="mt-2">
      <strong>VAT:</strong>{' '}
      {country.vatRate === null ? 'None currently' : `${country.vatRate}%`}{' '}
      <ConfidenceBadge level="HIGH" />
      {country.vatRate !== null && ` — ${country.vatNote}`}
    </p>
    {country.vatRate === null && (
      <p class="muted">{country.vatNote}</p>
    )}
  </section>

  <section class="section container">
    <h2>De minimis threshold</h2>
    <p>
      <strong>{country.deMinimis}</strong>{' '}
      <ConfidenceBadge level="LOW" />
    </p>
    <p class="muted">{country.deMinimisNote}</p>
  </section>

  <section class="section container">
    <h2>Compliance requirements</h2>
    <ul>
      {country.compliance.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="section container">
    <h2>Clearance process</h2>
    <ol>
      {country.clearanceProcess.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Ports</h2>
      <div class="grid grid--3 mt-2">
        {countryPorts.map((port) => (
          <Card
            title={port.name}
            description={`${port.type === 'dry-port' ? 'Dry port' : 'Seaport'} in ${port.country}.`}
            href={`/europe/ports/${port.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>What most guides skip</h2>
    <p>{country.insight}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={country.faqs} />
    </div>
  </section>

  <section class="section container">
    <h2>Key takeaways</h2>
    <ol>
      {country.keyTakeaways.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SourceList sources={[]} title="Official sources" />
    <p class="muted">
      Duty, VAT and de minimis figures are indicative and change over time.
      Always confirm current rates with the relevant customs authority before
      making commercial decisions.
    </p>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
