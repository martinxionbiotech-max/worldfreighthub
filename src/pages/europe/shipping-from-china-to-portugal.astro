const faqs = [
  {
    q: 'How long does shipping from China to Portugal take?',
    a: 'Allow roughly 30–38 days port-to-port by sea from Shanghai or Ningbo-Zhoushan to Sines or Lisbon via the Cape (MEDIUM confidence, planning estimate), plus the inland leg to your site — versus roughly 18–22 days by China-Europe rail to Madrid plus ~1–2 days transload/truck across the 1668mm Iberian gauge. No verified Portuguese air transit is published, so request that from your carrier.',
