---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { SITE_URL } from '../../site';
import { sourcesByIds } from '../../data/sources';

const pageUrl = `${SITE_URL}/europe/rail/`;

const railRows = [
  {
    route: "Xi'an → Duisburg",
    transit: '16–19 days',
    rate: '$4,200 – $5,100 per 40ft',
    note: 'Highest frequency, 5–7 departures per week',
    confidence: 'MEDIUM',
  },
  {
    route: 'Chengdu → Lodz',
    transit: '18–21 days',
    rate: '$4,000 – $4,800 per 40ft',
    note: 'Strong fit for central and western China origins',
    confidence: 'MEDIUM',
  },
  {
    route: 'Yiwu → Madrid',
    transit: '20–24 days',
    rate: '$4,800 – $5,800 per 40ft',
    note: 'Longest verified corridor and lowest frequency',
    confidence: 'MEDIUM',
  },
  {
    route: 'Chongqing → Hamburg',
    transit: '17–20 days',
    rate: '$4,300 – $5,200 per 40ft',
    note: 'Automotive and machinery supply-chain corridor',
    confidence: 'MEDIUM',
  },
  {
    route: 'Zhengzhou → Liege',
    transit: '15–18 days',
    rate: '$4,500 – $5,300 per 40ft',
    note: 'Fastest verified rail lane',
    confidence: 'MEDIUM',
  },
];

const seaRows = [
  { port: 'Rotterdam (NLRTM)', twenty: '$1,200 – $4,800', forty: '$1,600 – $6,800', lcl: '$60 – $160 per CBM', confidence: 'MEDIUM' },
  { port: 'Hamburg (DEHAM)', twenty: '$1,200 – $4,600', forty: '$1,600 – $6,500', lcl: '$60 – $150 per CBM', confidence: 'MEDIUM' },
  { port: 'Antwerp (BEANR)', twenty: '$1,200 – $4,700', forty: '$1,600 – $6,600', lcl: '$60 – $150 per CBM', confidence: 'MEDIUM' },
  { port: 'Felixstowe (GBFXT)', twenty: '$1,300 – $5,000', forty: '$1,800 – $7,000', lcl: '$70 – $170 per CBM', confidence: 'MEDIUM' },
  { port: 'Le Havre (FRLEH)', twenty: '$1,200 – $4,800', forty: '$1,600 – $6,800', lcl: '$60 – $150 per CBM', confidence: 'MEDIUM' },
  { port: 'Valencia (ESVLC)', twenty: '$1,300 – $5,000', forty: '$1,800 – $7,000', lcl: '$70 – $170 per CBM', confidence: 'MEDIUM' },
  { port: 'Genoa (ITGOA)', twenty: '$1,300 – $5,200', forty: '$1,800 – $7,200', lcl: '$70 – $170 per CBM', confidence: 'MEDIUM' },
  { port: 'Gdańsk (PLGDN)', twenty: '$1,200 – $4,800', forty: '$1,600 – $6,800', lcl: '$60 – $150 per CBM', confidence: 'MEDIUM' },
];

const airRows = [
  {
    mode: 'Air freight — China to Europe',
    rate: 'Not published in verified snapshot — request a quote',
    basis: 'No verified Europe air rate appears in the 2026 research snapshot',
    confidence: 'LOW',
  },
];

const transitRows = [
  {
    mode: 'Sea freight — China to Europe',
    transit: '28–45 days',
    basis: 'Cape-of-Good-Hope routing adds ~10–14 days versus the pre-crisis Suez lane',
    confidence: 'MEDIUM',
  },
  {
    mode: 'Rail — New Silk Road',
    transit: '15–24 days',
    basis: 'Terminal-to-terminal corridor estimates; fastest published lane is 15–18 days',
    confidence: 'MEDIUM',
  },
  {
    mode: 'Air freight',
    transit: 'Not published in verified snapshot — request a quote',
    basis: 'No verified Europe air transit appears in the research snapshot',
    confidence: 'LOW',
  },
  {
    mode: 'Door-to-door',
    transit: 'Not published in verified snapshot — request a door quote',
    basis: 'Adds China export clearance, final-mile trucking and destination clearance',
    confidence: 'LOW',
  },
];

const breakEvenRows = [
  {
    metric: 'Cargo value per container',
    ocean: '$80,000 benchmark',
    rail: '≈ $185/week carrying cost at 12% annual cost of capital',
    confidence: 'MEDIUM',
  },
  {
    metric: 'Transit difference',
    ocean: 'About 3 weeks longer than rail',
    rail: '≈ 3 weeks of tied-up capital recovered',
    confidence: 'MEDIUM',
  },
  {
    metric: 'Extra carrying cost from the slower mode',
    ocean: '≈ $555 more per container',
    rail: 'Erodes the ocean freight discount',
    confidence: 'MEDIUM',
  },
  {
    metric: 'Landed-cost crossover',
    ocean: 'Usually wins on low-value bulk cargo',
    rail: 'Often wins at ≈ $200,000 cargo value per container',
    confidence: 'MEDIUM',
  },
  {
    metric: 'Planning threshold',
    ocean: 'Below ~$50,000/container usually stays on water',
    rail: 'Above ~$50,000/container usually worth quoting',
    confidence: 'MEDIUM',
  },
];

const chinaTerminalRows = [
  { terminal: "Xi'an", unlocode: 'CNXIA', role: 'Top-frequency China-Europe block-train origin; northwest China gateway', confidence: 'MEDIUM' },
  { terminal: 'Chengdu', unlocode: 'CNCDU', role: 'Central/western China consolidation point; Lodz and Poland-heavy traffic', confidence: 'MEDIUM' },
  { terminal: 'Chongqing', unlocode: 'CNCQI', role: 'Automotive and machinery origin for the Hamburg corridor', confidence: 'MEDIUM' },
  { terminal: 'Zhengzhou', unlocode: 'CNZGZ', role: 'Fastest verified lane to Liege; central China production cluster', confidence: 'MEDIUM' },
  { terminal: 'Yiwu', unlocode: 'CNYIU', role: 'Longest corridor to Madrid; e-commerce and fast-fashion cargo', confidence: 'MEDIUM' },
];

const euTerminalRows = [
  { terminal: 'Duisburg', unlocode: 'DEDUI', role: 'Europe rail hub on the Rhine; major gateway and transshipment point', confidence: 'MEDIUM' },
  { terminal: 'Hamburg', unlocode: 'DEHAM', role: 'German deep-sea port and China-rail terminus', confidence: 'MEDIUM' },
  { terminal: 'Lodz', unlocode: 'PLLOD', role: 'Central Poland distribution point on the Chengdu corridor', confidence: 'MEDIUM' },
  { terminal: 'Madrid', unlocode: 'ESMAD', role: 'Iberian endpoint on the Yiwu line; final-mile to Spain', confidence: 'MEDIUM' },
  { terminal: 'Liege', unlocode: 'BELGG', role: 'Fast Zhengzhou destination with strong road/barge links', confidence: 'MEDIUM' },
  { terminal: 'Małaszewicze', unlocode: 'PLMAA', role: 'Polish EU-border rail gateway and the congestion gauge-change point', confidence: 'MEDIUM' },
];

const railCostRows = [
  { item: 'Rail base freight (40ft)', magnitude: '$4,000 – $5,800 by route', confidence: 'MEDIUM' },
  { item: 'Fuel surcharge', magnitude: '8–15% of base freight, monthly diesel-indexed', confidence: 'MEDIUM' },
  { item: 'Gauge-change fee', magnitude: '$150 – $250 per container', confidence: 'MEDIUM' },
  { item: 'Border fees', magnitude: '$50 – $150 per border; northern route ≥4 borders = $200 – $600 total', confidence: 'MEDIUM' },
  { item: 'Congestion surcharge', magnitude: '$200 – $500 per container at Małaszewicze in peak', confidence: 'MEDIUM' },
  { item: 'Terminal storage', magnitude: '$20 – $40 per day', confidence: 'MEDIUM' },
  { item: 'Cargo insurance', magnitude: '0.3 – 0.5% of cargo value (ocean 0.1 – 0.2%)', confidence: 'MEDIUM' },
  { item: 'Onward trucking off-corridor', magnitude: 'Duisburg to south Italy or Spain adds 3–5 days + $800–$1,200 trucking', confidence: 'MEDIUM' },
];

const faqs = [
  {
    q: 'How long does China-to-Europe rail freight take?',
    a: 'The verified research snapshot puts rail at 15–24 days on the main New Silk Road corridors, with the fastest published lane at 15–18 days. The old 18–22 day planning band still works for the major Xi\u2019an/Chengdu to Duisburg/Hamburg corridors in good conditions, but border transloading, customs and weather can push it to 25–30 days. It remains roughly half the time of a Cape-routed ocean sailing.',
  },
  {
    q: 'Is China rail freight cheaper than air freight?',
    a: 'Yes, by a wide margin. Rail typically costs about a quarter to a third of air freight per kilogram, and two to three times sea freight. It occupies the middle band: far cheaper than air and meaningfully faster than sea. The verified air Europe rate was not published in the research snapshot, so request a live quote before using air as a comparison.',
  },
  {
    q: 'What cargo suits China-to-Europe rail?',
    a: 'High-value, deadline-sensitive or inventory-heavy goods: electronics, automotive parts, machinery, fast fashion and pharmaceuticals. It does not suit low-value bulk commodities, where the rail premium over sea cannot be justified. The planning screen is useful: quote rail above roughly $50,000 of cargo value per container.',
  },
  {
    q: 'Does rail freight avoid the Red Sea problem?',
    a: 'Yes — rail runs overland through Central Asia and Russia, so it is insulated from Red Sea routing and the Cape of Good Hope detour. That is exactly why rail looked comparatively attractive through 2024–2026, when ocean transit stretched and rates spiked.',
  },
  {
    q: 'Do I still need an EORI for rail freight into the EU?',
    a: 'Yes. Rail cargo clears EU customs exactly like ocean cargo — the EORI number, TARIC classification and import VAT all apply regardless of whether the box arrived by ship or train. The UK uses a separate GB EORI since Brexit.',
  },
  {
    q: 'What are the published rail rates by route?',
    a: 'The verified snapshot lists five routes: Xi\u2019an to Duisburg $4,200–$5,100 per 40ft (16–19 days), Chengdu to Lodz $4,000–$4,800 (18–21 days), Yiwu to Madrid $4,800–$5,800 (20–24 days), Chongqing to Hamburg $4,300–$5,200 (17–20 days), and Zhengzhou to Liege $4,500–$5,300 (15–18 days). These are 40ft base rates, not all-in landed costs.',
  },
  {
    q: 'What surcharges should I add to a rail base rate?',
    a: 'Add 15–25% to the published rail base rate for fuel, gauge change, border fees, congestion and terminal handling. A $4,500 spot typically lands around $5,400–$5,800 all-in, depending on route and season. The verified line items are fuel 8–15%, gauge-change $150–$250, border fees $50–$150 per border, peak congestion $200–$500, and terminal storage $20–$40 per day.',
  },
  {
    q: 'How does inventory carrying cost change the sea-vs-rail decision?',
    a: 'At an $80,000 cargo value per container and 12% annual inventory cost, capital tied up in transit costs about $185 per week. If ocean takes roughly three weeks longer than rail, that is about $555 of extra carrying cost per container — enough to erase a large slice of the ocean freight discount. The published rule of thumb is that rail often wins on landed cost around $200,000 of cargo value per container.',
  },
  {
    q: 'Which documentation does China-to-Europe rail require?',
    a: 'Rail needs the CIM/SMGS consignment note — CIM covers the EU leg and SMGS covers the CIS leg — plus a T1 transit document filed electronically before the EU border. You also need the China export declaration and, recommended, a certificate of origin. Missing documents can stop the container at a border, and a missing T1 can add up to a week at Małaszewicze.',
  },
  {
    q: 'How does insurance differ between sea and rail?',
    a: 'Rail cargo insurance typically runs 0.3–0.5% of cargo value versus 0.1–0.2% for ocean, reflecting extra borders, gauge-change handling and higher theft risk. Check the geographic-scope clause on any marine policy because some policies exclude Russia or Central Asia overland legs. That clause matters most on the northern corridor.',
  },
  {
    q: 'Does the rail route transit Russia, and what are the sanctions risks?',
    a: 'The dominant northern and central corridors transit Russia, so you must screen the cargo, consignee and routing against sanctions and dual-use controls before booking. Some insurance policies exclude Russia or Central Asia overland legs, and some buyers avoid the corridor for reputational or compliance reasons. The southern Caspian corridor avoids Russia but carries less volume and is slower; for restricted cargo, the ocean lane or a corridor that avoids Russian territory is safer.',
  },
  {
    q: 'Which rail corridors avoid Russia?',
    a: 'The southern Caspian corridor through Kazakhstan, the Caspian Sea, Azerbaijan and Georgia can reach Turkey and onward into Europe without crossing Russia, but it has materially less capacity, more border handoffs and longer, less predictable transit. It is an option for buyers that cannot use Russian territory, not a like-for-like replacement for the main China-Kazakhstan-Russia-Poland lane.',
  },
  {
    q: 'What is the gauge change and why does it matter?',
    a: 'China and Europe use standard gauge (1,435 mm), while Russia, Belarus and much of Central Asia use broad gauge (1,520 mm). At Khorgos or Alashankou on the China side and at Małaszewicze or Brest on the Europe side, containers are transloaded between wagons. The operation adds hours per border, not days, but it is the main congestion and schedule-risk point when border volume spikes.',
  },
];

const organization = {
  '@id': `${SITE_URL}/#organization`,
  name: 'WorldFreightHub',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
};

const schema = [
  {
    type: 'Article',
    data: {
      headline: 'China to Europe Rail Freight — Complete New Silk Road Guide',
      description:
        'The complete China-to-Europe New Silk Road rail guide: verified corridor rates for Xi\u2019an, Chengdu, Yiwu, Chongqing and Zhengzhou, transit times, sea-vs-rail landed-cost arithmetic, surcharges, gauge-change planning, terminals and compliance.',
      datePublished: '2026-09-03',
      dateModified: '2026-09-03',
      inLanguage: 'en',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      author: {
        '@type': 'Organization',
        name: 'WorldFreightHub',
        url: SITE_URL,
      },
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      image: `${SITE_URL}/og.png`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  },
  {
    type: 'Organization',
    data: organization,
  },
];

const railRateSources = sourcesByIds(['freightsurcharge']);
const seaRateSources = sourcesByIds([
  'china-docshipper-europe',
  'port-rotterdam',
  'port-hamburg',
  'port-antwerp',
  'hmrc',
  'french-customs',
  'port-valencia',
  'port-genoa',
  'port-gdansk',
]);
const transitSources = sourcesByIds(['freightsurcharge', 'china-docshipper-europe']);
const decisionSources = sourcesByIds(['freightsurcharge']);
const terminalSources = sourcesByIds([
  'port-rotterdam',
  'port-hamburg',
  'port-antwerp',
  'hmrc',
  'french-customs',
  'port-valencia',
  'port-genoa',
  'port-gdansk',
]);
const costSources = sourcesByIds(['freightsurcharge', 'china-docshipper-europe', 'eu-taric']);
const complianceSources = sourcesByIds([
  'eu-taric',
  'german-customs',
  'hmrc',
  'french-customs',
  'dutch-customs',
  'spanish-customs',
  'italian-customs',
  'polish-customs',
  'belgian-customs',
]);
---

<BaseLayout
  title="China to Europe Rail Freight — Complete New Silk Road Guide"
  description="The complete China-to-Europe New Silk Road rail guide: verified corridor rates, transit times, carrying-cost break-even arithmetic, gauge-change planning, surcharge stack, terminals and compliance."
  canonical={pageUrl}
  ogType="article"
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Europe', href: '/europe/' },
          { label: 'Rail Freight' },
        ]}
      />
      <span class="badge badge--amber">September 2026 updated</span>
      <h1>China to Europe rail freight — Complete New Silk Road Guide</h1>
      <p class="lead">
        The New Silk Road is Europe's advantage that the Gulf does not have — a
        land bridge that halves ocean transit at a fraction of air cost. This
        guide walks the verified rates, the time-versus-money arithmetic and
        the operational detail that decides whether rail is right for your
        cargo.
      </p>
      <p class="small muted">
        Confidence badges separate verified figures from planning notes. Rail corridor rates and the
        surcharge stack are MEDIUM confidence from the 2026-09-03 research snapshot; ocean FCL/LCL
        benchmarks are MEDIUM from the WorldFreightHub Europe route data. Air figures and unquantified
        door-to-door items are LOW and marked request-for-quote.
      </p>

      <div class="fact-grid mt-3">
        <div class="fact">
          <span class="fact-label">Rail transit</span>
          <span class="fact-value">15–24 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Sea transit</span>
          <span class="fact-value">28–45 days <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">40ft rail range</span>
          <span class="fact-value">$4,000–$5,800 <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Rail all-in add-on</span>
          <span class="fact-value">+15–25% <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Carrying-cost tiebreaker</span>
          <span class="fact-value">≈ $185/week <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Quote threshold</span>
          <span class="fact-value">≈ $50k/container <ConfidenceBadge level="MEDIUM" /></span>
        </div>
      </div>
    </div>
  </div>

  <section class="section container">
    <blockquote class="tldr">
      <p>
        <strong>TL;DR:</strong> China-to-Europe rail runs about 15–24 days — half
        a Cape-routed ocean sailing — and costs roughly two to three times sea
        freight but a quarter to a third of air. It is not a way to save money
        against ocean; it is a way to buy back roughly three weeks of
        goods-in-transit when inventory cost justifies the premium.
      </p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>What the New Silk Road actually is</h2>
    <p>
      The China–Europe rail network — branded the New Silk Road under China's
      Belt and Road initiative — is a set of block-train services connecting
      Chinese manufacturing hubs to European terminals by rail. Containers load
      in Xi'an, Chengdu, Chongqing, Zhengzhou or Yiwu and unload in Duisburg,
      Hamburg, Lodz, Małaszewicze, Liege or Madrid, running through Kazakhstan,
      Russia and Belarus (or via a southern Caspian corridor) before entering
      the EU.
    </p>
    <p>
      It is not one route but a family of corridors. The northern and central
      lines dominate — they cross from China at Alashankou or Khorgos, traverse
      Kazakhstan and Russia, and enter the EU through Poland's Małaszewicze
      border terminal. A southern route via the Caspian Sea and Turkey exists
      but carries far less volume and serves mostly Central Asian and
      Transcaucasian destinations.
    </p>
  </section>

  <section class="section container">
    <h2>1. The verified rail rate table, sea benchmark and air note</h2>
    <p>
      Start with the rail corridors as <strong>40ft base rates</strong>. They do not include the
      +15–25% all-in surcharge stack, so a $4,500 spot is not a landed cost. The sea table below is
      the eight-port benchmark from the Europe route data; use it to see how much freight-cost premium
      rail is asking for before time value enters the equation.
    </p>

    <DataTable
      columns={[
        { key: 'route', label: 'Rail corridor' },
        { key: 'transit', label: 'Transit' },
        { key: 'rate', label: '40ft base rate' },
        { key: 'note', label: 'Route note' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={railRows}
      caption="Rail corridor rates are MEDIUM confidence from the FreightSurcharge May 2026 China-Europe guide. They are door-to-terminal base rates, not all-in landed costs."
    />
    <SourceList sources={railRateSources} title="Sources — New Silk Road rail corridor rates" />

    <h3 class="mt-3">Ocean benchmark: the eight-port cross-reference</h3>
    <p>
      Ocean is the mode rail has to beat on landed cost. Keep the port/terminal pair and container size
      identical before comparing — Rotterdam to Rotterdam, Hamburg to Hamburg — and remember the ocean
      range is also a freight line with its own destination surcharges on top.
    </p>
    <DataTable
      columns={[
        { key: 'port', label: 'Destination port' },
        { key: 'twenty', label: '20ft FCL' },
        { key: 'forty', label: '40ft FCL' },
        { key: 'lcl', label: 'LCL per CBM' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={seaRows}
      caption="Ocean FCL/LCL ranges are MEDIUM confidence from the WorldFreightHub Europe route data. Verify live figures before booking."
    />
    <SourceList sources={seaRateSources} title="Sources — China-to-Europe ocean rate ranges" />

    <h3 class="mt-3">Air freight</h3>
    <p>
      Air is the fastest lane but the verified research snapshot does not publish a China-to-Europe air
      rate, so the page will not invent one. Treat air as request-for-quote and use it only when a
      critical deadline or a very high-value, low-volume shipment justifies the premium.
    </p>
    <DataTable
      columns={[
        { key: 'mode', label: 'Mode' },
        { key: 'rate', label: 'Indicative rate' },
        { key: 'basis', label: 'Basis' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={airRows}
      caption="No verified China-to-Europe air rate was published in the research snapshot, so the air line stays LOW and request-for-quote."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>2. Transit-time table</h2>
      <p>
        Rail's entire value proposition is the gap between 15–24 days and 28–45 days. That is
        roughly three weeks of inventory, financing, production scheduling and buyer-deadline risk —
        the line item that makes a higher rail freight bill rational in the right cargo.
      </p>
      <DataTable
        columns={[
          { key: 'mode', label: 'Mode' },
          { key: 'transit', label: 'Indicative transit' },
          { key: 'basis', label: 'Basis' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={transitRows}
        caption="Sea and rail transit windows are MEDIUM confidence from the route data and research snapshot. Air and door-to-door figures were not published and stay LOW."
      />
      <SourceList sources={transitSources} title="Sources — China-to-Europe transit times" />

      <div class="note mt-2">
        <strong>Why the rail window still moves:</strong> the 15–24 day range is terminal-to-terminal,
        not a delivery promise. Gauge-change queues, border customs holds, weather and holiday peaks
        all sit inside that range. Plan the final-mile separately, especially for destinations off the
        main rail corridor.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>3. Decision module: rail-vs-sea break-even arithmetic</h2>
    <p>
      The mistake is to treat rail as a cheaper ocean. It is not — it is a faster ocean, and the value
      is in the time, not the freight rate. The research snapshot provides the arithmetic: an
      <strong>$80,000 cargo</strong> at a <strong>12% annual inventory cost</strong> carries about
      <strong>$185 per week</strong> of tied-up capital. If ocean takes roughly three weeks longer
      than rail, that is about <strong>$555 of extra carrying cost per container</strong>.
    </p>
    <p>
      At around <strong>$200,000 of cargo value per container</strong>, rail often beats ocean on
      total landed cost even though its freight line is higher. The planning threshold is simpler than
      the crossover: quote rail whenever the cargo value is above roughly <strong>$50,000 per
      container</strong>, the tolerance is <strong>15–25 days</strong>, and the origin sits in central
      or western China.
    </p>

    <DataTable
      columns={[
        { key: 'metric', label: 'Metric' },
        { key: 'ocean', label: 'Ocean' },
        { key: 'rail', label: 'Rail' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={breakEvenRows}
      caption="The inventory-carrying-cost arithmetic is MEDIUM confidence from the 2026 research notes. Use it as a decision screen, then request live quotes for both modes."
    />
    <SourceList sources={decisionSources} title="Sources — rail vs sea break-even arithmetic" />

    <div class="grid grid--2 mt-2">
      <Card title="Rail tends to win when...">
        <ul>
          <li>Cargo value is above ~$50,000 per container.</li>
          <li>Transit tolerance is 15–25 days.</li>
          <li>Origin is central or western China, close to a rail terminal.</li>
          <li>Destination is on the main rail corridor, not a long final-mile detour.</li>
          <li>Inventory cost, season deadline or cash-in-transit is the real constraint.</li>
        </ul>
      </Card>
      <Card title="Rail tends to lose when...">
        <ul>
          <li>Cargo is low-value bulk where carrying cost is small.</li>
          <li>Destination is off-corridor — Duisburg to south Italy or Spain adds 3–5 days and $800–$1,200 trucking.</li>
          <li>Cargo is subject to Russia-related sanctions or dual-use controls.</li>
          <li>The importer cannot manage CIM/SMGS, T1 and multi-border documentation risk.</li>
          <li>The freight line is the dominant cost and cash flow is not time-sensitive.</li>
        </ul>
      </Card>
    </div>

    <div class="note mt-2">
      <strong>Use the full landed-cost stack, not the headline:</strong> rail looks expensive only
      until you add three extra weeks of inventory carrying cost, missed season risk and the ocean
      destination-charge stack. Conversely, rail's 15–25% surcharge add-on can erase its value-of-time
      advantage if the destination is far from the corridor.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>4. Terminals and ports: China loading points and EU unloading points</h2>
      <p>
        The corridor starts and ends at specific rail terminals, not at every ocean gateway. The
        loading terminal changes which China production clusters can truck in cheaply; the EU terminal
        changes the final-mile and customs-clearance geometry.
      </p>

      <h3>China rail terminals</h3>
      <DataTable
        columns={[
          { key: 'terminal', label: 'Terminal' },
          { key: 'unlocode', label: 'UN/LOCODE' },
          { key: 'role', label: 'Role' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={chinaTerminalRows}
        caption="China rail terminal UN/LOCODEs are planning identifiers; confirm the exact terminal code with the forwarder before filing. Corridor roles are MEDIUM confidence planning notes."
      />

      <h3 class="mt-3">EU rail terminals</h3>
      <DataTable
        columns={[
          { key: 'terminal', label: 'Terminal' },
          { key: 'unlocode', label: 'UN/LOCODE' },
          { key: 'role', label: 'Role' },
          { key: 'confidence', label: 'Confidence', type: 'confidence' },
        ]}
        rows={euTerminalRows}
        caption="EU terminal UN/LOCODEs are MEDIUM confidence planning identifiers. Małaszewicze is the critical EU-border gauge-change and customs point, not just a destination."
      />
      <SourceList sources={terminalSources} title="Sources — European terminal and port context" />

      <div class="note mt-2">
        <strong>Gauge-change reality:</strong> China and Europe use standard gauge (1,435 mm), while
        Russia, Belarus and much of Central Asia use broad gauge (1,520 mm). At Khorgos or Alashankou
        on the China side and at Małaszewicze or Brest on the Europe side, containers are lifted and
        re-loaded onto different wagons. Transloading adds hours per border, not days, but it is the
        congestion point that can destroy schedule confidence when border volume spikes.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>5. Cost composition: the rail surcharge stack</h2>
    <p>
      The rail base rate is the first cost, not the final cost. The verified components below are the
      reason you should standardise every rail quote as “base plus named surcharges” before comparing
      it with an ocean all-in quote. Add <strong>15–25% to the base rate for the all-in estimate</strong>;
      a $4,500 spot typically lands around <strong>$5,400–$5,800</strong>.
    </p>
    <DataTable
      columns={[
        { key: 'item', label: 'Cost component' },
        { key: 'magnitude', label: 'Indicative magnitude' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={railCostRows}
      caption="Rail surcharge components are MEDIUM confidence from the FreightSurcharge May 2026 guide. Apply them to the same base rate and route before comparing with ocean."
    />
    <SourceList sources={costSources} title="Sources — rail surcharge and all-in cost stack" />

    <div class="note mt-2">
      <strong>The all-in rule:</strong> if a quote already says “all-in”, do not add fuel, gauge,
      border and congestion again. Ask the forwarder to list which items are included and which are
      estimated, then compare only like-for-like on the same origin, terminal pair and container size.
    </div>

    <p class="mt-2">
      For the destination free-time clock that can turn a good rail rate into an expensive delay, see
      the companion
      <a href="/europe/demurrage-detention/">Demurrage &amp; Detention: China to Europe</a> guide.
      For the full destination accessorial schedule, see
      <a href="/europe/hidden-charges/">Hidden Charges China to Europe: THC, ISPS, Documentation &amp; Accessorials</a>.
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>6. Compliance: CIM/SMGS, T1, EORI, duty, VAT and Russia transit</h2>

      <h3>Rail documentation</h3>
      <p>
        Rail uses the <strong>CIM/SMGS consignment note</strong>: CIM covers the EU leg and SMGS covers
        the CIS leg, with a combined note covering the full journey. File the <strong>T1 transit
        document</strong> electronically before the EU border, and prepare the China export declaration
        plus a certificate of origin where recommended. Missing documentation can stop the container at
        a border, and a missing T1 can add up to a week at Małaszewicze.
      </p>

      <h3>EORI, TARIC and VAT</h3>
      <p>
        An <strong>EORI number</strong> is mandatory for any EU import and must exist before arrival;
        the UK uses a separate <strong>GB EORI</strong> since Brexit. Duty follows the
        <strong>EU Common Customs Tariff</strong>, typically <strong>0–12%</strong> by HS/TARIC code,
        with no China–EU free-trade agreement in force. Import VAT is charged on the duty-inclusive
        value at the destination country rate. Rail changes the transport mode, not the customs,
        product-safety or VAT regime.
      </p>

      <h3>Product compliance: CE marking and REACH</h3>
      <p>
        <strong>CE marking</strong> is required for many regulated products — electronics, toys,
        machinery and medical devices among others — and <strong>REACH</strong> regulates chemical
        substances. Confirm applicability to your product class and prepare the technical file before
        shipment; a train cannot exempt cargo from EU product rules.
      </p>

      <h3>Sanctions and dual-use on Russia transit</h3>
      <p>
        The dominant northern rail corridor transits Russia, so shippers must screen the cargo, the
        consignee and the routing against sanctions and dual-use controls before booking. Some
        insurance policies exclude Russia or Central Asia overland legs, and some buyers avoid the
        corridor for reputational or compliance reasons. If the cargo is restricted, use the ocean
        lane or a corridor that avoids Russian territory.
      </p>
      <SourceList sources={complianceSources} title="Sources — EU/UK duty, VAT and EORI" />
    </div>
  </section>

