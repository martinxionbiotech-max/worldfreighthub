        <div class="fact">
          <span class="fact-label">Rail lane</span>
          <span class="fact-value">None — island <ConfidenceBadge level="MEDIUM" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">EORI</span>
          <span class="fact-value">Required before arrival <ConfidenceBadge level="MEDIUM" /></span>
        </div>
