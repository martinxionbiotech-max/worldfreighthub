const faqs = [
  {
    q: 'How long does shipping from China to Ireland take?',
    a: 'Allow roughly 32–43 days door-to-port by sea from Shanghai or Ningbo-Zhoushan (MEDIUM confidence, planning estimate) — about 30–38 days to a northern-range hub such as Rotterdam or Antwerp, then a ~1–3 day short-sea feeder west across the Irish Sea to Dublin or Cork. No verified Irish air transit is published, so request that from your carrier.',
