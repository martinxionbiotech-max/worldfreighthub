          <span class="fact-value">23% <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Currency</span>
          <span class="fact-value">EUR <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Destination port</span>
          <span class="fact-value">Dublin (IEDUB) / Cork (IEORK) <ConfidenceBadge level="HIGH" /></span>
        </div>
        <div class="fact">
          <span class="fact-label">Sea transit</span>
