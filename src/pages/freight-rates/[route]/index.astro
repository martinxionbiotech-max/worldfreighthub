---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import quotesJson from '../../../data/freight-quotes.json';
import {
  quotesByRoute, effectiveStatus, MIN_ROUTE_QUOTES_FOR_INDEXING,
} from '../../../lib/freight-quotes.mjs';
import { SITE_URL } from '../../../site';
import { routeId, rateId, entityUrl } from '../../../data/entity-ids';

// Route pages are generated only for routes with enough real data (doc §13).
// No empty route pages, no fabricated history.
// getStaticPaths 必须自包含（Vite 打包时函数被提升，外部 const 会 undefined）
export function getStaticPaths() {
  const quotes = Array.isArray(quotesJson.quotes) ? quotesJson.quotes : [];
  const byRoute = quotesByRoute(quotes);
  return Array.from(byRoute.entries())
    .filter(([, qs]) => qs.length >= MIN_ROUTE_QUOTES_FOR_INDEXING)
    .map(([slug, qs]) => ({ params: { route: slug }, props: { quotes: qs } }));
}

const { route } = Astro.params;
const { quotes: routeQuotes } = Astro.props;

const sorted = [...routeQuotes].sort((a, b) => (a.quote_date < b.quote_date ? 1 : -1));
const latest = sorted[0];
const titleFor = (q) => `${q.origin_port || q.origin_country} to ${q.destination_port || q.destination_country}`;
const title = `${titleFor(latest)} Freight Quotes — History`;
const description =
  `Historical freight quotes for ${titleFor(latest)} — indicative freight forwarder quotes with dates, equipment and validity. Retained permanently by WorldFreightHub.`;

const fmtDate = (d) => (d ? d : '—');
const fmtRate = (q) => `${q.currency} ${Number(q.rate).toLocaleString('en-US')}`;

/** P1: 实体 ID —— 稳定标识接入 JSON-LD（Route / Rate 实体身份） */
const rid = routeId(route);
const schema = [
  {
    type: 'Dataset',
    data: {
      '@id': `${SITE_URL}/freight-rates/${route}/#dataset`,
      name: `WorldFreightHub freight quotes — ${route}`,
      description: `Indicative freight forwarder quotes for the ${route} corridor, retained permanently.`,
      ...(rid ? { identifier: rid } : {}),
      isPartOf: { '@id': `${SITE_URL}/freight-rates/#dataset` },
    },
  },
];

/** P0-3: optional basis/confidence badges — rendered only when the field exists. */
const basisLabel = { 'port-to-port': 'Port-to-port', 'all-in': 'All-in' };
const confClass = { HIGH: 'badge-high', MEDIUM: 'badge-medium', LOW: 'badge-low' };

// Simple server-rendered history bars from real data only (doc §20).
const hasHistory = sorted.length >= 2;
const maxRate = Math.max(...sorted.map((q) => Number(q.rate)));
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/freight-rates/${route}/`}
  noindex={sorted.length < MIN_ROUTE_QUOTES_FOR_INDEXING}
  schema={schema}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Freight Rates', href: '/freight-rates/' }, { label: route }]} />

  <section class="section">
    <div class="container">
      <h1>{titleFor(latest)} freight quotes</h1>
      <p class="lead">
        Indicative freight forwarder quotes collected for this route. Each record
        carries its quote date, equipment, rate and validity — quotes are not
        guaranteed market prices.
      </p>

      <div class="note">
        <strong>Latest quote:</strong> {fmtRate(latest)} ({latest.equipment ?? 'equipment TBC'})
        quoted {fmtDate(latest.quote_date)}
        {latest.basis && <span class="badge badge-basis">{basisLabel[latest.basis] || latest.basis}</span>}
        {latest.confidence && <span class={`badge ${confClass[latest.confidence] || ''}`}>{latest.confidence}</span>}
        {latest.valid_until ? `, valid until ${fmtDate(latest.valid_until)}` : ''}.
        {effectiveStatus(latest) === 'expired' ? ' This quote has expired.' : ''}
      </div>

      <h2 class="mt-3">Quote history</h2>
      {hasHistory ? (
        <div class="chart" role="img" aria-label={`Freight quote history for ${route}, ${sorted.length} records`}>
          {sorted.map((q) => {
            const h = Math.max(8, Math.round((Number(q.rate) / maxRate) * 100));
            return (
              <div class="chart-col" title={`${fmtDate(q.quote_date)} — ${fmtRate(q)}`}>
                <span class="chart-bar" style={`height:${h}%`}></span>
                <span class="chart-date">{fmtDate(q.quote_date)}</span>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="note">
          Historical trend data will appear as more verified quotes are collected.
        </div>
      )}

      <h2 class="mt-3">Records</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Equipment</th>
              <th scope="col">Rate</th>
              <th scope="col">Basis</th>
              <th scope="col">Confidence</th>
              <th scope="col">Validity</th>
              <th scope="col">Quote type</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((q) => (
              <tr>
                <td>{fmtDate(q.quote_date)}</td>
                <td>{q.equipment ?? '—'}</td>
                <td>{fmtRate(q)}</td>
                <td>{q.basis ? <span class="badge badge-basis">{basisLabel[q.basis] || q.basis}</span> : '—'}</td>
                <td>{q.confidence ? <span class={`badge ${confClass[q.confidence] || ''}`}>{q.confidence}</span> : '—'}</td>
                <td>{q.valid_until ? fmtDate(q.valid_until) : '—'}{effectiveStatus(q) === 'expired' ? ' (expired)' : ''}</td>
                <td>{q.quote_type}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="note mt-3">
        <strong>Disclaimer:</strong> these are indicative freight forwarder quotes
        collected from available sources and should not be interpreted as
        guaranteed market prices.
      </div>

      <p class="mt-2">
        <a class="btn btn-secondary" href="/freight-rates/">← All routes</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .chart {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    height: 160px;
    padding: 12px;
    background: var(--surface, #f8fafc);
    border: 1px solid var(--border-strong, #cbd5e1);
    border-radius: 8px;
  }
  .chart-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    gap: 6px;
  }
  .chart-bar {
    width: 100%;
    max-width: 40px;
    background: var(--navy-700, #16345f);
    border-radius: 4px 4px 0 0;
    min-height: 8px;
  }
  .chart-date {
    font-size: 0.75rem;
    color: var(--slate-500, #64748b);
  }
  .mt-2 { margin-top: 16px; }
  .mt-3 { margin-top: 24px; }
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-basis { background: #e0f2fe; color: #075985; }
  .badge-high { background: #dcfce7; color: #166534; }
  .badge-medium { background: #fef9c3; color: #854d0e; }
  .badge-low { background: #fee2e2; color: #991b1b; }
</style>
