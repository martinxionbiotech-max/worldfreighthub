---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import { SITE_URL } from '../../site';

const tools = [
  {
    name: 'CBM Calculator',
    description: 'Convert dimensions into cubic meters for LCL and volumetric calculations.',
    href: '/tools/cbm-calculator/',
  },
  {
    name: 'Container Loading Calculator',
    description: 'Estimate how many cartons or pallets fit in a 20ft or 40ft container.',
    href: '/tools/container-loading-calculator/',
  },
  {
    name: 'Volumetric Weight Calculator',
    description: 'Compute volumetric and chargeable weight for air freight.',
    href: '/tools/volumetric-weight-calculator/',
  },
];
---

<BaseLayout
  title="Freight Tools & Calculators"
  description="CBM, container loading and volumetric weight calculators for the China–GCC freight corridor."
  canonical={`${SITE_URL}/tools/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Tools' }]} />
      <h1>Freight tools & calculators</h1>
      <p class="lead">
        Practical, client-side calculators to support shipment planning across
        the China–GCC freight corridor.
      </p>
    </div>
  </div>

  <section class="section container">
    <div class="grid grid--3">
      {tools.map((tool) => <Card title={tool.name} description={tool.description} href={tool.href} />)}
    </div>
  </section>
</BaseLayout>
