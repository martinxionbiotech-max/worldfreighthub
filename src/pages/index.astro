---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Cta from '../components/Cta.astro';
import AdSlot from '../components/AdSlot.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { SITE_URL, SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION } from '../site';

const stats = [
  { value: '6', label: 'GCC countries covered' },
  { value: '21', label: 'China → GCC shipping routes' },
  { value: '19', label: 'Port profiles (7 China + 12 GCC)' },
  { value: '103', label: 'Freight providers in the directory' },
  { value: '28', label: 'Freight & customs glossary terms' },
  { value: '46', label: 'Corridor guides & landing pages' },
];

const faqs = [
  {
    q: 'What is WorldFreightHub?',
    a: 'WorldFreightHub is a freight intelligence reference covering 6 GCC countries, 21 China→GCC routes, 19 port profiles, 103 directory providers and 46 corridor guides — a structured, source-backed guide to shipping routes, destination countries, ports, freight methods and costs. It is an information resource, not a freight forwarder itself.',
  },
  {
    q: 'Are the freight rates on this site real quotes?',
    a: 'No — the 21 route rates are reference ranges, not live quotes; every rate, transit time and cost figure is an indicative estimate clearly labelled HIGH / MEDIUM / LOW confidence. Rates move constantly with fuel, season and geopolitical risk, so always confirm figures with a licensed carrier or forwarder before booking.',
  },
  {
    q: 'How do I ship from China to Saudi Arabia or the UAE?',
    a: 'The first cost breakpoint is the destination, not the carrier: Saudi Arabia’s 5% duty + 15% VAT clears 20.75% above CIF while the UAE’s 5% + 5% clears 10.25% above CIF — a 10.5-percentage-point gap on the same goods. Then choose a method (FCL, LCL, air, rail, DDP or express) and a route from a China origin port to a GCC destination port; if you need a firm price, submit a quote request and a provider on the corridor will respond.',
  },
  {
    q: 'How is the data on this site verified?',
    a: 'Across 6 GCC countries, 19 port profiles and 103 directory providers, every data point is tied to a primary source — a port authority, customs authority, carrier or official registry — and carries a HIGH / MEDIUM / LOW confidence level. Figures that cannot be verified against a source are explicitly marked LOW confidence and flagged "verify before relying". Nothing is fabricated to fill a gap.',
  },
  {
    q: 'Which countries does WorldFreightHub cover?',
    a: 'All 6 GCC member states — Saudi Arabia (15% VAT), Bahrain (10%), the UAE and Oman (5%), and Qatar and Kuwait (0%) — each under the shared 5% CIF duty baseline. Coverage includes duty, VAT, de minimis thresholds, compliance requirements, entry ports and China-origin shipping routes to each.',
  },
  {
    q: 'Can I get a freight quote through this site?',
    a: 'Yes — the get-quote form routes your request to one of the 103 providers operating on the 21 China-to-GCC routes. There is no obligation and no fee — the request is simply passed to a provider who can quote your specific shipment.',
  },
];

const schema = [
  {
    type: 'WebSite',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
  },
  {
    type: 'Organization',
    data: {
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/og.png`,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'martin@dinweys.com',
        telephone: '+86-13323237275',
        availableLanguage: ['English'],
      },
      sameAs: [SITE_URL],
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title="China to GCC Freight Intelligence — Routes, Ports & Costs"
  description={SITE_DESCRIPTION}
  canonical={`${SITE_URL}/`}
  schema={schema}
>
  <section class="hero">
    <div class="container">
      <h1>China to GCC freight intelligence, without the noise</h1>
      <p>
        WorldFreightHub is a {SITE_TAGLINE} for the China–GCC corridor. Explore
        shipping routes, ports, destination countries, methods and tools — built
        on primary sources, with every rate clearly marked as an estimate.
      </p>
      <div class="hero-actions">
        <a class="btn btn-amber" href="/routes/">Explore routes</a>
        <a class="btn btn-secondary" href="/get-quote/">Get a quote</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>TL;DR:</strong> Across 21 China→GCC routes, the 6 destination countries split into three landed-cost tax bands: Saudi Arabia (5% duty + 15% VAT) clears 20.75% above CIF, the UAE and Oman clear 10.25% above CIF, and Qatar and Kuwait clear just 5% above CIF — a 15.75-percentage-point gap between the cheapest and costliest clearance. On a US$10,000 CIF shipment that gap is worth US$1,575: about US$12,075 landed in Saudi Arabia versus US$10,500 in Qatar, before freight-adjacent fees. The 19 port profiles and 46 corridor guides average 2.4 guides per port, and 103 directory providers across 21 routes average 4.9 providers per route — every figure is a confidence-labelled reference range, not a live quote.</p>
    </blockquote>
  </section>

  <section class="section container">
    <div class="fact-grid">
      {stats.map((stat) => (
        <div class="fact">
          <span class="fact-value">{stat.value}</span>
          <span class="fact-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>What we do</h2>
    <p class="lead">
      A structured, data-driven reference for importers, exporters and
      forwarders moving goods between China and the Gulf Cooperation Council
      states — from duty and VAT rules to port-by-port routing decisions.
    </p>
    <div class="grid grid--3 mt-2">
      <Card
        title="Shipping routes"
        description="China to GCC corridors with indicative transit times and cost ranges."
        href="/routes/"
      />
      <Card
        title="Destination countries"
        description="VAT, customs and port profiles for the six GCC member states."
        href="/countries/"
      />
      <Card
        title="Ports & terminals"
        description="Major seaports and dry ports from Shanghai to Khalifa bin Salman."
        href="/ports/"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Everything you need to plan a shipment</h2>
      <div class="grid grid--3 mt-2">
        <Card
          title="Freight methods"
          description="FCL, LCL, air, rail, DDP and express — cost, speed and when each wins."
          href="/methods/"
        />
        <Card
          title="Tools"
          description="CBM, container loading and volumetric weight calculators."
          href="/tools/"
        />
        <Card
          title="Provider directory"
          description="A verification-first directory of freight forwarders and customs brokers."
          href="/directory/"
        />
      </div>
      <div class="note mt-3">
        <strong>Rate transparency:</strong> all freight rates on this site are
        indicative estimates, not live quotes, and are shown with a confidence
        level. Figures that cannot be sourced are marked LOW and flagged
        "verify before relying" rather than fabricated.
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Why the data can be trusted</h2>
    <p class="lead">
      Most freight sites are written by freight forwarders selling their own
      service. WorldFreightHub is built the opposite way — as a neutral
      reference where every claim is traceable to a source.
    </p>
    <div class="fact-grid mt-2">
      <div class="fact">
        <span class="fact-label">Source-backed</span>
        <span class="fact-value">Every rate and rule is tied to a port authority, customs authority, carrier or official registry.</span>
      </div>
      <div class="fact">
        <span class="fact-label">Confidence-labelled</span>
        <span class="fact-value">Each figure carries a HIGH / MEDIUM / LOW confidence level, so you know what is solid and what needs checking.</span>
      </div>
      <div class="fact">
        <span class="fact-label">Honest about gaps</span>
        <span class="fact-value">Unverified data is labelled unverified rather than padded with plausible-looking numbers.</span>
      </div>
      <div class="fact">
        <span class="fact-label">Provider-verified</span>
        <span class="fact-value">Directory listings are marked verified only after contact details and claims are independently confirmed.</span>
      </div>
    </div>
    <p class="mt-2">
      <a class="btn btn-secondary" href="/methodology/">Read the methodology</a>
    </p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Middle East focus</h2>
      <p class="lead">
        We cover the China → GCC corridor in depth, including Saudi Arabia, the
        UAE, Qatar, Kuwait, Oman and Bahrain — duty and VAT, compliance, ports
        and transit times for each.
      </p>
      <p class="mt-2">
        <a class="btn btn-secondary" href="/middleeast/">Explore the Middle East</a>
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Frequently asked questions</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <AdSlot />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
