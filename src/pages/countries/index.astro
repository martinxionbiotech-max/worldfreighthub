---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { gccCountries } from '../../data/gcc-countries';
import { SITE_URL } from '../../site';

const rows = gccCountries.map((country) => ({
  country: { href: `/countries/${country.slug}/`, label: country.name },
  iso2: country.iso2,
  capital: country.capital,
  currency: country.currency,
  vat: country.vatRate === null ? 'None' : `${country.vatRate}%`,
  ports: country.ports.length,
}));

const faqs = [
  {
    q: 'Which GCC country has the lowest import tax?',
    a: 'Qatar and Kuwait are the lowest-tax destinations today at ×1.05 on CIF (5% duty, 0% VAT), while Saudi Arabia is the highest at ×1.2075 (5% duty + 15% VAT). The UAE and Oman charge 5% VAT at ×1.1025, Bahrain 10% at ×1.155, and Saudi Arabia 15% at ×1.2075.',
  },
  {
    q: 'Saudi Arabia or the UAE — which is easier to import into?',
    a: 'The UAE is the lower-friction entry point with a ×1.1025 landed-cost multiplier (5% VAT + 5% duty) and free zones that defer duty, while Saudi Arabia runs ×1.2075 plus mandatory SABER/SASO conformity for most goods. Choose by destination market — they serve different regions.',
  },
  {
    q: 'How is GCC import duty calculated?',
    a: 'On the CIF value (cost + insurance + freight), not the invoice value, at a baseline of 5% under the GCC Common Customs Tariff. VAT is then charged on top of the duty-inclusive value, which is why the headline 5% becomes ×1.05 before any VAT is added.',
  },
  {
    q: 'Which port should I choose for each country?',
    a: 'Each GCC state has a primary gateway — Jeddah and Dammam for Saudi Arabia, Jebel Ali for the UAE, Hamad for Qatar, Shuwaikh/Shuaiba for Kuwait, Sohar for Oman, and Khalifa bin Salman for Bahrain — so the port decision is really a final-destination decision. The right port depends on where in the country your goods are destined.',
  },
];

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'GCC destination countries',
      itemListElement: gccCountries.map((country, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: country.name,
        url: `${SITE_URL}/countries/${country.slug}/`,
      })),
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title="GCC Destination Countries for Freight"
  description="VAT rates, capitals, currencies and ports for the six GCC states served by the China freight corridor, plus duty and compliance guidance."
  canonical={`${SITE_URL}/countries/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Countries' }]} />
      <h1>GCC destination countries</h1>
      <p class="lead">
        The six Gulf Cooperation Council member states on the China freight
        corridor — each with its own VAT rate, duty rules, compliance
        requirements and entry ports.
      </p>
      <blockquote class="tldr">
        <p><strong>TL;DR:</strong> The GCC’s 6 countries span a 15.75-point landed-cost spread: Qatar and Kuwait clear at ×1.05, while Saudi Arabia clears at ×1.2075. Saudi’s 15% VAT plus 5% duty means CIF × 1.05 × 1.15, or CIF × 1.2075, before freight or compliance. UAE and Oman sit in the middle at ×1.1025 and Bahrain at ×1.155, so destination choice changes the tax stack before any quote.</p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>Destination at a glance</h2>
    <DataTable
      columns={[
        { key: 'country', label: 'Country', type: 'link' },
        { key: 'iso2', label: 'ISO' },
        { key: 'capital', label: 'Capital' },
        { key: 'currency', label: 'Currency' },
        { key: 'vat', label: 'VAT' },
        { key: 'ports', label: 'Ports' },
      ]}
      rows={rows}
      caption="VAT rates are indicative — verify with the relevant authority before relying on these figures."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>How the tax stacks up</h2>
      <p>
        All six states share the GCC Common Customs Tariff — a 5% baseline duty
        on CIF value — but they differ sharply on VAT and compliance. Qatar and
        Kuwait have no VAT today; the UAE and Oman charge 5%; Bahrain 10%; and
        Saudi Arabia 15% plus mandatory SABER/SASO conformity for most goods.
        These differences can swing a landed cost by 15% or more, so pick the
        destination profile before you commit to a shipment.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Frequently asked questions</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
