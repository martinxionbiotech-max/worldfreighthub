---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import Cta from '../../components/Cta.astro';
import { gccCountries } from '../../data/gcc-countries';
import { SITE_URL } from '../../site';

const rows = gccCountries.map((country) => ({
  country: { href: `/countries/${country.slug}/`, label: country.name },
  iso2: country.iso2,
  capital: country.capital,
  currency: country.currency,
  vat: country.vatRate === null ? 'None' : `${country.vatRate}%`,
  ports: country.ports.length,
}));

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'GCC destination countries',
      itemListElement: gccCountries.map((country, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: country.name,
        url: `${SITE_URL}/countries/${country.slug}/`,
      })),
    },
  },
];
---

<BaseLayout
  title="GCC Destination Countries for Freight"
  description="VAT rates, capitals, currencies and ports for the six GCC states served by the China freight corridor."
  canonical={`${SITE_URL}/countries/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Countries' }]} />
      <h1>GCC destination countries</h1>
      <p class="lead">
        The six Gulf Cooperation Council member states covered on the China
        freight corridor, with VAT and port profiles.
      </p>
    </div>
  </div>

  <section class="section container">
    <DataTable
      columns={[
        { key: 'country', label: 'Country', type: 'link' },
        { key: 'iso2', label: 'ISO' },
        { key: 'capital', label: 'Capital' },
        { key: 'currency', label: 'Currency' },
        { key: 'vat', label: 'VAT' },
        { key: 'ports', label: 'Ports' },
      ]}
      rows={rows}
      caption="VAT rates are indicative and marked for verification before publish."
    />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
