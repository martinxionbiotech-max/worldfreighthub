---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import SourceList from '../../components/SourceList.astro';
import Cta from '../../components/Cta.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { gccCountries } from '../../data/gcc-countries';
import { chinaPorts } from '../../data/china-ports';
import { methods } from '../../data/methods';
import { directoryProviders } from '../../data/directory';
import { routes } from '../../data/routes';
import { countrySourceIds, sourcesByIds } from '../../data/sources';
import { getPortBySlug, portName } from '../../data/lookup';
import { SITE_URL } from '../../site';

export function getStaticPaths() {
  return gccCountries.map((country) => ({
    params: { slug: country.slug },
    props: { country },
  }));
}

const { country } = Astro.props;

const countryPorts = country.ports
  .map((slug) => getPortBySlug(slug))
  .filter((port) => port !== undefined);

const countryRoutes = routes.filter((route) => route.country === country.slug);

const countryProviderCount = directoryProviders.filter((provider) =>
  provider.serviceCountries.includes(country.slug),
).length;

const countrySources = sourcesByIds(countrySourceIds[country.slug] ?? []);

const schema = [
  {
    type: 'Country',
    data: {
      name: country.name,
      url: `${SITE_URL}/countries/${country.slug}/`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: country.iso2,
      },
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: country.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`Shipping to ${country.name} from China — Duty, VAT & Clearance`}
  description={`Freight and customs information for ${country.name}: ${country.vatRate === null ? 'no VAT' : `${country.vatRate}% VAT`}, import duty, de minimis, compliance and entry ports.`}
  canonical={`${SITE_URL}/countries/${country.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Countries', href: '/countries/' },
          { label: country.name },
        ]}
      />
      <h1>{country.name}</h1>
      <p class="lead">Destination profile for the China freight corridor.</p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">ISO code</span>
        <span class="fact-value">{country.iso2}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Capital</span>
        <span class="fact-value">{country.capital}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Currency</span>
        <span class="fact-value">{country.currency}</span>
      </div>
      <div class="fact">
        <span class="fact-label">VAT rate</span>
        <span class="fact-value">{country.vatRate === null ? 'None' : `${country.vatRate}%`}</span>
      </div>
    </div>
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>TL;DR:</strong> {country.tldr}</p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>Import duty &amp; VAT</h2>
    <p>
      <strong>Duty:</strong> {country.dutyRate}{' '}
      <ConfidenceBadge level="MEDIUM" />
    </p>
    <p class="muted">{country.dutyNote}</p>
    <p class="mt-2">
      <strong>VAT:</strong>{' '}
      {country.vatRate === null ? 'None currently' : `${country.vatRate}%`}{' '}
      <ConfidenceBadge level="HIGH" />
      {country.vatRate !== null && ` — ${country.vatNote}`}
    </p>
    {country.vatRate === null && (
      <p class="muted">{country.vatNote}</p>
    )}
  </section>

  <section class="section container">
    <h2>De minimis threshold</h2>
    <p>
      <strong>{country.deMinimis}</strong>{' '}
      <ConfidenceBadge level="LOW" />
    </p>
    <p class="muted">{country.deMinimisNote}</p>
  </section>

  <section class="section container">
    <h2>Compliance requirements</h2>
    <ul>
      {country.compliance.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="section container">
    <h2>Clearance process</h2>
    <ol>
      {country.clearanceProcess.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Ports</h2>
      <div class="grid grid--3 mt-2">
        {countryPorts.map((port) => (
          <Card
            title={port.name}
            description={`${port.type === 'dry-port' ? 'Dry port' : 'Seaport'} in ${port.country}.`}
            href={`/ports/${port.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>China routes to {country.name}</h2>
    {countryRoutes.length > 0 ? (
      <div class="grid grid--3 mt-2">
        {countryRoutes.map((route) => (
          <Card
            title={`${portName(route.originPort)} → ${portName(route.destPort)}`}
            description={`Typical transit ${route.transitDays.typical} days (estimate).`}
            href={`/routes/${route.slug}/`}
          />
        ))}
      </div>
    ) : (
      <p class="muted">No routes published for this country yet.</p>
    )}
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>China origin ports</h2>
      <p class="muted">
        These are the principal Chinese loading ports for the GCC corridor. The
        right gateway depends on where your cargo originates — East China,
        South China or North China.
      </p>
      <div class="grid grid--3 mt-2">
        {chinaPorts.map((port) => (
          <Card
            title={port.name}
            description={port.hinterland}
            href={`/ports/${port.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Shipping methods to {country.name}</h2>
    <div class="grid grid--3 mt-2">
      {methods.map((method) => (
        <Card
          title={method.name}
          description={method.summary}
          href={`/methods/${method.slug}/`}
        />
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Freight providers serving {country.name}</h2>
      {countryProviderCount > 0 ? (
        <>
          <p>
            <strong>{countryProviderCount}</strong> source-documented
            provider{countryProviderCount === 1 ? '' : 's'} list {country.name}
            {' '}as a service destination.
          </p>
          <a class="btn btn-secondary mt-2" href="/directory/">
            Browse the directory
          </a>
        </>
      ) : (
        <>
          <p>No providers currently list {country.name}.</p>
          <a class="btn btn-secondary mt-2" href="/directory/">
            Browse the full directory
          </a>
        </>
      )}
    </div>
  </section>

  <section class="section container">
    <h2>Planning tools</h2>
    <Card
      title="Freight tools & calculators"
      description="Use the CBM, container loading and volumetric weight calculators before requesting a quote."
      href="/tools/"
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Evidence &amp; sources</h2>
      <p>
        See the evidence records behind this country's duty, VAT and port data.
      </p>
      <div class="grid grid--2 mt-2">
        <Card
          title="Regulatory evidence"
          description="Source-to-record trail for duty, VAT and compliance figures."
          href="/evidence/regulatory/"
        />
        <Card
          title="Port evidence"
          description="Source mapping for all China and GCC port profiles."
          href="/evidence/ports/"
        />
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Country intelligence</h2>
    <div class="grid grid--2 mt-2">
      <div>
        <h3>Typical cargo</h3>
        <ul>{country.typicalCargo.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div>
        <h3>Import risks</h3>
        <ul>{country.importRisks.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
    <div class="grid grid--2 mt-2">
      <div>
        <h3>Best port</h3>
        <p>{country.bestPort}</p>
      </div>
      <div>
        <h3>Inland logistics</h3>
        <p>{country.inlandLogistics}</p>
      </div>
    </div>
    <div class="mt-2">
      <h3>Decision guide</h3>
      <p>{country.decisionGuide}</p>
    </div>
  </section>

  <section class="section container">
    <h2>What most guides skip</h2>
    <p>{country.insight}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={country.faqs} />
    </div>
  </section>

  <section class="section container">
    <h2>Key takeaways</h2>
    <ol>
      {country.keyTakeaways.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SourceList sources={countrySources} title="Official sources" />
    <p class="muted">
      Last updated: {country.updated}. Duty, VAT and de minimis figures are
      indicative and change over time.
      Always confirm current rates with the relevant customs authority before
      making commercial decisions.
    </p>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
