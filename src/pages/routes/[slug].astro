---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import DataTable from '../../components/DataTable.astro';
import SourceList from '../../components/SourceList.astro';
import Cta from '../../components/Cta.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { routes } from '../../data/routes';
import { countrySourceIds, sourcesByIds } from '../../data/sources';
import { getCountryBySlug, portName, countryName } from '../../data/lookup';
import { SITE_URL } from '../../site';

export function getStaticPaths() {
  return routes.map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;

const originName = portName(route.originPort);
const destName = portName(route.destPort);
const destCountry = getCountryBySlug(route.country);
const routeSources = sourcesByIds(countrySourceIds[route.country] ?? []);

const costRows = route.costRows.map((row) => ({
  item: row.label,
  range: row.range,
  confidence: row.confidence,
}));

const costSummary = route.costRows.length > 0
  ? route.costRows.map((row) => `${row.label} ${row.range}`).join(' · ')
  : 'Cost ranges not published for this route — request a quote.';

const tldr = `${originName} to ${destName} typically runs ${route.transitDays.typical} days, with a ${route.transitDays.range[0]}–${route.transitDays.range[1]} day range. ${route.routingNote}`;

const schema = [
  {
    type: 'WebPage',
    data: {
      name: `${originName} to ${destName} freight route`,
      url: `${SITE_URL}/routes/${route.slug}/`,
      description: `Indicative transit time and rate placeholders for the ${originName} to ${destName} corridor.`,
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: route.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title={`${originName} to ${destName} shipping route`}
  description={`Shipping route from ${originName} to ${destName} — indicative transit time, placeholder rates, and primary sources.`}
  canonical={`${SITE_URL}/routes/${route.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Routes', href: '/routes/' },
          { label: `${originName} → ${destName}` },
        ]}
      />
      <h1>{originName} → {destName}</h1>
      <p class="lead">
        Indicative transit time and rate placeholders for the {originName} to
        {destName} corridor.
      </p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Origin</span>
        <span class="fact-value"><a href={`/ports/${route.originPort}/`}>{originName}</a></span>
      </div>
      <div class="fact">
        <span class="fact-label">Destination</span>
        <span class="fact-value"><a href={`/ports/${route.destPort}/`}>{destName}</a></span>
      </div>
      <div class="fact">
        <span class="fact-label">Destination country</span>
        <span class="fact-value"><a href={`/countries/${route.country}/`}>{countryName(route.country)}</a></span>
      </div>
      <div class="fact">
        <span class="fact-label">Typical transit</span>
        <span class="fact-value">{route.transitDays.typical} days</span>
      </div>
      <div class="fact">
        <span class="fact-label">Transit range</span>
        <span class="fact-value">{route.transitDays.range[0]}–{route.transitDays.range[1]} days</span>
      </div>
    </div>
  </section>

  <section class="section container">
    <blockquote class="tldr">
      <p><strong>TL;DR:</strong> {tldr}</p>
    </blockquote>
  </section>

  <section class="section container">
    <h2>Quick answer</h2>
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Transit time</span>
        <span class="fact-value">{route.transitDays.typical} days (range {route.transitDays.range[0]}–{route.transitDays.range[1]})</span>
      </div>
      <div class="fact">
        <span class="fact-label">Freight cost</span>
        <span class="fact-value">{costSummary}</span>
      </div>
      {destCountry && (
        <div class="fact">
          <span class="fact-label">Import duty</span>
          <span class="fact-value">{destCountry.dutyRate}</span>
        </div>
      )}
      {destCountry && (
        <div class="fact">
          <span class="fact-label">VAT</span>
          <span class="fact-value">{destCountry.vatRate === null ? 'None' : `${destCountry.vatRate}%`}</span>
        </div>
      )}
    </div>
    <p class="muted">
      <ConfidenceBadge level={route.confidence} /> Indicative ranges only — not a
      live quote. Last reviewed: {route.updated}. Duty/VAT from {destCountry ? destCountry.name : route.country} customs sources; freight costs shift weekly
      with fuel, season and geopolitical risk. Confirm a current quote before booking.
    </p>
  </section>

  <section class="section container">
    <h2>Route profile</h2>
    <p><strong>Origin:</strong> {route.originNote}</p>
    <p class="mt-2"><strong>Destination:</strong> {route.destNote}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Route intelligence</h2>
      <div class="grid grid--2 mt-2">
        <div>
          <h3>Key chokepoints</h3>
          <ul>
            {route.chokepoints.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div>
          <h3>Geopolitical risks</h3>
          <ul>
            {route.risks.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
      <div class="grid grid--2 mt-2">
        <div>
          <h3>Cargo fit</h3>
          <ul>
            {route.cargoFit.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div>
          <h3>Best-fit decision</h3>
          <p>{route.bestFit}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Transit time</h2>
    <p class="lead">
      <strong>{route.transitDays.typical} days typical</strong>{' '}
      <ConfidenceBadge level={route.confidence} />
    </p>
    <p class="muted">
      Range {route.transitDays.range[0]}–{route.transitDays.range[1]} days. {route.transitNote}
    </p>
  </section>

  <section class="section container">
    <h2>Reference cost ranges</h2>
    <p class="muted">
      Indicative ranges compiled from multiple public sources — not live quotes.
      Figures shift weekly with fuel, season and geopolitical risk. Confirm a
      current quote before booking.
    </p>
    <DataTable
      columns={[
        { key: 'item', label: 'Item' },
        { key: 'range', label: 'Indicative range (China → GCC)' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={costRows}
      caption={`Indicative cost ranges for ${originName} → ${destName}`}
    />
  </section>

  <section class="section container">
    <h2>Routing &amp; considerations</h2>
    <p>{route.routingNote}</p>
  </section>

  <section class="section container">
    <h2>What most guides skip</h2>
    <p>{route.insight}</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FaqBlock items={route.faqs} />
    </div>
  </section>

  <section class="section container">
    <h2>Key takeaways</h2>
    <ol>
      {route.keyTakeaways.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SourceList sources={routeSources} title="Reference sources" />
    <p class="muted">
      Last updated: {route.updated}. Transit times and rate ranges are
      indicative, not guarantees. Confirm
      figures with a licensed carrier or freight forwarder before booking.
    </p>
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
