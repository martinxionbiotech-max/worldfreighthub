---
import { getStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import DataTable from '../../components/DataTable.astro';
import SourceList from '../../components/SourceList.astro';
import Cta from '../../components/Cta.astro';
import { routes } from '../../data/routes';
import { getRatesByRoute } from '../../data/rates';
import { sources } from '../../data/sources';
import { portName } from '../../data/lookup';
import { SITE_URL } from '../../site';

export function getStaticPaths() {
  return routes.map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;

const originName = portName(route.originPort);
const destName = portName(route.destPort);
const routeRates = getRatesByRoute(route.slug);

const rateRows = routeRates.map((rate) => ({
  container: rate.container,
  amount: rate.amount,
  confidence: rate.confidence,
  lastUpdated: rate.lastUpdated,
}));

const schema = [
  {
    type: 'WebPage',
    data: {
      name: `${originName} to ${destName} freight route`,
      url: `${SITE_URL}/routes/${route.slug}/`,
      description: `Indicative transit time and rate placeholders for the ${originName} to ${destName} corridor.`,
    },
  },
];
---

<BaseLayout
  title={`${originName} to ${destName} shipping route`}
  description={`Shipping route from ${originName} to ${destName} — indicative transit time, placeholder rates, and primary sources.`}
  canonical={`${SITE_URL}/routes/${route.slug}/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Routes', href: '/routes/' },
          { label: `${originName} → ${destName}` },
        ]}
      />
      <h1>{originName} → {destName}</h1>
      <p class="lead">
        Indicative transit time and rate placeholders for the {originName} to
        {destName} corridor.
      </p>
    </div>
  </div>

  <section class="section container">
    <div class="fact-grid">
      <div class="fact">
        <span class="fact-label">Origin</span>
        <span class="fact-value">{originName}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Destination</span>
        <span class="fact-value">{destName}</span>
      </div>
      <div class="fact">
        <span class="fact-label">Typical transit</span>
        <span class="fact-value">{route.transitDays.typical} days</span>
      </div>
      <div class="fact">
        <span class="fact-label">Transit range</span>
        <span class="fact-value">{route.transitDays.range[0]}–{route.transitDays.range[1]} days</span>
      </div>
    </div>

    <div class="note mt-3">
      <strong>Transit time confidence: <ConfidenceBadge level={route.confidence} /></strong>
      <span> {route.note}.</span>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Indicative rates</h2>
      {routeRates.length > 0 ? (
        <DataTable
          columns={[
            { key: 'container', label: 'Container' },
            { key: 'amount', label: 'Rate (USD)', type: 'amount' },
            { key: 'confidence', label: 'Confidence', type: 'confidence' },
            { key: 'lastUpdated', label: 'Last updated' },
          ]}
          rows={rateRows}
          caption="Placeholder rates — a dash indicates no verified figure yet."
        />
      ) : (
        <p class="muted">No rate entries published for this route yet.</p>
      )}
    </div>
  </section>

  <section class="section container">
    <SourceList sources={sources.slice(0, 6)} title="Reference sources" />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
