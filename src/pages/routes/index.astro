---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Cta from '../../components/Cta.astro';
import { routes } from '../../data/routes';
import { portName, countryName } from '../../data/lookup';
import { SITE_URL } from '../../site';

const routeCount = routes.length;
const originCount = new Set(routes.map((route) => route.originPort)).size;
const destinationCount = new Set(routes.map((route) => route.destPort)).size;

const rows = routes.map((route) => ({
  route: {
    href: `/routes/${route.slug}/`,
    label: `${portName(route.originPort)} → ${portName(route.destPort)}`,
  },
  origin: { href: `/ports/${route.originPort}/`, label: portName(route.originPort) },
  destination: portName(route.destPort),
  country: { href: `/countries/${route.country}/`, label: countryName(route.country) },
  transit: `${route.transitDays.typical} days`,
  confidence: route.confidence,
}));

const faqs = [
  {
    q: 'Which China port should I ship from?',
    a: 'Among 3 origin ports, Shanghai is the default for East China with the densest sailings. Ningbo-Zhoushan is a strong alternative for Zhejiang cargo, often slightly cheaper, and Shenzhen (Yantian) is the natural South China origin. Choose the port closest to your factory to minimise inland trucking.',
  },
  {
    q: 'How long does a China-to-GCC route take?',
    a: 'Direct sailings to the UAE and Saudi Arabia typically run 14–20 days port-to-port. Qatar, Kuwait, Bahrain and Oman usually transship via Singapore or a regional hub, adding 5–10 days for a total of roughly 20–30 days.',
  },
  {
    q: 'Do these routes go direct or transship?',
    a: 'Of the 7 destination ports, Jebel Ali, Jeddah and Dammam have the most direct calls; the smaller Gulf markets (Hamad, Shuwaikh, Khalifa bin Salman) are often served by transshipment via Singapore or a regional hub. Direct sailings are faster and less likely to be delayed.',
  },
  {
    q: 'Why do transit times vary so much?',
    a: 'Two geopolitical chokepoints drive the variance: the Strait of Hormuz, which Gulf-bound cargo must transit, and the Red Sea, where the Houthi crisis forced carriers to reroute around the Cape of Good Hope — adding weeks to some Jeddah-bound sailings. Always confirm the current routing with the carrier.',
  },
];

const schema = [
  {
    type: 'ItemList',
    data: {
      name: 'China to GCC freight routes',
      itemListElement: routes.map((route, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${portName(route.originPort)} to ${portName(route.destPort)}`,
        url: `${SITE_URL}/routes/${route.slug}/`,
      })),
    },
  },
  {
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  },
];
---

<BaseLayout
  title="China to GCC Freight Routes"
  description="Indicative shipping routes from China (Shanghai, Ningbo, Shenzhen) to GCC ports, with transit time estimates and routing notes."
  canonical={`${SITE_URL}/routes/`}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Routes' }]} />
      <h1>China to GCC freight routes</h1>
      <p class="lead">
        Main corridors from Shanghai, Ningbo-Zhoushan and Shenzhen to major Gulf
        ports, with indicative transit times and the routing risks behind them.
      </p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> The route table is {routeCount} China-to-GCC lanes built from {originCount} origins × {destinationCount} destinations. Of the {destinationCount} destinations, 3 (Jebel Ali, Jeddah and Dammam) get the most direct calls, while the smaller markets usually transship and add 5–10 days. The practical win is the highest-density lanes: Shanghai/Ningbo to Jebel Ali or Dammam, where direct sailings run 14–20 days port-to-port.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>Route directory</h2>
    <DataTable
      columns={[
        { key: 'route', label: 'Route', type: 'link' },
        { key: 'origin', label: 'Origin', type: 'link' },
        { key: 'destination', label: 'Destination' },
        { key: 'country', label: 'Country', type: 'link' },
        { key: 'transit', label: 'Typical transit' },
        { key: 'confidence', label: 'Confidence', type: 'confidence' },
      ]}
      rows={rows}
      caption="Indicative transit times only — verify with the relevant carrier before relying on these figures."
    />
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Two chokepoints, two risks</h2>
      <p>
        Every China-to-GCC route passes through at least one geopolitical
        chokepoint. Gulf-bound cargo transits the Strait of Hormuz, where
        war-risk premiums feed straight into the rate when tensions rise.
        Jeddah-bound cargo instead faces the Red Sea, where the Houthi crisis
        forced carriers to reroute around the Cape of Good Hope — adding weeks
        to transit. These risks are why the rate ranges on this site are wide:
        the spread is not noise, it is the risk premium flexing with the news
        cycle.
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Frequently asked questions</h2>
    <FaqBlock items={faqs} />
  </section>

  <section class="section container">
    <Cta />
  </section>
</BaseLayout>
