---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL, CONTACT } from '../site';
---

<BaseLayout
  title="Contact"
  description="Contact the WorldFreightHub team with corrections, partnerships or general enquiries."
  canonical={`${SITE_URL}/contact/`}
>
  <div class="page-header">
    <div class="container">
      <Breadcrumb items={[{ label: 'Contact' }]} />
      <h1>Contact</h1>
      <p class="lead">Get in touch with the WorldFreightHub team.</p>
      <blockquote class="tldr">
        <p>
          <strong>TL;DR:</strong> Contact gives 1 entry point for corrections and quote requests: WhatsApp, phone or email. The same 3-tier confidence standard (HIGH/MEDIUM/LOW) applies to anything you receive back. A request is routed rather than resold, so 0 fees are added to the quote handoff.
        </p>
      </blockquote>
    </div>
  </div>

  <section class="section container">
    <h2>Contact us directly</h2>
    <p>
      For the fastest response, reach {CONTACT.name} on WhatsApp or by phone — or email us.
    </p>

    <div class="contact-actions" style="display:flex; flex-wrap:wrap; gap:0.75rem; margin:1.5rem 0;">
      <a class="btn btn-whatsapp" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">
        WhatsApp {CONTACT.phoneDisplay}
      </a>
      <a class="btn btn-secondary" href={`tel:${CONTACT.phoneTel}`}>
        Call {CONTACT.phoneDisplay}
      </a>
      <a class="btn btn-secondary" href={`mailto:${CONTACT.email}`}>
        Email {CONTACT.email}
      </a>
    </div>

    <h2>General enquiries</h2>
    <p>
      For corrections, data updates or general questions, email
      <a href={`mailto:${CONTACT.email}`}> {CONTACT.email}</a>.
    </p>

    <h2>Partnerships & directory</h2>
    <p>
      If you are a freight forwarder, customs broker or logistics provider
      interested in the directory, use the same address with the subject line
      "Directory".
    </p>

    <p class="mt-3">
      <a class="btn btn-primary" href="/get-quote/">Request a quote</a>
    </p>
  </section>
</BaseLayout>
